# =============================================================================
# Dark Pro Blog — environment template
#
#   cp .env.example .env
#   # edit secrets (Admin__Password, Smtp, …)
#   docker compose up --build -d
#
# Live public site: https://mhmdnzr.drl.ink/
#
# How keys work:
#   ASP.NET Core maps Section__Key → configuration Section:Key
#   (overrides appsettings.json). Nested: Section__Child__Key
#   docker compose also interpolates ${BLOG_HTTP_PORT} etc. from this file.
# =============================================================================

# --- Compose / host ports (not read by the app DLL) ---------------------------
BLOG_HTTP_PORT=8934
IMAGE_NAME=dark-pro-blog
IMAGE_TAG=latest
CONTAINER_NAME=dark-pro-blog
REDIS_CONTAINER=dark-pro-redis
RABBITMQ_CONTAINER=dark-pro-rabbitmq
RABBITMQ_PORT=25672
RABBITMQ_MGMT_PORT=35672
RABBITMQ_USER=blog
RABBITMQ_PASS=blog_change_me
VOLUME_DATA_NAME=dark-pro-blog-data
VOLUME_LOGS_NAME=dark-pro-blog-logs
VOLUME_REDIS_NAME=dark-pro-redis-data
VOLUME_RABBIT_NAME=dark-pro-rabbitmq-data
NETWORK_NAME=dark-pro-blog-net
DOTNET_VERSION=10.0
BLOG_CPU_LIMIT=1.0
BLOG_MEMORY_LIMIT=512M
BLOG_CPU_RESERVE=0.10
BLOG_MEMORY_RESERVE=128M

# --- ASP.NET Core runtime -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8934
ASPNETCORE_HTTP_PORTS=8934
TZ=Asia/Tehran

# Behind reverse proxy (Caddy/Nginx/Traefik) terminating TLS for mhmdnzr.drl.ink
ForceHttps=false
AllowedHosts=mhmdnzr.drl.ink;localhost;127.0.0.1

# --- SQLite (container path; volume blog_data → /app/data) --------------------
ConnectionStrings__DefaultConnection=Data Source=/app/data/blog.db;Cache=Shared;Pooling=True;Default Timeout=30
Database__CommandTimeoutSeconds=30
Database__MaxPoolSize=100
Database__MinPoolSize=0
Database__ConnectionLifetime=true

# --- Bootstrap SuperAdmin (seeded only when no users exist) ---------------------
# CHANGE these before first production start.
Admin__Username=admin
Admin__Password=ChangeMe_UseAStrongPassword123!
Admin__Email=admin@mhmdnzr.drl.ink

# --- SEO / public URL (required for sitemap, OG, IndexNow, feeds) -------------
Seo__SiteName=وبلاگ دارک‌پرو
Seo__SiteDescription=یادداشت‌های بلند و فنی درباره دات‌نت، معماری نرم‌افزار و ساختن درست چیزها.
Seo__AuthorName=مدیر کل
Seo__BaseUrl=https://mhmdnzr.drl.ink
Seo__TwitterHandle=@yourhandle

# --- SMTP (email notifications / newsletter) ----------------------------------
Smtp__Enabled=false
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=noreply@mhmdnzr.drl.ink
Smtp__FromDisplayName=وبلاگ دارک‌پرو

# --- SMS (optional) -----------------------------------------------------------
Sms__Enabled=false
Sms__Provider=none
Sms__ApiKey=
Sms__ApiSecret=
Sms__FromNumber=
Sms__Endpoint=

# --- Web Push (VAPID) ---------------------------------------------------------
Push__Enabled=false
Push__VapidPublicKey=
Push__VapidPrivateKey=
Push__Subject=mailto:admin@mhmdnzr.drl.ink

# --- Weekly digest ------------------------------------------------------------
Digest__Enabled=true
Digest__DayOfWeekUtc=1
Digest__HourUtc=8

# --- AI (optional content helpers) --------------------------------------------
Ai__Endpoint=
Ai__ApiKey=
Ai__Model=gpt-4o-mini
Ai__TimeoutSeconds=45

# --- IndexNow (search engine URL ping) ----------------------------------------
IndexNow__Enabled=false
IndexNow__Key=
IndexNow__Endpoints=https://api.indexnow.org/indexnow,https://www.bing.com/indexnow
IndexNow__TimeoutSeconds=20

# --- Comments / spam ----------------------------------------------------------
Comments__SpamDetectionEnabled=true
Comments__SpamThreshold=60
Comments__MaxLinks=2
Comments__MinBodyLength=2
Comments__MaxBodyLength=2000
Comments__EditWindowMinutes=15
Comments__GuestCommentsEnabled=true
Comments__AutoApproveAuthenticated=false
Comments__BlockedKeywords=viagra,cialis,casino,crypto-giveaway,click here now,free money,work from home $$$

# --- RabbitMQ / MassTransit ---------------------------------------------------
# Leave HostName empty → in-process bus only (default).
# With profile rabbitmq: set HostName=rabbitmq and match RABBITMQ_USER/PASS.
RabbitMq__HostName=
RabbitMq__Port=5672
RabbitMq__UserName=blog
RabbitMq__Password=blog_change_me
RabbitMq__VirtualHost=/
RabbitMq__FanoutExchange=blog.notifications.fanout
RabbitMq__TopicExchange=blog.notifications.topic
RabbitMq__ClientProvidedName=blogapp-notifications
RabbitMq__AutomaticRecoveryEnabled=true
RabbitMq__NetworkRecoverySeconds=10
RabbitMq__RequestedHeartbeatSeconds=30
RabbitMq__RequestedConnectionTimeoutSeconds=5

# --- Performance / cache / CDN / images / jobs --------------------------------
# Docker Compose includes Redis. Prefer redis provider in production containers.
Performance__Cache__Provider=redis
Performance__Cache__RedisConnection=redis:6379
Performance__Cache__RedisInstanceName=BlogApp:
Performance__Cache__DefaultSeconds=60
Performance__Cache__HomeFeedSeconds=30
Performance__Cache__PostPageSeconds=120
Performance__Cache__StaticMediaSeconds=604800
Performance__Cache__OutputCacheEnabled=true
Performance__Cache__ResponseCacheEnabled=true

Performance__Cdn__Enabled=false
Performance__Cdn__BaseUrl=
Performance__Cdn__RewriteMediaPaths=true

Performance__ImageOptimize__Enabled=true
Performance__ImageOptimize__MaxWidth=1920
Performance__ImageOptimize__JpegQuality=82
Performance__ImageOptimize__PreferWebP=true
# VariantWidths is an array in JSON; override in appsettings if needed.

Performance__Jobs__Enabled=true
Performance__Jobs__PollIntervalMs=2000
Performance__Jobs__BatchSize=8
Performance__Jobs__Workers=2

# --- OpenTelemetry (optional) -------------------------------------------------
OpenTelemetry__ServiceName=BlogApp
OpenTelemetry__OtlpEndpoint=
OpenTelemetry__Prometheus=true

# --- Backup (optional; paths inside container) --------------------------------
Backup__Enabled=true
Backup__Path=/app/data/backups
Backup__IntervalHours=24
Backup__RetentionDays=14
Backup__MaxFiles=30
Backup__IncludeDatabase=true
Backup__IncludeDataDirectory=true
Backup__TargetRtoMinutes=30

# --- Serilog ------------------------------------------------------------------
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore=Warning
Serilog__MinimumLevel__Override__System=Warning
Serilog__MinimumLevel__Override__BlogApp=Information
Serilog__Properties__Application=BlogApp
Serilog__Properties__Environment=Production

# --- Local SDK run (optional) -------------------------------------------------
# When using `dotnet run` on the host (not Docker), prefer a local DB path:
# ConnectionStrings__DefaultConnection=Data Source=blog.db;Cache=Shared;Pooling=True;Default Timeout=30
# Performance__Cache__Provider=memory
# Performance__Cache__RedisConnection=
# Seo__BaseUrl=https://mhmdnzr.drl.ink
