# =============================================================================
# Dark Pro Blog — environment template
#
#   cp .env.example .env
#   docker compose up --build -d
#
# Live public site: https://mhmdnzr.drl.ink/
# ASP.NET maps Section__Key → Section:Key (overrides appsettings.json).
# =============================================================================

# --- Compose / host ports -----------------------------------------------------
BLOG_HTTP_PORT=8934
IMAGE_NAME=dark-pro-blog
IMAGE_TAG=latest
CONTAINER_NAME=dark-pro-blog
REDIS_CONTAINER=dark-pro-redis
RABBITMQ_CONTAINER=dark-pro-rabbitmq
RABBITMQ_PORT=25672
RABBITMQ_MGMT_PORT=35672
RABBITMQ_USER=blog
RABBITMQ_PASS=blog_change_me
VOLUME_DATA_NAME=dark-pro-blog-data
VOLUME_LOGS_NAME=dark-pro-blog-logs
VOLUME_REDIS_NAME=dark-pro-redis-data
VOLUME_RABBIT_NAME=dark-pro-rabbitmq-data
NETWORK_NAME=dark-pro-blog-net
DOTNET_VERSION=10.0
BLOG_CPU_LIMIT=1.0
BLOG_MEMORY_LIMIT=512M
BLOG_CPU_RESERVE=0.10
BLOG_MEMORY_RESERVE=128M

# --- ASP.NET Core runtime -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8934
ASPNETCORE_HTTP_PORTS=8934
TZ=Asia/Tehran
ForceHttps=false
AllowedHosts=mhmdnzr.drl.ink;localhost;127.0.0.1

# --- SQLite -------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Data Source=/app/data/blog.db;Cache=Shared;Pooling=True;Default Timeout=30
Database__CommandTimeoutSeconds=30
Database__MaxPoolSize=100
Database__MinPoolSize=0
Database__ConnectionLifetime=true

# --- Data Protection (antiforgery / auth cookies) ------------------------------
# MUST be on the persistent volume so keys survive docker rebuilds.
DataProtection__KeysPath=/app/data/dp-keys
DataProtection__ApplicationName=BlogApp

# --- Bootstrap SuperAdmin -----------------------------------------------------
Admin__Username=admin
Admin__Password=ChangeMe_UseAStrongPassword123!
Admin__Email=admin@mhmdnzr.drl.ink

# --- SEO / public URL ---------------------------------------------------------
Seo__SiteName=وبلاگ دارک‌پرو
Seo__SiteDescription=یادداشت‌های بلند و فنی
Seo__AuthorName=مدیر کل
Seo__BaseUrl=https://mhmdnzr.drl.ink
Seo__TwitterHandle=@yourhandle

# --- SMTP ---------------------------------------------------------------------
Smtp__Enabled=false
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=noreply@mhmdnzr.drl.ink
Smtp__FromDisplayName=وبلاگ دارک‌پرو

# --- SMS / Push / Digest ------------------------------------------------------
Sms__Enabled=false
Sms__Provider=none
Push__Enabled=false
Push__VapidPublicKey=
Push__VapidPrivateKey=
Push__Subject=mailto:admin@mhmdnzr.drl.ink
Digest__Enabled=true
Digest__DayOfWeekUtc=1
Digest__HourUtc=8

# --- AI / IndexNow ------------------------------------------------------------
Ai__Endpoint=
Ai__ApiKey=
Ai__Model=gpt-4o-mini
IndexNow__Enabled=false
IndexNow__Key=

# --- Comments -----------------------------------------------------------------
Comments__SpamDetectionEnabled=true
Comments__GuestCommentsEnabled=true

# --- RabbitMQ (empty HostName = in-process) -----------------------------------
RabbitMq__HostName=
RabbitMq__Port=5672
RabbitMq__UserName=blog
RabbitMq__Password=blog_change_me

# --- Performance / Redis ------------------------------------------------------
Performance__Cache__Provider=redis
Performance__Cache__RedisConnection=redis:6379
Performance__Cache__RedisInstanceName=BlogApp:
Performance__ImageOptimize__Enabled=true
Performance__Jobs__Enabled=true

# --- Backup -------------------------------------------------------------------
Backup__Enabled=true
Backup__Path=/app/data/backups

# --- Serilog ------------------------------------------------------------------
Serilog__MinimumLevel__Default=Information
Serilog__Properties__Application=BlogApp
Serilog__Properties__Environment=Production
