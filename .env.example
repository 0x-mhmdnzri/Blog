# =============================================================================
# Dark Pro Blog — environment template
#
#   cp .env.example .env
#   # edit secrets (Admin__Password, …) then:
#   docker compose up --build -d
#
# Rules:
#   - Never commit .env (see .gitignore)
#   - ASP.NET Core maps KEY__Nested__Path → configuration ["Key:Nested:Path"]
#   - Values here override appsettings.json / appsettings.Production.json
#   - Empty RabbitMq__HostName = in-process MassTransit bus (no broker)
# =============================================================================

# ---- Compose / image / resources (interpolated by docker-compose.yml) -------
DOTNET_VERSION=10.0
IMAGE_NAME=dark-pro-blog
IMAGE_TAG=latest
CONTAINER_NAME=dark-pro-blog
BLOG_HTTP_PORT=8080
VOLUME_DATA_NAME=dark-pro-blog-data
VOLUME_LOGS_NAME=dark-pro-blog-logs
NETWORK_NAME=dark-pro-blog-net
BLOG_CPU_LIMIT=1.0
BLOG_MEMORY_LIMIT=512M
BLOG_CPU_RESERVE=0.10
BLOG_MEMORY_RESERVE=128M

# ---- ASP.NET Core runtime ---------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_URLS=http://+:8080
AllowedHosts=*
# Keep false behind plain HTTP / reverse proxy. true only if TLS ends at the app.
ForceHttps=false
TZ=Asia/Tehran
DOTNET_EnableDiagnostics=0
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# ---- Database (SQLite on named volume /app/data) ----------------------------
ConnectionStrings__DefaultConnection=Data Source=/app/data/blog.db;Cache=Shared;Pooling=True;Default Timeout=30
Database__CommandTimeoutSeconds=30
Database__MaxPoolSize=100
Database__MinPoolSize=0
Database__ConnectionLifetime=00:10:00

# ---- Admin seed (applied on first boot only) --------------------------------
Admin__Username=admin
Admin__Password=ChangeMe_Use_A_Strong_Password_123!
Admin__Email=admin@localhost

# ---- SEO / public site ------------------------------------------------------
Seo__SiteName=وبلاگ دارک‌پرو
Seo__SiteDescription=یادداشت‌های بلند و فنی به سبک ریدمی درباره دات‌نت، معماری نرم‌افزار و ساختن درست چیزها.
Seo__AuthorName=نویسنده سایت
Seo__BaseUrl=http://localhost:8080
Seo__TwitterHandle=

# ---- Serilog ----------------------------------------------------------------
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore=Warning

# ---- Comments ---------------------------------------------------------------
Comments__SpamDetectionEnabled=true
Comments__SpamThreshold=40
Comments__MaxLinks=2
Comments__MinBodyLength=2
Comments__MaxBodyLength=2000
Comments__EditWindowMinutes=15
Comments__GuestCommentsEnabled=true
Comments__AutoApproveAuthenticated=false

# ---- OpenTelemetry (optional) -----------------------------------------------
OpenTelemetry__ServiceName=BlogApp
OpenTelemetry__OtlpEndpoint=
OpenTelemetry__Prometheus=true

# ---- MassTransit / RabbitMQ -------------------------------------------------
# Leave HostName empty for in-memory bus (default single-node).
# For broker: docker compose --profile rabbitmq up -d
# then set RabbitMq__HostName=rabbitmq and recreate the blog service.
RabbitMq__HostName=
RabbitMq__Port=5672
RabbitMq__UserName=blog
RabbitMq__Password=blog_change_me
RabbitMq__VirtualHost=/
RabbitMq__FanoutExchange=blog.notifications.fanout
RabbitMq__TopicExchange=blog.notifications.topic
RabbitMq__ClientProvidedName=blogapp-notifications
RabbitMq__AutomaticRecoveryEnabled=true
RabbitMq__NetworkRecoverySeconds=10
RabbitMq__RequestedHeartbeatSeconds=30
RabbitMq__RequestedConnectionTimeoutSeconds=5
RabbitMq__DispatchConsumersAsync=true

# API topic bus (same broker when HostName is set; else in-process)
ApiTopicBus__UseRabbit=true
ApiTopicBus__TopicExchange=blog.api.topic
ApiTopicBus__WorkQueue=blog.api.work
ApiTopicBus__RoutingPrefix=api
ApiTopicBus__Prefetch=1
ApiTopicBus__DefaultTimeoutSeconds=25
ApiTopicBus__InProcessCapacity=10000

# Compose profile "rabbitmq" only (official image env names)
RABBITMQ_CONTAINER=dark-pro-rabbitmq
RABBITMQ_USER=blog
RABBITMQ_PASS=blog_change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
VOLUME_RABBIT_NAME=dark-pro-rabbitmq-data

# ---- Social login (optional — leave empty to disable) -----------------------
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__GitHub__ClientId=
Authentication__GitHub__ClientSecret=

# ---- Optional integrations (off by default) ---------------------------------
Smtp__Enabled=false
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromDisplayName=

Sms__Enabled=false
Sms__Provider=
Sms__ApiKey=
Sms__ApiSecret=
Sms__FromNumber=
Sms__Endpoint=

Push__Enabled=false
Push__VapidPublicKey=
Push__VapidPrivateKey=
Push__Subject=

Digest__Enabled=false
Digest__DayOfWeekUtc=1
Digest__HourUtc=8

IndexNow__Enabled=false
IndexNow__Key=
IndexNow__TimeoutSeconds=10

Ai__Endpoint=
Ai__ApiKey=
Ai__Model=
Ai__TimeoutSeconds=60

Performance__Cache__Provider=memory
Performance__Cdn__Enabled=false
Performance__ImageOptimize__Enabled=true

# ---- Application data backup (Docker volume /app/data/backups) ---------------
# RPO ≈ IntervalHours (worst-case loss window for scheduled full backups).
# RTO local restore is typically minutes (extract + optional DB swap + restart).
Backup__Enabled=true
Backup__Path=/app/data/backups
Backup__IntervalHours=24
Backup__RetentionDays=14
Backup__MaxFiles=30
Backup__IncludeDatabase=true
Backup__IncludeDataDirectory=true
Backup__TargetRtoMinutes=30
