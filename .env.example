# =============================================================================
# Dark Pro Blog — environment template
# cp .env.example .env   then edit.  Never commit .env.
# ASP.NET Core binds nested keys with double underscore: Section__Key
# =============================================================================

# ---- Compose / image --------------------------------------------------------
IMAGE_NAME=dark-pro-blog
IMAGE_TAG=latest
CONTAINER_NAME=dark-pro-blog
BLOG_HTTP_PORT=8080
VOLUME_DATA_NAME=dark-pro-blog-data
VOLUME_LOGS_NAME=dark-pro-blog-logs
NETWORK_NAME=dark-pro-blog-net
BLOG_CPU_LIMIT=1.0
BLOG_MEMORY_LIMIT=512M
BLOG_CPU_RESERVE=0.10
BLOG_MEMORY_RESERVE=128M

# ---- ASP.NET Core -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
# Comma-separated hosts or *
AllowedHosts=*
# true only if the container itself terminates TLS (usually false behind nginx/Caddy)
ForceHttps=false

# ---- Database (SQLite path inside container) ---------------------------------
ConnectionStrings__DefaultConnection=Data Source=/app/data/blog.db

# ---- Admin seed (created on first boot if missing) --------------------------
Admin__Username=admin
Admin__Password=ChangeMe_Use_A_Strong_Password_123!
Admin__Email=admin@localhost

# ---- SEO / public URL (must match the URL users open) -----------------------
Seo__SiteName=وبلاگ دارک‌پرو
Seo__SiteDescription=یادداشت‌های بلند و فنی به سبک ریدمی درباره دات‌نت، معماری نرم‌افزار و ساختن درست چیزها.
Seo__AuthorName=نویسنده سایت
Seo__BaseUrl=http://localhost:8080
Seo__TwitterHandle=

# ---- Serilog (structured JSON → stdout + /app/logs) -------------------------
# Production: Information. Use Debug only while troubleshooting.
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore=Warning
Serilog__MinimumLevel__Override__BlogApp=Information
Serilog__Properties__Application=BlogApp
