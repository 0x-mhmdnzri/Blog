# ===========================
# ASP.NET Core
# ===========================
ASPNETCORE_ENVIRONMENT=Production

# ===========================
# Database
# ===========================
ConnectionStrings__DefaultConnection=Data Source=blog.db

# ===========================
# Admin
# ===========================
Admin__Username=admin
Admin__Password=ChangeMe123!

# ===========================
# SEO
# ===========================
Seo__SiteName=وبلاگ دارک‌پرو
Seo__SiteDescription=یادداشت‌های بلند و فنی به سبک ریدمی درباره دات‌نت، معماری نرم‌افزار و ساختن درست چیزها.
Seo__AuthorName=نویسنده سایت
Seo__BaseUrl=https://example.com
Seo__TwitterHandle=@yourhandle

# ===========================
# Serilog (ELK-friendly)
# Production default: Information. Set Debug only while troubleshooting.
# ===========================
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore=Warning
Serilog__MinimumLevel__Override__BlogApp=Information

# ===========================
# ASP.NET
# ===========================
AllowedHosts=*
