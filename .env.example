# =============================================================================
# Dark Pro Blog — environment template (standalone / Docker)
#
#   cp .env.example .env
#   docker compose up --build -d
#
# .env is optional: compose has safe defaults. Never commit a real .env.
# Empty RabbitMq__HostName = in-process bus only (fastest single-node start).
# =============================================================================

# ---- Compose / image --------------------------------------------------------
IMAGE_NAME=dark-pro-blog
IMAGE_TAG=latest
CONTAINER_NAME=dark-pro-blog
BLOG_HTTP_PORT=8080
VOLUME_DATA_NAME=dark-pro-blog-data
VOLUME_LOGS_NAME=dark-pro-blog-logs
NETWORK_NAME=dark-pro-blog-net
BLOG_CPU_LIMIT=1.0
BLOG_MEMORY_LIMIT=512M
BLOG_CPU_RESERVE=0.10
BLOG_MEMORY_RESERVE=128M

# ---- ASP.NET Core -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_URLS=http://+:8080
AllowedHosts=*
# Keep false behind plain HTTP (compose / local). Set true only if TLS terminates at the app.
ForceHttps=false

# ---- Database (SQLite on named volume) --------------------------------------
ConnectionStrings__DefaultConnection=Data Source=/app/data/blog.db;Cache=Shared;Pooling=True;Default Timeout=30
Database__CommandTimeoutSeconds=30
Database__MaxPoolSize=100
Database__MinPoolSize=0

# ---- Admin seed (first boot only) -------------------------------------------
Admin__Username=admin
Admin__Password=ChangeMe_Use_A_Strong_Password_123!
Admin__Email=admin@localhost

# ---- SEO --------------------------------------------------------------------
Seo__SiteName=وبلاگ دارک‌پرو
Seo__SiteDescription=یادداشت‌های بلند و فنی به سبک ریدمی درباره دات‌نت، معماری نرم‌افزار و ساختن درست چیزها.
Seo__AuthorName=نویسنده سایت
Seo__BaseUrl=http://localhost:8080
Seo__TwitterHandle=

# ---- Serilog ----------------------------------------------------------------
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore=Warning
Serilog__MinimumLevel__Override__BlogApp=Information
Serilog__Properties__Application=BlogApp

# ---- RabbitMQ (optional multi-instance) -------------------------------------
# Standalone default: leave HostName EMPTY → Channel-only, no broker dependency.
# Enable broker:
#   1) docker compose --profile rabbitmq up -d
#   2) set RabbitMq__HostName=rabbitmq
RabbitMq__HostName=
RabbitMq__Port=5672
RabbitMq__UserName=blog
RabbitMq__Password=blog_change_me
RabbitMq__VirtualHost=/
RabbitMq__FanoutExchange=blog.notifications.fanout
RabbitMq__TopicExchange=blog.notifications.topic
RabbitMq__ClientProvidedName=blogapp-notifications
RabbitMq__AutomaticRecoveryEnabled=true
RabbitMq__NetworkRecoverySeconds=10
RabbitMq__RequestedHeartbeatSeconds=30
RabbitMq__RequestedConnectionTimeoutSeconds=5

# API topic bus (uses same broker when HostName is set; else in-process)
ApiTopicBus__UseRabbit=true
ApiTopicBus__TopicExchange=blog.api.topic
ApiTopicBus__WorkQueue=blog.api.work
ApiTopicBus__RoutingPrefix=api
ApiTopicBus__Prefetch=1
ApiTopicBus__DefaultTimeoutSeconds=25
ApiTopicBus__InProcessCapacity=10000

# Compose profile "rabbitmq" only
RABBITMQ_CONTAINER=dark-pro-rabbitmq
RABBITMQ_USER=blog
RABBITMQ_PASS=blog_change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
VOLUME_RABBIT_NAME=dark-pro-rabbitmq-data

# ---- Optional integrations (off by default) ---------------------------------
Smtp__Enabled=false
Sms__Enabled=false
Push__Enabled=false
Performance__Cache__Provider=memory
Performance__Cdn__Enabled=false
