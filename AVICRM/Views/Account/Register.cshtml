@model AVICRM.Models.ViewModels.RegisterReaderViewModel
@{
    ViewData["Title"] = "ثبت‌نام خواننده";
    ViewData["NoIndex"] = true;
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card-surface p-4" style="max-width:420px; width:100%;">
        <div class="hero-prompt mb-2">$ auth register --role reader</div>
        <h1 class="h4 mb-2">عضویت خواننده</h1>
        <p class="text-muted-dark small mb-4">برای نشان‌گذاری نوشته‌ها یک حساب ساده بسازید.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert mb-3" style="background:rgba(229,99,122,.12); color:var(--danger); border:1px solid rgba(229,99,122,.3);">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label class="form-label" asp-for="UserName"></label>
                <input class="form-control ltr-field" asp-for="UserName" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control ltr-field" asp-for="Email" required />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="DisplayName"></label>
                <input class="form-control" asp-for="DisplayName" dir="auto" required />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control ltr-field" asp-for="Password" required />
                <div class="form-text">حداقل ۱۰ نویسه، حروف بزرگ/کوچک، عدد و نماد</div>
            </div>
            <div class="mb-4">
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input class="form-control ltr-field" asp-for="ConfirmPassword" required />
            </div>
            <button class="btn btn-accent w-100" type="submit">ثبت‌نام</button>
        </form>

        <p class="mt-3 mb-0 small text-muted-dark text-center">
            حساب دارید؟
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">ورود</a>
        </p>
    </div>
</div>
