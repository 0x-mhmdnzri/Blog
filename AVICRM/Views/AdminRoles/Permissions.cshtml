@model AVICRM.Controllers.RolePermissionsVm
@inject AVICRM.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = $"مجوزهای {@Model.RoleName}";
}
<link rel="stylesheet" href="~/css/admin-permissions.css" asp-append-version="true" />

@if (TempData["Saved"] != null)
{
    <div class="card-surface p-3 mb-3 small text-muted-dark">@TempData["Saved"]</div>
}
 
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
    <div>
        <a class="small text-muted-dark" asp-action="Index">← نقش‌ها</a>
        <h1 class="h5 mb-1 mt-1">مجوزهای نقش <span class="ltr-field">@Model.RoleName</span></h1>
        <p class="small text-muted-dark mb-0">
            درخت منوی ادمین از سرور ساخته شده — صفحات را تیک بزنید و قابلیت‌ها را ترکیب کنید.
            @if (Model.IsSuperAdmin)
            {
                <span class="status-pill featured">SuperAdmin همیشه همه دسترسی‌ها را دارد</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-ghost btn-sm" id="permSelectAll">انتخاب همه</button>
        <button type="button" class="btn btn-ghost btn-sm" id="permClearAll">پاک کردن</button>
    </div>
</div>

<form asp-action="SavePermissions" method="post" id="permForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="role" value="@Model.RoleName" />

    <div class="perm-layout">
        <section class="perm-panel card-surface">
            <header class="perm-panel-head">
                <h2 class="h6 mb-0">صفحات پنل ادمین</h2>
                <span class="small text-muted-dark">منو و زیرمنو · تولید خودکار</span>
            </header>
            <div class="perm-tree">
            @foreach (var group in Model.PageTree)
            {
                var groupId = "g-" + group.GroupKey.Replace('.', '-');
                <div class="perm-group" data-group>
                    <button type="button" class="perm-group-toggle" data-group-toggle aria-expanded="true">
                        <span class="perm-chevron" aria-hidden="true"></span>
                        <span class="perm-group-title">@T[group.GroupKey]</span>
                        <span class="perm-group-count small text-muted-dark ltr-field">@group.Pages.Count</span>
                    </button>
                    <div class="perm-group-body" id="@groupId">
                    @foreach (var navPage in group.Pages)
                    {
                        var checkedAttr = Model.IsSuperAdmin || Model.SelectedPages.Contains(navPage.Key) ? "checked" : null;
                        <label class="perm-page">
                            <input type="checkbox" name="pages" value="@navPage.Key" @checkedAttr class="perm-check" data-perm-page />
                            <span class="perm-page-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="@navPage.Icon"/></svg>
                            </span>
                            <span class="perm-page-label">
                                <span>@T[navPage.LabelKey]</span>
                                <span class="perm-page-key ltr-field">@navPage.Key</span>
                            </span>
                            @if (navPage.SuperAdminOnly)
                            {
                                <span class="soon-tag">Super</span>
                            }
                        </label>
                    }
                    </div>
                </div>
            }
            </div>
        </section>

        <section class="perm-panel card-surface">
            <header class="perm-panel-head">
                <h2 class="h6 mb-0">قابلیت‌ها (Claims)</h2>
                <span class="small text-muted-dark">ترکیب با صفحات برای دسترسی ریزدانه‌تر</span>
            </header>
            <div class="perm-caps">
            @foreach (var cap in Model.Capabilities)
            {
                var checkedAttr = Model.IsSuperAdmin || Model.SelectedCapabilities.Contains(cap.ClaimType) ? "checked" : null;
                <label class="perm-cap">
                    <input type="checkbox" name="capabilities" value="@cap.ClaimType" @checkedAttr class="perm-check" data-perm-cap />
                    <span class="perm-cap-icon" aria-hidden="true">@cap.Icon</span>
                    <span class="perm-cap-text">
                        <span class="perm-cap-fa">@cap.LabelFa</span>
                        <span class="perm-cap-en ltr-field">@cap.LabelEn</span>
                        <span class="perm-page-key ltr-field">@cap.ClaimType</span>
                    </span>
                </label>
            }
            </div>
        </section>
    </div>

    <div class="perm-footer card-surface">
        <button type="submit" class="btn btn-accent">ذخیره مجوزها</button>
        <a class="btn btn-ghost" asp-action="Index">انصراف</a>
        <span class="small text-muted-dark ms-auto">کاربران پس از ذخیره باید یک‌بار خارج و دوباره وارد شوند.</span>
    </div>
</form>

<script src="~/js/admin-permissions.js" asp-append-version="true"></script>
