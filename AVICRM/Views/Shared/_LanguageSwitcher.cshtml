@inject AVICRM.Services.ICultureService Culture
@{
    var current = Culture.Current;
    var returnPath = Context.Request.Path + Context.Request.QueryString;
    // Prefer original path if middleware stored it
    if (Context.Items.TryGetValue("OriginalPath", out var op) && op is string orig)
        returnPath = orig + Context.Request.QueryString;
}
<div class="lang-switcher dropdown">
    <button class="btn btn-ghost btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Language">
        <span class="ltr-field">@current.Code.ToUpperInvariant()</span>
        <span class="d-none d-md-inline"> · @current.NativeName</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" style="min-width:9rem;">
        @foreach (var c in Culture.EnabledCultures)
        {
            var active = c.Code == current.Code;
            <li>
                <a class="dropdown-item @(active ? "active" : "")"
                   href="/culture/@c.Code?returnUrl=@Uri.EscapeDataString(returnPath.ToString())"
                   dir="@(c.IsRtl ? "rtl" : "ltr")">
                    <span class="ltr-field">@c.Code.ToUpperInvariant()</span>
                    — @c.NativeName
                </a>
            </li>
        }
    </ul>
</div>
