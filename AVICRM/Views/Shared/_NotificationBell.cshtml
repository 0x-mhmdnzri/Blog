@{
    var isAuthed = User.Identity?.IsAuthenticated == true;
}
@if (isAuthed)
{
    <div class="notif-bell dropdown" id="notifBell"
         data-i18n-empty="@T["notif.empty"]"
         data-i18n-loading="@T["notif.loading"]"
         data-i18n-failed="@T["notif.failed"]">
        <button class="notif-bell-btn" type="button" id="notifBellBtn"
                data-bs-toggle="dropdown" data-bs-auto-close="outside"
                aria-expanded="false" aria-label="@T["notif.title"]" title="@T["notif.title"]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <span class="notif-badge" id="notifBadge" hidden>0</span>
        </button>
        <div class="dropdown-menu notif-dropdown dropdown-menu-end" aria-labelledby="notifBellBtn">
            <div class="notif-dropdown-head">
                <strong>@T["notif.title"]</strong>
                <button type="button" class="notif-mark-all" id="notifMarkAll">@T["notif.mark_all"]</button>
            </div>
            <div class="notif-list" id="notifList">
                <div class="notif-empty text-muted-dark small p-3">@T["notif.loading"]</div>
            </div>
            <div class="notif-dropdown-foot">
                <a asp-controller="Notifications" asp-action="Index">@T["notif.view_all"]</a>
                <a asp-controller="Notifications" asp-action="Preferences">@T["notif.preferences"]</a>
            </div>
        </div>
        @Html.AntiForgeryToken()
    </div>
}
