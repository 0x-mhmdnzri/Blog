@model AVICRM.Models.PostRevision
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var post = ViewBag.Post as AVICRM.Models.Post;
    var current = ViewBag.CurrentMarkdown as string ?? "";
    ViewData["Title"] = "Revision";
    ViewData["NoIndex"] = true;
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h5 mb-1">Revision</h1>
        <p class="text-muted-dark small mb-0 ltr-field">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC · @Model.Note</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@Model.PostId">Back to editor</a>
        <form asp-action="RestoreRevision" method="post" class="d-inline"
              onsubmit="return confirm('Restore this revision into the live draft?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="postId" value="@Model.PostId" />
            <input type="hidden" name="revisionId" value="@Model.Id" />
            <button type="submit" class="btn btn-accent btn-sm">Restore</button>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card-surface p-3">
            <h2 class="h6 text-muted-dark">Revision snapshot</h2>
            <p class="fw-bold" dir="auto">@Model.Title</p>
            @if (!string.IsNullOrEmpty(Model.Summary))
            {
                <p class="small text-muted-dark" dir="auto">@Model.Summary</p>
            }
            <pre class="small ltr-field" style="white-space:pre-wrap;max-height:28rem;overflow:auto;">@Model.ContentMarkdown</pre>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-surface p-3">
            <h2 class="h6 text-muted-dark">Current draft</h2>
            <p class="fw-bold" dir="auto">@(post?.Title)</p>
            <pre class="small ltr-field" style="white-space:pre-wrap;max-height:28rem;overflow:auto;">@current</pre>
        </div>
    </div>
</div>
