@model List<PostListItemViewModel>
@{
    ViewData["Title"] = T["home.title"];
    var categories = ViewBag.Categories as List<Category> ?? new();
    var currentPage = ViewBag.Page as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var sort = ViewBag.Sort as string;
    var featured = ViewBag.Featured as bool?;
    var minRead = ViewBag.MinRead as int?;
    var q = ViewBag.SearchQuery as string;
    var isFeedOnly = !string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(ViewBag.CurrentCategory as string)
        || !string.IsNullOrEmpty(ViewBag.CurrentTag as string) || currentPage > 1
        || !string.IsNullOrEmpty(sort) || featured == true || minRead is > 0;
}

@section Head {
    @if (ViewBag.WebsiteJsonLd is string websiteLd && !string.IsNullOrEmpty(websiteLd))
    {
        <script type="application/ld+json">@Html.Raw(websiteLd)</script>
    }
    @if (ViewBag.CollectionJsonLd is string collectionLd && !string.IsNullOrEmpty(collectionLd))
    {
        <script type="application/ld+json">@Html.Raw(collectionLd)</script>
    }
}

@if (!isFeedOnly)
{
<section class="persona-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="persona-kicker">Senior .NET Backend Engineer · Tehran</div>
                <h1 class="persona-title" dir="auto">محمد نظری</h1>
                <p class="persona-lead" dir="auto">
                    طراحی و ساخت سیستم‌های توزیع‌شده برای FinTech، ERP و HealthTech —
                    Clean Architecture، DDD، CQRS، RabbitMQ و Redis در مقیاس واقعی.
                    این وبلاگ جای درس‌آموخته‌های فنی و مسیر کار با مشتریان است.
                </p>
                <div class="persona-cta">
                    <a class="btn btn-accent" href="#blog-feed">مطالعه وبلاگ</a>
                    <a class="btn btn-ghost" asp-controller="Pages" asp-action="About">درباره من</a>
                    <a class="btn btn-ghost" asp-controller="Pages" asp-action="Contact">همکاری با من</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="persona-stats">
                    <div class="persona-stat">
                        <div class="num ltr-field">6+</div>
                        <div class="lbl" dir="auto">سال تجربه</div>
                    </div>
                    <div class="persona-stat">
                        <div class="num ltr-field">.NET 8</div>
                        <div class="lbl" dir="auto">اکوسیستم اصلی</div>
                    </div>
                    <div class="persona-stat">
                        <div class="num">DDD</div>
                        <div class="lbl" dir="auto">معماری دامنه</div>
                    </div>
                    <div class="persona-stat">
                        <div class="num">EDA</div>
                        <div class="lbl" dir="auto">رویدادمحور</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    <h2 class="section-title" dir="auto">نقشه راه برای مشتریان</h2>
    <p class="section-sub" dir="auto">اگر برای اولین بار آمده‌اید، این ترتیب را پیشنهاد می‌کنم.</p>
    <div class="roadmap mb-5">
        <div class="roadmap-step">
            <div class="roadmap-num">1</div>
            <div>
                <strong dir="auto"><a asp-controller="Pages" asp-action="About">درباره</a></strong>
                <span class="text-muted-dark small"> — سابقه، حوزه و سبک کار</span>
            </div>
        </div>
        <div class="roadmap-step">
            <div class="roadmap-num">2</div>
            <div>
                <strong dir="auto"><a asp-controller="Pages" asp-action="Services">خدمات</a> و <a asp-controller="Pages" asp-action="Projects">پروژه‌ها</a></strong>
                <span class="text-muted-dark small"> — آنچه می‌توانم تحویل دهم</span>
            </div>
        </div>
        <div class="roadmap-step">
            <div class="roadmap-num">3</div>
            <div>
                <strong dir="auto"><a href="#blog-feed">وبلاگ</a></strong>
                <span class="text-muted-dark small"> — عمق فنی، الگوها و تصمیم‌های واقعی</span>
            </div>
        </div>
        <div class="roadmap-step">
            <div class="roadmap-num">4</div>
            <div>
                <strong dir="auto"><a asp-controller="Pages" asp-action="Contact">تماس</a></strong>
                <span class="text-muted-dark small"> — شروع همکاری</span>
            </div>
        </div>
    </div>

    <h2 class="section-title" dir="auto">مهارت‌های کلیدی</h2>
    <div class="skill-grid mb-2">
        <div class="skill-card"><h3>Architecture</h3><p>Clean Architecture · DDD · CQRS · Microservices · Modular Monolith</p></div>
        <div class="skill-card"><h3>Data &amp; Cache</h3><p>EF Core · Dapper · SQL Server · PostgreSQL · Redis lock &amp; cache</p></div>
        <div class="skill-card"><h3>Messaging</h3><p>RabbitMQ patterns · SignalR · Event-driven flows</p></div>
        <div class="skill-card"><h3>Security</h3><p>OAuth2 · OIDC · IdentityServer · JWT · SSO</p></div>
    </div>
</div>
}

<div class="container py-5" id="blog-feed">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
        <div>
            <h2 class="section-title mb-1" dir="auto">@(isFeedOnly ? T["home.title"] : "از وبلاگ")</h2>
            @if (!isFeedOnly)
            {
                <p class="section-sub mb-0" dir="auto">نوشته‌های فنی، معماری و تجربه پروژه — برای مشتریان و مهندسان.</p>
            }
        </div>
    </div>

    <form method="get" class="ux-filters mb-3" action="">
        <input type="search" name="q" value="@q" placeholder="جست‌وجو…" dir="auto" />
        <select name="sort">
            <option value="">جدیدترین</option>
            @if (sort == "popular") { <option value="popular" selected>محبوب</option> } else { <option value="popular">محبوب</option> }
            @if (sort == "oldest") { <option value="oldest" selected>قدیمی‌تر</option> } else { <option value="oldest">قدیمی‌تر</option> }
            @if (sort == "read") { <option value="read" selected>کوتاه‌تر</option> } else { <option value="read">کوتاه‌تر</option> }
        </select>
        <label class="small d-inline-flex align-items-center gap-1">
            <input type="checkbox" name="featured" value="true" @(featured == true ? "checked" : null) /> ویژه
        </label>
        <select name="minRead">
            <option value="">هر مدت</option>
            @if (minRead == 3) { <option value="3" selected>۳+ دقیقه</option> } else { <option value="3">۳+ دقیقه</option> }
            @if (minRead == 5) { <option value="5" selected>۵+ دقیقه</option> } else { <option value="5">۵+ دقیقه</option> }
            @if (minRead == 10) { <option value="10" selected>۱۰+ دقیقه</option> } else { <option value="10">۱۰+ دقیقه</option> }
        </select>
        @if (!string.IsNullOrEmpty(ViewBag.CurrentCategory as string))
        {
            <input type="hidden" name="category" value="@ViewBag.CurrentCategory" />
        }
        <button type="submit" class="btn btn-ghost btn-sm">اعمال</button>
    </form>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="tag-pill @(ViewBag.CurrentCategory == null ? "border-0" : "")"
           style="@(ViewBag.CurrentCategory == null ? "background:var(--accent-soft);color:var(--accent);" : "")"
           asp-action="Index">@T["home.all"]</a>
        @foreach (var c in categories)
        {
            <a class="tag-pill" dir="auto" style="@(ViewBag.CurrentCategory == c.Slug ? "background:var(--accent-soft);color:var(--accent);" : "")"
               asp-action="Index" asp-route-category="@c.Slug">@c.Name</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card-surface p-5 text-center text-muted-dark">
            <p class="mb-0" dir="auto">@T["home.empty"]</p>
        </div>
    }

    <div class="row g-4" id="posts-grid" data-page="@currentPage" data-total-pages="@totalPages">
        <partial name="_PostCards" model="Model" />
    </div>

    <div id="infinite-sentinel"></div>
    <div id="infinite-status" class="infinite-status"></div>

    @if (totalPages > 1)
    {
        <noscript>
            <nav class="mt-5 d-flex justify-content-center gap-2">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <a class="btn btn-ghost btn-sm ltr-field" asp-action="Index" asp-route-page="@p"
                       asp-route-category="@ViewBag.CurrentCategory" asp-route-q="@q">@p</a>
                }
            </nav>
        </noscript>
    }
</div>
