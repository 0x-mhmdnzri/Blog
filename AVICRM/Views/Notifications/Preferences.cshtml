@model AVICRM.Models.NotificationPreference
@{
    ViewData["Title"] = T["notif.prefs_title"];
}

<div class="np-page">
    <header class="np-hero">
        <div>
            <p class="np-eyebrow">Settings</p>
            <h1 class="np-title">@T["notif.prefs_title"]</h1>
            <p class="np-sub">کانال‌ها و رویدادهایی که می‌خواهید از آن‌ها خبردار شوید.</p>
        </div>
        <a class="np-back" asp-action="Index">← @T["btn.back"]</a>
    </header>

    @if (TempData["PrefsSaved"] != null)
    {
        <div class="np-alert" role="status">@T["msg.saved"]</div>
    }

    <form asp-action="Preferences" method="post" class="np-form">
        @Html.AntiForgeryToken()

        <section class="np-card">
            <div class="np-card-head">
                <h2 class="np-card-title">@T["notif.channels"]</h2>
                <p class="np-card-desc">از کدام مسیر اعلان بگیرید</p>
            </div>
            <div class="np-toggles">
                <label class="np-toggle">
                    <span class="np-toggle-text">
                        <strong>@T["notif.channel_inapp"]</strong>
                        <span>اعلان داخل سایت و زنگوله</span>
                    </span>
                    <input class="np-switch" type="checkbox" asp-for="InAppEnabled" />
                </label>
                <label class="np-toggle">
                    <span class="np-toggle-text">
                        <strong>@T["notif.channel_email"]</strong>
                        <span>ایمیل به آدرس حساب</span>
                    </span>
                    <input class="np-switch" type="checkbox" asp-for="EmailEnabled" />
                </label>
                <label class="np-toggle">
                    <span class="np-toggle-text">
                        <strong>@T["notif.channel_push"]</strong>
                        <span>پوش مرورگر (در صورت پشتیبانی)</span>
                    </span>
                    <input class="np-switch" type="checkbox" asp-for="PushEnabled" />
                </label>
                <label class="np-toggle">
                    <span class="np-toggle-text">
                        <strong>@T["notif.channel_sms"]</strong>
                        <span>پیامک — نیاز به شماره معتبر</span>
                    </span>
                    <input class="np-switch" type="checkbox" asp-for="SmsEnabled" />
                </label>
            </div>

            <div class="np-field">
                <label class="np-label" asp-for="PhoneE164">@T["notif.phone"]</label>
                <input class="form-control ltr-field" asp-for="PhoneE164" placeholder="+98912…" />
                <p class="np-hint">@T["notif.phone_help"]</p>
            </div>
        </section>

        <section class="np-card">
            <div class="np-card-head">
                <h2 class="np-card-title">@T["notif.events"]</h2>
                <p class="np-card-desc">برای کدام رویدادها اعلان بفرستیم</p>
            </div>
            <div class="np-toggles">
                <label class="np-toggle">
                    <span class="np-toggle-text">
                        <strong>@T["notif.event_comment"]</strong>
                        <span>کامنت جدید روی نوشته‌های شما</span>
                    </span>
                    <input class="np-switch" type="checkbox" asp-for="NotifyNewComment" />
                </label>
                <label class="np-toggle">
                    <span class="np-toggle-text">
                        <strong>@T["notif.event_follower"]</strong>
                        <span>دنبال‌کننده جدید</span>
                    </span>
                    <input class="np-switch" type="checkbox" asp-for="NotifyNewFollower" />
                </label>
                <label class="np-toggle">
                    <span class="np-toggle-text">
                        <strong>@T["notif.event_digest"]</strong>
                        <span>خلاصه هفتگی فعالیت</span>
                    </span>
                    <input class="np-switch" type="checkbox" asp-for="WeeklyDigest" />
                </label>
                <label class="np-toggle">
                    <span class="np-toggle-text">
                        <strong>پست از دنبال‌شده‌ها</strong>
                        <span>وقتی کسی که دنبال می‌کنید پست جدید بگذارد</span>
                    </span>
                    <input class="np-switch" type="checkbox" asp-for="NotifyNewPostFromFollowed" />
                </label>
            </div>
        </section>

        <div class="np-foot">
            <button type="submit" class="btn btn-accent">@T["btn.save"]</button>
            <a class="btn btn-ghost" asp-action="Index">@T["btn.back"]</a>
        </div>
    </form>
</div>

<style>
.np-page { max-width: 560px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
.np-hero {
  display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
  gap: .75rem; margin-bottom: 1.25rem;
}
.np-eyebrow {
  margin: 0 0 .2rem; font-size: .68rem; font-weight: 700; letter-spacing: .08em;
  text-transform: uppercase; color: var(--accent); opacity: .9;
}
.np-title { margin: 0 0 .3rem; font-size: 1.35rem; font-weight: 750; letter-spacing: -0.02em; }
.np-sub { margin: 0; font-size: .86rem; color: var(--text-muted); line-height: 1.5; }
.np-back {
  font-size: .84rem; font-weight: 600; color: var(--text-muted);
  text-decoration: none !important; padding: .4rem .7rem;
  border-radius: 10px; border: 1px solid var(--border-soft); background: var(--surface);
}
.np-back:hover { color: var(--text); }

.np-alert {
  padding: .75rem 1rem; border-radius: 12px; font-size: .88rem; margin-bottom: 1rem;
  background: color-mix(in srgb, #9ecb8c 12%, transparent);
  border: 1px solid color-mix(in srgb, #9ecb8c 32%, var(--border-soft));
  color: var(--success, #9ecb8c);
}

.np-card {
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: 16px; padding: 1.15rem 1.25rem; margin-bottom: 1rem;
}
.np-card-head { margin-bottom: 1rem; }
.np-card-title { margin: 0 0 .2rem; font-size: 1rem; font-weight: 700; }
.np-card-desc { margin: 0; font-size: .8rem; color: var(--text-muted); }

.np-toggles { display: flex; flex-direction: column; gap: .35rem; }
.np-toggle {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  padding: .75rem .85rem; border-radius: 12px;
  background: var(--surface-2); border: 1px solid transparent;
  cursor: pointer; margin: 0;
  transition: border-color .12s, background .12s;
}
.np-toggle:hover {
  border-color: color-mix(in srgb, var(--accent) 25%, var(--border));
}
.np-toggle-text {
  display: flex; flex-direction: column; gap: .15rem; min-width: 0;
}
.np-toggle-text strong { font-size: .9rem; font-weight: 650; }
.np-toggle-text span { font-size: .78rem; color: var(--text-faint); }

.np-switch {
  width: 2.6rem; height: 1.45rem; flex-shrink: 0;
  appearance: none; -webkit-appearance: none;
  background: var(--border); border-radius: 999px; position: relative;
  cursor: pointer; transition: background .15s;
  margin: 0;
}
.np-switch::after {
  content: ""; position: absolute; top: 2px; inset-inline-start: 2px;
  width: 1.15rem; height: 1.15rem; border-radius: 50%;
  background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2);
  transition: transform .15s;
}
.np-switch:checked { background: var(--accent); }
.np-switch:checked::after {
  transform: translateX(1.15rem);
}
html[dir="rtl"] .np-switch:checked::after {
  transform: translateX(-1.15rem);
}

.np-field { margin-top: 1rem; padding-top: .9rem; border-top: 1px solid var(--border-soft); }
.np-label {
  display: block; font-size: .72rem; font-weight: 600;
  color: var(--text-muted); margin-bottom: .3rem;
}
.np-hint { font-size: .75rem; color: var(--text-faint); margin: .35rem 0 0; }

.np-foot {
  display: flex; flex-wrap: wrap; gap: .5rem;
  padding-top: .25rem;
}
</style>
