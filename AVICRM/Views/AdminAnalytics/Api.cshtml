@model AVICRM.Models.ViewModels.ApiAnalyticsPanel
@using System.Text.Json
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "مانیتورینگ API";
    var range = (int)(ViewBag.Range ?? 30);
    var filterUserId = ViewBag.FilterUserId as string;
    var json = new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var healthOk = Model.ErrorCount == 0 && Model.BannedKeys == 0 && Model.RateLimitedCount == 0;
}

<style>
.aa { max-width: 1100px; }
.aa-top {
  display: flex; flex-wrap: wrap; gap: .85rem 1.25rem;
  justify-content: space-between; align-items: flex-start;
  margin-bottom: 1.15rem;
}
.aa-top h1 { font-size: 1.2rem; font-weight: 750; margin: 0 0 .3rem; }
.aa-top .sub { margin: 0; font-size: .84rem; color: var(--text-muted); line-height: 1.55; max-width: 28rem; }
.aa-tools { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
.aa-pill {
  display: inline-flex; align-items: center; gap: .3rem;
  font-size: .78rem; padding: .35rem .75rem; border-radius: 999px;
  border: 1px solid var(--border-soft); background: var(--surface);
  color: var(--text); text-decoration: none; font-weight: 550;
}
.aa-pill:hover { border-color: var(--accent); color: var(--accent); }
.aa-pill.on {
  border-color: color-mix(in srgb, var(--accent) 50%, var(--border-soft));
  background: color-mix(in srgb, var(--accent) 14%, transparent);
  color: var(--accent); font-weight: 700;
}
.aa-pill.solid {
  background: var(--accent); color: #1a1a1a; border-color: transparent; font-weight: 700;
}
.aa-health {
  display: flex; flex-wrap: wrap; gap: .5rem; align-items: center;
  padding: .7rem 1rem; border-radius: 12px; margin-bottom: 1rem;
  border: 1px solid var(--border-soft);
  font-size: .84rem;
}
.aa-health.good {
  background: color-mix(in srgb, #9ecb8c 10%, transparent);
  border-color: color-mix(in srgb, #9ecb8c 30%, var(--border-soft));
}
.aa-health.warn {
  background: color-mix(in srgb, #e3b341 10%, transparent);
  border-color: color-mix(in srgb, #e3b341 35%, var(--border-soft));
}
.aa-health .dot {
  width: .55rem; height: .55rem; border-radius: 50%; flex-shrink: 0;
}
.aa-health.good .dot { background: #9ecb8c; }
.aa-health.warn .dot { background: #e3b341; }

.aa-kpis {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: .55rem;
  margin-bottom: 1rem;
}
@@media (max-width: 720px) { .aa-kpis { grid-template-columns: 1fr 1fr; } }
.aa-kpi {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: 14px;
  padding: 1rem 1.05rem;
  min-height: 92px;
}
.aa-kpi .label {
  font-size: .75rem; color: var(--text-muted); margin-bottom: .35rem;
  display: flex; justify-content: space-between; align-items: center;
}
.aa-kpi .num {
  font-size: 1.55rem; font-weight: 750; font-variant-numeric: tabular-nums;
  line-height: 1.15; direction: ltr; text-align: start;
}
.aa-kpi .hint { font-size: .72rem; color: var(--text-muted); margin-top: .35rem; }
.aa-kpi.alert .num { color: #e5637a; }
.aa-kpi.ok .num { color: var(--accent); }

.aa-block {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: 14px;
  padding: 1.05rem 1.15rem;
  margin-bottom: .75rem;
}
.aa-block h2 {
  font-size: .92rem; font-weight: 700; margin: 0 0 .85rem;
  display: flex; align-items: center; justify-content: space-between; gap: .5rem;
}
.aa-block h2 .meta { font-size: .75rem; font-weight: 500; color: var(--text-muted); }
.aa-chart { height: 180px; position: relative; }

.aa-users {
  display: flex; flex-direction: column; gap: .55rem;
}
.aa-user {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) repeat(4, minmax(0, .7fr)) auto;
  gap: .5rem .75rem;
  align-items: center;
  padding: .85rem 1rem;
  border-radius: 12px;
  border: 1px solid var(--border-soft);
  background: color-mix(in srgb, var(--bg, #000) 2%, var(--surface));
}
@@media (max-width: 900px) {
  .aa-user {
    grid-template-columns: 1fr 1fr;
  }
  .aa-user .act { grid-column: 1 / -1; justify-content: flex-start; }
}
.aa-user .who {
  display: flex; flex-direction: column; gap: .2rem; min-width: 0;
}
.aa-user .name {
  font-weight: 700; font-size: .9rem;
  direction: ltr; text-align: start;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.aa-user .keys-line {
  font-size: .75rem; color: var(--text-muted);
}
.aa-user .stat .k { font-size: .68rem; color: var(--text-muted); display: block; }
.aa-user .stat .n {
  font-size: .95rem; font-weight: 700; direction: ltr; font-variant-numeric: tabular-nums;
}
.aa-user .stat .n.bad { color: #e5637a; }
.aa-user .act { display: flex; gap: .35rem; justify-content: flex-end; }
.aa-badge {
  display: inline-flex; font-size: .68rem; font-weight: 700;
  padding: .12rem .45rem; border-radius: 999px;
}
.aa-badge.ban {
  background: color-mix(in srgb, #e5637a 22%, transparent); color: #e5637a;
}
.aa-badge.active {
  background: color-mix(in srgb, #9ecb8c 20%, transparent); color: #6aab5a;
}
[data-theme="dark"] .aa-badge.active, html.dark .aa-badge.active { color: #b6e0a8; }

.aa-split {
  display: grid;
  grid-template-columns: 1.35fr .9fr;
  gap: .75rem;
  margin-bottom: .75rem;
}
@@media (max-width: 900px) { .aa-split { grid-template-columns: 1fr; } }

.aa-ep {
  display: flex; align-items: center; gap: .65rem;
  padding: .65rem .75rem;
  border-bottom: 1px solid var(--border-soft);
}
.aa-ep:last-child { border-bottom: 0; }
.aa-ep .m {
  font-size: .65rem; font-weight: 700; padding: .2rem .4rem; border-radius: 5px;
  font-family: ui-monospace, monospace; direction: ltr; flex-shrink: 0;
  background: color-mix(in srgb, #6fb3d2 22%, transparent); color: #5aa0c0;
}
[data-theme="dark"] .aa-ep .m, html.dark .aa-ep .m { color: #8ec8e0; }
.aa-ep .path {
  flex: 1; min-width: 0;
  font-family: ui-monospace, monospace; font-size: .78rem; direction: ltr;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.aa-ep .nums {
  display: flex; gap: .65rem; font-size: .78rem; direction: ltr;
  font-variant-numeric: tabular-nums; color: var(--text-muted); flex-shrink: 0;
}
.aa-ep .nums strong { color: var(--text); font-weight: 700; }

.aa-codes {
  display: flex; flex-wrap: wrap; gap: .5rem;
}
.aa-code {
  flex: 1 1 5.5rem;
  min-width: 5rem;
  text-align: center;
  padding: .85rem .5rem;
  border-radius: 12px;
  border: 1px solid var(--border-soft);
}
.aa-code .c {
  font-size: 1.2rem; font-weight: 750; direction: ltr;
  font-family: ui-monospace, monospace;
}
.aa-code .n { font-size: .75rem; color: var(--text-muted); margin-top: .2rem; direction: ltr; }
.aa-code.s2 { background: color-mix(in srgb, #9ecb8c 12%, transparent); }
.aa-code.s4 { background: color-mix(in srgb, #e3b341 12%, transparent); }
.aa-code.s5 { background: color-mix(in srgb, #e5637a 12%, transparent); }

.aa-empty {
  text-align: center; padding: 2rem 1rem; color: var(--text-muted); font-size: .88rem;
}
.aa-filter-bar {
  display: flex; flex-wrap: wrap; gap: .5rem; align-items: center;
  margin-bottom: .75rem; font-size: .82rem;
}
.aa-filter-bar a { color: var(--accent); }
</style>

<div class="aa">
    <div class="aa-top">
        <div>
            <h1>مانیتورینگ API</h1>
            <p class="sub">چه کسی، چند بار، به کدام endpoint زده — و آیا کلیدش بن شده یا خطایی بوده.</p>
        </div>
        <div class="aa-tools">
            <a class="aa-pill @(range==7?"on":"")" asp-action="Api" asp-route-range="7" asp-route-userId="@filterUserId">۷ روز</a>
            <a class="aa-pill @(range==30?"on":"")" asp-action="Api" asp-route-range="30" asp-route-userId="@filterUserId">۳۰ روز</a>
            <a class="aa-pill @(range==90?"on":"")" asp-action="Api" asp-route-range="90" asp-route-userId="@filterUserId">۹۰ روز</a>
            <a class="aa-pill solid" asp-controller="AdminApiKeys" asp-action="Index">مدیریت کلیدها</a>
            <a class="aa-pill" asp-action="Index" asp-route-range="@range">آنالیتیکس کلی</a>
        </div>
    </div>

    <div class="aa-health @(healthOk ? "good" : "warn")">
        <span class="dot" aria-hidden="true"></span>
        @if (healthOk)
        {
            <span>وضعیت سالم — بدون خطا، بن یا محدودیت نرخ در این بازه.</span>
        }
        else
        {
            <span>
                نیاز به بررسی:
                @if (Model.BannedKeys > 0) { <strong>@Model.BannedKeys کلید بن</strong> }
                @if (Model.ErrorCount > 0) { <span>· <strong>@Model.ErrorCount خطا</strong></span> }
                @if (Model.RateLimitedCount > 0) { <span>· <strong>@Model.RateLimitedCount × ۴۲۹</strong></span> }
            </span>
        }
    </div>

    <div class="aa-kpis">
        <div class="aa-kpi ok">
            <div class="label"><span>کل درخواست‌ها</span></div>
            <div class="num">@Model.TotalRequests.ToString("N0")</div>
            <div class="hint">میانگین تأخیر <span class="ltr-field">@Model.AvgDurationMs ms</span></div>
        </div>
        <div class="aa-kpi">
            <div class="label"><span>کاربران با ترافیک</span></div>
            <div class="num">@Model.UniqueUsers</div>
            <div class="hint">کلید فعال: <span class="ltr-field">@Model.ActiveKeys</span></div>
        </div>
        <div class="aa-kpi @(Model.ErrorCount + Model.BannedKeys + Model.RateLimitedCount > 0 ? "alert" : "")">
            <div class="label"><span>مشکلات</span></div>
            <div class="num">@(Model.ErrorCount + Model.RateLimitedCount)</div>
            <div class="hint">خطا <span class="ltr-field">@Model.ErrorCount</span> · بن <span class="ltr-field">@Model.BannedKeys</span> · ۴۲۹ <span class="ltr-field">@Model.RateLimitedCount</span></div>
        </div>
    </div>

    <div class="aa-block">
        <h2>روند درخواست‌ها <span class="meta">@range روز اخیر</span></h2>
        <div class="aa-chart"><canvas id="apiDayChart"></canvas></div>
    </div>

    @if (!string.IsNullOrEmpty(filterUserId))
    {
        <div class="aa-filter-bar">
            <span>فیلتر روی یک کاربر فعال است.</span>
            <a asp-action="Api" asp-route-range="@range">پاک کردن فیلتر</a>
        </div>
    }

    <div class="aa-block">
        <h2>
            کاربران و کلیدها
            <span class="meta">@Model.Users.Count نفر</span>
        </h2>

        @if (Model.Users.Count == 0)
        {
            <div class="aa-empty">هنوز ترافیکی ثبت نشده یا کلیدی ساخته نشده.</div>
        }
        else
        {
            <div class="aa-users">
                @foreach (var u in Model.Users)
                {
                    <article class="aa-user">
                        <div class="who">
                            <div class="name" title="@u.UserName">@u.UserName</div>
                            <div class="keys-line">
                                <span class="aa-badge active">@u.ActiveKeys فعال</span>
                                <span class="text-muted-dark">از @u.KeyCount</span>
                                @if (u.BannedKeys > 0)
                                {
                                    <span class="aa-badge ban">@u.BannedKeys بن</span>
                                }
                            </div>
                        </div>
                        <div class="stat">
                            <span class="k">درخواست</span>
                            <span class="n">@u.RangeRequests</span>
                        </div>
                        <div class="stat">
                            <span class="k">خطا</span>
                            <span class="n @(u.RangeErrors > 0 ? "bad" : "")">@u.RangeErrors</span>
                        </div>
                        <div class="stat">
                            <span class="k">۴۲۹</span>
                            <span class="n @(u.RangeRateLimited > 0 ? "bad" : "")">@u.RangeRateLimited</span>
                        </div>
                        <div class="stat">
                            <span class="k">تأخیر</span>
                            <span class="n">@u.AvgDurationMs<span style="font-size:.7rem;font-weight:500">ms</span></span>
                        </div>
                        <div class="act">
                            <a class="aa-pill @(filterUserId == u.UserId ? "on" : "")"
                               asp-action="Api" asp-route-range="@range" asp-route-userId="@u.UserId">فقط این</a>
                            <a class="aa-pill" asp-controller="AdminApiKeys" asp-action="Index">کلیدها</a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="aa-split">
        <div class="aa-block" style="margin-bottom:0;">
            <h2>پرکاربردترین endpointها</h2>
            @if (Model.TopEndpoints.Count == 0)
            {
                <div class="aa-empty">—</div>
            }
            else
            {
                @foreach (var e in Model.TopEndpoints.Take(10))
                {
                    <div class="aa-ep">
                        <span class="m">@e.Method</span>
                        <span class="path" title="@e.Path">@e.Path</span>
                        <div class="nums">
                            <span><strong>@e.Count</strong> req</span>
                            <span>err <strong>@e.Errors</strong></span>
                            <span>@e.AvgMs ms</span>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="aa-block" style="margin-bottom:0;">
            <h2>کدهای پاسخ HTTP</h2>
            @if (Model.StatusCodes.Count == 0)
            {
                <div class="aa-empty">—</div>
            }
            else
            {
                <div class="aa-codes">
                    @foreach (var s in Model.StatusCodes)
                    {
                        var cls = s.Name.StartsWith("2") ? "s2" : s.Name.StartsWith("5") ? "s5" : s.Name.StartsWith("4") ? "s4" : "";
                        <div class="aa-code @cls">
                            <div class="c">@s.Name</div>
                            <div class="n">@s.Count.ToString("N0") بار</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
  if (typeof Chart === 'undefined') return;
  var root = getComputedStyle(document.documentElement);
  var accent = root.getPropertyValue('--accent').trim() || '#e3b341';
  var muted = root.getPropertyValue('--text-muted').trim();
  var border = root.getPropertyValue('--border-soft').trim();
  Chart.defaults.color = muted;
  Chart.defaults.borderColor = border;
  Chart.defaults.font.family = 'Vazirmatn, sans-serif';
  Chart.defaults.font.size = 11;
  new Chart(document.getElementById('apiDayChart'), {
    type: 'line',
    data: {
      labels: @Html.Raw(JsonSerializer.Serialize(Model.RequestsByDay.Select(p => p.Label), json)),
      datasets: [{
        data: @Html.Raw(JsonSerializer.Serialize(Model.RequestsByDay.Select(p => p.Value), json)),
        borderColor: accent,
        backgroundColor: 'rgba(227,179,65,.12)',
        fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { maxTicksLimit: 8 } },
        y: { beginAtZero: true, ticks: { precision: 0, maxTicksLimit: 5 } }
      }
    }
  });
})();
</script>
}
