@inject AVICRM.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["admin.nav.monetization"];
    var tab = (string)(ViewBag.ActiveTab ?? "overview");
    var plans = (List<SubscriptionPlan>)ViewBag.Plans;
    var subs = (List<UserSubscription>)ViewBag.Subscriptions;
    var donations = (List<Donation>)ViewBag.Donations;
    var ads = (List<Advertisement>)ViewBag.Ads;
    var affiliates = (List<AffiliateLink>)ViewBag.Affiliates;

    string TabClass(string id) => tab == id ? "is-active" : "";

    string StatusPill(string status) => status?.ToLowerInvariant() switch
    {
        "active" or "confirmed" => "mon-pill-ok",
        "pending" => "mon-pill-warn",
        "cancelled" or "rejected" or "expired" => "mon-pill-off",
        _ => ""
    };
}

@if (TempData["MonOk"] is string ok)
{
    <div class="mon-alert mon-alert-ok mb-3" role="status">@ok</div>
}
@if (TempData["MonErr"] is string err)
{
    <div class="mon-alert mon-alert-err mb-3" role="alert">@err</div>
}

<header class="mon-header">
    <div>
        <h1 class="mon-title">@T["admin.nav.monetization"]</h1>
        <p class="mon-sub">پلن‌ها، اعضا، حمایت مالی، تبلیغات و لینک‌های افیلیت — درآمد سایت از یک پنل.</p>
    </div>
    <div class="mon-header-links">
        <a class="mon-ext" asp-controller="Monetization" asp-action="Membership" target="_blank" rel="noopener">@T["mon.public_membership"] ↗</a>
        <a class="mon-ext" asp-controller="Monetization" asp-action="Donate" target="_blank" rel="noopener">@T["mon.public_donate"] ↗</a>
    </div>
</header>

<nav class="mon-nav" role="tablist" aria-label="بخش‌های درآمدزایی">
    <a class="mon-nav-item @TabClass("overview")" asp-action="Index" asp-route-tab="overview">@T["mon.tab_overview"]</a>
    <a class="mon-nav-item @TabClass("plans")" asp-action="Index" asp-route-tab="plans">
        @T["mon.tab_plans"]
        <span class="mon-nav-badge">@ViewBag.PlanCount</span>
    </a>
    <a class="mon-nav-item @TabClass("members")" asp-action="Index" asp-route-tab="members">
        @T["mon.tab_members"]
        <span class="mon-nav-badge">@ViewBag.ActiveMembers</span>
    </a>
    <a class="mon-nav-item @TabClass("donations")" asp-action="Index" asp-route-tab="donations">
        @T["mon.tab_donations"]
        @if ((int)ViewBag.PendingDonations > 0)
        {
            <span class="mon-nav-badge mon-nav-badge-warn">@ViewBag.PendingDonations</span>
        }
    </a>
    <a class="mon-nav-item @TabClass("ads")" asp-action="Index" asp-route-tab="ads">
        @T["mon.tab_ads"]
        <span class="mon-nav-badge">@ViewBag.AdCount</span>
    </a>
    <a class="mon-nav-item @TabClass("affiliates")" asp-action="Index" asp-route-tab="affiliates">@T["mon.tab_affiliates"]</a>
</nav>

@* ════════════ OVERVIEW ════════════ *@
@if (tab == "overview")
{
    <div class="mon-kpis">
        <div class="mon-kpi">
            <span class="mon-kpi-label">@T["mon.kpi_plans"]</span>
            <span class="mon-kpi-value">@ViewBag.PlanCount</span>
        </div>
        <div class="mon-kpi">
            <span class="mon-kpi-label">@T["mon.kpi_members"]</span>
            <span class="mon-kpi-value">@ViewBag.ActiveMembers</span>
        </div>
        <div class="mon-kpi @((int)ViewBag.PendingDonations > 0 ? "mon-kpi-warn" : "")">
            <span class="mon-kpi-label">@T["mon.kpi_pending_don"]</span>
            <span class="mon-kpi-value">@ViewBag.PendingDonations</span>
        </div>
        <div class="mon-kpi">
            <span class="mon-kpi-label">@T["mon.kpi_don_sum"]</span>
            <span class="mon-kpi-value mon-kpi-sm">@(((decimal)ViewBag.ConfirmedDonationSum).ToString("N0"))</span>
        </div>
        <div class="mon-kpi">
            <span class="mon-kpi-label">@T["mon.kpi_ads"]</span>
            <span class="mon-kpi-value">@ViewBag.AdCount</span>
        </div>
        <div class="mon-kpi">
            <span class="mon-kpi-label">@T["mon.kpi_aff_clicks"]</span>
            <span class="mon-kpi-value">@ViewBag.AffiliateClicks</span>
        </div>
    </div>

    <div class="mon-grid-2">
        <section class="mon-card">
            <h2 class="mon-card-title">@T["mon.overview_hint"]</h2>
            <ul class="mon-cap-list">
                <li>@T["mon.cap_plans"]</li>
                <li>@T["mon.cap_premium"]</li>
                <li>@T["mon.cap_donate"]</li>
                <li>@T["mon.cap_ads"]</li>
                <li>@T["mon.cap_aff"]</li>
                <li>@T["mon.cap_sponsored"]</li>
            </ul>
        </section>
        <section class="mon-card">
            <h2 class="mon-card-title">لینک‌های عمومی</h2>
            <div class="mon-endpoint-list">
                <a class="mon-endpoint" asp-controller="Monetization" asp-action="Membership" target="_blank" rel="noopener">
                    <span class="mon-endpoint-body">
                        <strong>@T["mon.public_membership"]</strong>
                        <span class="ltr-field mon-endpoint-url">/Monetization/Membership</span>
                    </span>
                    <span aria-hidden="true">↗</span>
                </a>
                <a class="mon-endpoint" asp-controller="Monetization" asp-action="Donate" target="_blank" rel="noopener">
                    <span class="mon-endpoint-body">
                        <strong>@T["mon.public_donate"]</strong>
                        <span class="ltr-field mon-endpoint-url">/Monetization/Donate</span>
                    </span>
                    <span aria-hidden="true">↗</span>
                </a>
                <div class="mon-endpoint mon-endpoint-static">
                    <span class="mon-endpoint-body">
                        <strong>Affiliate redirect</strong>
                        <span class="ltr-field mon-endpoint-url">/go/{code}</span>
                    </span>
                </div>
            </div>
            <p class="mon-hint mt-3 mb-0">@T["mon.premium_posts"]: <strong class="ltr-field">@ViewBag.PremiumPosts</strong></p>
        </section>
    </div>

    <div class="mon-quick">
        <a class="mon-quick-link" asp-action="Index" asp-route-tab="plans">پلن‌ها ←</a>
        <a class="mon-quick-link" asp-action="Index" asp-route-tab="members">اعضا ←</a>
        <a class="mon-quick-link" asp-action="Index" asp-route-tab="donations">حمایت‌ها ←</a>
        <a class="mon-quick-link" asp-action="Index" asp-route-tab="ads">تبلیغات ←</a>
        <a class="mon-quick-link" asp-action="Index" asp-route-tab="affiliates">افیلیت ←</a>
    </div>
}

@* ════════════ PLANS ════════════ *@
@if (tab == "plans")
{
    <section class="mon-card mon-form mb-3">
        <div class="mon-card-head">
            <h2 class="mon-card-title mb-0">@T["mon.add_plan"]</h2>
            <p class="mon-card-desc mb-0">نام، کد، قیمت و مدت اشتراک.</p>
        </div>
        <form asp-action="SavePlan" method="post">
            @Html.AntiForgeryToken()
            <div class="mon-form-grid mon-form-plans">
                <div class="mon-field">
                    <label class="mon-label">@T["mon.plan_name"]</label>
                    <input name="name" class="form-control form-control-sm" placeholder="@T["mon.plan_name"]" required />
                </div>
                <div class="mon-field">
                    <label class="mon-label">Code</label>
                    <input name="code" class="form-control form-control-sm ltr-field" placeholder="pro" required />
                </div>
                <div class="mon-field">
                    <label class="mon-label">@T["mon.price"]</label>
                    <input name="price" type="number" step="0.01" class="form-control form-control-sm ltr-field" placeholder="0" required />
                </div>
                <div class="mon-field mon-field-xs">
                    <label class="mon-label">Currency</label>
                    <input name="currency" class="form-control form-control-sm ltr-field" value="IRT" />
                </div>
                <div class="mon-field mon-field-sm">
                    <label class="mon-label">@T["mon.duration"]</label>
                    <input name="durationDays" type="number" class="form-control form-control-sm ltr-field" value="30" title="@T["mon.duration"]" />
                </div>
                <div class="mon-field mon-field-check">
                    <label class="mon-check">
                        <input type="checkbox" name="isActive" value="true" checked />
                        <span>@T["mon.active"]</span>
                    </label>
                </div>
                <div class="mon-field mon-field-full">
                    <label class="mon-label">@T["mon.desc"]</label>
                    <input name="description" class="form-control form-control-sm" placeholder="@T["mon.desc"]" />
                </div>
            </div>
            <div class="mon-form-footer">
                <button type="submit" class="btn btn-accent btn-sm">@T["mon.save"]</button>
            </div>
        </form>
    </section>

    @if (plans.Count == 0)
    {
        <div class="mon-empty">
            <div class="mon-empty-ico" aria-hidden="true">💎</div>
            <p class="mon-empty-title">پلنی تعریف نشده</p>
            <p class="mon-empty-hint">اولین پلن اشتراک را از فرم بالا بسازید.</p>
        </div>
    }
    else
    {
        <div class="mon-list">
            @foreach (var p in plans)
            {
                <article class="mon-list-item @(p.IsActive ? "" : "is-disabled")">
                    <div class="mon-list-text">
                        <div class="mon-list-name" dir="auto">
                            @p.Name
                            @if (!p.IsActive)
                            {
                                <span class="mon-pill mon-pill-off">off</span>
                            }
                        </div>
                        <div class="mon-list-meta">
                            <span class="mon-pill mon-pill-code ltr-field">@p.Code</span>
                            <span class="ltr-field">@p.Price.ToString("N0") @p.Currency</span>
                            <span class="mon-dot">·</span>
                            <span class="ltr-field">@(p.DurationDays == 0 ? "∞" : p.DurationDays + "d")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.Description))
                        {
                            <p class="mon-list-desc" dir="auto">@p.Description</p>
                        }
                    </div>
                    <div class="mon-list-actions">
                        <form asp-action="DeletePlan" method="post" onsubmit="return confirm('@T["msg.confirm_delete"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="mon-act mon-act-danger">@T["btn.delete"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
}

@* ════════════ MEMBERS ════════════ *@
@if (tab == "members")
{
    <section class="mon-card mon-form mb-3">
        <div class="mon-card-head">
            <h2 class="mon-card-title mb-0">@T["mon.grant"]</h2>
            <p class="mon-card-desc mb-0">اعضای فعال را دستی اختصاص دهید (پس از پرداخت خارج از سیستم).</p>
        </div>
        <form asp-action="GrantMembership" method="post">
            @Html.AntiForgeryToken()
            <div class="mon-form-grid mon-form-grant">
                <div class="mon-field">
                    <label class="mon-label">UserId</label>
                    <input name="userId" class="form-control form-control-sm ltr-field" required placeholder="user-id" />
                </div>
                <div class="mon-field">
                    <label class="mon-label">@T["mon.tab_plans"]</label>
                    <select name="planId" class="form-select form-select-sm">
                        @foreach (var p in plans.Where(x => x.IsActive))
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="mon-field">
                    <label class="mon-label">@T["mon.pay_ref"]</label>
                    <input name="paymentReference" class="form-control form-control-sm" placeholder="ref" />
                </div>
                <div class="mon-field mon-field-action">
                    <button type="submit" class="btn btn-accent btn-sm w-100">@T["mon.grant"]</button>
                </div>
            </div>
        </form>
    </section>

    @if (subs.Count == 0)
    {
        <div class="mon-empty">
            <div class="mon-empty-ico" aria-hidden="true">👤</div>
            <p class="mon-empty-title">عضوی ثبت نشده</p>
        </div>
    }
    else
    {
        <div class="mon-list">
            @foreach (var s in subs)
            {
                var st = s.Status.ToString();
                <article class="mon-list-item">
                    <div class="mon-list-text">
                        <div class="mon-list-name ltr-field">@s.UserId</div>
                        <div class="mon-list-meta">
                            <span>@s.Plan?.Name</span>
                            <span class="mon-pill @StatusPill(st)">@st</span>
                            <span class="mon-dot">·</span>
                            <span class="ltr-field">@(s.EndsAtUtc?.ToString("yyyy-MM-dd") ?? "∞")</span>
                        </div>
                    </div>
                    <div class="mon-list-actions">
                        @if (s.Status == SubscriptionStatus.Active || s.Status == SubscriptionStatus.Pending)
                        {
                            <form asp-action="CancelMembership" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="mon-act">@T["mon.cancel"]</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
}

@* ════════════ DONATIONS ════════════ *@
@if (tab == "donations")
{
    @if (donations.Count == 0)
    {
        <div class="mon-empty">
            <div class="mon-empty-ico" aria-hidden="true">💝</div>
            <p class="mon-empty-title">حمایتی ثبت نشده</p>
            <p class="mon-empty-hint">
                <a asp-controller="Monetization" asp-action="Donate" target="_blank">@T["mon.public_donate"]</a>
            </p>
        </div>
    }
    else
    {
        <div class="mon-list">
            @foreach (var d in donations)
            {
                var st = d.Status.ToString();
                var donor = d.IsAnonymous ? "—" : (d.DonorName ?? d.UserId ?? "—");
                <article class="mon-list-item @(d.Status == DonationStatus.Pending ? "mon-list-item-warn" : "")">
                    <div class="mon-list-text">
                        <div class="mon-list-name" dir="auto">@donor</div>
                        <div class="mon-list-meta">
                            <span class="ltr-field mon-amount">@d.Amount.ToString("N0") @d.Currency</span>
                            <span class="mon-pill @StatusPill(st)">@st</span>
                            @if (!string.IsNullOrWhiteSpace(d.PaymentReference))
                            {
                                <span class="mon-dot">·</span>
                                <span class="ltr-field">@d.PaymentReference</span>
                            }
                        </div>
                    </div>
                    <div class="mon-list-actions">
                        @if (d.Status == DonationStatus.Pending)
                        {
                            <form asp-action="ConfirmDonation" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.Id" />
                                <button type="submit" class="mon-act mon-act-ok">@T["mon.confirm"]</button>
                            </form>
                            <form asp-action="RejectDonation" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.Id" />
                                <button type="submit" class="mon-act mon-act-danger">@T["mon.reject"]</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
}

@* ════════════ ADS ════════════ *@
@if (tab == "ads")
{
    <section class="mon-card mon-form mb-3">
        <div class="mon-card-head">
            <h2 class="mon-card-title mb-0">@T["mon.add_ad"]</h2>
            <p class="mon-card-desc mb-0">جایگاه، لینک و HTML/متن تبلیغ.</p>
        </div>
        <form asp-action="SaveAd" method="post">
            @Html.AntiForgeryToken()
            <div class="mon-form-grid mon-form-ads">
                <div class="mon-field">
                    <label class="mon-label">@T["mon.ad_name"]</label>
                    <input name="name" class="form-control form-control-sm" placeholder="@T["mon.ad_name"]" required />
                </div>
                <div class="mon-field">
                    <label class="mon-label">@T["mon.placement"]</label>
                    <select name="placement" class="form-select form-select-sm">
                        @foreach (AdPlacement pl in Enum.GetValues(typeof(AdPlacement)))
                        {
                            <option value="@((int)pl)">@pl</option>
                        }
                    </select>
                </div>
                <div class="mon-field mon-field-wide">
                    <label class="mon-label">URL</label>
                    <input name="targetUrl" class="form-control form-control-sm ltr-field" placeholder="https://..." />
                </div>
                <div class="mon-field mon-field-check">
                    <label class="mon-check">
                        <input type="checkbox" name="isActive" value="true" checked />
                        <span>@T["mon.active"]</span>
                    </label>
                </div>
                <div class="mon-field mon-field-full">
                    <label class="mon-label">HTML / text</label>
                    <textarea name="htmlContent" class="form-control form-control-sm ltr-field" rows="2" placeholder="HTML / text"></textarea>
                </div>
            </div>
            <div class="mon-form-footer">
                <button type="submit" class="btn btn-accent btn-sm">@T["mon.save"]</button>
            </div>
        </form>
    </section>

    @if (ads.Count == 0)
    {
        <div class="mon-empty">
            <div class="mon-empty-ico" aria-hidden="true">📢</div>
            <p class="mon-empty-title">تبلیغی نیست</p>
        </div>
    }
    else
    {
        <div class="mon-list">
            @foreach (var a in ads)
            {
                <article class="mon-list-item @(a.IsActive ? "" : "is-disabled")">
                    <div class="mon-list-text">
                        <div class="mon-list-name" dir="auto">
                            @a.Name
                            @if (!a.IsActive)
                            {
                                <span class="mon-pill mon-pill-off">off</span>
                            }
                        </div>
                        <div class="mon-list-meta">
                            <span class="mon-pill">@a.Placement</span>
                            <span class="ltr-field">@a.ImpressionCount impr</span>
                            <span class="mon-dot">·</span>
                            <span class="ltr-field">@a.ClickCount clicks</span>
                        </div>
                    </div>
                    <div class="mon-list-actions">
                        <form asp-action="DeleteAd" method="post" onsubmit="return confirm('@T["msg.confirm_delete"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="mon-act mon-act-danger">@T["btn.delete"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
}

@* ════════════ AFFILIATES ════════════ *@
@if (tab == "affiliates")
{
    <section class="mon-card mon-form mb-3">
        <div class="mon-card-head">
            <h2 class="mon-card-title mb-0">@T["mon.add_aff"]</h2>
            <p class="mon-card-desc mb-0">@T["mon.aff_hint"] <code class="ltr-field">/go/code</code></p>
        </div>
        <form asp-action="SaveAffiliate" method="post">
            @Html.AntiForgeryToken()
            <div class="mon-form-grid mon-form-aff">
                <div class="mon-field mon-field-xs">
                    <label class="mon-label">Code</label>
                    <input name="code" class="form-control form-control-sm ltr-field" placeholder="book" required />
                </div>
                <div class="mon-field">
                    <label class="mon-label">@T["mon.aff_title"]</label>
                    <input name="title" class="form-control form-control-sm" placeholder="@T["mon.aff_title"]" required />
                </div>
                <div class="mon-field mon-field-wide">
                    <label class="mon-label">Destination</label>
                    <input name="destinationUrl" class="form-control form-control-sm ltr-field" placeholder="https://..." required />
                </div>
                <div class="mon-field">
                    <label class="mon-label">Network</label>
                    <input name="network" class="form-control form-control-sm" placeholder="Amazon" />
                </div>
                <div class="mon-field mon-field-check">
                    <label class="mon-check">
                        <input type="checkbox" name="isActive" value="true" checked />
                        <span>@T["mon.active"]</span>
                    </label>
                </div>
            </div>
            <div class="mon-form-footer">
                <button type="submit" class="btn btn-accent btn-sm">@T["mon.save"]</button>
            </div>
        </form>
    </section>

    @if (affiliates.Count == 0)
    {
        <div class="mon-empty">
            <div class="mon-empty-ico" aria-hidden="true">🔗</div>
            <p class="mon-empty-title">لینک افیلیتی نیست</p>
        </div>
    }
    else
    {
        <div class="mon-list">
            @foreach (var a in affiliates)
            {
                <article class="mon-list-item @(a.IsActive ? "" : "is-disabled")">
                    <div class="mon-list-text">
                        <div class="mon-list-name">
                            <a class="ltr-field mon-aff-code" href="/go/@a.Code" target="_blank" rel="noopener">@a.Code</a>
                            <span dir="auto">@a.Title</span>
                        </div>
                        <div class="mon-list-meta">
                            <span class="ltr-field">@a.ClickCount clicks</span>
                            @if (!string.IsNullOrWhiteSpace(a.Network))
                            {
                                <span class="mon-dot">·</span>
                                <span>@a.Network</span>
                            }
                            <span class="mon-dot">·</span>
                            <span class="ltr-field mon-aff-url">@a.DestinationUrl</span>
                        </div>
                    </div>
                    <div class="mon-list-actions">
                        <form asp-action="DeleteAffiliate" method="post" onsubmit="return confirm('@T["msg.confirm_delete"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="mon-act mon-act-danger">@T["btn.delete"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
}

<style>
/* ── Monetization redesign ── */
.mon-header {
  display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
  gap: 1rem; margin-bottom: 1.15rem;
}
.mon-title { font-size: 1.35rem; font-weight: 750; margin: 0 0 .3rem; letter-spacing: -0.01em; }
.mon-sub { margin: 0; font-size: .86rem; color: var(--text-muted); line-height: 1.5; max-width: 34rem; }
.mon-header-links { display: flex; flex-wrap: wrap; gap: .5rem .85rem; }
.mon-ext {
  font-size: .82rem; font-weight: 600; color: var(--accent);
  text-decoration: none !important;
}
.mon-ext:hover { text-decoration: underline !important; }

.mon-alert {
  padding: .75rem 1rem; border-radius: 12px; font-size: .88rem;
  border: 1px solid var(--border-soft);
}
