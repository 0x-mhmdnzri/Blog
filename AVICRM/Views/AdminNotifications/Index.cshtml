@model AVICRM.Controllers.ComposeNotificationVm
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["notif.admin_title"];
    var isSuper = ViewBag.IsSuperAdmin as bool? ?? false;
    var recent = ViewBag.Recent as List<NotificationCampaign> ?? new();
    var categories = ViewBag.Categories as List<Category> ?? new();
}

@if (TempData["Saved"] != null)
{
    <div class="wizard-alert success mb-3">@TempData["Saved"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="wizard-alert danger mb-3">@TempData["Error"]</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="wizard">
            <div class="wizard-steps" id="notifWizardSteps" role="tablist">
                <button type="button" class="wizard-step active" data-step="1" aria-selected="true">
                    <span class="wizard-step-num">1</span>
                    <span class="wizard-step-label">@T["wizard.content"]</span>
                </button>
                <button type="button" class="wizard-step" data-step="2" aria-selected="false">
                    <span class="wizard-step-num">2</span>
                    <span class="wizard-step-label">@T["notif.form_audience"]</span>
                </button>
                <button type="button" class="wizard-step" data-step="3" aria-selected="false">
                    <span class="wizard-step-num">3</span>
                    <span class="wizard-step-label">@T["wizard.timing"]</span>
                </button>
            </div>

            <form method="post" asp-action="Compose" class="card-surface p-4 wizard-form" id="notifWizardForm" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="wizard-alert danger"></div>

                <div class="wizard-pane active" data-pane="1">
                    <p class="wizard-hint">@T["wizard.notif_step1_hint"]</p>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Title">@T["notif.form_title"] <span class="text-danger">*</span></label>
                        <input class="form-control" asp-for="Title" dir="auto" required maxlength="200" />
                        <span asp-validation-for="Title" class="field-error"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Body">@T["notif.form_body"]</label>
                        <textarea class="form-control" asp-for="Body" rows="4" dir="auto" maxlength="1000"></textarea>
                        <span asp-validation-for="Body" class="field-error"></span>
                        <div class="form-text"><span id="bodyCount">0</span> / 1000</div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label" asp-for="LinkUrl">@T["notif.form_link"]</label>
                        <input class="form-control ltr-field" asp-for="LinkUrl" maxlength="400" placeholder="/post/slug or https://…" />
                        <span asp-validation-for="LinkUrl" class="field-error"></span>
                    </div>
                </div>

                <div class="wizard-pane" data-pane="2" hidden>
                    @if (isSuper)
                    {
                        <p class="wizard-hint">@T["wizard.notif_step2_hint"]</p>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Audience">@T["notif.form_audience"]</label>
                            <select class="form-select" asp-for="Audience" id="audienceSelect">
                                <option value="@((int)NotificationAudience.AllAuthors)">@T["notif.aud_authors"]</option>
                                <option value="@((int)NotificationAudience.Broadcast)">@T["notif.aud_broadcast"]</option>
                                <option value="@((int)NotificationAudience.CategoryReaders)">@T["notif.aud_category"]</option>
                                <option value="@((int)NotificationAudience.AuthorFollowers)">@T["notif.aud_followers"]</option>
                                <option value="@((int)NotificationAudience.SingleUser)">@T["notif.aud_single"]</option>
                                <option value="@((int)NotificationAudience.UserList)">@T["notif.aud_list"]</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Kind">@T["notif.form_kind"]</label>
                            <select class="form-select" asp-for="Kind">
                                <option value="@((int)NotificationKind.AdminMessage)">@T["notif.kind_admin"]</option>
                                <option value="@((int)NotificationKind.Broadcast)">@T["notif.kind_broadcast"]</option>
                                <option value="@((int)NotificationKind.CategoryBatch)">@T["notif.kind_category"]</option>
                                <option value="@((int)NotificationKind.System)">@T["notif.kind_system"]</option>
                                <option value="@((int)NotificationKind.AdCampaign)">@T["notif.kind_ad"]</option>
                            </select>
                        </div>

                        <div class="mb-3 audience-field" data-for="@((int)NotificationAudience.CategoryReaders)" hidden>
                            <label class="form-label" asp-for="CategoryId">@T["notif.form_category"] <span class="text-danger">*</span></label>
                            <select class="form-select" asp-for="CategoryId" id="categorySelect">
                                <option value="">@T["msg.dash"]</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3 audience-field" data-for="@((int)NotificationAudience.SingleUser)" hidden>
                            <label class="form-label" asp-for="TargetUserId">@T["notif.form_target_user"] <span class="text-danger">*</span></label>
                            <input class="form-control ltr-field" asp-for="TargetUserId" id="targetUserId" maxlength="450" />
                        </div>
                        <div class="mb-3 audience-field" data-for="@((int)NotificationAudience.UserList)" hidden>
                            <label class="form-label" asp-for="TargetUserIdsCsv">@T["notif.form_target_csv"] <span class="text-danger">*</span></label>
                            <input class="form-control ltr-field" asp-for="TargetUserIdsCsv" id="targetCsv" maxlength="4000"
                                   placeholder="id1,id2,id3" />
                        </div>
                        <div class="mb-1 audience-field" data-for="@((int)NotificationAudience.AuthorFollowers)" hidden>
                            <label class="form-label" asp-for="AuthorUserId">@T["notif.form_author"]</label>
                            <input class="form-control ltr-field" asp-for="AuthorUserId" id="authorUserId" maxlength="450"
                                   placeholder="@T["wizard.leave_blank_self"]" />
                        </div>
                    }
                    else
                    {
                        <p class="wizard-hint">@T["notif.author_help"]</p>
                        <input type="hidden" asp-for="Audience" value="@((int)NotificationAudience.AuthorFollowers)" />
                        <input type="hidden" asp-for="Kind" value="@((int)NotificationKind.NewPost)" />
                        <div class="wizard-review p-3 small">@T["notif.aud_followers"]</div>
                    }
                </div>

                <div class="wizard-pane" data-pane="3" hidden>
                    <p class="wizard-hint">@T["wizard.notif_step3_hint"]</p>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Schedule" id="scheduleToggle" />
                        <label class="form-check-label" asp-for="Schedule">@T["notif.form_schedule"]</label>
                    </div>
                    <div class="mb-3" id="scheduleBox" hidden>
                        <label class="form-label" asp-for="ScheduledAtUtc">@T["notif.form_scheduled_at"] <span class="text-danger">*</span></label>
                        <input class="form-control ltr-field" asp-for="ScheduledAtUtc" type="datetime-local" id="scheduledAt" />
                    </div>
                    <div class="wizard-review p-3 small" id="notifReview">
                        <div class="text-muted-dark mb-2">@T["wizard.review"]</div>
                        <div><strong>@T["notif.form_title"]:</strong> <span data-review="Title">—</span></div>
                        <div class="text-truncate"><strong>@T["notif.form_body"]:</strong> <span data-review="Body">—</span></div>
                    </div>
                </div>

                <div class="wizard-actions">
                    <button type="button" class="btn btn-ghost" id="notifPrev" hidden>@T["wizard.prev"]</button>
                    <div class="ms-auto d-flex gap-2">
                        <button type="button" class="btn btn-accent" id="notifNext">@T["wizard.next"]</button>
                        <button type="submit" class="btn btn-accent" id="notifSubmit" hidden>@T["notif.form_send"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <h2 class="h6 text-muted-dark mb-3">@T["notif.recent_campaigns"]</h2>
        @if (recent.Count == 0)
        {
            <div class="admin-empty"><p>@T["notif.no_campaigns"]</p></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>@T["col.title"]</th>
                            <th>@T["notif.form_audience"]</th>
                            <th>@T["col.status"]</th>
                            <th>@T["notif.col_recipients"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in recent)
                    {
                        <tr>
                            <td dir="auto">@c.Title</td>
                            <td class="small ltr-field">@c.Audience</td>
                            <td>
                                @if (c.IsSent)
                                {
                                    <span class="status-pill approved">@T["notif.status_sent"]</span>
                                }
                                else
                                {
                                    <span class="status-pill pending">@T["status.scheduled"]</span>
                                }
                            </td>
                            <td class="ltr-field">@c.RecipientCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
  var form = document.getElementById('notifWizardForm');
  if (!form) return;
  var step = 1;
  var panes = form.querySelectorAll('.wizard-pane');
  var steps = document.querySelectorAll('#notifWizardSteps .wizard-step');
  var prev = document.getElementById('notifPrev');
  var next = document.getElementById('notifNext');
  var submit = document.getElementById('notifSubmit');
  var audience = document.getElementById('audienceSelect');
  var scheduleToggle = document.getElementById('scheduleToggle');
  var scheduleBox = document.getElementById('scheduleBox');
  var scheduledAt = document.getElementById('scheduledAt');
  var body = form.querySelector('[name="Body"]');
  var bodyCount = document.getElementById('bodyCount');

  var AUD = {
    CategoryReaders: @((int)NotificationAudience.CategoryReaders),
    SingleUser: @((int)NotificationAudience.SingleUser),
    UserList: @((int)NotificationAudience.UserList),
    AuthorFollowers: @((int)NotificationAudience.AuthorFollowers)
  };

  function show(n) {
    step = n;
    panes.forEach(function (p) {
      var on = +p.getAttribute('data-pane') === n;
      p.hidden = !on;
      p.classList.toggle('active', on);
    });
    steps.forEach(function (s) {
      var sn = +s.getAttribute('data-step');
      s.classList.toggle('active', sn === n);
      s.classList.toggle('done', sn < n);
      s.setAttribute('aria-selected', sn === n ? 'true' : 'false');
    });
    prev.hidden = n === 1;
    next.hidden = n === 3;
    submit.hidden = n !== 3;
    if (n === 3) {
      form.querySelectorAll('[data-review]').forEach(function (el) {
        var name = el.getAttribute('data-review');
        var input = form.querySelector('[name="' + name + '"]');
        var v = input ? (input.value || '').trim() : '';
        el.textContent = v || '—';
      });
    }
  }

  function syncAudienceFields() {
    if (!audience) return;
    var v = +audience.value;
    form.querySelectorAll('.audience-field').forEach(function (box) {
      var forAud = +box.getAttribute('data-for');
      var on = forAud === v;
      box.hidden = !on;
      box.querySelectorAll('input,select').forEach(function (el) {
        if (on && (forAud === AUD.CategoryReaders || forAud === AUD.SingleUser || forAud === AUD.UserList)) {
          el.setAttribute('required', 'required');
        } else {
          el.removeAttribute('required');
        }
      });
    });
  }

  function syncSchedule() {
    if (!scheduleToggle || !scheduleBox) return;
    var on = scheduleToggle.checked;
    scheduleBox.hidden = !on;
    if (scheduledAt) {
      if (on) scheduledAt.setAttribute('required', 'required');
      else {
        scheduledAt.removeAttribute('required');
        scheduledAt.value = '';
      }
    }
  }

  function fieldsInPane(n) {
    var pane = form.querySelector('.wizard-pane[data-pane="' + n + '"]');
    if (!pane) return [];
    return Array.prototype.filter.call(pane.querySelectorAll('input,textarea,select'), function (el) {
      return !el.disabled && el.offsetParent !== null && !el.closest('[hidden]');
    });
  }

  function validatePane(n) {
    var ok = true;
    fieldsInPane(n).forEach(function (el) {
      if (typeof el.reportValidity === 'function' && !el.reportValidity()) ok = false;
    });
    return ok;
  }

  if (audience) audience.addEventListener('change', syncAudienceFields);
  if (scheduleToggle) scheduleToggle.addEventListener('change', syncSchedule);
  if (next) next.addEventListener('click', function () {
    if (!validatePane(step)) return;
    if (step < 3) show(step + 1);
  });
  if (prev) prev.addEventListener('click', function () {
    if (step > 1) show(step - 1);
  });
  steps.forEach(function (s) {
    s.addEventListener('click', function () {
      var target = +s.getAttribute('data-step');
      if (target < step) show(target);
      else if (target > step) {
        for (var i = step; i < target; i++) if (!validatePane(i)) return;
        show(target);
      }
    });
  });
  form.addEventListener('submit', function (e) {
    for (var i = 1; i <= 3; i++) {
      if (!validatePane(i)) {
        e.preventDefault();
        show(i);
        return;
      }
    }
  });
  if (body && bodyCount) {
    var upd = function () { bodyCount.textContent = String((body.value || '').length); };
    body.addEventListener('input', upd);
    upd();
  }

  syncAudienceFields();
  syncSchedule();
  show(1);
})();
</script>
}
