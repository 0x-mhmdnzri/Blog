@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["page.users"];
    var j = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

@if (TempData["Saved"] != null)
{
    <div class="card-surface p-3 mb-3 small text-muted-dark">@TempData["Saved"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="card-surface p-3 mb-3 small" style="border-color:var(--danger,#e5637a);">@TempData["Error"]</div>
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <p class="small text-muted-dark mb-0">مدیریت کاربران، نقش‌ها و دسترسی صفحات</p>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-accent btn-sm" asp-controller="AdminRoles" asp-action="Index">نقش‌ها و مجوزها</a>
        <a class="btn btn-ghost btn-sm" asp-controller="AdminRoles" asp-action="Assign">اختصاص نقش</a>
    </div>
</div>

@Html.AntiForgeryToken()

<div class="admin-table-wrap">
    <table id="usersTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>@T["col.index"]</th>
                <th>@T["col.user"]</th>
                <th>@T["col.roles"]</th>
                <th>@T["col.posts"]</th>
                <th>@T["col.registered"]</th>
                <th>@T["col.status"]</th>
                <th>@T["col.actions"]</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
BlogDT.init('#usersTable', {
    ajax: { url: '@Url.Action("Data", "AdminUsers")', type: 'GET' },
    exportUrl: '@Url.Action("ExportCsv", "AdminUsers")',
    columns: [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field col-idx' },
        { data: 1 },
        { data: 2, className: 'ltr-field small' },
        { data: 3, className: 'ltr-field col-num' },
        { data: 4, className: 'ltr-field col-date' },
        { data: 5, className: 'col-status' },
        { data: 6, orderable: false, searchable: false, className: 'col-actions' }
    ],
    order: [[4, 'desc']],
    columnDefs: [{ orderable: false, targets: [0, 6] }],
    columnFilters: [
        false,
        true,
        true,
        false,
        false,
        {
            type: 'select',
            placeholder: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["col.status"].ToString(), j)),
            options: [
                { value: 'active', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.active"]?.ToString() ?? "فعال", j)) },
                { value: 'locked', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.locked"]?.ToString() ?? "قفل", j)) }
            ]
        },
        false
    ]
});
</script>
}
