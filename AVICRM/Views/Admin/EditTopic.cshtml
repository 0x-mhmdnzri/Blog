@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var topic = (AVICRM.Models.TopicCollection)ViewBag.Topic;
    var cats = (List<AVICRM.Models.Category>)ViewBag.AllCategories;
    var tags = (List<AVICRM.Models.Tag>)ViewBag.AllTags;
}

<p class="text-muted-dark mb-3">@topic.Description</p>

<form asp-controller="Taxonomy" asp-action="AddTopicItem" method="post" class="card-surface p-3 mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="topicId" value="@topic.Id" />
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">افزودن دسته</label>
            <select class="form-select form-select-sm" name="categoryId">
                <option value="">—</option>
                @foreach (var c in cats) { <option value="@c.Id">@c.Name</option> }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label">یا برچسب</label>
            <select class="form-select form-select-sm" name="tagId">
                <option value="">—</option>
                @foreach (var t in tags) { <option value="@t.Id">@t.Name</option> }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-accent btn-sm w-100">افزودن</button>
        </div>
    </div>
</form>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr><th>نوع</th><th>نام</th><th>عملیات</th></tr>
        </thead>
        <tbody>
        @foreach (var item in topic.Items.OrderBy(i => i.SortOrder))
        {
            <tr>
                <td>@(item.CategoryId.HasValue ? "دسته" : "برچسب")</td>
                <td dir="auto">@(item.Category?.Name ?? item.Tag?.Name)</td>
                <td>
                    <form asp-controller="Taxonomy" asp-action="RemoveTopicItem" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="topicId" value="@topic.Id" />
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <button type="submit" class="icon-btn reject">حذف</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<a class="btn btn-ghost btn-sm mt-3" asp-controller="Taxonomy" asp-action="Categories">بازگشت</a>
