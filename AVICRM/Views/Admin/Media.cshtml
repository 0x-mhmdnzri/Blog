@model MediaLibraryViewModel
@inject AVICRM.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["admin.nav.media"];

    string FmtBytes(long b)
    {
        if (b < 1024) return $"{b} B";
        if (b < 1024 * 1024) return $"{b / 1024.0:0.#} KB";
        if (b < 1024L * 1024 * 1024) return $"{b / (1024.0 * 1024):0.##} MB";
        return $"{b / (1024.0 * 1024 * 1024):0.##} GB";
    }
}

@if (TempData["MediaOk"] is string ok)
{
    <div class="ml-alert ml-alert-ok mb-3" role="status">@ok</div>
}
@if (TempData["MediaErr"] is string err)
{
    <div class="ml-alert ml-alert-err mb-3" role="alert">@err</div>
}

@* ── Page header ── *@
<header class="ml-header">
    <div class="ml-header-text">
        <h1 class="ml-title">@T["admin.nav.media"]</h1>
        <p class="ml-sub">کتابخانه رسانه — آپلود، جست‌وجو، کپی لینک و مدیریت فایل‌ها</p>
    </div>
    <div class="ml-header-actions">
        <button type="button" class="btn btn-accent" id="mediaPickBtnTop">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z"/></svg>
            @T["media.pick_file"]
        </button>
    </div>
</header>

@* ── KPI strip ── *@
<div class="ml-kpis" role="group" aria-label="آمار رسانه">
    <div class="ml-kpi">
        <span class="ml-kpi-label">@T["media.kpi_total"]</span>
        <span class="ml-kpi-value">@Model.TotalCount.ToString("N0")</span>
    </div>
    <div class="ml-kpi">
        <span class="ml-kpi-label">@T["media.kpi_images"]</span>
        <span class="ml-kpi-value">@Model.ImageCount.ToString("N0")</span>
    </div>
    <div class="ml-kpi">
        <span class="ml-kpi-label">@T["media.kpi_videos"]</span>
        <span class="ml-kpi-value">@Model.VideoCount.ToString("N0")</span>
    </div>
    <div class="ml-kpi">
        <span class="ml-kpi-label">@T["media.kpi_size"]</span>
        <span class="ml-kpi-value ml-kpi-size">@FmtBytes(Model.TotalBytes)</span>
    </div>
</div>

@* ── Dropzone ── *@
<div class="ml-drop" id="mediaDropzone" tabindex="0" role="button" aria-label="@T["media.drop_title"]">
    <form asp-action="MediaUpload" method="post" enctype="multipart/form-data" id="mediaUploadForm">
        @Html.AntiForgeryToken()
        <input type="file" name="file" id="mediaFileInput" class="d-none"
               accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/ogg" required />
        <div class="ml-drop-inner">
            <div class="ml-drop-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M19.35 10.04A7.49 7.49 0 0 0 12 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
            </div>
            <div class="ml-drop-copy">
                <div class="ml-drop-title">@T["media.drop_title"]</div>
                <p class="ml-drop-hint">@T["media.upload_hint"]</p>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" id="mediaPickBtn">@T["media.pick_file"]</button>
            <div class="ml-picked" id="mediaPickedName" hidden></div>
            <button type="submit" class="btn btn-accent btn-sm" id="mediaUploadSubmit" hidden>@T["media.upload_btn"]</button>
        </div>
    </form>
</div>

@* ── Toolbar ── *@
<div class="ml-toolbar">
    <div class="ml-seg" role="tablist">
        <a class="ml-seg-item @(string.IsNullOrEmpty(Model.FilterKind) ? "is-active" : "")" asp-action="Media" role="tab">
            @T["media.all"] <span class="ml-seg-n">@Model.TotalCount</span>
        </a>
        <a class="ml-seg-item @(Model.FilterKind == "Image" ? "is-active" : "")" asp-action="Media" asp-route-kind="Image" role="tab">
            @T["media.images"] <span class="ml-seg-n">@Model.ImageCount</span>
        </a>
        <a class="ml-seg-item @(Model.FilterKind == "Video" ? "is-active" : "")" asp-action="Media" asp-route-kind="Video" role="tab">
            @T["media.videos"] <span class="ml-seg-n">@Model.VideoCount</span>
        </a>
    </div>

    <div class="ml-toolbar-end">
        <form method="get" asp-action="Media" class="ml-search" role="search">
            @if (!string.IsNullOrEmpty(Model.FilterKind))
            {
                <input type="hidden" name="kind" value="@Model.FilterKind" />
            }
            <svg class="ml-search-ico" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <input type="search" name="q" value="@Model.Search" class="ml-search-input"
                   placeholder="@T["media.search"]" autocomplete="off" id="mediaSearchInput" />
        </form>

        <div class="ml-view-toggle" role="group" aria-label="نمای شبکه / لیست">
            <button type="button" class="ml-view-btn is-active" data-view="grid" title="شبکه" aria-pressed="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z"/></svg>
            </button>
            <button type="button" class="ml-view-btn" data-view="list" title="لیست" aria-pressed="false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/></svg>
            </button>
        </div>
    </div>
</div>

@* ── Selection bar (sticky when active) ── *@
<div class="ml-sel" id="mediaSelectionBar" data-active="0">
    <label class="ml-sel-all">
        <input type="checkbox" id="mediaSelectAll" />
        <span>@T["media.select_all"]</span>
    </label>
    <span class="ml-sel-count" id="mediaSelCount">@T["media.selected_zero"]</span>
    <div class="ml-sel-actions">
        <button type="button" class="btn btn-ghost btn-sm" id="mediaClearSel" disabled>@T["media.clear_sel"]</button>
        <button type="submit" form="mediaBulkForm" class="btn btn-sm ml-btn-danger" id="bulkDeleteBtn" disabled>@T["media.bulk_delete"]</button>
    </div>
</div>

<form asp-action="MediaBulkDelete" method="post" id="mediaBulkForm"
      onsubmit="return confirm('@T["media.confirm_bulk"]');">
    @Html.AntiForgeryToken()

    @if (Model.Items.Count == 0)
    {
        <div class="ml-empty">
            <div class="ml-empty-icon" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" opacity="0.35"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
            </div>
            <p class="ml-empty-title">@T["media.empty"]</p>
            <p class="ml-empty-hint">@T["media.empty_hint"]</p>
            <button type="button" class="btn btn-accent btn-sm" id="mediaEmptyPick">@T["media.pick_file"]</button>
        </div>
    }
    else
    {
        <div class="ml-grid" id="mediaGrid" data-view="grid">
            @foreach (var m in Model.Items)
            {
                var md = m.Kind == AVICRM.Models.MediaKind.Image
                    ? $"![img]({m.Url})"
                    : m.Kind == AVICRM.Models.MediaKind.Video
                        ? $"{{{{video:{m.Id}}}}}"
                        : $"[{m.FileName}]({m.Url})";
                var kindLabel = m.Kind == AVICRM.Models.MediaKind.Image ? "IMG"
                    : m.Kind == AVICRM.Models.MediaKind.Video ? "VID" : "FILE";
                <article class="ml-card" data-id="@m.Id" data-name="@m.FileName.ToLowerInvariant()" data-kind="@m.Kind">
                    <label class="ml-check">
                        <input type="checkbox" name="ids" value="@m.Id" class="media-cb" aria-label="@m.FileName" />
                    </label>

                    <button type="button" class="ml-thumb" data-lightbox="@m.Url" data-kind="@m.Kind" data-title="@m.FileName" title="@T["media.preview"]">
                        @if (m.Kind == AVICRM.Models.MediaKind.Image)
                        {
                            <img src="@m.Url" alt="" loading="lazy" decoding="async" />
                        }
                        else if (m.Kind == AVICRM.Models.MediaKind.Video)
                        {
                            <video src="@m.Url" muted preload="metadata" playsinline></video>
                            <span class="ml-kind-badge">@kindLabel</span>
                        }
                        else
                        {
                            <div class="ml-file-ph">@kindLabel</div>
                        }
                        <span class="ml-thumb-veil" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M15 3l2.3 2.3-2.89 2.87 1.42 1.42L18.7 6.7 21 9V3h-6zM3 9l2.3-2.3 2.87 2.89 1.42-1.42L6.7 5.3 9 3H3v6zm6 12l-2.3-2.3 2.89-2.87-1.42-1.42L5.3 17.3 3 15v6h6zm12-6l-2.3 2.3-2.87-2.89-1.42 1.42 2.89 2.87L15 21h6v-6z"/></svg>
                        </span>
                    </button>

                    <div class="ml-card-body">
                        <div class="ml-card-name" title="@m.FileName">@m.FileName</div>
                        <div class="ml-card-meta">
                            <span class="ltr-field">@m.SizeLabel</span>
                            <span class="ml-dot" aria-hidden="true">·</span>
                            <span class="ltr-field">#@m.Id</span>
                        </div>
                        <div class="ml-card-actions">
                            <button type="button" class="ml-act" data-copy="@m.Url" title="@T["media.copy_url"]">URL</button>
                            <button type="button" class="ml-act" data-md="@md" title="@T["media.copy_md"]">MD</button>
                            <button type="button" class="ml-act" data-usage="@m.Id" title="@T["media.usage"]">@T["media.usage"]</button>
                            <button type="submit" class="ml-act ml-act-danger" form="del-@m.Id" title="@T["btn.delete"]">@T["btn.delete"]</button>
                        </div>
                    </div>
                </article>
            }
        </div>
        <p class="ml-visible-hint" id="mediaVisibleHint" hidden></p>
    }
</form>

@foreach (var m in Model.Items)
{
    <form asp-action="MediaDelete" method="post" class="d-none" id="del-@m.Id"
          onsubmit="return confirm('@T["msg.confirm_delete"]');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@m.Id" />
    </form>
}

@* ── Usage modal ── *@
<div class="modal fade" id="usageModal" tabindex="-1" aria-labelledby="usageModalTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ml-modal">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="usageModalTitle">@T["media.usage_title"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="usageBody">
                <p class="text-muted-dark small mb-0">…</p>
            </div>
        </div>
    </div>
</div>

@* ── Lightbox ── *@
<div class="ml-lightbox" id="mediaLightbox" hidden>
    <button type="button" class="ml-lb-close" id="mediaLbClose" aria-label="Close">×</button>
    <div class="ml-lb-body" id="mediaLbBody"></div>
    <div class="ml-lb-caption" id="mediaLbCaption"></div>
</div>

<div class="ml-toast" id="mediaToast" hidden role="status"></div>

<style>
/* ── Media library redesign ── */
.ml-header {
  display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
  gap: 1rem; margin-bottom: 1.25rem;
}
.ml-title { font-size: 1.35rem; font-weight: 750; margin: 0 0 .25rem; letter-spacing: -0.01em; }
.ml-sub { margin: 0; font-size: .86rem; color: var(--text-muted); line-height: 1.5; max-width: 28rem; }
.ml-header-actions { display: flex; gap: .5rem; flex-shrink: 0; }
.ml-header-actions .btn { display: inline-flex; align-items: center; gap: .4rem; }

.ml-alert {
  padding: .75rem 1rem; border-radius: 12px; font-size: .88rem;
  border: 1px solid var(--border-soft);
}
.ml-alert-ok {
  background: color-mix(in srgb, #9ecb8c 12%, transparent);
  border-color: color-mix(in srgb, #9ecb8c 30%, var(--border-soft));
  color: var(--success, #9ecb8c);
}
.ml-alert-err {
  background: color-mix(in srgb, #e5637a 12%, transparent);
  border-color: color-mix(in srgb, #e5637a 35%, var(--border-soft));
  color: var(--danger);
}

/* KPIs */
.ml-kpis {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: .65rem;
  margin-bottom: 1rem;
}
@@media (max-width: 720px) { .ml-kpis { grid-template-columns: 1fr 1fr; } }
.ml-kpi {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: 14px;
  padding: .9rem 1rem;
  display: flex; flex-direction: column; gap: .35rem;
  min-height: 4.5rem;
}
.ml-kpi-label { font-size: .72rem; color: var(--text-muted); font-weight: 550; }
.ml-kpi-value {
  font-size: 1.45rem; font-weight: 750; line-height: 1.15;
  font-variant-numeric: tabular-nums; direction: ltr; text-align: start;
}
.ml-kpi-size { font-size: 1.15rem; }

/* Dropzone */
.ml-drop {
  border: 1.5px dashed var(--border);
  border-radius: 16px;
  background: color-mix(in srgb, var(--surface) 90%, var(--bg));
  margin-bottom: 1rem;
  transition: border-color .2s, background .2s, box-shadow .2s;
  cursor: pointer;
  outline: none;
}
.ml-drop:hover, .ml-drop:focus-visible {
  border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  background: color-mix(in srgb, var(--accent) 5%, var(--surface));
}
.ml-drop.is-dragover {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 10%, var(--surface));
  box-shadow: 0 0 0 3px var(--accent-soft, rgba(227,179,65,.15));
}
.ml-drop-inner {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
  gap: .85rem 1.25rem; padding: 1.35rem 1.25rem; text-align: start;
}
.ml-drop-icon {
  width: 3rem; height: 3rem; border-radius: 12px;
  background: var(--surface-2); color: var(--text-muted);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ml-drop.is-dragover .ml-drop-icon { color: var(--accent); background: var(--accent-soft); }
.ml-drop-copy { flex: 1 1 12rem; min-width: 0; }
.ml-drop-title { font-weight: 650; font-size: .95rem; margin-bottom: .15rem; }
.ml-drop-hint { margin: 0; font-size: .78rem; color: var(--text-faint); line-height: 1.45; }
.ml-picked {
  font-size: .8rem; color: var(--accent); font-family: var(--font-mono);
  direction: ltr; width: 100%; text-align: center;
}

/* Toolbar */
.ml-toolbar {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  gap: .75rem 1rem; margin-bottom: .75rem;
}
.ml-seg {
  display: inline-flex; flex-wrap: wrap; gap: .25rem;
  padding: .2rem; background: var(--surface-2); border-radius: 12px;
  border: 1px solid var(--border-soft);
}
.ml-seg-item {
  display: inline-flex; align-items: center; gap: .35rem;
  padding: .4rem .85rem; border-radius: 9px;
  font-size: .82rem; font-weight: 550; color: var(--text-muted);
  text-decoration: none !important; transition: background .12s, color .12s;
}
.ml-seg-item:hover { color: var(--text); }
.ml-seg-item.is-active {
  background: var(--surface); color: var(--accent); font-weight: 650;
  box-shadow: 0 1px 3px rgba(0,0,0,.12);
}
.ml-seg-n {
  font-size: .7rem; opacity: .7; font-variant-numeric: tabular-nums; direction: ltr;
}

.ml-toolbar-end {
  display: flex; flex-wrap: wrap; align-items: center; gap: .5rem;
}
.ml-search {
  display: flex; align-items: center; gap: .4rem;
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: 10px; padding: 0 .65rem; min-height: 2.25rem;
  transition: border-color .15s;
}
.ml-search:focus-within {
  border-color: var(--accent-dim, var(--accent));
  box-shadow: 0 0 0 3px var(--accent-soft, rgba(227,179,65,.15));
}
.ml-search-ico { color: var(--text-faint); flex-shrink: 0; }
.ml-search-input {
  border: 0; background: transparent; color: var(--text);
  font-size: .86rem; outline: none; min-width: 10rem; max-width: 16rem; padding: .35rem 0;
}
.ml-search-input::placeholder { color: var(--text-faint); }

.ml-view-toggle {
  display: inline-flex; gap: .15rem; padding: .15rem;
  background: var(--surface-2); border-radius: 10px; border: 1px solid var(--border-soft);
}
.ml-view-btn {
  width: 2.1rem; height: 2.1rem; border: 0; border-radius: 8px;
  background: transparent; color: var(--text-muted); cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center;
}
.ml-view-btn:hover { color: var(--text); }
.ml-view-btn.is-active {
  background: var(--surface); color: var(--accent);
  box-shadow: 0 1px 2px rgba(0,0,0,.1);
}

/* Selection bar */
.ml-sel {
  display: flex; flex-wrap: wrap; align-items: center; gap: .65rem 1rem;
  padding: .65rem 1rem; margin-bottom: .85rem;
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: 12px; transition: border-color .15s, background .15s;
}
.ml-sel[data-active="1"] {
  border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  position: sticky; top: .5rem; z-index: 15;
}
.ml-sel-all {
  display: inline-flex; align-items: center; gap: .4rem;
  font-size: .85rem; cursor: pointer; user-select: none; margin: 0;
}
.ml-sel-count { font-size: .82rem; color: var(--text-muted); flex: 1; }
.ml-sel-actions { display: flex; gap: .4rem; }
.ml-btn-danger:not(:disabled) {
  border-color: color-mix(in srgb, var(--danger) 50%, var(--border));
  color: var(--danger);
  background: color-mix(in srgb, var(--danger) 8%, transparent);
}
.ml-btn-danger:not(:disabled):hover {
  background: color-mix(in srgb, var(--danger) 16%, transparent);
}

/* Empty */
.ml-empty {
  text-align: center; padding: 3.5rem 1.5rem;
  background: var(--surface); border: 1px dashed var(--border);
  border-radius: 16px;
}
.ml-empty-icon { margin-bottom: .75rem; }
.ml-empty-title { font-weight: 650; margin: 0 0 .35rem; }
.ml-empty-hint { color: var(--text-muted); font-size: .86rem; margin: 0 0 1rem; }

/* Grid / list */
.ml-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 1rem;
}
.ml-grid[data-view="list"] {
  grid-template-columns: 1fr;
  gap: .55rem;
}
.ml-grid[data-view="list"] .ml-card {
  flex-direction: row; align-items: stretch;
}
.ml-grid[data-view="list"] .ml-thumb {
  width: 5.5rem; min-width: 5.5rem; aspect-ratio: 1; border-radius: 10px 0 0 10px;
}
html[dir="rtl"] .ml-grid[data-view="list"] .ml-thumb {
  border-radius: 0 10px 10px 0;
}
.ml-grid[data-view="list"] .ml-card-body {
  flex: 1; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem;
  padding: .65rem 1rem;
}
.ml-grid[data-view="list"] .ml-card-name { flex: 1 1 8rem; margin: 0; }
.ml-grid[data-view="list"] .ml-card-meta { margin: 0; }
.ml-grid[data-view="list"] .ml-card-actions { margin: 0; margin-inline-start: auto; }

/* Card */
.ml-card {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: 14px;
  overflow: hidden;
  display: flex; flex-direction: column;
  transition: border-color .15s, box-shadow .15s, transform .15s;
}
.ml-card:hover {
  border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  box-shadow: 0 8px 24px rgba(0,0,0,.16);
}
.ml-card.is-selected {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent), 0 6px 18px rgba(0,0,0,.12);
}
.ml-card.is-hidden { display: none !important; }

.ml-check {
  position: absolute; top: .5rem; inset-inline-start: .5rem; z-index: 3;
  margin: 0; padding: .2rem;
  background: rgba(8,10,16,.55); backdrop-filter: blur(4px);
  border-radius: 7px; line-height: 0;
}
.ml-check input { margin: 0; cursor: pointer; width: 1rem; height: 1rem; accent-color: var(--accent); }

.ml-thumb {
  aspect-ratio: 1; background: var(--surface-2);
  display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden; border: 0; padding: 0; width: 100%;
  cursor: zoom-in;
}
.ml-thumb img, .ml-thumb video {
  width: 100%; height: 100%; object-fit: cover; pointer-events: none;
}
.ml-thumb-veil {
  position: absolute; inset: 0;
  background: rgba(0,0,0,.4);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transition: opacity .15s; color: #fff;
}
.ml-card:hover .ml-thumb-veil { opacity: 1; }
.ml-kind-badge {
  position: absolute; bottom: .4rem; inset-inline-end: .4rem;
  font-size: .62rem; font-weight: 700; letter-spacing: .04em;
  background: rgba(0,0,0,.6); color: #fff;
  padding: .15rem .45rem; border-radius: 999px;
}
.ml-file-ph {
  font-size: .8rem; font-weight: 700; color: var(--text-muted);
  letter-spacing: .06em;
}

.ml-card-body { padding: .65rem .75rem .8rem; }
.ml-card-name {
  font-size: .8rem; font-weight: 650;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  margin-bottom: .2rem;
}
.ml-card-meta {
  font-size: .7rem; color: var(--text-faint);
  display: flex; align-items: center; gap: .3rem; flex-wrap: wrap;
}
.ml-dot { opacity: .5; }
.ml-card-actions {
  display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .55rem;
}
.ml-act {
  border: 1px solid var(--border);
  background: transparent;
  border-radius: 7px;
  padding: .22rem .5rem;
  font-size: .7rem; font-weight: 600;
  color: var(--text-muted);
  cursor: pointer;
  transition: border-color .12s, color .12s, background .12s;
}
.ml-act:hover {
  color: var(--text); border-color: var(--text-faint);
  background: var(--surface-2);
}
.ml-act-danger:hover {
  color: var(--danger); border-color: var(--danger);
  background: color-mix(in srgb, var(--danger) 10%, transparent);
}

.ml-visible-hint {
  margin: .85rem 0 0; font-size: .78rem; color: var(--text-faint);
  text-align: center;
}
.ml-visible-hint:not([hidden]) { display: block; }

/* Modal */
.ml-modal {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  color: var(--text);
  border-radius: 16px;
}

/* Lightbox */
.ml-lightbox {
  position: fixed; inset: 0; z-index: 10050;
  background: rgba(4, 6, 12, .88);
  backdrop-filter: blur(10px);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 2rem 1rem;
}
.ml-lightbox[hidden] { display: none !important; }
.ml-lb-close {
  position: absolute; top: 1rem; inset-inline-end: 1rem;
  border: 0; background: rgba(255,255,255,.12); color: #fff;
  width: 2.4rem; height: 2.4rem; border-radius: 50%;
  font-size: 1.4rem; line-height: 1; cursor: pointer;
  transition: background .12s;
}
.ml-lb-close:hover { background: rgba(255,255,255,.22); }
.ml-lb-body { max-width: min(92vw, 960px); max-height: 78vh; }
.ml-lb-body img, .ml-lb-body video {
  max-width: 100%; max-height: 78vh; border-radius: 12px;
  box-shadow: 0 16px 48px rgba(0,0,0,.45);
}
.ml-lb-caption {
  margin-top: .85rem; color: rgba(255,255,255,.7);
  font-size: .85rem; direction: ltr; text-align: center;
  font-family: var(--font-mono); max-width: 90vw;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.ml-toast {
  position: fixed; bottom: 1.35rem; inset-inline-start: 50%;
  transform: translateX(-50%);
  z-index: 10060;
  background: var(--surface); border: 1px solid var(--border); color: var(--text);
  padding: .55rem 1.15rem; border-radius: 999px; font-size: .85rem;
  box-shadow: 0 10px 28px rgba(0,0,0,.28); pointer-events: none;
}
html[dir="rtl"] .ml-toast { transform: translateX(50%); }

@@media (max-width: 576px) {
  .ml-grid { grid-template-columns: repeat(2, 1fr); gap: .65rem; }
  .ml-search { width: 100%; }
  .ml-search-input { min-width: 0; max-width: none; flex: 1; }
  .ml-toolbar-end { width: 100%; }
  .ml-drop-inner { flex-direction: column; text-align: center; }
  .ml-drop-copy { text-align: center; }
}
</style>

@section Scripts {
<script>
(function () {
  var T = {
    selected: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["media.selected_n"].ToString())),
    selectedZero: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["media.selected_zero"].ToString())),
    copied: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["media.copied"].ToString()))
  };

  function toast(msg) {
    var el = document.getElementById('mediaToast');
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
    clearTimeout(el._t);
    el._t = setTimeout(function () { el.hidden = true; }, 1600);
  }

  function copyText(t) {
    if (navigator.clipboard && navigator.clipboard.writeText)
      return navigator.clipboard.writeText(t);
    var i = document.createElement('input');
    i.value = t; document.body.appendChild(i); i.select();
    try { document.execCommand('copy'); } catch (e) {}
    i.remove();
    return Promise.resolve();
  }

  /* Upload / dropzone */
  var zone = document.getElementById('mediaDropzone');
  var input = document.getElementById('mediaFileInput');
  var pickBtn = document.getElementById('mediaPickBtn');
  var pickTop = document.getElementById('mediaPickBtnTop');
  var emptyPick = document.getElementById('mediaEmptyPick');
  var nameEl = document.getElementById('mediaPickedName');
  var submitBtn = document.getElementById('mediaUploadSubmit');
  var form = document.getElementById('mediaUploadForm');

  function openPicker() { if (input) input.click(); }
  [pickBtn, pickTop, emptyPick].forEach(function (btn) {
    if (btn) btn.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); openPicker(); });
  });
  if (zone) {
    zone.addEventListener('click', function (e) {
      if (e.target.closest('button') || e.target.closest('input')) return;
      openPicker();
    });
    zone.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPicker(); }
    });
    ['dragenter', 'dragover'].forEach(function (ev) {
      zone.addEventListener(ev, function (e) {
        e.preventDefault(); e.stopPropagation();
        zone.classList.add('is-dragover');
      });
    });
    ['dragleave', 'drop'].forEach(function (ev) {
      zone.addEventListener(ev, function (e) {
        e.preventDefault(); e.stopPropagation();
        zone.classList.remove('is-dragover');
      });
    });
    zone.addEventListener('drop', function (e) {
      var files = e.dataTransfer && e.dataTransfer.files;
      if (!files || !files.length || !input) return;
      input.files = files;
      onFilePicked();
      if (form) form.submit();
    });
  }
  function onFilePicked() {
    if (!input || !input.files || !input.files[0]) return;
    if (nameEl) { nameEl.hidden = false; nameEl.textContent = input.files[0].name; }
    if (submitBtn) submitBtn.hidden = false;
  }
  if (input) input.addEventListener('change', function () {
    onFilePicked();
    if (input.files && input.files[0] && form) form.submit();
  });

  /* Selection */
  var bulkBtn = document.getElementById('bulkDeleteBtn');
  var clearBtn = document.getElementById('mediaClearSel');
  var selectAll = document.getElementById('mediaSelectAll');
  var countEl = document.getElementById('mediaSelCount');
  var selBar = document.getElementById('mediaSelectionBar');

  function visibleCbs() {
    return Array.prototype.slice.call(document.querySelectorAll('.ml-card:not(.is-hidden) .media-cb'));
  }
  function syncSel() {
    var all = visibleCbs();
    var n = all.filter(function (c) { return c.checked; }).length;
    if (bulkBtn) bulkBtn.disabled = n === 0;
    if (clearBtn) clearBtn.disabled = n === 0;
    if (countEl) countEl.textContent = n === 0 ? T.selectedZero : T.selected.replace('{0}', String(n));
    if (selectAll && all.length) {
      selectAll.checked = n === all.length;
      selectAll.indeterminate = n > 0 && n < all.length;
    }
    if (selBar) selBar.setAttribute('data-active', n > 0 ? '1' : '0');
    document.querySelectorAll('.ml-card').forEach(function (card) {
      var cb = card.querySelector('.media-cb');
      card.classList.toggle('is-selected', !!(cb && cb.checked));
    });
  }
  document.querySelectorAll('.media-cb').forEach(function (c) { c.addEventListener('change', syncSel); });
  if (selectAll) {
    selectAll.addEventListener('change', function () {
      visibleCbs().forEach(function (c) { c.checked = selectAll.checked; });
      syncSel();
    });
  }
  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      document.querySelectorAll('.media-cb').forEach(function (c) { c.checked = false; });
      if (selectAll) { selectAll.checked = false; selectAll.indeterminate = false; }
      syncSel();
    });
  }
  syncSel();

  /* Local search */
  var searchInput = document.getElementById('mediaSearchInput');
  var hint = document.getElementById('mediaVisibleHint');
  function filterLocal() {
    var q = (searchInput && searchInput.value || '').trim().toLowerCase();
    var cards = document.querySelectorAll('.ml-card');
    var shown = 0;
    cards.forEach(function (card) {
      var name = card.getAttribute('data-name') || '';
      var ok = !q || name.indexOf(q) !== -1;
      card.classList.toggle('is-hidden', !ok);
      if (ok) shown++;
    });
    if (hint) {
      if (q) {
        hint.hidden = false;
        hint.textContent = shown + ' / ' + cards.length;
      } else {
        hint.hidden = true;
      }
    }
    syncSel();
  }
  if (searchInput) searchInput.addEventListener('input', filterLocal);

  /* View toggle */
  var grid = document.getElementById('mediaGrid');
  document.querySelectorAll('.ml-view-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var v = btn.getAttribute('data-view');
      if (!grid) return;
      grid.setAttribute('data-view', v);
      document.querySelectorAll('.ml-view-btn').forEach(function (b) {
        var on = b.getAttribute('data-view') === v;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      try { localStorage.setItem('blog-media-view', v); } catch (e) {}
    });
  });
  try {
    var saved = localStorage.getItem('blog-media-view');
    if (saved && grid) {
      var b = document.querySelector('.ml-view-btn[data-view="' + saved + '"]');
      if (b) b.click();
    }
  } catch (e) {}

  /* Copy */
  document.querySelectorAll('[data-copy]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      copyText(btn.getAttribute('data-copy') || '').then(function () {
        toast(T.copied);
        var old = btn.textContent;
        btn.textContent = '✓';
        setTimeout(function () { btn.textContent = old; }, 900);
      });
    });
  });
  document.querySelectorAll('[data-md]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      copyText(btn.getAttribute('data-md') || '').then(function () {
        toast(T.copied);
        var old = btn.textContent;
        btn.textContent = '✓';
        setTimeout(function () { btn.textContent = old; }, 900);
      });
    });
  });

  /* Usage */
  var usageModal = document.getElementById('usageModal');
  var usageBody = document.getElementById('usageBody');
  document.querySelectorAll('[data-usage]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-usage');
      usageBody.innerHTML = '<p class="text-muted-dark small">…</p>';
      fetch('/Admin/MediaUsage?id=' + id)
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var list = data.usages || [];
          if (!list.length) {
            usageBody.innerHTML = '<p class="text-muted-dark small mb-0">@T["media.usage_none"]</p>';
          } else {
            var html = '<ul class="mb-0" style="padding-inline-start:1.1rem;">';
            list.forEach(function (u) {
              var title = u.title || u.Title || ('#' + (u.id || u.Id));
              var href = u.editUrl || u.EditUrl || '#';
              var cover = u.isCover || u.IsCover;
              html += '<li class="mb-1"><a href="' + href + '">' + title + '</a>'
                + (cover ? ' <span class="soon-tag">cover</span>' : '') + '</li>';
            });
            html += '</ul>';
            usageBody.innerHTML = html;
          }
          if (window.bootstrap) new bootstrap.Modal(usageModal).show();
        })
        .catch(function () { usageBody.innerHTML = '<p class="text-muted-dark small">—</p>'; });
    });
  });

  /* Lightbox */
  var lb = document.getElementById('mediaLightbox');
  var lbBody = document.getElementById('mediaLbBody');
  var lbCap = document.getElementById('mediaLbCaption');
  var lbClose = document.getElementById('mediaLbClose');
  function closeLb() {
    if (!lb) return;
    lb.hidden = true;
    if (lbBody) lbBody.innerHTML = '';
  }
  document.querySelectorAll('[data-lightbox]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-lightbox');
      var kind = btn.getAttribute('data-kind');
      var title = btn.getAttribute('data-title') || '';
      if (!lb || !lbBody) return;
      if (kind === 'Video') {
        lbBody.innerHTML = '<video src="' + url + '" controls autoplay playsinline></video>';
      } else {
        lbBody.innerHTML = '<img src="' + url + '" alt="" />';
      }
      if (lbCap) lbCap.textContent = title + ' · ' + url;
      lb.hidden = false;
    });
  });
  if (lbClose) lbClose.addEventListener('click', closeLb);
  if (lb) lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLb(); });
})();
</script>
}
