@model List<SubscriptionPlan>
@inject BlogApp.Services.IUiTranslator T
@{
    ViewData["Title"] = T["mon.membership_title"];
    var has = (bool)(ViewBag.HasMembership ?? false);
    var active = ViewBag.ActiveSub as UserSubscription;
}

<div class="container py-5" style="max-width:720px;">
    <h1 class="h3 mb-2">@T["mon.membership_title"]</h1>
    <p class="text-muted-dark mb-4">@T["mon.membership_intro"]</p>

    @if (TempData["MemOk"] is string ok)
    {
        <div class="wizard-alert success mb-3">@ok</div>
    }

    @if (has && active?.Plan != null)
    {
        <div class="wizard-alert success mb-4">
            @T["mon.you_are_member"]: <strong>@active.Plan.Name</strong>
            @if (active.EndsAtUtc is DateTime ends)
            {
                <span class="ltr-field"> · @ends.ToString("yyyy-MM-dd")</span>
            }
        </div>
    }

    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-md-6">
                <div class="card-surface p-4 h-100 d-flex flex-column">
                    <h2 class="h5">@p.Name</h2>
                    <p class="text-muted-dark small flex-grow-1">@p.Description</p>
                    <div class="mb-3">
                        <span class="h4 ltr-field">@p.Price.ToString("N0")</span>
                        <span class="text-muted-dark">@p.Currency</span>
                        <span class="small text-muted-dark"> / @(p.DurationDays == 0 ? T["mon.lifetime"] : p.DurationDays + " " + T["mon.days"])</span>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="RequestMembership" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="planId" value="@p.Id" />
                            <input name="paymentReference" class="form-control form-control-sm mb-2" placeholder="@T["mon.pay_ref"]" />
                            <button type="submit" class="btn btn-accent btn-sm w-100">@T["mon.request_plan"]</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Membership")">@T["mon.login_to_join"]</a>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.Count == 0)
    {
        <p class="text-muted-dark">@T["mon.no_plans"]</p>
    }
</div>
