@model BlogApp.Models.ViewModels.CreateAuthorViewModel
@using BlogApp.Models
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["btn.new_author"];

    var fieldStep = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
    {
        ["UserName"] = 1, ["Email"] = 1, ["DisplayName"] = 1,
        ["Bio"] = 2, ["Gender"] = 2, ["ProfileImageFile"] = 2,
        ["Twitter"] = 2, ["LinkedIn"] = 2, ["Telegram"] = 2, ["Phone"] = 2,
        ["Website"] = 2, ["GitHub"] = 2, ["Instagram"] = 2,
        ["Password"] = 3, ["ConfirmPassword"] = 3
    };
    var errorStep = 1;
    var hasServerErrors = !ViewData.ModelState.IsValid;
    if (hasServerErrors)
    {
        var stepsWithErrors = ViewData.ModelState
            .Where(kv => kv.Value?.Errors.Count > 0 && fieldStep.ContainsKey(kv.Key))
            .Select(kv => fieldStep[kv.Key])
            .DefaultIfEmpty(1);
        errorStep = stepsWithErrors.Min();
        if (ViewData.ModelState.Any(m => string.IsNullOrEmpty(m.Key) && m.Value?.Errors.Count > 0))
            errorStep = Math.Max(errorStep, 3);
    }

    string? FieldError(string key)
    {
        if (ViewData.ModelState.TryGetValue(key, out var entry) && entry?.Errors.Count > 0)
            return entry.Errors[0].ErrorMessage;
        return null;
    }
    var modelErrors = ViewData.ModelState
        .Where(m => string.IsNullOrEmpty(m.Key) && m.Value?.Errors.Count > 0)
        .SelectMany(m => m.Value!.Errors.Select(e => e.ErrorMessage))
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .ToList();
}

<div class="wizard" style="max-width:640px;">
    <div class="wizard-steps" id="authorWizardSteps" role="tablist">
        <button type="button" class="wizard-step active" data-step="1" aria-selected="true">
            <span class="wizard-step-num">1</span>
            <span class="wizard-step-label">@T["wizard.identity"]</span>
        </button>
        <button type="button" class="wizard-step" data-step="2" aria-selected="false">
            <span class="wizard-step-num">2</span>
            <span class="wizard-step-label">@T["wizard.profile"]</span>
        </button>
        <button type="button" class="wizard-step" data-step="3" aria-selected="false">
            <span class="wizard-step-num">3</span>
            <span class="wizard-step-label">@T["wizard.security"]</span>
        </button>
    </div>

    <form asp-action="CreateAuthor" method="post" enctype="multipart/form-data"
          class="card-surface p-4 wizard-form" id="authorWizardForm" novalidate
          data-error-step="@errorStep"
          data-has-errors="@(hasServerErrors ? "1" : "0")">
        @Html.AntiForgeryToken()

        @if (modelErrors.Count > 0)
        {
            <div class="wizard-alert danger" id="authorModelErrors" role="alert">
                @foreach (var msg in modelErrors)
                {
                    <div>@msg</div>
                }
            </div>
        }

        <div class="wizard-pane active" data-pane="1">
            <p class="wizard-hint">@T["wizard.author_step1_hint"]</p>
            <div class="mb-3">
                <label class="form-label" asp-for="UserName">@T["col.username"] <span class="text-danger">*</span></label>
                <input class="form-control ltr-field @(FieldError("UserName") != null ? "is-invalid" : null)"
                       asp-for="UserName" autocomplete="username"
                       required minlength="3" maxlength="50" pattern="[a-zA-Z0-9._\-]{3,50}"
                       data-msg-required="@T["wizard.val_username_required"]"
                       data-msg-pattern="@T["wizard.val_username_pattern"]"
                       data-msg-minlength="@T["wizard.val_username_pattern"]"
                       placeholder="mhmdnzr" />
                <span class="field-error" data-val-for="UserName">@FieldError("UserName")</span>
                <div class="form-text">@T["wizard.username_help"] · /author/<span class="ltr-field">username</span></div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Email">@T["col.email"] <span class="text-danger">*</span></label>
                <input class="form-control ltr-field @(FieldError("Email") != null ? "is-invalid" : null)"
                       asp-for="Email" type="email" autocomplete="email"
                       required maxlength="256"
                       data-msg-required="@T["wizard.val_email_required"]"
                       data-msg-type="@T["wizard.val_email_invalid"]"
                       placeholder="author@@example.com" />
                <span class="field-error" data-val-for="Email">@FieldError("Email")</span>
            </div>
            <div class="mb-1">
                <label class="form-label" asp-for="DisplayName">@T["col.display_name"] <span class="text-danger">*</span></label>
                <input class="form-control @(FieldError("DisplayName") != null ? "is-invalid" : null)"
                       asp-for="DisplayName" autocomplete="name"
                       required minlength="2" maxlength="100"
                       data-msg-required="@T["wizard.val_display_required"]"
                       data-msg-minlength="@T["wizard.val_display_min"]" />
                <span class="field-error" data-val-for="DisplayName">@FieldError("DisplayName")</span>
            </div>
        </div>

        <div class="wizard-pane" data-pane="2" hidden>
            <p class="wizard-hint">@T["wizard.author_step2_hint"]</p>
            <div class="d-flex align-items-start gap-3 mb-3">
                <div class="fu-avatar-target author-avatar-preview" id="authorAvatarPreview" aria-hidden="true">
                    <span id="authorInitial">?</span>
                </div>
                <div class="flex-grow-1">
                    <label class="form-label" asp-for="ProfileImageFile">@T["wizard.avatar"]</label>
                    <div class="fu-zone fu-zone-sm" data-fu data-fu-preview="#authorAvatarPreview" data-fu-kind="image" tabindex="0" role="button" aria-label="@T["fu.drop_title"]">
                        <input type="file" name="ProfileImageFile" id="authorAvatarFile" accept="image/jpeg,image/png,image/webp" />
                        <button type="button" class="fu-zone-btn">@T["fu.select"]</button>
                        <div class="fu-zone-copy">
                            <p class="fu-zone-title">@T["fu.drop_title"]</p>
                            <p class="fu-zone-hint">@T["fu.hint_image"]</p>
                        </div>
                        <span class="fu-zone-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.35 10.04A7.49 7.49 0 0 0 12 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
                        </span>
                        <div class="fu-zone-picked" hidden></div>
                    </div>
                    <span class="field-error" data-val-for="ProfileImageFile">@FieldError("ProfileImageFile")</span>
                    <div class="form-text">@T["wizard.avatar_help"]</div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Bio">@T["wizard.bio"]</label>
                <textarea class="form-control @(FieldError("Bio") != null ? "is-invalid" : null)"
                          asp-for="Bio" rows="3" maxlength="500" id="authorBio"
                          data-msg-maxlength="@T["wizard.val_bio_max"]"></textarea>
                <span class="field-error" data-val-for="Bio">@FieldError("Bio")</span>
                <div class="form-text"><span id="bioCount">0</span>/500</div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Gender">@T["wizard.gender"]</label>
                <select class="form-select" asp-for="Gender" asp-items="Html.GetEnumSelectList<UserGender>()"></select>
            </div>
            <div class="row g-2">
                <div class="col-md-6 mb-2">
                    <label class="form-label" asp-for="Website">@T["wizard.website"]</label>
                    <input class="form-control ltr-field" asp-for="Website" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label" asp-for="Phone">@T["wizard.phone"]</label>
                    <input class="form-control ltr-field" asp-for="Phone" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label" asp-for="Twitter">Twitter / X</label>
                    <input class="form-control ltr-field" asp-for="Twitter" placeholder="@@handle" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label" asp-for="GitHub">GitHub</label>
                    <input class="form-control ltr-field" asp-for="GitHub" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label" asp-for="Telegram">Telegram</label>
                    <input class="form-control ltr-field" asp-for="Telegram" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label" asp-for="Instagram">Instagram</label>
                    <input class="form-control ltr-field" asp-for="Instagram" />
                </div>
                <div class="col-12 mb-2">
                    <label class="form-label" asp-for="LinkedIn">LinkedIn</label>
                    <input class="form-control ltr-field" asp-for="LinkedIn" />
                </div>
            </div>
        </div>

        <div class="wizard-pane" data-pane="3" hidden>
            <p class="wizard-hint">@T["wizard.author_step3_hint"]</p>
            <div class="mb-3">
                <label class="form-label" asp-for="Password">@T["auth.password"] <span class="text-danger">*</span></label>
                <input class="form-control ltr-field @(FieldError("Password") != null ? "is-invalid" : null)"
                       asp-for="Password" type="password" autocomplete="new-password"
                       required minlength="10" maxlength="128"
                       pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{10,}"
                       data-msg-required="@T["wizard.val_password_required"]"
                       data-msg-pattern="@T["wizard.val_password_pattern"]"
                       data-msg-minlength="@T["wizard.val_password_pattern"]" />
                <span class="field-error" data-val-for="Password">@FieldError("Password")</span>
                <div class="form-text">@T["wizard.password_help"]</div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="ConfirmPassword">@T["wizard.confirm_password"] <span class="text-danger">*</span></label>
                <input class="form-control ltr-field @(FieldError("ConfirmPassword") != null ? "is-invalid" : null)"
                       asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                       required minlength="10" maxlength="128"
                       data-msg-required="@T["wizard.val_confirm_required"]"
                       data-msg-match="@T["wizard.val_confirm_match"]" />
                <span class="field-error" data-val-for="ConfirmPassword">@FieldError("ConfirmPassword")</span>
            </div>
            <div class="wizard-review card-surface p-3 mb-2">
                <div class="small text-muted mb-1">@T["wizard.review"]</div>
                <div><strong>@T["col.username"]:</strong> <span class="ltr-field" data-review="UserName">—</span></div>
                <div><strong>@T["col.email"]:</strong> <span class="ltr-field" data-review="Email">—</span></div>
                <div><strong>@T["col.display_name"]:</strong> <span data-review="DisplayName">—</span></div>
            </div>
        </div>

        <div class="wizard-nav d-flex justify-content-between gap-2 mt-4">
            <button type="button" class="btn btn-outline-secondary" id="authorWizardPrev" hidden>@T["wizard.prev"]</button>
            <div class="ms-auto d-flex gap-2">
                <button type="button" class="btn btn-accent" id="authorWizardNext">@T["wizard.next"]</button>
                <button type="submit" class="btn btn-accent" id="authorWizardSubmit" hidden>@T["btn.create"]</button>
            </div>
        </div>
    </form>
</div>

@section Styles {
<style>
.wizard-steps{display:flex;gap:.5rem;margin-bottom:1rem;flex-wrap:wrap}
.wizard-step{flex:1;min-width:7rem;display:flex;align-items:center;gap:.5rem;padding:.65rem .85rem;border:1px solid var(--border-soft);border-radius:12px;background:var(--surface);color:var(--text-muted);cursor:pointer;font:inherit;text-align:start}
.wizard-step.active{border-color:color-mix(in srgb,var(--accent) 45%,var(--border));background:color-mix(in srgb,var(--accent) 10%,var(--surface));color:var(--text)}
.wizard-step-num{width:1.5rem;height:1.5rem;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;background:var(--surface-2)}
.wizard-step.active .wizard-step-num{background:var(--accent);color:#111}
.wizard-hint{color:var(--text-muted);font-size:.88rem;margin:0 0 1rem}
.wizard-pane[hidden]{display:none!important}
.wizard-alert.danger{background:color-mix(in srgb,var(--danger,#ef4444) 12%,var(--surface));border:1px solid color-mix(in srgb,var(--danger,#ef4444) 35%,var(--border));color:var(--danger,#ef4444);border-radius:10px;padding:.75rem 1rem;margin-bottom:1rem;font-size:.88rem}
.field-error{display:block;color:var(--danger,#ef4444);font-size:.8rem;margin-top:.3rem;min-height:0;line-height:1.35}
.field-error:empty{display:none}
.wizard-form .form-control.is-invalid,
.wizard-form .form-select.is-invalid{
  border-color:color-mix(in srgb,var(--danger,#ef4444) 70%,var(--border));
  box-shadow:0 0 0 3px color-mix(in srgb,var(--danger,#ef4444) 14%,transparent);
}
.author-avatar-preview{width:4rem;height:4rem;border-radius:50%;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-size:1.4rem;font-weight:700;overflow:hidden;flex-shrink:0}
</style>
}

@section Scripts {
<script src="~/js/author-wizard.js" asp-append-version="true"></script>
}
