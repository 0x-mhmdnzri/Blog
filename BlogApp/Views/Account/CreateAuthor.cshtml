@model BlogApp.Models.ViewModels.CreateAuthorViewModel
@using BlogApp.Models
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["btn.new_author"];
}

<div class="wizard" style="max-width:640px;">
    <div class="wizard-steps" id="authorWizardSteps" role="tablist">
        <button type="button" class="wizard-step active" data-step="1" aria-selected="true">
            <span class="wizard-step-num">1</span>
            <span class="wizard-step-label">@T["wizard.identity"]</span>
        </button>
        <button type="button" class="wizard-step" data-step="2" aria-selected="false">
            <span class="wizard-step-num">2</span>
            <span class="wizard-step-label">@T["wizard.profile"]</span>
        </button>
        <button type="button" class="wizard-step" data-step="3" aria-selected="false">
            <span class="wizard-step-num">3</span>
            <span class="wizard-step-label">@T["wizard.security"]</span>
        </button>
    </div>

    <form asp-action="CreateAuthor" method="post" enctype="multipart/form-data"
          class="card-surface p-4 wizard-form" id="authorWizardForm" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="wizard-alert danger" id="authorValSummary"></div>

        <div class="wizard-pane active" data-pane="1">
            <p class="wizard-hint">@T["wizard.author_step1_hint"]</p>
            <div class="mb-3">
                <label class="form-label" asp-for="UserName">@T["col.username"] <span class="text-danger">*</span></label>
                <input class="form-control ltr-field" asp-for="UserName" autocomplete="username"
                       required minlength="3" maxlength="50" pattern="[a-zA-Z0-9._-]{3,50}"
                       placeholder="mhmdnzr" />
                <span asp-validation-for="UserName" class="field-error"></span>
                <div class="form-text">@T["wizard.username_help"] · /author/<span class="ltr-field">username</span></div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Email">@T["col.email"] <span class="text-danger">*</span></label>
                <input class="form-control ltr-field" asp-for="Email" type="email" autocomplete="email"
                       required maxlength="256" placeholder="author@example.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="mb-1">
                <label class="form-label" asp-for="DisplayName">@T["col.display_name"] <span class="text-danger">*</span></label>
                <input class="form-control" asp-for="DisplayName" dir="auto" required minlength="2" maxlength="100" />
                <span asp-validation-for="DisplayName" class="field-error"></span>
            </div>
        </div>

        <div class="wizard-pane" data-pane="2" hidden>
            <p class="wizard-hint">Avatar, gender, bio & optional socials</p>

            <div class="mb-3 d-flex align-items-center gap-3">
                <div class="author-avatar-preview rounded-circle d-flex align-items-center justify-content-center"
                     id="avatarPreview"
                     style="width:72px;height:72px;background:var(--surface-2);border:2px solid var(--border-soft);font-size:1.4rem;overflow:hidden;flex-shrink:0;">
                    <span id="avatarInitial">?</span>
                </div>
                <div class="flex-grow-1">
                    <label class="form-label" for="ProfileImageFile">تصویر پروفایل</label>
                    <input type="file" name="ProfileImageFile" id="ProfileImageFile" accept="image/jpeg,image/png,image/webp"
                           class="form-control form-control-sm" />
                    <div class="form-text">JPG / PNG / WebP · max 2 MB</div>
                    <span asp-validation-for="ProfileImageFile" class="field-error"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Gender">جنسیت (him / her)</label>
                <select class="form-select" asp-for="Gender">
                    <option value="@((int)UserGender.Unspecified)">ترجیح می‌دهم نگویم</option>
                    <option value="@((int)UserGender.Male)">مرد · him</option>
                    <option value="@((int)UserGender.Female)">زن · her</option>
                    <option value="@((int)UserGender.Other)">سایر</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Bio">@T["wizard.bio_optional"]</label>
                <textarea class="form-control" asp-for="Bio" rows="3" dir="auto" maxlength="500"
                          placeholder="…"></textarea>
                <span asp-validation-for="Bio" class="field-error"></span>
                <div class="form-text"><span id="bioCount">0</span> / 500</div>
            </div>

            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label" asp-for="Twitter">X / Twitter</label>
                    <input class="form-control ltr-field" asp-for="Twitter" placeholder="@handle" maxlength="120" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="LinkedIn">LinkedIn</label>
                    <input class="form-control ltr-field" asp-for="LinkedIn" placeholder="in/username or URL" maxlength="200" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Telegram">Telegram</label>
                    <input class="form-control ltr-field" asp-for="Telegram" placeholder="@username" maxlength="120" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Phone">Phone</label>
                    <input class="form-control ltr-field" asp-for="Phone" placeholder="+98…" maxlength="40" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="GitHub">GitHub</label>
                    <input class="form-control ltr-field" asp-for="GitHub" placeholder="username" maxlength="120" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Instagram">Instagram</label>
                    <input class="form-control ltr-field" asp-for="Instagram" placeholder="@username" maxlength="120" />
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Website">Website</label>
                    <input class="form-control ltr-field" asp-for="Website" placeholder="https://…" maxlength="200" />
                </div>
            </div>
        </div>

        <div class="wizard-pane" data-pane="3" hidden>
            <p class="wizard-hint">@T["wizard.author_step3_hint"]</p>
            <div class="mb-3">
                <label class="form-label" asp-for="Password">@T["auth.password"] <span class="text-danger">*</span></label>
                <input class="form-control ltr-field" asp-for="Password" type="password" autocomplete="new-password"
                       required minlength="10" maxlength="128" />
                <span asp-validation-for="Password" class="field-error"></span>
                <div class="form-text">@T["wizard.password_help"]</div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="ConfirmPassword">@T["wizard.confirm_password"] <span class="text-danger">*</span></label>
                <input class="form-control ltr-field" asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                       required minlength="10" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <div class="wizard-review card-surface p-3 small" id="authorReview">
                <div class="text-muted-dark mb-1">@T["wizard.review"]</div>
                <div><strong>@T["col.username"]:</strong> <span class="ltr-field" data-review="UserName">—</span></div>
                <div><strong>@T["col.email"]:</strong> <span class="ltr-field" data-review="Email">—</span></div>
                <div><strong>@T["col.display_name"]:</strong> <span data-review="DisplayName">—</span></div>
            </div>
        </div>

        <div class="wizard-actions">
            <a class="btn btn-ghost" asp-action="Authors">@T["btn.cancel"]</a>
            <div class="ms-auto d-flex gap-2">
                <button type="button" class="btn btn-ghost" id="authorPrev" hidden>@T["wizard.prev"]</button>
                <button type="button" class="btn btn-accent" id="authorNext">@T["wizard.next"]</button>
                <button type="submit" class="btn btn-accent" id="authorSubmit" hidden>@T["btn.new_author"]</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
  var form = document.getElementById('authorWizardForm');
  if (!form) return;
  var step = 1;
  var panes = form.querySelectorAll('.wizard-pane');
  var steps = document.querySelectorAll('#authorWizardSteps .wizard-step');
  var prev = document.getElementById('authorPrev');
  var next = document.getElementById('authorNext');
  var submit = document.getElementById('authorSubmit');
  var bio = form.querySelector('[name="Bio"]');
  var bioCount = document.getElementById('bioCount');
  var fileInput = document.getElementById('ProfileImageFile');
  var preview = document.getElementById('avatarPreview');
  var initial = document.getElementById('avatarInitial');
  var displayName = form.querySelector('[name="DisplayName"]');

  function show(n) {
    step = n;
    panes.forEach(function (p) {
      var on = +p.getAttribute('data-pane') === n;
      p.hidden = !on;
      p.classList.toggle('active', on);
    });
    steps.forEach(function (s) {
      var sn = +s.getAttribute('data-step');
      s.classList.toggle('active', sn === n);
      s.classList.toggle('done', sn < n);
      s.setAttribute('aria-selected', sn === n ? 'true' : 'false');
    });
    prev.hidden = n === 1;
    next.hidden = n === 3;
    submit.hidden = n !== 3;
    if (n === 3) {
      form.querySelectorAll('[data-review]').forEach(function (el) {
        var name = el.getAttribute('data-review');
        var input = form.querySelector('[name="' + name + '"]');
        el.textContent = (input && input.value) ? input.value : '—';
      });
    }
  }

  function fieldsInPane(n) {
    var pane = form.querySelector('.wizard-pane[data-pane="' + n + '"]');
    return pane ? pane.querySelectorAll('input:not([type=file]),textarea,select') : [];
  }

  function validatePane(n) {
    var ok = true;
    fieldsInPane(n).forEach(function (el) {
      if (typeof el.reportValidity === 'function' && !el.reportValidity()) ok = false;
    });
    if (n === 3) {
      var p = form.querySelector('[name="Password"]');
      var c = form.querySelector('[name="ConfirmPassword"]');
      if (p && c && p.value !== c.value) {
        c.setCustomValidity('Passwords do not match');
        c.reportValidity();
        c.setCustomValidity('');
        ok = false;
      }
    }
    return ok;
  }

  if (next) next.addEventListener('click', function () {
    if (!validatePane(step)) return;
    if (step < 3) show(step + 1);
  });
  if (prev) prev.addEventListener('click', function () {
    if (step > 1) show(step - 1);
  });
  steps.forEach(function (s) {
    s.addEventListener('click', function () {
      var target = +s.getAttribute('data-step');
      if (target < step) show(target);
      else if (target > step) {
        for (var i = step; i < target; i++) if (!validatePane(i)) return;
        show(target);
      }
    });
  });
  form.addEventListener('submit', function (e) {
    for (var i = 1; i <= 3; i++) {
      if (!validatePane(i)) {
        e.preventDefault();
        show(i);
        return;
      }
    }
  });
  if (bio && bioCount) {
    var upd = function () { bioCount.textContent = String((bio.value || '').length); };
    bio.addEventListener('input', upd);
    upd();
  }
  if (displayName && initial) {
    displayName.addEventListener('input', function () {
      var v = (displayName.value || '').trim();
      initial.textContent = v ? v.charAt(0).toUpperCase() : '?';
    });
  }
  if (fileInput && preview) {
    fileInput.addEventListener('change', function () {
      var f = fileInput.files && fileInput.files[0];
      if (!f) return;
      var url = URL.createObjectURL(f);
      preview.innerHTML = '<img src="' + url + '" alt="" style="width:100%;height:100%;object-fit:cover;" />';
    });
  }
  show(1);
})();
</script>
}
