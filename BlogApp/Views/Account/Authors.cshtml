@model List<BlogApp.Models.ViewModels.AuthorListItem>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["page.authors"];
}

@if (TempData["AuthorCreated"] != null)
{
    <div class="alert mb-4" style="background:rgba(34,197,94,.12); color:#4ade80; border:1px solid rgba(34,197,94,.3);">
        @TempData["AuthorCreated"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <p class="text-muted-dark mb-0 small">@T["authors.subtitle"]</p>
    <a class="btn btn-accent btn-sm" asp-action="CreateAuthor">+ @T["btn.new_author"]</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="admin-empty">
        <h2>@T["authors.empty_title"]</h2>
        <p class="mb-0">@T["authors.empty_body"]</p>
    </div>
}
else
{
    <div class="admin-table-wrap authors-table-desktop">
        <table class="admin-table authors-table">
            <thead>
                <tr>
                    <th class="avatar-cell"></th>
                    <th>@T["col.display_name"]</th>
                    <th>@T["col.username"]</th>
                    <th>@T["col.email"]</th>
                    <th>@T["col.role"]</th>
                    <th>@T["col.post_count"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="avatar-cell">
                        @if (a.HasProfileImage)
                        {
                            <img src="@Url.Action("ProfileImage", "Account", new { userId = a.Id })"
                                 class="avatar" alt="" width="36" height="36" />
                        }
                        else
                        {
                            <span class="avatar-fallback" aria-hidden="true">
                                @(string.IsNullOrEmpty(a.DisplayName) ? "?" : a.DisplayName.Trim()[0].ToString())
                            </span>
                        }
                    </td>
                    <td class="name-cell" dir="auto" title="@a.DisplayName">@a.DisplayName</td>
                    <td><span class="ltr-field">@a.UserName</span></td>
                    <td class="email-cell" title="@a.Email"><span class="ltr-field">@a.Email</span></td>
                    <td>
                        @if (a.IsSuperAdmin)
                        {
                            <span class="role-badge super">SuperAdmin</span>
                        }
                        else
                        {
                            <span class="role-badge author">Author</span>
                        }
                    </td>
                    <td><span class="ltr-field">@a.PostCount</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="authors-cards">
        @foreach (var a in Model)
        {
            <div class="author-card">
                @if (a.HasProfileImage)
                {
                    <img src="@Url.Action("ProfileImage", "Account", new { userId = a.Id })"
                         class="avatar" alt="" width="40" height="40" style="width:40px;height:40px;" />
                }
                else
                {
                    <span class="avatar-fallback" style="width:40px;height:40px;" aria-hidden="true">
                        @(string.IsNullOrEmpty(a.DisplayName) ? "?" : a.DisplayName.Trim()[0].ToString())
                    </span>
                }
                <div class="meta">
                    <div class="title" dir="auto">@a.DisplayName</div>
                    <div class="sub ltr-field">@a.UserName</div>
                    <div class="sub ltr-field">@a.Email</div>
                    <div class="row-bits">
                        @if (a.IsSuperAdmin)
                        {
                            <span class="role-badge super">SuperAdmin</span>
                        }
                        else
                        {
                            <span class="role-badge author">Author</span>
                        }
                        <span class="ltr-field small">@a.PostCount @T["authors.posts_suffix"]</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
