@{
    ViewData["Title"] = "ورود";
    ViewData["NoIndex"] = true;
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card-surface p-4" style="max-width:380px; width:100%;">
        <div class="hero-prompt mb-2">$ auth login</div>
        <h1 class="h4 mb-4">ورود به حساب</h1>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert" style="background:rgba(229,99,122,.12); color:var(--danger); border:1px solid rgba(229,99,122,.3);">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="mb-3">
                <label class="form-label">نام کاربری</label>
                <input class="form-control ltr-field" style="width:100%; display:block;" name="username" required autofocus />
            </div>
            <div class="mb-4">
                <label class="form-label">رمز عبور</label>
                <input class="form-control ltr-field" style="width:100%; display:block;" type="password" name="password" required />
            </div>
            <button class="btn btn-accent w-100" type="submit">ورود</button>
        </form>
    </div>
</div>
