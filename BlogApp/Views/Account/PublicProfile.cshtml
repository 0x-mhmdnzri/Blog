@model BlogApp.Models.ViewModels.PublicAuthorProfileViewModel
@using BlogApp.Models
@inject BlogApp.Services.IUiTranslator T
@{
    ViewData["Title"] = Model.DisplayName;
    var initial = string.IsNullOrWhiteSpace(Model.DisplayName)
        ? "?"
        : Model.DisplayName.Trim()[0].ToString().ToUpperInvariant();

    string? TwitterUrl() => string.IsNullOrWhiteSpace(Model.Twitter) ? null
        : Model.Twitter.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.Twitter
            : "https://x.com/" + Model.Twitter.TrimStart('@');
    string? LinkedInUrl() => string.IsNullOrWhiteSpace(Model.LinkedIn) ? null
        : Model.LinkedIn.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.LinkedIn
            : "https://www.linkedin.com/in/" + Model.LinkedIn.TrimStart('/');
    string? TelegramUrl() => string.IsNullOrWhiteSpace(Model.Telegram) ? null
        : Model.Telegram.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.Telegram
            : "https://t.me/" + Model.Telegram.TrimStart('@');
    string? GitHubUrl() => string.IsNullOrWhiteSpace(Model.GitHub) ? null
        : Model.GitHub.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.GitHub
            : "https://github.com/" + Model.GitHub.TrimStart('@');
    string? InstagramUrl() => string.IsNullOrWhiteSpace(Model.Instagram) ? null
        : Model.Instagram.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.Instagram
            : "https://instagram.com/" + Model.Instagram.TrimStart('@');
    string? WebsiteUrl() => string.IsNullOrWhiteSpace(Model.Website) ? null
        : Model.Website.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.Website
            : "https://" + Model.Website;
    string? PhoneTel() => string.IsNullOrWhiteSpace(Model.Phone) ? null
        : "tel:" + new string(Model.Phone.Where(c => char.IsDigit(c) || c == '+').ToArray());

    var genderLabel = Model.Gender switch
    {
        UserGender.Male => "him",
        UserGender.Female => "her",
        UserGender.Other => "they",
        _ => null
    };
}
<link rel="stylesheet" href="~/css/persona.css" asp-append-version="true" />

<section class="author-profile">
    <div class="author-hero">
        <div class="container author-hero-inner">
            <div class="author-identity">
                <div class="author-avatar-wrap">
                    @if (Model.HasProfileImage)
                    {
                        <img src="@Url.Action("ProfileImage", "Account", new { userId = Model.UserId })"
                             alt="@Model.DisplayName"
                             class="author-avatar"
                             width="128" height="128"
                             loading="eager" />
                    }
                    else
                    {
                        <div class="author-avatar author-avatar-fallback" aria-hidden="true">@initial</div>
                    }
                    @if (Model.IsAuthor)
                    {
                        <span class="author-badge @(Model.IsSuperAdmin ? "is-super" : "is-author")"
                              title="@(Model.IsSuperAdmin ? "SuperAdmin" : "Author")">
                            @if (Model.IsSuperAdmin)
                            {
                                <svg class="author-badge-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.2 14.9 8l6.6.6-5 4.4 1.5 6.4L12 16.5 6 19.4l1.5-6.4-5-4.4L9.1 8 12 2.2z"/></svg>
                            }
                            else
                            {
                                <svg class="author-badge-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                            }
                        </span>
                    }
                </div>

                <div class="author-meta">
                    <h1 class="author-name" dir="auto">@Model.DisplayName</h1>
                    <p class="author-handle ltr-field">@@@Model.UserName</p>

                    <div class="author-chips">
                        @if (Model.IsSuperAdmin)
                        {
                            <span class="author-chip super">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.2 14.9 8l6.6.6-5 4.4 1.5 6.4L12 16.5 6 19.4l1.5-6.4-5-4.4L9.1 8 12 2.2z"/></svg>
                                SuperAdmin
                            </span>
                        }
                        else if (Model.IsAuthor)
                        {
                            <span class="author-chip">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                @T["role.author"]
                            </span>
                        }
                        @if (genderLabel != null)
                        {
                            <span class="author-chip muted ltr-field">@genderLabel</span>
                        }
                        <span class="author-chip muted ltr-field">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/></svg>
                            @Model.JoinedAtUtc.ToString("yyyy") · @T["author.joined"]
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Bio))
                    {
                        <p class="author-bio" dir="auto">@Model.Bio</p>
                    }
                    else
                    {
                        <p class="author-bio author-bio-empty">@T["author.no_bio"]</p>
                    }

                    @if (Model.HasAnySocial)
                    {
                        <ul class="author-socials" aria-label="Social links">
                            @if (TwitterUrl() is string tw)
                            {
                                <li>
                                    <a class="author-social as-x" href="@tw" target="_blank" rel="noopener noreferrer me" title="X / Twitter" aria-label="X">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                                    </a>
                                </li>
                            }
                            @if (LinkedInUrl() is string li)
                            {
                                <li>
                                    <a class="author-social as-linkedin" href="@li" target="_blank" rel="noopener noreferrer me" title="LinkedIn" aria-label="LinkedIn">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                                    </a>
                                </li>
                            }
                            @if (TelegramUrl() is string tg)
                            {
                                <li>
                                    <a class="author-social as-telegram" href="@tg" target="_blank" rel="noopener noreferrer me" title="Telegram" aria-label="Telegram">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                                    </a>
                                </li>
                            }
                            @if (GitHubUrl() is string gh)
                            {
                                <li>
                                    <a class="author-social as-github" href="@gh" target="_blank" rel="noopener noreferrer me" title="GitHub" aria-label="GitHub">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                                    </a>
                                </li>
                            }
                            @if (InstagramUrl() is string ig)
                            {
                                <li>
                                    <a class="author-social as-instagram" href="@ig" target="_blank" rel="noopener noreferrer me" title="Instagram" aria-label="Instagram">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
                                    </a>
                                </li>
                            }
                            @if (WebsiteUrl() is string web)
                            {
                                <li>
                                    <a class="author-social as-web" href="@web" target="_blank" rel="noopener noreferrer me" title="Website" aria-label="Website">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                                    </a>
                                </li>
                            }
                            @if (PhoneTel() is string tel)
                            {
                                <li>
                                    <a class="author-social as-phone" href="@tel" title="@Model.Phone" aria-label="Phone">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                                    </a>
                                </li>
                            }
                        </ul>
                    }

                    <div class="author-actions">
                        @if (Model.IsOwnProfile)
                        {
                            <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Profile">@T["author.edit_profile"]</a>
                        }
                        else if (Model.CanFollow)
                        {
                            <form method="post" asp-controller="Follow" asp-action="Toggle" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="authorUserId" value="@Model.UserId" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn @(Model.IsFollowing ? "btn-ghost" : "btn-accent") btn-sm author-follow-btn">
                                    @if (Model.IsFollowing)
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                        @T["author.unfollow"]
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                        @T["author.follow"]
                                    }
                                </button>
                            </form>
                        }
                        else if (User.Identity?.IsAuthenticated != true)
                        {
                            <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login"
                               asp-route-returnUrl="@Context.Request.Path">@T["author.login_to_follow"]</a>
                        }
                    </div>
                </div>
            </div>

            <div class="author-stats" role="group" aria-label="stats">
                <div class="author-stat as-posts">
                    <div class="author-stat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
                    </div>
                    <div class="num ltr-field">@Model.PostCount.ToString("N0")</div>
                    <div class="lbl">@T["author.stat_posts"]</div>
                </div>
                <div class="author-stat as-followers">
                    <div class="author-stat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                    </div>
                    <div class="num ltr-field">@Model.FollowerCount.ToString("N0")</div>
                    <div class="lbl">@T["author.stat_followers"]</div>
                </div>
                <div class="author-stat as-views">
                    <div class="author-stat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                    </div>
                    <div class="num ltr-field">@FormatViews(Model.TotalViews)</div>
                    <div class="lbl">@T["author.stat_views"]</div>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AuthorPostsBody", Model)
</section>

@functions {
    static string FormatViews(long n)
    {
        if (n >= 1_000_000) return (n / 1_000_000d).ToString("0.#") + "M";
        if (n >= 1_000) return (n / 1_000d).ToString("0.#") + "K";
        return n.ToString("N0");
    }
}
