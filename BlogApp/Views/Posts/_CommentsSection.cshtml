@model Post
@inject BlogApp.Services.IUiTranslator T
@{
    var commentSort = (ViewBag.CommentSort as string) ?? "relevant";
    var likedIds = ViewBag.LikedCommentIds as HashSet<int> ?? new HashSet<int>();
    var canLike = User.Identity?.IsAuthenticated == true
        && (User.IsInRole(AppRoles.Reader) || User.IsInRole(AppRoles.Author) || User.IsInRole(AppRoles.SuperAdmin));
    var canEditPost = ViewBag.CanEdit as bool? ?? false;
    var currentUserId = ViewBag.CurrentUserId as string;
    var editWindow = ViewBag.CommentEditWindowMinutes as int? ?? 15;
    var postUrl = Url.Action("Details", "Posts", new { slug = Model.Slug })!;

    IEnumerable<Comment> orderedComments = commentSort == "latest"
        ? Model.Comments.OrderByDescending(c => c.IsPinned).ThenByDescending(c => c.CreatedAtUtc)
        : Model.Comments.OrderByDescending(c => c.IsPinned).ThenByDescending(c => c.LikeCount).ThenByDescending(c => c.CreatedAtUtc);
}

<section class="mt-5 pt-4 comments-section" style="border-top:1px solid var(--border-soft);">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="h6 text-muted-dark mb-0">دیدگاه‌ها <span class="ltr-field">(@Model.Comments.Count)</span></h2>
        <form method="get" asp-action="Details" asp-route-slug="@Model.Slug" class="d-flex align-items-center gap-2">
            <label class="small text-muted-dark mb-0" for="commentSort">مرتب‌سازی</label>
            <select class="form-select form-select-sm" id="commentSort" name="sort" style="width:auto;min-width:9rem;"
                    onchange="this.form.submit()">
                <option value="relevant" selected="@(commentSort == "relevant")">مرتبط (پسندها)</option>
                <option value="latest" selected="@(commentSort == "latest")">جدیدترین</option>
            </select>
        </form>
    </div>

    @if (TempData["CommentSubmitted"] != null)
    {
        <div class="card-surface p-3 mb-3 small text-muted-dark">@TempData["CommentSubmitted"]</div>
    }

    @foreach (var c in orderedComments)
    {
        var liked = likedIds.Contains(c.Id);
        var isOwner = !string.IsNullOrEmpty(c.UserId) && c.UserId == currentUserId;
        var canEditThis = isOwner && (DateTime.UtcNow - c.CreatedAtUtc).TotalMinutes <= editWindow;
        <div class="card-surface p-3 mb-3 @(c.IsPinned ? "comment-pinned" : "")" id="comment-@c.Id">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                    <strong dir="@MarkdownService.DetectDir(c.AuthorName)" style="font-size:.9rem;">@c.AuthorName</strong>
                    @if (c.IsPinned)
                    {
                        <span class="status-pill sticky" style="font-size:.7rem;">سنجاق‌شده</span>
                    }
                    @if (c.EditCount > 0)
                    {
                        <span class="small text-muted-dark">(ویرایش‌شده)</span>
                    }
                </div>
                <span class="ltr-field small" style="color:var(--text-faint);">@PersianDate.DateTime(c.CreatedAtUtc)</span>
            </div>
            <p class="mb-2 mt-2 text-muted-dark" dir="@MarkdownService.DetectDir(c.Body)">@c.Body</p>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (canLike)
                {
                    <form asp-controller="Comments" asp-action="ToggleLike" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="commentId" value="@c.Id" />
                        <input type="hidden" name="returnUrl" value="@(postUrl + "?sort=" + commentSort)" />
                        <button type="submit" class="btn btn-ghost btn-sm py-0 px-2">
                            @(liked ? "♥" : "♡") <span class="ltr-field">@c.LikeCount</span>
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-ghost btn-sm py-0 px-2" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(postUrl + "?sort=" + commentSort)">
                        ♡ <span class="ltr-field">@c.LikeCount</span>
                    </a>
                }
                @if (canEditPost)
                {
                    <form asp-controller="Comments" asp-action="TogglePin" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="hidden" name="returnUrl" value="@(postUrl + "?sort=" + commentSort)" />
                        <button type="submit" class="btn btn-ghost btn-sm py-0 px-2">@(c.IsPinned ? "برداشتن سنجاق" : "سنجاق")</button>
                    </form>
                }
                @if (canEditThis || canEditPost)
                {
                    <button type="button" class="btn btn-ghost btn-sm py-0 px-2" onclick="document.getElementById('edit-@c.Id').hidden = !document.getElementById('edit-@c.Id').hidden">ویرایش</button>
                }
            </div>
            @if (canEditThis || canEditPost)
            {
                <form id="edit-@c.Id" asp-controller="Comments" asp-action="Edit" method="post" class="mt-2" hidden>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@c.Id" />
                    <input type="hidden" name="returnUrl" value="@(postUrl + "?sort=" + commentSort)" />
                    <textarea class="form-control form-control-sm mb-2" name="body" dir="auto" rows="3" maxlength="2000" required>@c.Body</textarea>
                    <button type="submit" class="btn btn-accent btn-sm">ذخیره</button>
                </form>
            }
        </div>
    }

    <form asp-action="AddComment" method="post" class="card-surface p-3 mt-3" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" name="postId" value="@Model.Id" />
        @* Honeypot — leave empty *@
        <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
            <label>Website</label>
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="mb-2">
            <input class="form-control form-control-sm" name="authorName" dir="auto" placeholder="نام شما" required maxlength="80"
                   value="@(User.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "") : "")" />
        </div>
        <div class="mb-2">
            <input class="form-control form-control-sm" name="authorEmail" type="email" dir="ltr" placeholder="ایمیل (اختیاری — مهمان)" maxlength="120" />
        </div>
        <div class="mb-2">
            <textarea class="form-control form-control-sm" name="body" dir="auto" rows="3" required maxlength="2000" placeholder="متن دیدگاه… می‌توانید با @@username منشن کنید"></textarea>
        </div>
        <button class="btn btn-accent btn-sm" type="submit">ارسال دیدگاه</button>
    </form>
</section>
