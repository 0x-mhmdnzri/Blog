@model Post
@inject BlogApp.Services.IUiTranslator T
@{
    var commentSort = (ViewBag.CommentSort as string) ?? "relevant";
    var likedIds = ViewBag.LikedCommentIds as HashSet<int> ?? new HashSet<int>();
    var canLike = User.Identity?.IsAuthenticated == true
        && (User.IsInRole(AppRoles.Reader) || User.IsInRole(AppRoles.Author) || User.IsInRole(AppRoles.SuperAdmin));
    var canEditPost = ViewBag.CanEdit as bool? ?? false;
    var currentUserId = ViewBag.CurrentUserId as string;
    var editWindow = ViewBag.CommentEditWindowMinutes as int? ?? 15;
    var maxBody = ViewBag.CommentMaxBodyLength as int? ?? 2000;
    var postUrl = Url.Action("Details", "Posts", new { slug = Model.Slug })!;
    var sortQs = "?sort=" + commentSort;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var defaultName = isAuth ? (User.Identity?.Name ?? "") : "";

    var all = Model.Comments.ToList();
    var byParent = all.GroupBy(c => c.ParentId ?? 0).ToDictionary(g => g.Key, g => g.ToList());

    List<Comment> OrderSiblings(IEnumerable<Comment> src)
    {
        return commentSort == "latest"
            ? src.OrderByDescending(c => c.IsPinned).ThenByDescending(c => c.CreatedAtUtc).ToList()
            : src.OrderByDescending(c => c.IsPinned).ThenByDescending(c => c.LikeCount).ThenByDescending(c => c.CreatedAtUtc).ToList();
    }

    var roots = OrderSiblings(all.Where(c => c.ParentId == null));
    var byId = all.ToDictionary(c => c.Id);

    string Initials(string name)
    {
        var parts = (name ?? "?").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Length > 0 ? parts[0][..1].ToUpperInvariant() : "?";
        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    async Task RenderThread(Comment c, int depth)
    {
        var liked = likedIds.Contains(c.Id);
        var isOwner = !string.IsNullOrEmpty(c.UserId) && c.UserId == currentUserId;
        var canEditThis = isOwner && (DateTime.UtcNow - c.CreatedAtUtc).TotalMinutes <= editWindow;
        var replies = byParent.TryGetValue(c.Id, out var kids) ? OrderSiblings(kids) : new List<Comment>();
        var parentName = c.ParentId is int pid && byId.TryGetValue(pid, out var par) ? par.AuthorName : null;

        <article class="cmt @(c.IsPinned ? "is-pinned" : "")" id="comment-@c.Id" data-id="@c.Id" data-depth="@depth" data-author="@c.AuthorName">
            <div class="cmt-avatar" aria-hidden="true">@Initials(c.AuthorName)</div>
            <div class="cmt-main">
                <header class="cmt-head">
                    <span class="cmt-name" dir="auto">@c.AuthorName</span>
                    @if (c.IsGuest)
                    {
                        <span class="cmt-badge">مهمان</span>
                    }
                    @if (c.IsPinned)
                    {
                        <span class="cmt-badge cmt-badge-pin">سنجاق‌شده</span>
                    }
                    <span class="cmt-dot" aria-hidden="true">·</span>
                    <time class="cmt-time ltr-field" datetime="@c.CreatedAtUtc.ToString("o")">@PersianDate.DateTime(c.CreatedAtUtc)</time>
                    @if (c.EditedAtUtc is not null)
                    {
                        <span class="cmt-edited">ویرایش‌شده</span>
                    }
                </header>

                @if (!string.IsNullOrEmpty(parentName))
                {
                    <div class="cmt-replying">
                        در پاسخ به <button type="button" class="cmt-reply-link" data-scroll-to="@c.ParentId">@parentName</button>
                    </div>
                }

                <p class="cmt-body" dir="@MarkdownService.DetectDir(c.Body)">@c.Body</p>

                <footer class="cmt-actions">
                    @if (canLike)
                    {
                        <form asp-controller="Comments" asp-action="ToggleLike" method="post" class="cmt-act-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="commentId" value="@c.Id" />
                            <input type="hidden" name="returnUrl" value="@(postUrl + sortQs + "#comment-" + c.Id)" />
                            <button type="submit" class="cmt-act @(liked ? "is-on" : "")" title="پسند">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="@(liked ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                <span class="ltr-field">@c.LikeCount</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="cmt-act" asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@(postUrl + sortQs + "#comment-" + c.Id)" title="برای پسندیدن وارد شوید">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            <span class="ltr-field">@c.LikeCount</span>
                        </a>
                    }

                    <button type="button" class="cmt-act" data-reply-to="@c.Id" data-reply-name="@c.AuthorName">پاسخ</button>

                    @if (canEditPost)
                    {
                        <form asp-controller="Comments" asp-action="TogglePin" method="post" class="cmt-act-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <input type="hidden" name="returnUrl" value="@(postUrl + sortQs + "#comment-" + c.Id)" />
                            <button type="submit" class="cmt-act">@(c.IsPinned ? "برداشتن سنجاق" : "سنجاق")</button>
                        </form>
                    }

                    @if (canEditThis || canEditPost)
                    {
                        <button type="button" class="cmt-act" data-edit-toggle="@c.Id">ویرایش</button>
                    }

                    <button type="button" class="cmt-act cmt-act-muted"
                            onclick="document.getElementById('reportBox')?.removeAttribute('hidden'); document.getElementById('reportBox')?.scrollIntoView({behavior:'smooth',block:'center'});">
                        گزارش
                    </button>
                </footer>

                @if (canEditThis || canEditPost)
                {
                    <form id="edit-@c.Id" asp-controller="Comments" asp-action="Edit" method="post" class="cmt-edit" hidden>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="hidden" name="returnUrl" value="@(postUrl + sortQs + "#comment-" + c.Id)" />
                        <textarea class="cmt-input" name="body" dir="auto" rows="3" maxlength="@maxBody" required>@c.Body</textarea>
                        <div class="cmt-compose-foot">
                            <button type="submit" class="btn btn-accent btn-sm">ذخیره</button>
                        </div>
                    </form>
                }

                <div class="cmt-reply-slot" id="reply-slot-@c.Id" hidden></div>

                @if (replies.Count > 0)
                {
                    <div class="cmt-thread">
                        @foreach (var r in replies)
                        {
                            await RenderThread(r, depth + 1);
                        }
                    </div>
                }
            </div>
        </article>
    }
}

<section class="cmt-section" id="comments" data-max-body="@maxBody" data-post-id="@Model.Id" data-post-url="@(postUrl + sortQs)">
    <header class="cmt-section-head">
        <h2 class="cmt-section-title">
            دیدگاه‌ها
            <span class="cmt-count ltr-field">@Model.Comments.Count</span>
        </h2>
        <form method="get" asp-action="Details" asp-route-slug="@Model.Slug" class="cmt-sort">
            <label class="visually-hidden" for="cmtSort">مرتب‌سازی</label>
            <select id="cmtSort" name="sort" onchange="this.form.submit()">
                <option value="relevant" selected="@(commentSort == "relevant")">مرتبط‌ترین</option>
                <option value="latest" selected="@(commentSort == "latest")">جدیدترین</option>
            </select>
        </form>
    </header>

    <form asp-action="AddComment" method="post" class="cmt-composer" id="cmtMainComposer" autocomplete="off" data-toast-success="دیدگاه ثبت شد">
        @Html.AntiForgeryToken()
        <input type="hidden" name="postId" value="@Model.Id" />
        <div class="cmt-honeypot" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="cmt-composer-row">
            <div class="cmt-avatar cmt-avatar-self" aria-hidden="true">@(string.IsNullOrEmpty(defaultName) ? "+" : Initials(defaultName))</div>
            <div class="cmt-composer-body">
                <input class="cmt-input cmt-input-name" name="authorName" dir="auto" placeholder="نام شما" required maxlength="80" value="@defaultName" />
                @if (!isAuth)
                {
                    <input class="cmt-input cmt-input-email" name="authorEmail" type="email" dir="ltr" placeholder="ایمیل (اختیاری)" maxlength="120" />
                }
                <textarea class="cmt-input cmt-input-body" name="body" id="cmtBody" dir="auto" rows="3" required maxlength="@maxBody"
                          placeholder="چه چیزی در ذهن دارید؟ می‌توانید با @@username منشن کنید"></textarea>
                <div class="cmt-compose-foot">
                    <span class="cmt-counter ltr-field" id="cmtCounter">0 / @maxBody</span>
                    <button class="btn btn-accent btn-sm" type="submit">ارسال</button>
                </div>
            </div>
        </div>
    </form>

    @* Template for inline reply (cloned by JS) *@
    <template id="cmtReplyTemplate">
        <form asp-action="AddComment" method="post" class="cmt-composer cmt-composer-inline" autocomplete="off" data-toast-success="پاسخ ثبت شد">
            @Html.AntiForgeryToken()
            <input type="hidden" name="postId" value="@Model.Id" />
            <input type="hidden" name="parentId" value="" data-parent-field />
            <div class="cmt-honeypot" aria-hidden="true">
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <div class="cmt-composer-row">
                <div class="cmt-avatar cmt-avatar-self" aria-hidden="true">@(string.IsNullOrEmpty(defaultName) ? "+" : Initials(defaultName))</div>
                <div class="cmt-composer-body">
                    <input class="cmt-input cmt-input-name" name="authorName" dir="auto" placeholder="نام شما" required maxlength="80" value="@defaultName" />
                    @if (!isAuth)
                    {
                        <input class="cmt-input cmt-input-email" name="authorEmail" type="email" dir="ltr" placeholder="ایمیل (اختیاری)" maxlength="120" />
                    }
                    <textarea class="cmt-input cmt-input-body" name="body" dir="auto" rows="2" required maxlength="@maxBody" placeholder="پاسخ خود را بنویسید…"></textarea>
                    <div class="cmt-compose-foot">
                        <button type="button" class="btn btn-ghost btn-sm" data-reply-dismiss>لغو</button>
                        <button class="btn btn-accent btn-sm" type="submit">پاسخ</button>
                    </div>
                </div>
            </div>
        </form>
    </template>

    <div class="cmt-list">
        @if (roots.Count == 0)
        {
            <div class="cmt-empty">
                <p>هنوز دیدگاهی نیست — اولین نفر باشید.</p>
            </div>
        }
        else
        {
            @foreach (var c in roots)
            {
                await RenderThread(c, 0);
            }
        }
    </div>
</section>
