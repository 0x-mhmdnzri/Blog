@model PostEditViewModel
@inject BlogApp.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["pe.edit_title"];
    ViewData["NoIndex"] = true;
}

<link rel="stylesheet" href="~/css/post-editor.css" asp-append-version="true" />

<div class="pe-page">
    <header class="pe-page-head">
        <h1 class="pe-page-title">@T["pe.edit_title"]</h1>
        <p class="pe-page-sub">@T["pe.edit_sub"]</p>
    </header>

    @if (TempData["Success"] is string ok) { <div class="wizard-alert success mb-3">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="wizard-alert danger mb-3">@err</div> }

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="postEditForm" data-native-submit="true" class="pe-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CoverMediaAssetId" />
        @await Html.PartialAsync("_EditorForm", Model)
    </form>

    @if (Model.IsPublished && Model.Id > 0)
    {
        <form asp-action="SendToNewsletter" method="post" class="pe-newsletter" data-native-submit="true"
              onsubmit="return confirm('@T["pe.newsletter_confirm"]');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-ghost btn-sm">@T["pe.newsletter_send"]</button>
        </form>
    }
</div>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
}
