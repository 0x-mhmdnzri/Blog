@model PostEditViewModel
@{
    ViewData["Title"] = "Edit post";
    ViewData["NoIndex"] = true;
}

<div class="container py-5" style="max-width: 1100px;">
    <div class="hero-prompt mb-2">$ posts edit --id=@Model.Id</div>
    <h1 class="h3 mb-4">Edit post</h1>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CoverMediaAssetId" />
        @await Html.PartialAsync("_EditorForm", Model)
    </form>
</div>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
}
