@model PostEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "ویرایش نوشته";
    ViewData["NoIndex"] = true;
}

<div class="mb-3">
    <h1 class="h5 mb-1">ویرایش نوشته</h1>
    <p class="text-muted-dark small mb-0">همان ویزارد ایجاد — تغییرات را مرحله‌به‌مرحله مرور کنید</p>
</div>

<form asp-action="Edit" method="post" id="postEditForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CoverMediaAssetId" />
    @await Html.PartialAsync("_EditorForm", Model)
</form>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
}
