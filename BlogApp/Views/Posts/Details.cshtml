@model Post
@inject BlogApp.Services.IUiTranslator T
@using BlogApp.Models.ViewModels
@{
    ViewData["Title"] = Model.Title;
    var readingMinutes = ViewBag.ReadingTimeMinutes as int? ?? Math.Max(1, Model.ReadingTimeMinutes);
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var isBookmarked = ViewBag.IsBookmarked as bool? ?? false;
    var published = Model.PublishedAtUtc ?? Model.CreatedAtUtc;
    var titleDir = MarkdownService.DetectDir(Model.Title);
    var postUrl = Url.Action("Details", "Posts", new { slug = Model.Slug })!;
    var canBookmark = User.Identity?.IsAuthenticated == true
        && (User.IsInRole(AppRoles.Reader) || User.IsInRole(AppRoles.Author) || User.IsInRole(AppRoles.SuperAdmin));
    var premiumLocked = ViewBag.PremiumLocked as bool? ?? false;
    var isSponsored = ViewBag.IsSponsoredPost as bool? ?? Model.IsSponsored;
    var sponsoredLabel = (ViewBag.SponsoredLabel as string) ?? Model.SponsoredLabel;
    var tocHtml = ViewBag.TocHtml as string;
    var related = ViewBag.RelatedPosts as IList<RelatedPostItem> ?? new List<RelatedPostItem>();
    var hasToc = !string.IsNullOrWhiteSpace(tocHtml);
    var hasCover = Model.CoverMediaAssetId is > 0;
    var hasAuthorImg = Model.Author?.ProfileImage is { Length: > 0 };
    var tags = Model.PostTags?
        .Where(pt => pt.Tag != null)
        .Select(pt => pt.Tag!)
        .OrderBy(t => t.Name)
        .ToList() ?? new List<Tag>();
}

@section Head {
    <link rel="stylesheet" href="~/css/code-onedark.css" asp-append-version="true" />
    <script type="application/ld+json">@Html.Raw(ViewBag.PostJsonLd)</script>
    <meta property="og:type" content="article" />
    <link rel="stylesheet" href="~/css/post-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/related-rail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/comments.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report-section.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/code-onedark.css" asp-append-version="true" />
}
