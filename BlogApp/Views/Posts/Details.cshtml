@model BlogApp.Models.Post
@using BlogApp.Services
@inject BlogApp.Services.IUiTranslator T
@{
    ViewData["Title"] = Model.Title;
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var isSponsored = Model.IsSponsored;
    var sponsoredLabel = Model.SponsoredLabel;
}

<article class="post-detail container py-4">
    <header class="mb-4">
        <h1 class="post-title" dir="auto">@Model.Title</h1>
        <div class="post-meta text-muted-dark small d-flex flex-wrap gap-2 align-items-center">
            @if (Model.Author != null)
            {
                <a href="/author/@Model.Author.UserName" class="text-decoration-none">@Model.Author.DisplayName</a>
            }
            @if (Model.PublishedAtUtc is DateTime pub)
            {
                <span>· @PersianDate.DateTime(pub)</span>
            }
            <span>· @Model.ReadingTimeMinutes دقیقه مطالعه</span>
            <span>· @Model.ViewCount.ToString("N0") بازدید</span>
        </div>

        @if (canEdit)
        {
            <div class="d-flex gap-2 mb-4 flex-wrap align-items-center">
                <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@Model.Id">ویرایش</a>
                <form asp-action="Duplicate" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-ghost btn-sm" type="submit">کپی</button>
                </form>
                <form asp-action="Delete" method="post" class="d-inline-flex flex-wrap gap-1 align-items-center"
                      onsubmit="return confirm('انتقال به سطل زباله؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="text" name="reason" class="form-control form-control-sm" style="max-width:14rem"
                           placeholder="دلیل حذف (اختیاری)" maxlength="500" />
                    <button class="btn btn-outline-danger-dark btn-sm" type="submit">حذف</button>
                </form>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 mb-2">
            @if (Model.IsFeatured) { <span class="badge-category">ویژه</span> }
            @if (Model.IsSticky) { <span class="status-pill sticky">چسبان</span> }
            @if (Model.IsPremium) { <span class="status-pill featured">@T["mon.premium_badge"]</span> }
            @if (isSponsored)
            {
                <span class="status-pill scheduled">@(string.IsNullOrWhiteSpace(sponsoredLabel) ? T["mon.sponsored_default"] : sponsoredLabel)</span>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Summary))
    {
        <p class="lead text-muted-dark" dir="auto">@Model.Summary</p>
    }

    <div class="post-body markdown-body" dir="auto">
        @Html.Raw(ViewBag.RenderedHtml)
    </div>

    @await Html.PartialAsync("_CommentsSection", Model)
</article>
