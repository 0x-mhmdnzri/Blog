@model PostEditViewModel
@inject BlogApp.Services.IUiTranslator T

@{
    var selectedFolders = new HashSet<int>(Model.FolderIds ?? new List<int>());
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert mb-3" style="background:rgba(229,99,122,.12);color:var(--danger);border:1px solid rgba(229,99,122,.3);">
        <div asp-validation-summary="All"></div>
    </div>
}

<div class="pw" id="postWizard" data-start-step="1">
    <div class="pw-progress" aria-hidden="true"><span id="pwProgressBar"></span></div>
    <div class="pw-steps" role="tablist" aria-label="مراحل نوشتن">
        <button type="button" class="pw-step is-active" data-step="1" role="tab" aria-selected="true"><span class="pw-n">۱</span><span class="pw-label">اطلاعات پایه</span><span class="pw-hint">عنوان و طبقه‌بندی</span></button>
        <button type="button" class="pw-step" data-step="2" role="tab" aria-selected="false"><span class="pw-n">۲</span><span class="pw-label">محتوا</span><span class="pw-hint">متن و رسانه</span></button>
        <button type="button" class="pw-step" data-step="3" role="tab" aria-selected="false"><span class="pw-n">۳</span><span class="pw-label">انتشار</span><span class="pw-hint">زمان و وضعیت</span></button>
        <button type="button" class="pw-step" data-step="4" role="tab" aria-selected="false"><span class="pw-n">۴</span><span class="pw-label">بازبینی</span><span class="pw-hint">تأیید و ذخیره</span></button>
    </div>

    <div class="pw-panel is-active" data-panel="1" role="tabpanel">
        <div class="pw-card">
            <h2><span class="dot"></span> اطلاعات پایه</h2>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label" asp-for="Title">عنوان <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" dir="auto" id="pwTitle" autocomplete="off" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="LanguageCode">زبان</label>
                    <select asp-for="LanguageCode" class="form-select">
                        <option value="fa">فارسی</option>
                        <option value="en">English</option>
                        <option value="ar">العربية</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Summary">خلاصه</label>
                    <div class="input-group">
                        <input asp-for="Summary" class="form-control" dir="auto" maxlength="400" id="summary-input" placeholder="یک یا دو جمله برای کارت پست…" />
                        <button type="button" class="btn btn-ghost" id="btn-ai-summarize" title="پیشنهاد خلاصه">AI</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="pw-card">
            <h2><span class="dot"></span> طبقه‌بندی از Taxonomy</h2>
            <p class="text-muted-dark small mb-3">پوشه، دسته، برچسب و سری را از همان موجودی‌های <a asp-controller="Taxonomy" asp-action="Index" asp-fragment="folders">Taxonomy</a> انتخاب کنید.</p>

            <div class="pw-tax">
                <div class="pw-tax-block">
                    <div class="pw-tax-block-head">
                        <h3 class="pw-tax-title">@T["tax.tab_folders"]</h3>
                        <a class="pw-tax-link" asp-controller="Taxonomy" asp-action="Index" asp-fragment="folders">مدیریت</a>
                    </div>
                    @if (Model.AvailableFolders.Count == 0)
                    {
                        <p class="pw-tax-empty">هنوز پوشه‌ای نیست. از Taxonomy بسازید.</p>
                    }
                    else
                    {
                        <div class="pw-tax-picks">
                            @foreach (var f in Model.AvailableFolders)
                            {
                                var on = selectedFolders.Contains(f.Id);
                                <label class="pw-tax-pick @(on ? "is-on" : null)">
                                    <input type="checkbox" name="FolderIds" value="@f.Id" @(on ? "checked" : null) />
                                    <span dir="auto">@f.Name</span>
                                </label>
                            }
                        </div>
                    }
                </div>

                <div class="pw-tax-block">
                    <div class="pw-tax-block-head">
                        <h3 class="pw-tax-title">@T["tax.tab_cats"]</h3>
                        <a class="pw-tax-link" asp-controller="Taxonomy" asp-action="Index" asp-fragment="cats">مدیریت</a>
                    </div>
                    <select asp-for="CategoryId" class="form-select form-select-sm pw-tax-select" id="pwCategory">
                        <option value="">— بدون دسته —</option>
                        @foreach (var c in Model.AvailableCategories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="pw-tax-block">
                    <div class="pw-tax-block-head">
                        <h3 class="pw-tax-title">@T["tax.tab_tags"]</h3>
                        <a class="pw-tax-link" asp-controller="Taxonomy" asp-action="Index" asp-fragment="tags">مدیریت</a>
                    </div>
                    <label class="form-label small" asp-for="TagsCsv">برچسب‌ها (کاما)</label>
                    <div class="input-group input-group-sm">
                        <input asp-for="TagsCsv" class="form-control ltr-field" id="tags-input" placeholder="tag1, tag2" list="existing-tags" />
                        <button type="button" class="btn btn-ghost" id="btn-ai-assist" title="پیشنهاد برچسب">AI</button>
                    </div>
                    @if (Model.AvailableTags.Count > 0)
                    {
                        <datalist id="existing-tags">
                            @foreach (var t in Model.AvailableTags)
                            {
                                <option value="@t.Name"></option>
                            }
                        </datalist>
                        <div class="pw-tax-picks mt-2" id="tagQuickPicks">
                            @foreach (var t in Model.AvailableTags.Take(24))
                            {
                                <button type="button" class="pw-tax-pick" data-tag="@t.Name">@t.Name</button>
                            }
                        </div>
                    }
                </div>

                <div class="pw-tax-block">
                    <div class="pw-tax-block-head">
                        <h3 class="pw-tax-title">@T["tax.tab_series"]</h3>
                        <a class="pw-tax-link" asp-controller="Taxonomy" asp-action="Index" asp-fragment="series">مدیریت</a>
                    </div>
                    <select asp-for="SeriesId" class="form-select form-select-sm pw-tax-select" id="pwSeries">
                        <option value="">— بدون سری —</option>
                        @foreach (var s in Model.AvailableSeries)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>

                <div class="pw-tax-block">
                    <div class="pw-tax-block-head">
                        <h3 class="pw-tax-title">@T["tax.tab_topics"]</h3>
                        <a class="pw-tax-link" asp-controller="Taxonomy" asp-action="Index" asp-fragment="topics">مدیریت</a>
                    </div>
                    <p class="pw-tax-hint mb-1">موضوع‌ها مجموعه‌های دسته/برچسب هستند و مستقیم به نوشته وصل نمی‌شوند. با انتخاب دسته و برچسب، نوشته در topicهای مرتبط دیده می‌شود.</p>
                    @if (Model.AvailableTopics.Count == 0)
                    {
                        <p class="pw-tax-empty">موضوعی تعریف نشده.</p>
                    }
                    else
                    {
                        <div class="pw-tax-picks">
                            @foreach (var t in Model.AvailableTopics)
                            {
                                <span class="pw-tax-pick" style="cursor:default;opacity:.85;" dir="auto">@t.Name</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="pw-nav">
            <a asp-controller="Admin" asp-action="Posts" class="btn btn-ghost">انصراف</a>
            <div class="pw-nav-right"><button type="button" class="btn btn-accent" data-pw-next>ادامه ←</button></div>
        </div>
    </div>

    <div class="pw-panel" data-panel="2" role="tabpanel">
        <div class="pw-card">
            <h2>
                <span class="dot"></span> محتوا
                <span class="text-muted-dark small fw-normal ms-1">· <span id="reading-time-display">@(Model.ReadingTimeMinutes > 0 ? Model.ReadingTimeMinutes : "—")</span> دقیقه</span>
                <span id="autosave-status" class="ltr-field"></span>
            </h2>
            <label class="form-label" asp-for="ContentMarkdown">متن <span class="text-danger">*</span></label>
            <div class="editor-shell mb-2">
                <div class="editor-toolbar">
                    <button type="button" data-md-action="h2">H2</button>
                    <button type="button" data-md-action="bold">B</button>
                    <button type="button" data-md-action="italic">I</button>
                    <button type="button" data-md-action="code-block">Code</button>
                    <button type="button" id="btn-ai-grammar">AI Grammar</button>
                    <button type="button" id="btn-editor-mode" class="btn-ghost">Rich text</button>
                    <button type="button" id="btn-autosave" class="btn-ghost">Save now</button>
                </div>
                <div class="row g-0">
                    <div class="col-lg-6">
                        <textarea id="markdown-input" asp-for="ContentMarkdown" class="form-control" dir="auto"
                                  data-preview-url="@Url.Action("PreviewMarkdown", "Posts")"
                                  data-upload-url="@Url.Action("Upload", "Media")"
                                  data-autosave-url="@Url.Action("AutoSave", "Posts")"
                                  data-post-id="@Model.Id"></textarea>
                        <div id="rich-editor" contenteditable="true" dir="auto" hidden></div>
                    </div>
                    <div class="col-lg-6">
                        <div id="preview-pane" class="readme-content editor-preview-pane" dir="auto"></div>
                    </div>
                </div>
            </div>
            <div id="ai-hints" class="alert mb-3 d-none" style="background:rgba(99,140,229,.1);border:1px solid rgba(99,140,229,.3);"></div>
            <div id="dropzone" class="upload-dropzone mb-2">تصویر یا ویدیو را اینجا رها کنید یا کلیک کنید</div>
            <input type="file" id="file-input" accept="image/*,video/*" class="d-none" />
            <span asp-validation-for="ContentMarkdown" class="text-danger small"></span>
        </div>
        <div class="pw-nav">
            <button type="button" class="btn btn-ghost" data-pw-prev>→ قبلی</button>
            <div class="pw-nav-right"><button type="button" class="btn btn-accent" data-pw-next>ادامه ←</button></div>
        </div>
    </div>

    <div class="pw-panel" data-panel="3" role="tabpanel">
        <div class="pw-card">
            <h2><span class="dot"></span> انتشار و نمایش</h2>
            <div class="pw-switch-grid mb-3">
                <div class="pw-switch">
                    <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="pwPub" />
                    <label asp-for="IsPublished">منتشر شود</label>
                </div>
                <div class="pw-switch">
                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                    <label asp-for="IsFeatured">نوشته ویژه</label>
                </div>
                <div class="pw-switch">
                    <input asp-for="IsSticky" class="form-check-input" type="checkbox" />
                    <label asp-for="IsSticky">چسبان در بالا</label>
                </div>
                <div class="pw-switch">
                    <input asp-for="IsPremium" class="form-check-input" type="checkbox" />
                    <label asp-for="IsPremium">@T["mon.field_premium"]</label>
                </div>
                <div class="pw-switch">
                    <input asp-for="IsSponsored" class="form-check-input" type="checkbox" />
                    <label asp-for="IsSponsored">@T["mon.field_sponsored"]</label>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="SponsoredLabel">@T["mon.field_sponsored_label"]</label>
                    <input asp-for="SponsoredLabel" class="form-control form-control-sm" dir="auto" maxlength="120" />
                </div>
                <div class="col-md-6"></div>
                @{
                    var schedIso = Model.ScheduledPublishAtUtc.HasValue
                        ? Model.ScheduledPublishAtUtc.Value.ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")
                        : null;
                    var expIso = Model.ExpiresAtUtc.HasValue
                        ? Model.ExpiresAtUtc.Value.ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")
                        : null;
                }
                <div class="col-md-6">
                    <label class="form-label" asp-for="ScheduledPublishAtUtc">انتشار زمان‌بندی‌شده</label>
                    <input asp-for="ScheduledPublishAtUtc" type="datetime-local" class="form-control ltr-field" data-utc-iso="@schedIso" />
                    <div class="form-text text-muted-dark">زمان محلی شما · هر ~۳۰ ثانیه توسط worker منتشر می‌شود</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="ExpiresAtUtc">انقضا</label>
                    <input asp-for="ExpiresAtUtc" type="datetime-local" class="form-control ltr-field" data-utc-iso="@expIso" />
                </div>
            </div>
        </div>

        @if (Model.Revisions?.Any() == true)
        {
            <div class="pw-card">
                <h2><span class="dot"></span> تاریخچه نسخه‌ها</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var r in Model.Revisions)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2" style="background:transparent;border-color:var(--border);">
                            <span>
                                <strong dir="auto">@r.Title</strong>
                                <small class="text-muted ltr-field">@r.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</small>
                                @if (!string.IsNullOrEmpty(r.Note))
                                {
                                    <span class="badge bg-secondary">@r.Note</span>
                                }
                            </span>
                            <span class="d-flex gap-1">
                                <a class="btn btn-sm btn-ghost" asp-action="Revision" asp-route-postId="@Model.Id" asp-route-revisionId="@r.Id">View</a>
                                <form asp-action="RestoreRevision" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@Model.Id" />
                                    <input type="hidden" name="revisionId" value="@r.Id" />
                                    <button type="submit" class="btn btn-sm btn-ghost">Restore</button>
                                </form>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="pw-nav">
            <button type="button" class="btn btn-ghost" data-pw-prev>→ قبلی</button>
            <div class="pw-nav-right"><button type="button" class="btn btn-accent" data-pw-next>بازبینی ←</button></div>
        </div>
    </div>

    <div class="pw-panel" data-panel="4" role="tabpanel">
        <div class="pw-card">
            <h2><span class="dot"></span> بازبینی نهایی</h2>
            <p class="text-muted-dark small mb-3">قبل از ذخیره یک‌بار خلاصه را چک کنید.</p>
            <div class="pw-review" id="pwReview">
                <div class="pw-review-row"><span class="k">عنوان</span><span class="v" dir="auto" data-rv="title">—</span></div>
                <div class="pw-review-row"><span class="k">دسته</span><span class="v" data-rv="category">—</span></div>
                <div class="pw-review-row"><span class="k">پوشه‌ها</span><span class="v" data-rv="folders">—</span></div>
                <div class="pw-review-row"><span class="k">سری</span><span class="v" data-rv="series">—</span></div>
                <div class="pw-review-row"><span class="k">خلاصه</span><span class="v" dir="auto" data-rv="summary">—</span></div>
                <div class="pw-review-row"><span class="k">برچسب‌ها</span><span class="v ltr-field" data-rv="tags">—</span></div>
                <div class="pw-review-row"><span class="k">حجم محتوا</span><span class="v ltr-field" data-rv="chars">—</span></div>
                <div class="pw-review-row"><span class="k">وضعیت</span><span class="v" data-rv="status">—</span></div>
            </div>
        </div>
        <div class="pw-nav">
            <button type="button" class="btn btn-ghost" data-pw-prev>→ قبلی</button>
            <div class="pw-nav-right">
                @if (Model.Id > 0)
                {
                    <button type="submit" formaction="@Url.Action("Duplicate")" formmethod="post" class="btn btn-ghost" name="id" value="@Model.Id">کپی</button>
                }
                <button type="submit" class="btn btn-accent" id="pwSubmit">ذخیره نوشته</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
  var root = document.getElementById('postWizard');
  if (!root) return;
  var total = 4, step = 1;
  var bar = document.getElementById('pwProgressBar');
  var panels = root.querySelectorAll('[data-panel]');
  var tabs = root.querySelectorAll('.pw-step');

  root.querySelectorAll('.pw-tax-pick input[type="checkbox"]').forEach(function (cb) {
    cb.addEventListener('change', function () {
      cb.closest('.pw-tax-pick').classList.toggle('is-on', cb.checked);
    });
  });

  var tagInput = document.getElementById('tags-input');
  var quick = document.getElementById('tagQuickPicks');
  if (tagInput && quick) {
    quick.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-tag]');
      if (!btn) return;
      var name = btn.getAttribute('data-tag');
      var parts = (tagInput.value || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      if (parts.some(function (p) { return p.toLowerCase() === name.toLowerCase(); })) return;
      parts.push(name);
      tagInput.value = parts.join(', ');
      btn.classList.add('is-on');
    });
  }

  function show(n) {
    step = Math.max(1, Math.min(total, n));
    panels.forEach(function (p) { p.classList.toggle('is-active', Number(p.getAttribute('data-panel')) === step); });
    tabs.forEach(function (t) {
      var s = Number(t.getAttribute('data-step'));
      t.classList.toggle('is-active', s === step);
      t.classList.toggle('is-done', s < step);
      t.setAttribute('aria-selected', s === step ? 'true' : 'false');
    });
    if (bar) bar.style.width = (step / total * 100) + '%';
    if (step === 4) fillReview();
  }
  function validate(n) {
    if (n === 1) {
      var title = document.getElementById('pwTitle');
      if (!title || !title.value.trim()) { title && title.classList.add('pw-error'); title && title.focus(); return false; }
      title.classList.remove('pw-error'); return true;
    }
    if (n === 2) {
      var md = document.getElementById('markdown-input');
      if (!md || !md.value.trim()) { md && md.classList.add('pw-error'); md && md.focus(); return false; }
      md.classList.remove('pw-error'); return true;
    }
    return true;
  }
  function fillReview() {
    var title = (document.getElementById('pwTitle') || {}).value || '—';
    var cat = document.getElementById('pwCategory');
    var catText = cat && cat.selectedIndex > 0 ? cat.options[cat.selectedIndex].text : '—';
    var series = document.getElementById('pwSeries');
    var seriesText = series && series.selectedIndex > 0 ? series.options[series.selectedIndex].text : '—';
    var folders = Array.prototype.map.call(root.querySelectorAll('.pw-tax-pick input[name="FolderIds"]:checked'), function (el) {
      return el.closest('.pw-tax-pick').querySelector('span').textContent.trim();
    }).join('، ') || '—';
    var summary = (document.getElementById('summary-input') || {}).value || '—';
    var tags = (document.getElementById('tags-input') || {}).value || '—';
    var md = (document.getElementById('markdown-input') || {}).value || '';
    var pub = document.getElementById('pwPub');
    var status = pub && pub.checked ? 'منتشر' : 'پیش‌نویس';
    setRv('title', title); setRv('category', catText); setRv('folders', folders); setRv('series', seriesText);
    setRv('summary', summary.trim() || '—');
    setRv('tags', tags.trim() || '—'); setRv('chars', md.trim().length + ' نویسه'); setRv('status', status);
  }
  function setRv(key, val) { var el = root.querySelector('[data-rv="' + key + '"]'); if (el) el.textContent = val; }
  root.querySelectorAll('[data-pw-next]').forEach(function (btn) { btn.addEventListener('click', function () { if (!validate(step)) return; show(step + 1); }); });
  root.querySelectorAll('[data-pw-prev]').forEach(function (btn) { btn.addEventListener('click', function () { show(step - 1); }); });
  tabs.forEach(function (t) {
    t.addEventListener('click', function () {
      var target = Number(t.getAttribute('data-step'));
      if (target < step) { show(target); return; }
      for (var i = 1; i < target; i++) { if (!validate(i)) { show(i); return; } }
      show(target);
    });
  });
  show(1);
})();
</script>
