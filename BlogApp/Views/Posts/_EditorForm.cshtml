@model PostEditViewModel
@inject BlogApp.Services.IUiTranslator T

<style>
.pw {
  max-width: 960px;
}
.pw-steps {
  display: flex;
  gap: .35rem;
  margin-bottom: 1.25rem;
  padding: .35rem;
  border-radius: 14px;
  background: var(--surface);
  border: 1px solid var(--border-soft);
  overflow-x: auto;
}
.pw-step {
  flex: 1 1 0;
  min-width: 7.5rem;
  border: 0;
  background: transparent;
  color: var(--text-muted);
  border-radius: 10px;
  padding: .65rem .7rem;
  text-align: start;
  cursor: pointer;
  transition: background .15s, color .15s, box-shadow .15s;
}
.pw-step:hover { color: var(--text); background: color-mix(in srgb, var(--accent) 6%, transparent); }
.pw-step.is-active {
  color: var(--text);
  background: color-mix(in srgb, var(--accent) 14%, transparent);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
}
.pw-step.is-done { color: var(--text); }
.pw-step .pw-n {
  display: inline-flex; align-items: center; justify-content: center;
  width: 1.35rem; height: 1.35rem; border-radius: 50%;
  font-size: .72rem; font-weight: 700; margin-inline-end: .4rem;
  background: color-mix(in srgb, var(--text-muted) 18%, transparent);
  font-variant-numeric: tabular-nums;
}
.pw-step.is-active .pw-n,
.pw-step.is-done .pw-n {
  background: var(--accent); color: #1a1a1a;
}
.pw-step .pw-label { font-size: .8rem; font-weight: 650; display: block; line-height: 1.25; }
.pw-step .pw-hint { font-size: .68rem; opacity: .75; display: block; margin-top: .15rem; }
.pw-panel { display: none; animation: pwIn .2s ease; }
.pw-panel.is-active { display: block; }
@@keyframes pwIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
.pw-card {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: 14px;
  padding: 1.15rem 1.25rem;
  margin-bottom: 1rem;
}
.pw-card h2 {
  font-size: .95rem; font-weight: 700; margin: 0 0 .85rem;
  display: flex; align-items: center; gap: .45rem;
}
.pw-card h2 .dot {
  width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
}
.pw-nav {
  display: flex; flex-wrap: wrap; gap: .5rem; justify-content: space-between; align-items: center;
  padding-top: .25rem;
}
.pw-nav-right { display: flex; flex-wrap: wrap; gap: .5rem; }
.pw-progress {
  height: 3px; border-radius: 999px; background: var(--border-soft); margin-bottom: 1rem; overflow: hidden;
}
.pw-progress > span {
  display: block; height: 100%; width: 25%; background: var(--accent);
  transition: width .25s ease;
}
.pw-switch-grid {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem 1rem;
}
@@media (max-width: 576px) { .pw-switch-grid { grid-template-columns: 1fr; } }
.pw-switch {
  display: flex; align-items: center; gap: .55rem;
  padding: .7rem .85rem; border-radius: 10px;
  border: 1px solid var(--border-soft);
  background: color-mix(in srgb, var(--bg, #000) 2%, var(--surface));
}
.pw-switch label { margin: 0; font-size: .88rem; cursor: pointer; }
.pw-review {
  display: grid; gap: .55rem;
  font-size: .86rem;
}
.pw-review-row {
  display: grid; grid-template-columns: 8rem 1fr; gap: .5rem;
  padding: .45rem 0; border-bottom: 1px solid var(--border-soft);
}
.pw-review-row .k { color: var(--text-muted); }
.pw-review-row .v { font-weight: 600; word-break: break-word; }
.pw-error {
  border-color: rgba(229,99,122,.55) !important;
  box-shadow: 0 0 0 2px rgba(229,99,122,.12);
}
.pw-step-error .pw-n { background: #e5637a !important; color: #fff !important; }
</style>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert mb-3" style="background:rgba(229,99,122,.12);color:var(--danger);border:1px solid rgba(229,99,122,.3);">
        <div asp-validation-summary="All"></div>
    </div>
}

<div class="pw" id="postWizard" data-start-step="1">
    <div class="pw-progress" aria-hidden="true"><span id="pwProgressBar"></span></div>

    <div class="pw-steps" role="tablist" aria-label="مراحل نوشتن">
        <button type="button" class="pw-step is-active" data-step="1" role="tab" aria-selected="true">
            <span class="pw-n">۱</span>
            <span class="pw-label">اطلاعات پایه</span>
            <span class="pw-hint">عنوان و دسته‌بندی</span>
        </button>
        <button type="button" class="pw-step" data-step="2" role="tab" aria-selected="false">
            <span class="pw-n">۲</span>
            <span class="pw-label">محتوا</span>
            <span class="pw-hint">متن و رسانه</span>
        </button>
        <button type="button" class="pw-step" data-step="3" role="tab" aria-selected="false">
            <span class="pw-n">۳</span>
            <span class="pw-label">انتشار</span>
            <span class="pw-hint">زمان و وضعیت</span>
        </button>
        <button type="button" class="pw-step" data-step="4" role="tab" aria-selected="false">
            <span class="pw-n">۴</span>
            <span class="pw-label">بازبینی</span>
            <span class="pw-hint">تأیید و ذخیره</span>
        </button>
    </div>

    <!-- Step 1: Basics -->
    <div class="pw-panel is-active" data-panel="1" role="tabpanel">
        <div class="pw-card">
            <h2><span class="dot"></span> اطلاعات پایه</h2>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label" asp-for="Title">عنوان <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" dir="auto" id="pwTitle" autocomplete="off" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="CategoryId">دسته‌بندی</label>
                    <select asp-for="CategoryId" class="form-select" id="pwCategory">
                        <option value="">— بدون دسته —</option>
                        @foreach (var c in Model.AvailableCategories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Summary">خلاصه</label>
                    <div class="input-group">
                        <input asp-for="Summary" class="form-control" dir="auto" maxlength="400" id="summary-input" placeholder="یک یا دو جمله برای کارت پست…" />
                        <button type="button" class="btn btn-ghost" id="btn-ai-summarize" title="پیشنهاد خلاصه">AI</button>
                    </div>
                </div>
                <div class="col-md-8">
                    <label class="form-label" asp-for="TagsCsv">برچسب‌ها</label>
                    <div class="input-group">
                        <input asp-for="TagsCsv" class="form-control ltr-field" id="tags-input" placeholder="tag1, tag2" />
                        <button type="button" class="btn btn-ghost" id="btn-ai-assist" title="پیشنهاد برچسب">AI</button>
                    </div>
                    <div class="form-text text-muted-dark">با کاما جدا کنید</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="LanguageCode">زبان</label>
                    <select asp-for="LanguageCode" class="form-select">
                        <option value="fa">فارسی</option>
                        <option value="en">English</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="pw-nav">
            <a asp-controller="Admin" asp-action="Posts" class="btn btn-ghost">انصراف</a>
            <div class="pw-nav-right">
                <button type="button" class="btn btn-accent" data-pw-next>ادامه ←</button>
            </div>
        </div>
    </div>

    <!-- Step 2: Content -->
    <div class="pw-panel" data-panel="2" role="tabpanel">
        <div class="pw-card">
            <h2><span class="dot"></span> محتوا <span class="text-muted-dark small fw-normal ms-1">· <span id="reading-time-display">@(Model.ReadingTimeMinutes > 0 ? Model.ReadingTimeMinutes : "—")</span> دقیقه مطالعه</span></h2>
            <label class="form-label" asp-for="ContentMarkdown">مارک‌داون <span class="text-danger">*</span></label>
            <div class="editor-shell mb-2">
                <div class="editor-toolbar">
                    <button type="button" data-md-action="h2">H2</button>
                    <button type="button" data-md-action="bold">B</button>
                    <button type="button" data-md-action="italic">I</button>
                    <button type="button" data-md-action="code-block">Code</button>
                    <button type="button" id="btn-ai-grammar">AI Grammar</button>
                    @if (Model.Id > 0)
                    {
                        <button type="button" id="btn-autosave" class="btn-ghost">ذخیره خودکار</button>
                    }
                </div>
                <div class="row g-0">
                    <div class="col-lg-6">
                        <textarea id="markdown-input" asp-for="ContentMarkdown" class="form-control" dir="auto"
                                  data-preview-url="@Url.Action("PreviewMarkdown", "Posts")"
                                  data-upload-url="@Url.Action("Upload", "Media")"
                                  data-autosave-url="@Url.Action("AutoSave", "Posts")"
                                  data-post-id="@Model.Id"></textarea>
                    </div>
                    <div class="col-lg-6">
                        <div id="preview-pane" class="readme-content editor-preview-pane" dir="auto"></div>
                    </div>
                </div>
            </div>
            <div id="ai-hints" class="alert mb-3 d-none" style="background:rgba(99,140,229,.1);border:1px solid rgba(99,140,229,.3);"></div>
            <div id="dropzone" class="upload-dropzone mb-2">تصویر یا ویدیو را اینجا رها کنید یا کلیک کنید</div>
            <input type="file" id="file-input" accept="image/*,video/*" class="d-none" />
            <span asp-validation-for="ContentMarkdown" class="text-danger small"></span>
        </div>
        <div class="pw-nav">
            <button type="button" class="btn btn-ghost" data-pw-prev>→ قبلی</button>
            <div class="pw-nav-right">
                <button type="button" class="btn btn-accent" data-pw-next>ادامه ←</button>
            </div>
        </div>
    </div>

    <!-- Step 3: Publishing -->
    <div class="pw-panel" data-panel="3" role="tabpanel">
        <div class="pw-card">
            <h2><span class="dot"></span> انتشار و نمایش</h2>
            <div class="pw-switch-grid mb-3">
                <div class="pw-switch">
                    <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="pwPub" />
                    <label asp-for="IsPublished">منتشر شود</label>
                </div>
                <div class="pw-switch">
                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                    <label asp-for="IsFeatured">نوشته ویژه</label>
                </div>
                <div class="pw-switch">
                    <input asp-for="IsSticky" class="form-check-input" type="checkbox" />
                    <label asp-for="IsSticky">چسبان در بالا</label>
                </div>
                <div class="pw-switch">
                    <input asp-for="IsPremium" class="form-check-input" type="checkbox" />
                    <label asp-for="IsPremium">@T["mon.field_premium"]</label>
                </div>
                <div class="pw-switch">
                    <input asp-for="IsSponsored" class="form-check-input" type="checkbox" />
                    <label asp-for="IsSponsored">@T["mon.field_sponsored"]</label>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="SponsoredLabel">@T["mon.field_sponsored_label"]</label>
                    <input asp-for="SponsoredLabel" class="form-control form-control-sm" dir="auto" maxlength="120" />
                </div>
                <div class="col-md-6"></div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="ScheduledPublishAtUtc">انتشار زمان‌بندی‌شده (UTC)</label>
                    <input asp-for="ScheduledPublishAtUtc" type="datetime-local" class="form-control ltr-field" />
                    <div class="form-text text-muted-dark">خالی = فوری پس از ذخیره در صورت انتشار</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="ExpiresAtUtc">انقضا (UTC)</label>
                    <input asp-for="ExpiresAtUtc" type="datetime-local" class="form-control ltr-field" />
                </div>
            </div>
        </div>

        @if (Model.Revisions?.Any() == true)
        {
            <div class="pw-card">
                <h2><span class="dot"></span> تاریخچه نسخه‌ها</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var r in Model.Revisions)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center" style="background:transparent;border-color:var(--border);">
                            <span>
                                <strong dir="auto">@r.Title</strong>
                                <small class="text-muted ltr-field">@r.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</small>
                                @if (!string.IsNullOrEmpty(r.Note))
                                {
                                    <span class="badge bg-secondary">@r.Note</span>
                                }
                            </span>
                            <form asp-action="RestoreRevision" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@Model.Id" />
                                <input type="hidden" name="revisionId" value="@r.Id" />
                                <button type="submit" class="btn btn-sm btn-ghost">بازگردانی</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="pw-nav">
            <button type="button" class="btn btn-ghost" data-pw-prev>→ قبلی</button>
            <div class="pw-nav-right">
                <button type="button" class="btn btn-accent" data-pw-next>بازبینی ←</button>
            </div>
        </div>
    </div>

    <!-- Step 4: Review -->
    <div class="pw-panel" data-panel="4" role="tabpanel">
        <div class="pw-card">
            <h2><span class="dot"></span> بازبینی نهایی</h2>
            <p class="text-muted-dark small mb-3">قبل از ذخیره یک‌بار خلاصه را چک کنید. می‌توانید به مراحل قبل برگردید.</p>
            <div class="pw-review" id="pwReview">
                <div class="pw-review-row"><span class="k">عنوان</span><span class="v" dir="auto" data-rv="title">—</span></div>
                <div class="pw-review-row"><span class="k">دسته</span><span class="v" data-rv="category">—</span></div>
                <div class="pw-review-row"><span class="k">خلاصه</span><span class="v" dir="auto" data-rv="summary">—</span></div>
                <div class="pw-review-row"><span class="k">برچسب‌ها</span><span class="v ltr-field" data-rv="tags">—</span></div>
                <div class="pw-review-row"><span class="k">حجم محتوا</span><span class="v ltr-field" data-rv="chars">—</span></div>
                <div class="pw-review-row"><span class="k">وضعیت</span><span class="v" data-rv="status">—</span></div>
            </div>
        </div>
        <div class="pw-nav">
            <button type="button" class="btn btn-ghost" data-pw-prev>→ قبلی</button>
            <div class="pw-nav-right">
                @if (Model.Id > 0)
                {
                    <button type="submit" formaction="@Url.Action("Duplicate")" formmethod="post" class="btn btn-ghost" name="id" value="@Model.Id">کپی</button>
                }
                <button type="submit" class="btn btn-accent" id="pwSubmit">ذخیره نوشته</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
  var root = document.getElementById('postWizard');
  if (!root) return;
  var total = 4;
  var step = 1;
  var bar = document.getElementById('pwProgressBar');
  var panels = root.querySelectorAll('[data-panel]');
  var tabs = root.querySelectorAll('.pw-step');

  function show(n) {
    step = Math.max(1, Math.min(total, n));
    panels.forEach(function (p) {
      p.classList.toggle('is-active', Number(p.getAttribute('data-panel')) === step);
    });
    tabs.forEach(function (t) {
      var s = Number(t.getAttribute('data-step'));
      t.classList.toggle('is-active', s === step);
      t.classList.toggle('is-done', s < step);
      t.setAttribute('aria-selected', s === step ? 'true' : 'false');
    });
    if (bar) bar.style.width = (step / total * 100) + '%';
    if (step === 4) fillReview();
    try { window.scrollTo({ top: root.offsetTop - 12, behavior: 'smooth' }); } catch (e) {}
  }

  function validate(n) {
    if (n === 1) {
      var title = document.getElementById('pwTitle');
      if (!title || !title.value.trim()) {
        title && title.classList.add('pw-error');
        title && title.focus();
        return false;
      }
      title.classList.remove('pw-error');
      return true;
    }
    if (n === 2) {
      var md = document.getElementById('markdown-input');
      if (!md || !md.value.trim()) {
        md && md.classList.add('pw-error');
        md && md.focus();
        return false;
      }
      md.classList.remove('pw-error');
      return true;
    }
    return true;
  }

  function fillReview() {
    var title = (document.getElementById('pwTitle') || {}).value || '—';
    var cat = document.getElementById('pwCategory');
    var catText = cat && cat.selectedIndex > 0 ? cat.options[cat.selectedIndex].text : '—';
    var summary = (document.getElementById('summary-input') || {}).value || '—';
    var tags = (document.getElementById('tags-input') || {}).value || '—';
    var md = (document.getElementById('markdown-input') || {}).value || '';
    var pub = document.getElementById('pwPub');
    var status = pub && pub.checked ? 'منتشر' : 'پیش‌نویس';
    setRv('title', title);
    setRv('category', catText);
    setRv('summary', summary.trim() || '—');
    setRv('tags', tags.trim() || '—');
    setRv('chars', md.trim().length + ' نویسه');
    setRv('status', status);
  }
  function setRv(key, val) {
    var el = root.querySelector('[data-rv="' + key + '"]');
    if (el) el.textContent = val;
  }

  root.querySelectorAll('[data-pw-next]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!validate(step)) return;
      show(step + 1);
    });
  });
  root.querySelectorAll('[data-pw-prev]').forEach(function (btn) {
    btn.addEventListener('click', function () { show(step - 1); });
  });
  tabs.forEach(function (t) {
    t.addEventListener('click', function () {
      var target = Number(t.getAttribute('data-step'));
      // allow going back freely; forward only if previous steps valid
      if (target < step) { show(target); return; }
      for (var i = 1; i < target; i++) {
        if (!validate(i)) { show(i); return; }
      }
      show(target);
    });
  });

  // If server validation failed, jump to first invalid step
  if (document.querySelector('.validation-summary-errors, .field-validation-error, .text-danger.field-validation-error')) {
    var titleErr = document.querySelector('[data-valmsg-for="Title"]');
    var contentErr = document.querySelector('[data-valmsg-for="ContentMarkdown"]');
    if (titleErr && titleErr.textContent.trim()) show(1);
    else if (contentErr && contentErr.textContent.trim()) show(2);
  }

  show(1);
})();
</script>
