@model PostEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "نوشته جدید";
    ViewData["NoIndex"] = true;
}

<div class="mb-3">
    <h1 class="h5 mb-1">نوشته جدید</h1>
    <p class="text-muted-dark small mb-0">در چهار مرحله: پایه → محتوا → انتشار → بازبینی</p>
</div>

@* data-native-submit: multi-step wizard must use full browser POST so ContentMarkdown is never dropped *@
<form asp-action="Create" method="post" id="postCreateForm" data-native-submit="true">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    @await Html.PartialAsync("_EditorForm", Model)
</form>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
}
