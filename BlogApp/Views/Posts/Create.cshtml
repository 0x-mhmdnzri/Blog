@model PostEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "نوشته جدید";
    ViewData["NoIndex"] = true;
}

<link rel="stylesheet" href="~/css/post-editor.css" asp-append-version="true" />

<div class="pe-page">
    <header class="pe-page-head">
        <h1 class="pe-page-title">نوشته جدید</h1>
        <p class="pe-page-sub">در چهار مرحله: پایه و طبقه‌بندی → محتوا → انتشار → بازبینی</p>
    </header>

    <form asp-action="Create" method="post" id="postCreateForm" data-native-submit="true" class="pe-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        @await Html.PartialAsync("_EditorForm", Model)
    </form>
</div>

@section Scripts {
    <script src="~/js/editor.js" asp-append-version="true"></script>
}
