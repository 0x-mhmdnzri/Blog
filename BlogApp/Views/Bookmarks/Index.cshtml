@model List<BlogApp.Controllers.BookmarkListItem>
@{
    ViewData["Title"] = "نشان‌های من";
}

<div class="container py-5" style="max-width:780px;">
    <h1 class="h4 mb-4">نشان‌های من</h1>

    @if (Model.Count == 0)
    {
        <div class="admin-empty card-surface p-4">
            <p class="mb-2">هنوز نوشته‌ای نشان نکرده‌اید.</p>
            <a class="btn btn-accent btn-sm" asp-controller="Home" asp-action="Index">مشاهده نوشته‌ها</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var b in Model)
            {
                <div class="card-surface p-3 d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        @if (b.IsPublished)
                        {
                            <a asp-controller="Posts" asp-action="Details" asp-route-slug="@b.Slug"
                               class="h6 text-decoration-none d-block mb-1" dir="auto">@b.Title</a>
                        }
                        else
                        {
                            <span class="h6 d-block mb-1 text-muted-dark" dir="auto">@b.Title (غیرفعال)</span>
                        }
                        @if (!string.IsNullOrEmpty(b.Summary))
                        {
                            <p class="mb-1 small text-muted-dark" dir="auto">@(b.Summary.Length > 140 ? b.Summary[..140] + "…" : b.Summary)</p>
                        }
                        <span class="ltr-field small" style="color:var(--text-faint);">@PersianDate.DateTime(b.SavedAtUtc)</span>
                    </div>
                    <form asp-action="Toggle" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@b.PostId" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />
                        <button type="submit" class="btn btn-ghost btn-sm">برداشتن نشان</button>
                    </form>
                </div>
            }
        </div>
    }
</div>
