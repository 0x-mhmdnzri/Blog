@model List<PostListItemViewModel>
@{
    ViewData["Title"] = "Posts";
    var categories = ViewBag.Categories as List<Category> ?? new();
}

@section Head {
    <script type="application/ld+json">@Html.Raw(ViewBag.WebsiteJsonLd)</script>
}

<section class="hero py-5">
    <div class="container">
        <div class="hero-prompt mb-2">$ cat ./posts --sort=recent</div>
        <h1 class="mb-3">Notes on building things.</h1>
        <p class="text-muted-dark" style="max-width:640px;">
            Long-form write-ups, stored the same way a README is written — Markdown in,
            styled HTML out, with code, images, and video embedded right in the text.
        </p>
    </div>
</section>

<div class="container py-5">
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="tag-pill @(ViewBag.CurrentCategory == null ? "border-0" : "")"
           style="@(ViewBag.CurrentCategory == null ? "background:var(--accent-soft);color:var(--accent);" : "")"
           asp-action="Index">All</a>
        @foreach (var c in categories)
        {
            <a class="tag-pill" style="@(ViewBag.CurrentCategory == c.Slug ? "background:var(--accent-soft);color:var(--accent);" : "")"
               asp-action="Index" asp-route-category="@c.Slug">@c.Name</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card-surface p-5 text-center text-muted-dark">
            <p class="mb-0 font-monospace">// no posts yet — the first one is waiting to be written.</p>
        </div>
    }

    <div class="row g-4">
        @foreach (var post in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="post-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        @if (post.CategoryName != null)
                        {
                            <div class="eyebrow">@post.CategoryName</div>
                        }
                        @if (!post.IsPublished)
                        {
                            <span class="tag-pill" style="color:var(--danger); border-color:rgba(229,99,122,.4);">Draft</span>
                        }
                    </div>
                    <h2 class="h5 mb-2">
                        <a asp-controller="Posts" asp-action="Details" asp-route-slug="@post.Slug">@post.Title</a>
                    </h2>
                    <p class="text-muted-dark small mb-3">@post.Summary</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-faint small" style="color:var(--text-faint); font-family:var(--font-mono); font-size:.78rem;">
                            @(post.PublishedAtUtc?.ToString("MMM d, yyyy"))
                        </span>
                        <div class="d-flex gap-1">
                            @foreach (var t in post.Tags.Take(2))
                            {
                                <span class="tag-pill">#@t</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <nav class="mt-5 d-flex justify-content-center gap-2">
            @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <a class="btn btn-ghost btn-sm @(p == (int)ViewBag.Page ? "border-accent" : "")"
                   style="@(p == (int)ViewBag.Page ? "border-color:var(--accent);color:var(--accent);" : "")"
                   asp-action="Index" asp-route-page="@p" asp-route-category="@ViewBag.CurrentCategory">@p</a>
            }
        </nav>
    }
</div>
