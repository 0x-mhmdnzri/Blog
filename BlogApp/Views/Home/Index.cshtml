@model List<PostListItemViewModel>
@inject BlogApp.Services.ICultureService Culture
@{
    var lang = Culture.CurrentCode;
    ViewData["Title"] = lang == "en" ? "Posts" : lang == "ar" ? "المقالات" : "نوشته‌ها";
    var categories = ViewBag.Categories as List<Category> ?? new();

    var heroTitle = lang switch
    {
        "en" => "Notes on building things.",
        "ar" => "ملاحظات حول بناء الأشياء.",
        _ => "یادداشت‌هایی درباره ساختن چیزها."
    };
    var heroBody = lang switch
    {
        "en" => "Long-form writing in the style of a README — Markdown in, polished output with code, images and video inline.",
        "ar" => "كتابات طويلة بأسلوب ملف README — ماركداون كمدخل، ومخرجات أنيقة مع الكود والصور والفيديو داخل النص.",
        _ => "نوشته‌های بلند، دقیقاً به همان سبکی که یک ریدمی نوشته می‌شود — مارک‌داون به‌عنوان ورودی، خروجی شیک و استایل‌دار، همراه با کد، تصویر و ویدیو دقیقاً درون متن."
    };
    var allLabel = lang switch { "en" => "All", "ar" => "الكل", _ => "همه" };
    var emptyLabel = lang switch
    {
        "en" => "No posts published yet — the first one is waiting to be written.",
        "ar" => "لا توجد مقالات منشورة بعد — المقالة الأولى في انتظار الكتابة.",
        _ => "هنوز نوشته‌ای منتشر نشده — اولین نوشته منتظر نوشته‌شدن است."
    };
    var draftLabel = lang switch { "en" => "Draft", "ar" => "مسودة", _ => "پیش‌نویس" };
}

@section Head {
    <script type="application/ld+json">@Html.Raw(ViewBag.WebsiteJsonLd)</script>
}

<section class="hero py-5">
    <div class="container">
        <div class="hero-prompt mb-2">$ cat ./posts --sort=recent</div>
        <h1 class="mb-3" dir="auto">@heroTitle</h1>
        <p class="text-muted-dark" style="max-width:640px;" dir="auto">@heroBody</p>
    </div>
</section>

<div class="container py-5">
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="tag-pill @(ViewBag.CurrentCategory == null ? "border-0" : "")"
           style="@(ViewBag.CurrentCategory == null ? "background:var(--accent-soft);color:var(--accent);" : "")"
           asp-action="Index">@allLabel</a>
        @foreach (var c in categories)
        {
            <a class="tag-pill" dir="auto" style="@(ViewBag.CurrentCategory == c.Slug ? "background:var(--accent-soft);color:var(--accent);" : "")"
               asp-action="Index" asp-route-category="@c.Slug">@c.Name</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card-surface p-5 text-center text-muted-dark">
            <p class="mb-0" dir="auto">@emptyLabel</p>
        </div>
    }

    <div class="row g-4">
        @foreach (var post in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="post-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        @if (post.CategoryName != null)
                        {
                            <div class="eyebrow" dir="auto">@post.CategoryName</div>
                        }
                        @if (!post.IsPublished)
                        {
                            <span class="tag-pill" style="color:var(--danger); border-color:rgba(229,99,122,.4);">@draftLabel</span>
                        }
                    </div>
                    <h2 class="h5 mb-2" dir="auto">
                        <a asp-controller="Posts" asp-action="Details" asp-route-slug="@post.Slug">@post.Title</a>
                    </h2>
                    <p class="text-muted-dark small mb-3" dir="auto">@post.Summary</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="ltr-field small" style="color:var(--text-faint); font-size:.78rem;">
                            @PersianDate.Date(post.PublishedAtUtc)
                        </span>
                        <div class="d-flex gap-1">
                            @foreach (var t in post.Tags.Take(2))
                            {
                                <span class="tag-pill" dir="auto">#@t</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <nav class="mt-5 d-flex justify-content-center gap-2">
            @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <a class="btn btn-ghost btn-sm ltr-field @(p == (int)ViewBag.Page ? "border-accent" : "")"
                   style="@(p == (int)ViewBag.Page ? "border-color:var(--accent);color:var(--accent);" : "")"
                   asp-action="Index" asp-route-page="@p" asp-route-category="@ViewBag.CurrentCategory">@p</a>
            }
        </nav>
    }
</div>
