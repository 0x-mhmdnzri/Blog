@model List<PostListItemViewModel>
@{
    ViewData["Title"] = T["home.title"];
    var categories = ViewBag.Categories as List<Category> ?? new();
    var currentPage = ViewBag.Page as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var sort = ViewBag.Sort as string;
    var featured = ViewBag.Featured as bool?;
    var minRead = ViewBag.MinRead as int?;
    var q = ViewBag.SearchQuery as string;
    var currentCategory = ViewBag.CurrentCategory as string;
    var folders = ViewBag.Folders as List<BlogApp.Controllers.BlogFeedFolderItem> ?? new();
    var currentFolderId = ViewBag.CurrentFolderId as int?;
    var currentFolder = ViewBag.CurrentFolder as BlogApp.Controllers.BlogFeedFolderItem;
    var isFeedOnly = !string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(currentCategory)
        || !string.IsNullOrEmpty(ViewBag.CurrentTag as string) || currentPage > 1
        || !string.IsNullOrEmpty(sort) || featured == true || minRead is > 0
        || currentFolderId is > 0;
}

@section Head {
    <link rel="stylesheet" href="~/css/site-marketing.css" asp-append-version="true" />
    @if (ViewBag.WebsiteJsonLd is string websiteLd && !string.IsNullOrEmpty(websiteLd))
    {
        <script type="application/ld+json">@Html.Raw(websiteLd)</script>
    }
    @if (ViewBag.CollectionJsonLd is string collectionLd && !string.IsNullOrEmpty(collectionLd))
    {
        <script type="application/ld+json">@Html.Raw(collectionLd)</script>
    }
}

@if (!isFeedOnly)
{
<section class="persona-hero">
    <div class="container">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-7">
                <div class="persona-kicker">@T["mkt.home.kicker"]</div>
                <h1 class="persona-title" dir="auto">@T["mkt.home.title"]</h1>
                <p class="persona-lead" dir="auto">@T["mkt.home.lead"]</p>
                <div class="persona-cta">
                    <a class="btn btn-accent" href="#blog-feed">@T["mkt.home.cta_blog"]</a>
                    <a class="btn btn-ghost" asp-controller="Pages" asp-action="About">@T["mkt.home.cta_about"]</a>
                    <a class="btn btn-ghost" asp-controller="Pages" asp-action="Contact">@T["mkt.home.cta_contact"]</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="persona-stats" aria-label="@T["mkt.home.stats_label"]">
                    <div class="persona-stat">
                        <div class="num ltr-field">6+</div>
                        <div class="lbl" dir="auto">@T["mkt.home.stat_years"]</div>
                    </div>
                    <div class="persona-stat">
                        <div class="num ltr-field">.NET 8</div>
                        <div class="lbl" dir="auto">@T["mkt.home.stat_stack"]</div>
                    </div>
                    <div class="persona-stat">
                        <div class="num ltr-field">DDD</div>
                        <div class="lbl" dir="auto">@T["mkt.home.stat_arch"]</div>
                    </div>
                    <div class="persona-stat">
                        <div class="num ltr-field">EDA</div>
                        <div class="lbl" dir="auto">@T["mkt.home.stat_msg"]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container persona-page pt-4 pb-0">
    <div class="persona-highlights">
        <div class="persona-highlight">
            <strong dir="auto"><a asp-controller="Pages" asp-action="Services">@T["mkt.home.hl_services_t"]</a></strong>
            <span dir="auto">@T["mkt.home.hl_services_d"]</span>
        </div>
        <div class="persona-highlight">
            <strong dir="auto"><a asp-controller="Pages" asp-action="Projects">@T["mkt.home.hl_projects_t"]</a></strong>
            <span dir="auto">@T["mkt.home.hl_projects_d"]</span>
        </div>
        <div class="persona-highlight">
            <strong dir="auto"><a href="#blog-feed">@T["mkt.home.hl_blog_t"]</a></strong>
            <span dir="auto">@T["mkt.home.hl_blog_d"]</span>
        </div>
        <div class="persona-highlight">
            <strong dir="auto"><a asp-controller="Pages" asp-action="Contact">@T["mkt.home.hl_contact_t"]</a></strong>
            <span dir="auto">@T["mkt.home.hl_contact_d"]</span>
        </div>
    </div>

    <h2 class="section-title" dir="auto">@T["mkt.home.skills_title"]</h2>
    <p class="section-sub" dir="auto">@T["mkt.home.skills_sub"]</p>
    <div class="skill-grid mb-1">
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">◇</div>
            <h3>@T["mkt.home.skill_arch_t"]</h3>
            <p>@T["mkt.home.skill_arch_b"]</p>
        </div>
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">▣</div>
            <h3>@T["mkt.home.skill_data_t"]</h3>
            <p>@T["mkt.home.skill_data_b"]</p>
        </div>
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">⇄</div>
            <h3>@T["mkt.home.skill_msg_t"]</h3>
            <p>@T["mkt.home.skill_msg_b"]</p>
        </div>
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">⬡</div>
            <h3>@T["mkt.home.skill_sec_t"]</h3>
            <p>@T["mkt.home.skill_sec_b"]</p>
        </div>
    </div>
</div>
}

<div class="container py-5" id="blog-feed">
    <div class="feed-head">
        <div>
            @if (currentFolder is not null)
            {
                <nav class="bf-crumb" aria-label="breadcrumb">
                    <a asp-action="Index" asp-route-q="@q" asp-route-sort="@sort" class="bf-crumb-link">@T["mkt.home.feed_title"]</a>
                    <span class="bf-crumb-sep" aria-hidden="true">/</span>
                    <span class="bf-crumb-current" dir="auto">@currentFolder.Name</span>
                </nav>
                <h2 class="section-title" dir="auto">@currentFolder.Name</h2>
                <p class="section-sub" dir="auto">@currentFolder.Count @T["tab.all"]</p>
            }
            else
            {
                <h2 class="section-title" dir="auto">@(isFeedOnly ? T["home.title"] : T["mkt.home.feed_title"])</h2>
                @if (!isFeedOnly)
                {
                    <p class="section-sub" dir="auto">@T["mkt.home.feed_sub"]</p>
                }
            }
        </div>
        @if (currentFolder is not null)
        {
            <a class="bf-back" asp-action="Index" asp-route-q="@q" asp-route-sort="@sort" asp-route-category="@currentCategory">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10.5 3.5 5 8l5.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>@T["home.all"]</span>
            </a>
        }
    </div>

    <form method="get" class="ux-filters" action="">
        @if (currentFolderId is int cf)
        {
            <input type="hidden" name="folderId" value="@cf" />
        }
        <input type="search" name="q" value="@q" placeholder="@T["mkt.home.search_ph"]" dir="auto" aria-label="@T["mkt.home.search_ph"]" />
        <select name="sort" aria-label="@T["btn.filter"]">
            <option value="">@T["mkt.home.sort_newest"]</option>
            @if (sort == "popular") { <option value="popular" selected>@T["mkt.home.sort_popular"]</option> } else { <option value="popular">@T["mkt.home.sort_popular"]</option> }
            @if (sort == "oldest") { <option value="oldest" selected>@T["mkt.home.sort_oldest"]</option> } else { <option value="oldest">@T["mkt.home.sort_oldest"]</option> }
            @if (sort == "read") { <option value="read" selected>@T["mkt.home.sort_read"]</option> } else { <option value="read">@T["mkt.home.sort_read"]</option> }
        </select>
        <label>
            <input type="checkbox" name="featured" value="true" @(featured == true ? "checked" : null) />
            @T["mkt.home.featured"]
        </label>
        <select name="minRead" aria-label="@T["mkt.home.min_any"]">
            <option value="">@T["mkt.home.min_any"]</option>
            @if (minRead == 3) { <option value="3" selected>@T["mkt.home.min_3"]</option> } else { <option value="3">@T["mkt.home.min_3"]</option> }
            @if (minRead == 5) { <option value="5" selected>@T["mkt.home.min_5"]</option> } else { <option value="5">@T["mkt.home.min_5"]</option> }
            @if (minRead == 10) { <option value="10" selected>@T["mkt.home.min_10"]</option> } else { <option value="10">@T["mkt.home.min_10"]</option> }
        </select>
        <button type="submit" class="btn btn-ghost btn-sm">@T["mkt.home.apply"]</button>
    </form>

    @if (currentFolder is null && folders.Count > 0 && string.IsNullOrEmpty(q) && string.IsNullOrEmpty(currentCategory))
    {
        <section class="bf-folders" aria-label="Folders">
            <div class="bf-section-label">Folders</div>
            <div class="bf-folder-grid">
                @foreach (var f in folders)
                {
                    <a class="bf-folder bf-folder--@f.Color"
                       asp-action="Index"
                       asp-route-folderId="@f.Id"
                       asp-route-sort="@sort"
                       asp-fragment="blog-feed">
                        <span class="bf-folder-icon" aria-hidden="true">
                            <svg viewBox="0 0 96 78" class="bf-folder-svg">
                                <path class="bf-folder-back" d="M6 16c0-5 4-9 9-9h18l8 8h40c5 0 9 4 9 9v44c0 5-4 9-9 9H15c-5 0-9-4-9-9V16z"/>
                                <path class="bf-folder-front" d="M6 28c0-3.5 2.8-6.5 6.5-6.5h71c3.7 0 6.5 3 6.5 6.5v35c0 3.5-2.8 6.5-6.5 6.5h-71C8.8 69.5 6 66.5 6 63V28z"/>
                            </svg>
                        </span>
                        <span class="bf-folder-name" dir="auto">@f.Name</span>
                        <span class="bf-folder-meta">@f.Count</span>
                    </a>
                }
            </div>
        </section>
    }

    @if (categories.Count > 0 && currentFolder is null)
    {
        <div class="cat-pills" role="navigation" aria-label="@T["mkt.home.cats_label"]">
            <a class="tag-pill @(string.IsNullOrEmpty(currentCategory) ? "is-active" : null)"
               asp-action="Index" asp-fragment="blog-feed">@T["home.all"]</a>
            @foreach (var c in categories)
            {
                <a class="tag-pill @(string.Equals(currentCategory, c.Slug, StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"
                   asp-action="Index" asp-route-category="@c.Slug" asp-fragment="blog-feed">@c.Name</a>
            }
        </div>
    }

    <section class="bf-posts" aria-label="Posts">
        @if (currentFolder is null && folders.Count > 0 && string.IsNullOrEmpty(q) && string.IsNullOrEmpty(currentCategory) && Model.Any())
        {
            <div class="bf-section-label">@T["mkt.home.feed_title"]</div>
        }

        @if (!Model.Any())
        {
            <div class="bf-empty card-surface">
                <p class="mb-0" dir="auto">@T["home.empty"]</p>
            </div>
        }
        else
        {
            <div class="row g-3 g-md-4" id="posts-grid" data-page="@currentPage" data-total-pages="@totalPages">
                <partial name="_PostCards" model="Model" />
            </div>
        }
    </section>

    <div id="infinite-sentinel"></div>
    <div id="infinite-status" class="infinite-status"></div>

    @if (totalPages > 1)
    {
        <noscript>
            <nav class="mt-5 d-flex justify-content-center gap-2">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <a class="btn btn-ghost btn-sm ltr-field" asp-action="Index" asp-route-page="@p"
                       asp-route-category="@ViewBag.CurrentCategory" asp-route-q="@q" asp-route-folderId="@currentFolderId">@p</a>
                }
            </nav>
        </noscript>
    }
</div>
