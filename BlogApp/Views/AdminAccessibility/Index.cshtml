@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["a11y.admin.title"];
}

<style>
.a11y-admin { max-width: 920px; }
.a11y-admin .lead {
  font-size: .88rem; color: var(--text-muted); line-height: 1.55; margin: 0 0 1.25rem;
}
.a11y-admin h2 {
  font-size: 1rem; font-weight: 700; margin: 1.5rem 0 .75rem;
}
.a11y-admin .checklist {
  list-style: none; padding: 0; margin: 0 0 1rem;
}
.a11y-admin .checklist li {
  padding: .55rem .85rem; margin-bottom: .4rem;
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: 10px; font-size: .85rem; line-height: 1.5;
}
.a11y-admin .checklist li strong { display: block; margin-bottom: .15rem; }
.a11y-admin .checklist .tag {
  display: inline-block; font-size: .68rem; font-weight: 650;
  padding: .1rem .45rem; border-radius: 999px; margin-inline-end: .35rem;
  background: color-mix(in srgb, var(--accent) 16%, transparent);
}
.a11y-summary {
  padding: .75rem 1rem; border-radius: 12px; margin-bottom: 1rem;
  background: color-mix(in srgb, var(--accent) 10%, var(--surface));
  border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border-soft));
  font-size: .9rem;
}
.a11y-admin .kbd {
  font-family: ui-monospace, monospace; font-size: .78rem;
  padding: .1rem .4rem; border-radius: 4px;
  border: 1px solid var(--border-soft); background: var(--surface-2, var(--surface));
  direction: ltr; display: inline-block;
}
</style>

<div class="a11y-admin">
    <p class="lead">@T["a11y.admin.lead"]</p>

    <h2>@T["a11y.admin.live_title"]</h2>
    <div class="a11y-summary" id="a11y-checker-summary">@T["a11y.admin.checking"]</div>
    <div class="a11y-check-grid" id="a11y-checker-results"></div>

    <h2>@T["a11y.admin.wcag_title"]</h2>
    <ul class="checklist">
        <li>
            <strong><span class="tag">1.1</span> @T["a11y.admin.wcag_11_title"]</strong>
            @T["a11y.admin.wcag_11_body"]
        </li>
        <li>
            <strong><span class="tag">1.3</span> @T["a11y.admin.wcag_13_title"]</strong>
            @T["a11y.admin.wcag_13_body"]
        </li>
        <li>
            <strong><span class="tag">1.4</span> @T["a11y.admin.wcag_14_title"]</strong>
            @T["a11y.admin.wcag_14_body"]
        </li>
        <li>
            <strong><span class="tag">2.1</span> @T["a11y.admin.wcag_21_title"]</strong>
            @T["a11y.admin.wcag_21_body"]
        </li>
        <li>
            <strong><span class="tag">2.4</span> @T["a11y.admin.wcag_24_title"]</strong>
            @T["a11y.admin.wcag_24_body"]
        </li>
        <li>
            <strong><span class="tag">4.1</span> @T["a11y.admin.wcag_41_title"]</strong>
            @T["a11y.admin.wcag_41_body"]
        </li>
    </ul>

    <h2>@T["a11y.admin.kb_title"]</h2>
    <ul class="checklist">
        <li>@T["a11y.admin.kb_tab"]</li>
        <li>@T["a11y.admin.kb_skip"]</li>
        <li>@T["a11y.admin.kb_search"]</li>
        <li>@T["a11y.admin.kb_panel"]</li>
        <li>@T["a11y.admin.kb_arrows"]</li>
    </ul>

    <h2>@T["a11y.admin.sr_title"]</h2>
    <ul class="checklist">
        <li>@T["a11y.admin.sr_1"]</li>
        <li>@T["a11y.admin.sr_2"]</li>
        <li>@T["a11y.admin.sr_3"]</li>
        <li>@T["a11y.admin.sr_4"]</li>
    </ul>

    <h2>@T["a11y.admin.hc_title"]</h2>
    <ul class="checklist">
        <li>@T["a11y.admin.hc_1"]</li>
        <li>@T["a11y.admin.hc_2"]</li>
    </ul>

    <p class="small text-muted-dark mt-4 mb-0">@T["a11y.admin.footer"]</p>
</div>

@section Scripts {
<script>
  window.__a11yAdminI18n = {
    pass: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["a11y.admin.pass"].ToString())),
    warn: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["a11y.admin.warn"].ToString())),
    fail: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["a11y.admin.fail"].ToString())),
    summary: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["a11y.admin.summary"].ToString()))
  };
  document.addEventListener('DOMContentLoaded', function () {
    if (window.blogA11y && !document.getElementById('a11y-checker-results').children.length) {
      var results = window.blogA11y.runChecker();
      var host = document.getElementById('a11y-checker-results');
      var summary = document.getElementById('a11y-checker-summary');
      var pass = results.filter(function (r) { return r.level === 'pass'; }).length;
      var fail = results.filter(function (r) { return r.level === 'fail'; }).length;
      var warn = results.filter(function (r) { return r.level === 'warn'; }).length;
      var i18n = window.__a11yAdminI18n || {};
      if (summary) {
        var tpl = i18n.summary || '{0} · {1} · {2}';
        summary.innerHTML = tpl
          .replace('{0}', '<strong class="ltr-field">' + pass + '</strong>')
          .replace('{1}', '<strong class="ltr-field">' + warn + '</strong>')
          .replace('{2}', '<strong class="ltr-field">' + fail + '</strong>');
      }
      host.innerHTML = results.map(function (r) {
        var label = r.level === 'pass' ? (i18n.pass || 'pass')
          : r.level === 'fail' ? (i18n.fail || 'fail')
          : (i18n.warn || 'warn');
        return '<article class="a11y-check-item">' +
          '<span class="status ' + r.level + '">' + label + '</span>' +
          '<div><h3>' + r.title + '</h3><p>' + r.detail + '</p></div></article>';
      }).join('');
    }
  });
</script>
}
