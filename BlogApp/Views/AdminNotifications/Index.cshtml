@model BlogApp.Controllers.ComposeNotificationVm
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["notif.admin_title"];
    var isSuper = ViewBag.IsSuperAdmin as bool? ?? false;
    var recent = ViewBag.Recent as List<NotificationCampaign> ?? new();
    var categories = ViewBag.Categories as List<Category> ?? new();
}

@if (TempData["Saved"] != null)
{
    <div class="card-surface p-3 mb-3 small text-muted-dark">@T["msg.saved"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="card-surface p-3 mb-3 small" style="border-color:var(--danger);">@TempData["Error"]</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <form method="post" asp-action="Compose" class="card-surface p-4">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label" asp-for="Title">@T["notif.form_title"]</label>
                <input class="form-control" asp-for="Title" dir="auto" required />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Body">@T["notif.form_body"]</label>
                <textarea class="form-control" asp-for="Body" rows="3" dir="auto"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="LinkUrl">@T["notif.form_link"]</label>
                <input class="form-control ltr-field" asp-for="LinkUrl" placeholder="/post/slug" />
            </div>

            @if (isSuper)
            {
                <div class="mb-3">
                    <label class="form-label" asp-for="Audience">@T["notif.form_audience"]</label>
                    <select class="form-select" asp-for="Audience">
                        <option value="@((int)NotificationAudience.AllAuthors)">@T["notif.aud_authors"]</option>
                        <option value="@((int)NotificationAudience.Broadcast)">@T["notif.aud_broadcast"]</option>
                        <option value="@((int)NotificationAudience.CategoryReaders)">@T["notif.aud_category"]</option>
                        <option value="@((int)NotificationAudience.AuthorFollowers)">@T["notif.aud_followers"]</option>
                        <option value="@((int)NotificationAudience.SingleUser)">@T["notif.aud_single"]</option>
                        <option value="@((int)NotificationAudience.UserList)">@T["notif.aud_list"]</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Kind">@T["notif.form_kind"]</label>
                    <select class="form-select" asp-for="Kind">
                        <option value="@((int)NotificationKind.AdminMessage)">@T["notif.kind_admin"]</option>
                        <option value="@((int)NotificationKind.Broadcast)">@T["notif.kind_broadcast"]</option>
                        <option value="@((int)NotificationKind.CategoryBatch)">@T["notif.kind_category"]</option>
                        <option value="@((int)NotificationKind.System)">@T["notif.kind_system"]</option>
                        <option value="@((int)NotificationKind.AdCampaign)">@T["notif.kind_ad"]</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="CategoryId">@T["notif.form_category"]</label>
                    <select class="form-select" asp-for="CategoryId">
                        <option value="">@T["msg.dash"]</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="TargetUserId">@T["notif.form_target_user"]</label>
                    <input class="form-control ltr-field" asp-for="TargetUserId" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="TargetUserIdsCsv">@T["notif.form_target_csv"]</label>
                    <input class="form-control ltr-field" asp-for="TargetUserIdsCsv" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="AuthorUserId">@T["notif.form_author"]</label>
                    <input class="form-control ltr-field" asp-for="AuthorUserId" />
                </div>
            }
            else
            {
                <p class="small text-muted-dark">@T["notif.author_help"]</p>
                <input type="hidden" asp-for="Audience" value="@((int)NotificationAudience.AuthorFollowers)" />
                <input type="hidden" asp-for="Kind" value="@((int)NotificationKind.NewPost)" />
            }

            <div class="form-check mb-2">
                <input class="form-check-input" asp-for="Schedule" id="scheduleToggle" />
                <label class="form-check-label" asp-for="Schedule">@T["notif.form_schedule"]</label>
            </div>
            <div class="mb-4" id="scheduleBox">
                <label class="form-label" asp-for="ScheduledAtUtc">@T["notif.form_scheduled_at"]</label>
                <input class="form-control ltr-field" asp-for="ScheduledAtUtc" type="datetime-local" />
            </div>

            <button type="submit" class="btn btn-accent">@T["notif.form_send"]</button>
        </form>
    </div>

    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-3">@T["notif.recent_campaigns"]</h2>
        @if (recent.Count == 0)
        {
            <div class="admin-empty"><p>@T["notif.no_campaigns"]</p></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>@T["col.title"]</th>
                            <th>@T["notif.form_audience"]</th>
                            <th>@T["col.status"]</th>
                            <th>@T["notif.col_recipients"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in recent)
                    {
                        <tr>
                            <td dir="auto">@c.Title</td>
                            <td class="small ltr-field">@c.Audience</td>
                            <td>
                                @if (c.IsSent)
                                {
                                    <span class="status-pill approved">@T["notif.status_sent"]</span>
                                }
                                else
                                {
                                    <span class="status-pill pending">@T["status.scheduled"]</span>
                                }
                            </td>
                            <td class="ltr-field">@c.RecipientCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
