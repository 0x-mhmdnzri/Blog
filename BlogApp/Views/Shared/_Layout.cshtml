@inject BlogApp.Services.SeoService Seo
@inject BlogApp.Services.ISiteConfigService SiteConfig
@inject BlogApp.Services.ICultureService Culture
@inject BlogApp.Services.IUiTranslator T
@using BlogApp.Models
@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = pageTitle != null ? $"{pageTitle} · {Seo.SiteName}" : $"{Seo.SiteName} — {Seo.SiteDescription}";
    var description = ViewData["Description"] as string ?? Seo.SiteDescription;
    var keywords = ViewData["Keywords"] as string;
    var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var canonicalUrl = ViewData["Canonical"] as string ?? currentUrl;
    var ogType = ViewData["OgType"] as string ?? "website";
    var ogImage = ViewData["OgImage"] as string;
    var ogImageAlt = ViewData["OgImageAlt"] as string ?? pageTitle ?? Seo.SiteName;
    var noIndex = ViewData["NoIndex"] as bool? ?? false;
    var pageAuthor = ViewData["Author"] as string ?? Seo.AuthorName;
    var articlePublished = ViewData["ArticlePublished"] as string;
    var articleModified = ViewData["ArticleModified"] as string;
    var articleSection = ViewData["ArticleSection"] as string;
    var articleTags = ViewData["ArticleTags"] as string[] ?? Array.Empty<string>();
    var isStaff = User.IsInRole(AppRoles.Author) || User.IsInRole(AppRoles.SuperAdmin);
    var isReader = User.IsInRole(AppRoles.Reader) || isStaff;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name;

    var culture = Culture.Current;
    var lang = culture.Code;
    var dir = culture.Direction;
    var locale = culture.Locale;

    var hreflang = ViewBag.HreflangLinks as IEnumerable<dynamic>;

    var robotsContent = noIndex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    var act = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
    var path = Context.Request.Path.Value ?? "";

    string NavActive(string c, string? a = null)
    {
        if (!string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase)) return "";
        if (a != null && !string.Equals(act, a, StringComparison.OrdinalIgnoreCase)) return "";
        return "active";
    }

    var homeActive = (ctrl == "home" && act == "index") || path.TrimEnd('/').Equals($"/{lang}", StringComparison.OrdinalIgnoreCase) || path == "/" || path == $"/{lang}/";
    var blogActive = path.Contains("/post/", StringComparison.OrdinalIgnoreCase)
                     || (ctrl == "home" && act == "index" && Context.Request.Query.ContainsKey("tag"));
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir" data-bs-theme="dark" data-theme="dark" data-culture="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <meta name="description" content="@description" />
    @if (!string.IsNullOrWhiteSpace(keywords))
    {
        <meta name="keywords" content="@keywords" />
    }
    <meta name="author" content="@pageAuthor" />
    <meta name="robots" content="@robotsContent" />
    <meta name="googlebot" content="@robotsContent" />
    <meta name="bingbot" content="@robotsContent" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta name="theme-color" content="#0b0e14" id="meta-theme-color" />
    <meta name="color-scheme" content="dark light" />
    <link rel="alternate" type="application/rss+xml" title="@Seo.SiteName RSS" href="/feed.xml" />

    @if (hreflang != null)
    {
        foreach (var h in hreflang)
        {
            <link rel="alternate" hreflang="@h.Lang" href="@h.Href" />
        }
        <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    }

    <meta property="og:site_name" content="@Seo.SiteName" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@(pageTitle ?? Seo.SiteName)" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="@locale" />
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
        <meta property="og:image:secure_url" content="@ogImage" />
        <meta property="og:image:alt" content="@ogImageAlt" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
    }
    @if (string.Equals(ogType, "article", StringComparison.OrdinalIgnoreCase))
    {
        if (!string.IsNullOrEmpty(articlePublished))
        {
            <meta property="article:published_time" content="@articlePublished" />
        }
        if (!string.IsNullOrEmpty(articleModified))
        {
            <meta property="article:modified_time" content="@articleModified" />
        }
        if (!string.IsNullOrWhiteSpace(pageAuthor))
        {
            <meta property="article:author" content="@pageAuthor" />
        }
        if (!string.IsNullOrWhiteSpace(articleSection))
        {
            <meta property="article:section" content="@articleSection" />
        }
        foreach (var tag in articleTags)
        {
            <meta property="article:tag" content="@tag" />
        }
    }

    <meta name="twitter:card" content="@(string.IsNullOrEmpty(ogImage) ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@(pageTitle ?? Seo.SiteName)" />
    <meta name="twitter:description" content="@description" />
    @if (!string.IsNullOrEmpty(Seo.TwitterHandle))
    {
        <meta name="twitter:site" content="@Seo.TwitterHandle" />
        <meta name="twitter:creator" content="@Seo.TwitterHandle" />
    }
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta name="twitter:image" content="@ogImage" />
        <meta name="twitter:image:alt" content="@ogImageAlt" />
    }

    @if (ViewBag.WebsiteJsonLd is string websiteLd && !string.IsNullOrWhiteSpace(websiteLd))
    {
        <script type="application/ld+json">@Html.Raw(websiteLd)</script>
    }
    @if (ViewBag.PersonJsonLd is string personLd && !string.IsNullOrWhiteSpace(personLd))
    {
        <script type="application/ld+json">@Html.Raw(personLd)</script>
    }

    <script>
        (function () {
            try {
                var fs = localStorage.getItem('blog-font-scale');
                if (fs) document.documentElement.style.setProperty('--reader-font-scale', fs);
                var ap = JSON.parse(localStorage.getItem('blog-a11y-prefs') || '{}');
                if (ap.contrast === 'high') document.documentElement.setAttribute('data-a11y-contrast', 'high');
                if (ap.motion === 'reduce') document.documentElement.setAttribute('data-a11y-motion', 'reduce');
                if (ap.underline === 'on') document.documentElement.setAttribute('data-a11y-underline', 'on');
                if (ap.text === 'large' || ap.text === 'xlarge') document.documentElement.setAttribute('data-a11y-text', ap.text);
            } catch (e) {}
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="@culture.BootstrapCss" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="/Themes/ActiveCss" />
    <link rel="stylesheet" href="~/css/theme-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cms-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media-blur.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications-bell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toastify-stack.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ux.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/a11y.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/persona.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer-hubs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search-spotlight.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/datepicker.css" asp-append-version="true" />
    <style>
        .lang-switcher .dropdown-menu { background: var(--surface, #12161f); border: 1px solid var(--border-soft, #1e2430); }
        .lang-switcher .dropdown-item { color: var(--text, #e8ecf4); font-size: .9rem; }
        .lang-switcher .dropdown-item:hover,
        .lang-switcher .dropdown-item.active { background: rgba(111,179,210,.15); color: #fff; }
    </style>

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <ul class="skip-links">
        <li><a class="skip-link" href="#main-content">@T["a11y.skip_content"]</a></li>
        <li><a class="skip-link" href="#site-footer">@T["a11y.skip_footer"]</a></li>
    </ul>
    <div id="reading-progress" class="reading-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="@T["a11y.reading_progress"]"></div>

    @await Component.InvokeAsync("SiteAnnounce")

    <header class="site-header" id="site-header" role="banner">
        <nav class="site-nav-bar" aria-label="@T["nav.main"]">
            <a class="brand" href="/@lang/" title="@T["nav.home"]">
                <span class="brand-cursor" aria-hidden="true"></span>
                <span class="ltr-signature">m.nazari</span>
            </a>

            <ul class="site-nav-primary">
                <li><a class="site-nav-link @(homeActive ? "active" : "")" href="/@lang/" aria-current="@(homeActive ? "page" : null)">@T["nav.home"]</a></li>
                <li><a class="site-nav-link @NavActive("pages", "about")" asp-controller="Pages" asp-action="About">@T["nav.about"]</a></li>
                <li><a class="site-nav-link @NavActive("pages", "services")" asp-controller="Pages" asp-action="Services">@T["nav.services"]</a></li>
                <li><a class="site-nav-link @NavActive("pages", "projects")" asp-controller="Pages" asp-action="Projects">@T["nav.projects"]</a></li>
                <li><a class="site-nav-link @(blogActive && !homeActive ? "active" : "")" href="/@lang/#blog-feed">@T["nav.blog"]</a></li>
                <li><a class="site-nav-link @NavActive("pages", "contact")" asp-controller="Pages" asp-action="Contact">@T["nav.contact"]</a></li>
            </ul>

            <div class="site-nav-utils">
                <button type="button" class="btn-nav-icon" data-search-open title="@T["search.aria"] (Ctrl+K)" aria-label="@T["search.aria"]">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                    <span class="nav-icon-label">@T["search.aria"]</span>
                </button>
                <partial name="_ThemePicker" />
                <div class="d-none d-lg-block">
                    <partial name="_LanguageSwitcher" />
                </div>
                @if (isAuth)
                {
                    <div class="nav-account-desktop">
                        <partial name="_NotificationBell" />
                    </div>
                }
                <div class="nav-account-desktop">
                    @if (isAuth)
                    {
                        <div class="dropdown">
                            <button class="btn-account dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false"
                                    id="accountMenuBtn" aria-label="@T["nav.account"]">
                                <span class="account-avatar" aria-hidden="true">@(string.IsNullOrEmpty(userName) ? "?" : char.ToUpperInvariant(userName[0]))</span>
                                <span class="d-none d-xl-inline account-name ltr-field">@(userName ?? T["nav.account"])</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end account-menu" aria-labelledby="accountMenuBtn">
                                @if (!string.IsNullOrEmpty(userName))
                                {
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="PublicProfile" asp-route-userName="@userName">@T["nav.public_profile"]</a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">@T["nav.account_settings"]</a></li>
                                <li><a class="dropdown-item" asp-controller="AccountApiKeys" asp-action="Index">@T["nav.api_keys"]</a></li>
                                <li><a class="dropdown-item" asp-controller="Themes" asp-action="Index">@T["nav.themes"]</a></li>
                                @if (isReader)
                                {
                                    <li><a class="dropdown-item" asp-controller="Bookmarks" asp-action="Index">@T["nav.bookmarks"]</a></li>
                                    <li><a class="dropdown-item" asp-controller="Feed" asp-action="Index">@T["nav.activity_feed"]</a></li>
                                }
                                @if (isStaff)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">@T["nav.admin"]</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-sm w-100">@T["nav.logout"]</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn-nav-login" asp-controller="Account" asp-action="Login">@T["nav.login"]</a>
                    }
                </div>
                <button type="button" class="btn-nav-icon nav-menu-btn" data-nav-drawer-open
                        aria-controls="siteNavDrawer" aria-expanded="false" aria-label="@T["nav.menu"]">
                    <span class="nav-burger" aria-hidden="true"><span></span><span></span><span></span></span>
                </button>
            </div>
        </nav>
    </header>

    <div class="site-nav-drawer" id="siteNavDrawer" aria-hidden="true">
        <div class="site-nav-drawer-backdrop" data-nav-drawer-close></div>
        <div class="site-nav-drawer-panel" role="dialog" aria-modal="true" aria-label="@T["nav.menu"]">
            <div class="site-nav-drawer-head">
                <span class="site-nav-drawer-title">@T["nav.menu"]</span>
                <button type="button" class="btn-nav-icon" data-nav-drawer-close aria-label="@T["search.close"]">×</button>
            </div>
            <div class="site-nav-drawer-body">
                <div class="nav-section-label">@T["nav.pages"]</div>
                <a class="site-nav-link @(homeActive ? "active" : "")" href="/@lang/">@T["nav.home"]</a>
                <a class="site-nav-link @NavActive("pages", "about")" asp-controller="Pages" asp-action="About">@T["nav.about"]</a>
                <a class="site-nav-link @NavActive("pages", "services")" asp-controller="Pages" asp-action="Services">@T["nav.services"]</a>
                <a class="site-nav-link @NavActive("pages", "projects")" asp-controller="Pages" asp-action="Projects">@T["nav.projects"]</a>
                <a class="site-nav-link @(blogActive && !homeActive ? "active" : "")" href="/@lang/#blog-feed">@T["nav.blog"]</a>
                <a class="site-nav-link @NavActive("pages", "contact")" asp-controller="Pages" asp-action="Contact">@T["nav.contact"]</a>
                @if (isReader || isStaff)
                {
                    <div class="nav-section-label">@T["nav.account_tools"]</div>
                    @if (isReader)
                    {
                        <a class="site-nav-link @NavActive("bookmarks")" asp-controller="Bookmarks" asp-action="Index">@T["nav.bookmarks"]</a>
                    }
                    @if (isStaff)
                    {
                        <a class="site-nav-link @NavActive("admin")" asp-controller="Admin" asp-action="Index">@T["nav.admin"]</a>
                    }
                }
            </div>
            <div class="site-nav-drawer-footer">
                <div class="lang-slot"><partial name="_LanguageSwitcher" /></div>
                @if (isAuth)
                {
                    <div class="dropdown w-100">
                        <button class="btn-account dropdown-toggle w-100" type="button" data-bs-toggle="dropdown">
                            <span class="account-avatar">@(string.IsNullOrEmpty(userName) ? "?" : char.ToUpperInvariant(userName[0]))</span>
                            <span class="account-name ltr-field">@(userName ?? T["nav.account"])</span>
                        </button>
                        <ul class="dropdown-menu account-menu w-100">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">@T["nav.account_settings"]</a></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-ghost btn-sm w-100">@T["nav.logout"]</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn-nav-login" asp-controller="Account" asp-action="Login">@T["nav.login"]</a>
                }
            </div>
        </div>
    </div>

    <main class="site-main" id="main-content" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer py-4 mt-5" id="site-footer" role="contentinfo">
        <div class="container">
            <div class="d-flex justify-content-between flex-wrap gap-3 align-items-start">
                <div>
                    <div class="mb-1"><strong>@Seo.AuthorName</strong></div>
                    <div class="small text-muted-dark">&copy; @DateTime.UtcNow.Year · @Seo.SiteName</div>
                </div>
                <nav class="d-flex flex-wrap gap-3 small" aria-label="@T["nav.footer"]">
                    <a asp-controller="Pages" asp-action="About">@T["nav.about"]</a>
                    <a asp-controller="Pages" asp-action="Services">@T["nav.services"]</a>
                    <a asp-controller="Pages" asp-action="Projects">@T["nav.projects"]</a>
                    <a href="/@lang/#blog-feed">@T["nav.blog"]</a>
                    <a asp-controller="Pages" asp-action="Contact">@T["nav.contact"]</a>
                    <a asp-controller="Themes" asp-action="Index">@T["nav.themes"]</a>
                </nav>
                <span class="ltr-field small">@culture.NativeName · @culture.Code</span>
            </div>
            <div class="mt-3">
                @await Component.InvokeAsync("FooterHubs")
            </div>
        </div>
    </footer>

    <partial name="_SiteSearch" />

    <div id="a11y-live" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    <button type="button" id="back-to-top" class="back-to-top" aria-label="@T["a11y.back_to_top"]">↑</button>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" defer></script>
    <script src="~/js/media-blur.js" asp-append-version="true" defer></script>
    <script src="~/js/toastify-stack.js" asp-append-version="true" defer></script>
    <script src="~/js/form-submit-observer.js" asp-append-version="true" defer></script>
    <script src="~/js/notifications-bell.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/site-nav.js" asp-append-version="true" defer></script>
    <script src="~/js/site-search.js" asp-append-version="true" defer></script>
    <script src="~/js/ux.js" asp-append-version="true" defer></script>
    <script src="~/js/a11y.js" asp-append-version="true" defer></script>
    <script src="~/js/datepicker.js" asp-append-version="true" defer></script>
    <script defer>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.ToastifyStack && !window.__blogToastBridged) {
                window.__blogToastBridged = true;
                window.blogToast = function (message, type) {
                    var kind = type === 'success' ? 'success'
                      : (type === 'error' || type === 'danger') ? 'error'
                      : 'info';
                    return ToastifyStack.push({ title: message, kind: kind, duration: 3200, linkUrl: null });
                };
            }
            if (window.hljs) hljs.highlightAll();
            var header = document.getElementById('site-header');
            if (header) {
                var onScroll = function () {
                    if (window.scrollY > 8) header.classList.add('is-scrolled');
                    else header.classList.remove('is-scrolled');
                };
                onScroll();
                window.addEventListener('scroll', onScroll, { passive: true });
            }
            if (window.BlogDatePicker) window.BlogDatePicker.init();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
