@inject BlogApp.Services.SeoService Seo
@using BlogApp.Models
@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = pageTitle != null ? $"{pageTitle} · {Seo.SiteName}" : $"{Seo.SiteName} — {Seo.SiteDescription}";
    var description = ViewData["Description"] as string ?? Seo.SiteDescription;
    var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var canonicalUrl = ViewData["Canonical"] as string ?? currentUrl;
    var ogType = ViewData["OgType"] as string ?? "website";
    var ogImage = ViewData["OgImage"] as string;
    var noIndex = ViewData["NoIndex"] as bool? ?? false;
    var isStaff = User.IsInRole(AppRoles.Author) || User.IsInRole(AppRoles.SuperAdmin);
    var isReader = User.IsInRole(AppRoles.Reader) || isStaff;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>

    <meta name="description" content="@description" />
    <meta name="author" content="@Seo.AuthorName" />
    <meta name="robots" content="@(noIndex ? "noindex, nofollow" : "index, follow")" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta name="theme-color" content="#0b0e14" />

    <meta property="og:site_name" content="@Seo.SiteName" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@(pageTitle ?? Seo.SiteName)" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="fa_IR" />
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
    }

    <meta name="twitter:card" content="@(string.IsNullOrEmpty(ogImage) ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@(pageTitle ?? Seo.SiteName)" />
    <meta name="twitter:description" content="@description" />
    @if (!string.IsNullOrEmpty(Seo.TwitterHandle))
    {
        <meta name="twitter:site" content="@Seo.TwitterHandle" />
    }
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta name="twitter:image" content="@ogImage" />
    }

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cms-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media-blur.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-md py-3">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-cursor"></span> <span class="ltr-signature">dark_pro / blog</span>
                </a>
                <button class="navbar-toggler border-0 text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav ms-auto align-items-md-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-controller="Home" asp-action="Index">نوشته‌ها</a>
                        </li>
                        @if (isReader)
                        {
                            <li class="nav-item">
                                <a class="nav-link site-nav-link" asp-controller="Bookmarks" asp-action="Index">نشان‌ها</a>
                            </li>
                        }
                        @if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link site-nav-link" asp-controller="Admin" asp-action="Index">پنل مدیریت</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-ghost btn-sm ms-md-2">خروج</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Register">ثبت‌نام</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-ghost btn-sm ms-md-2" asp-controller="Account" asp-action="Login">ورود</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer py-4 mt-5">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; @DateTime.UtcNow.Year — ساخته‌شده با ASP.NET Core MVC</span>
            <span>همه‌چیز در یک پایگاه‌داده ذخیره می‌شود</span>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
    <script src="~/js/media-blur.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
