@inject BlogApp.Services.SeoService Seo
@inject BlogApp.Services.ISiteConfigService SiteConfig
@inject BlogApp.Services.ICultureService Culture
@using BlogApp.Models
@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = pageTitle != null ? $"{pageTitle} · {Seo.SiteName}" : $"{Seo.SiteName} — {Seo.SiteDescription}";
    var description = ViewData["Description"] as string ?? Seo.SiteDescription;
    var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var canonicalUrl = ViewData["Canonical"] as string ?? currentUrl;
    var ogType = ViewData["OgType"] as string ?? "website";
    var ogImage = ViewData["OgImage"] as string;
    var noIndex = ViewData["NoIndex"] as bool? ?? false;
    var isStaff = User.IsInRole(AppRoles.Author) || User.IsInRole(AppRoles.SuperAdmin);
    var isReader = User.IsInRole(AppRoles.Reader) || isStaff;

    var culture = Culture.Current;
    var lang = culture.Code;
    var dir = culture.Direction;
    var locale = culture.Locale;

    var announceOn = await SiteConfig.GetBoolAsync(SiteSettingKeys.AnnouncementEnabled);
    var announceText = await SiteConfig.GetAsync(SiteSettingKeys.AnnouncementText);
    var announceStyle = await SiteConfig.GetAsync(SiteSettingKeys.AnnouncementStyle) ?? "info";

    var hreflang = ViewBag.HreflangLinks as IEnumerable<dynamic>;
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir" data-bs-theme="dark" data-theme="dark" data-culture="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>

    <meta name="description" content="@description" />
    <meta name="author" content="@Seo.AuthorName" />
    <meta name="robots" content="@(noIndex ? "noindex, nofollow" : "index, follow")" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta name="theme-color" content="#0b0e14" id="meta-theme-color" />
    <meta name="color-scheme" content="dark light" />

    @if (hreflang != null)
    {
        foreach (var h in hreflang)
        {
            <link rel="alternate" hreflang="@h.Lang" href="@h.Href" />
        }
        <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    }

    <meta property="og:site_name" content="@Seo.SiteName" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@(pageTitle ?? Seo.SiteName)" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="@locale" />
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
    }

    <meta name="twitter:card" content="@(string.IsNullOrEmpty(ogImage) ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@(pageTitle ?? Seo.SiteName)" />
    <meta name="twitter:description" content="@description" />
    @if (!string.IsNullOrEmpty(Seo.TwitterHandle))
    {
        <meta name="twitter:site" content="@Seo.TwitterHandle" />
    }
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta name="twitter:image" content="@ogImage" />
    }

    <script>
        (function () {
            try {
                var t = localStorage.getItem('blog-theme');
                if (t === 'light' || t === 'dark') {
                    document.documentElement.setAttribute('data-theme', t);
                    document.documentElement.setAttribute('data-bs-theme', t);
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
                    document.documentElement.setAttribute('data-theme', 'light');
                    document.documentElement.setAttribute('data-bs-theme', 'light');
                }
                var fs = localStorage.getItem('blog-font-scale');
                if (fs) document.documentElement.style.setProperty('--reader-font-scale', fs);
            } catch (e) {}
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="@culture.BootstrapCss" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cms-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media-blur.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications-bell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ux.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/persona.css" asp-append-version="true" />
    <style>
        .site-announce { padding: .65rem 1rem; text-align: center; font-size: .9rem; border-bottom: 1px solid var(--border-soft, #1e2430); }
        .site-announce.info { background: rgba(111,179,210,.12); color: #b8d4e8; }
        .site-announce.warn { background: rgba(227,179,65,.15); color: #e3b341; }
        .site-announce.success { background: rgba(158,203,140,.12); color: #9ecb8c; }
        .lang-switcher .dropdown-menu { background: var(--surface, #12161f); border: 1px solid var(--border-soft, #1e2430); }
        .lang-switcher .dropdown-item { color: var(--text, #e8ecf4); font-size: .9rem; }
        .lang-switcher .dropdown-item:hover,
        .lang-switcher .dropdown-item.active { background: rgba(111,179,210,.15); color: #fff; }
    </style>

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">پرش به محتوا</a>
    <div id="reading-progress" class="reading-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="پیشرفت مطالعه"></div>

    @if (announceOn && !string.IsNullOrWhiteSpace(announceText))
    {
        <div class="site-announce @announceStyle" dir="auto" role="status">@announceText</div>
    }

    <header class="site-header">
        <nav class="navbar navbar-expand-md py-3">
            <div class="container">
                <a class="navbar-brand brand" href="/@lang/">
                    <span class="brand-cursor"></span> <span class="ltr-signature">m.nazari</span>
                </a>
                <button class="navbar-toggler border-0 text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav ms-auto align-items-md-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" href="/@lang/">خانه</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-controller="Pages" asp-action="About">درباره</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-controller="Pages" asp-action="Services">خدمات</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-controller="Pages" asp-action="Projects">پروژه‌ها</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" href="/@lang/#blog-feed">وبلاگ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-controller="Pages" asp-action="Contact">تماس</a>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="btn btn-ghost btn-sm nav-link site-nav-link" data-search-open title="جست‌وجو (Ctrl+K)">⌕</button>
                        </li>
                        @if (isReader)
                        {
                            <li class="nav-item">
                                <a class="nav-link site-nav-link" asp-controller="Bookmarks" asp-action="Index">@T["nav.bookmarks"]</a>
                            </li>
                        }
                        @if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link site-nav-link" asp-controller="Admin" asp-action="Index">@T["nav.admin"]</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <partial name="_NotificationBell" />
                            </li>
                        }
                        <li class="nav-item">
                            <button type="button" class="btn btn-ghost btn-sm" data-theme-toggle title="تم روشن/تاریک" aria-label="تغییر تم">
                                <span class="theme-icon-dark">☾</span>
                                <span class="theme-icon-light">☀</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <partial name="_LanguageSwitcher" />
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-ghost btn-sm ms-md-2">@T["nav.logout"]</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-ghost btn-sm ms-md-2" asp-controller="Account" asp-action="Login">@T["nav.login"]</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main" id="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer py-4 mt-5">
        <div class="container">
            <div class="d-flex justify-content-between flex-wrap gap-3 align-items-start">
                <div>
                    <div class="mb-1"><strong>محمد نظری</strong> — Senior .NET Backend Engineer</div>
                    <div class="small text-muted-dark">&copy; @DateTime.UtcNow.Year · Tehran</div>
                </div>
                <div class="d-flex flex-wrap gap-3 small">
                    <a asp-controller="Pages" asp-action="About">درباره</a>
                    <a asp-controller="Pages" asp-action="Services">خدمات</a>
                    <a asp-controller="Pages" asp-action="Projects">پروژه‌ها</a>
                    <a href="/@lang/#blog-feed">وبلاگ</a>
                    <a asp-controller="Pages" asp-action="Contact">تماس</a>
                </div>
                <span class="ltr-field small">@culture.NativeName · @culture.Code</span>
            </div>
        </div>
    </footer>

    <div id="search-overlay" hidden>
        <div class="search-panel" role="dialog" aria-modal="true" aria-label="جست‌وجو">
            <input type="search" id="search-input" placeholder="جست‌وجوی نوشته‌ها… (Enter)" autocomplete="off" dir="auto" />
            <div id="search-suggest" role="listbox"></div>
            <div class="p-2 small" style="opacity:.6;border-top:1px solid var(--border-soft,#1e2430)">
                <button type="button" class="btn btn-ghost btn-sm" data-search-close>بستن (Esc)</button>
                <span class="ltr-field ms-2">Ctrl+K</span>
            </div>
        </div>
    </div>
    <div id="toast-host" aria-live="polite"></div>
    <button type="button" id="back-to-top" class="back-to-top" aria-label="بازگشت به بالا">↑</button>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
    <script src="~/js/media-blur.js" asp-append-version="true"></script>
    <script src="~/js/notifications-bell.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/ux.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
