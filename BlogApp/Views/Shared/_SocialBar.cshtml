@{
    var postId = ViewBag.SocialPostId is int pid ? pid : 0;
    var slug = ViewBag.SocialSlug as string ?? "";
    var likeCount = (int)(ViewBag.SocialLikeCount ?? 0);
    var liked = (bool)(ViewBag.SocialLiked ?? false);
    var isBookmarked = ViewBag.IsBookmarked as bool? ?? false;
    var myReaction = ViewBag.SocialMyReaction as ReactionKind?;
    var reactionCounts = ViewBag.SocialReactionCounts as Dictionary<ReactionKind, int> ?? new();
    var followingAuthor = (bool)(ViewBag.SocialFollowingAuthor ?? false);
    var authorId = ViewBag.SocialAuthorId as string;
    var canSocial = User.Identity?.IsAuthenticated == true
        && (User.IsInRole(AppRoles.Reader) || User.IsInRole(AppRoles.Author) || User.IsInRole(AppRoles.SuperAdmin));
    var canBookmark = canSocial;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Action("Details", "Posts", new { slug })}";
    var shareText = ViewBag.SocialTitle as string ?? "";

    string RCount(ReactionKind k) => reactionCounts.TryGetValue(k, out var n) && n > 0 ? n.ToString() : "";
}

<div class="ps-bar" data-social-bar>
    <div class="ps-bar-primary">
        @if (canSocial)
        {
            <form asp-controller="Social" asp-action="ToggleLike" method="post" class="ps-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@postId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="ps-btn ps-like @(liked ? "is-on" : "")" title="پسندیدن">
                    <span class="ps-ico" aria-hidden="true">@(liked ? "♥" : "♡")</span>
                    <span class="ps-label">پسند</span>
                    <span class="ps-count ltr-field">@likeCount</span>
                </button>
            </form>
        }
        else
        {
            <a class="ps-btn ps-like" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" title="پسندیدن">
                <span class="ps-ico" aria-hidden="true">♡</span>
                <span class="ps-label">پسند</span>
                <span class="ps-count ltr-field">@likeCount</span>
            </a>
        }

        @if (canBookmark)
        {
            <form asp-controller="Bookmarks" asp-action="Toggle" method="post" class="ps-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@postId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="ps-btn ps-bookmark @(isBookmarked ? "is-on" : "")" title="نشان‌گذاری">
                    <span class="ps-ico" aria-hidden="true">@(isBookmarked ? "★" : "☆")</span>
                    <span class="ps-label">@(isBookmarked ? "نشان‌شده" : "نشان")</span>
                </button>
            </form>
        }
        else
        {
            <a class="ps-btn ps-bookmark" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" title="نشان‌گذاری">
                <span class="ps-ico" aria-hidden="true">☆</span>
                <span class="ps-label">نشان</span>
            </a>
        }

        <div class="ps-share">
            <button type="button" class="ps-btn ps-share-toggle" data-share-toggle aria-expanded="false" aria-haspopup="true">
                <span class="ps-ico" aria-hidden="true">↗</span>
                <span class="ps-label">اشتراک</span>
            </button>
            <div class="ps-share-menu" data-share-menu hidden>
                <button type="button" class="ps-share-item" data-share-copy data-url="@shareUrl">کپی لینک</button>
                <a class="ps-share-item" target="_blank" rel="noopener"
                   href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(shareUrl)&text=@Uri.EscapeDataString(shareText)">X / Twitter</a>
                <a class="ps-share-item" target="_blank" rel="noopener"
                   href="https://t.me/share/url?url=@Uri.EscapeDataString(shareUrl)&text=@Uri.EscapeDataString(shareText)">Telegram</a>
                <a class="ps-share-item" target="_blank" rel="noopener"
                   href="https://www.linkedin.com/sharing/share-offsite/?url=@Uri.EscapeDataString(shareUrl)">LinkedIn</a>
            </div>
        </div>

        @if (canSocial && !string.IsNullOrEmpty(authorId))
        {
            <form asp-controller="Follow" asp-action="Toggle" method="post" class="ps-form ps-follow">
                @Html.AntiForgeryToken()
                <input type="hidden" name="authorUserId" value="@authorId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="ps-btn @(followingAuthor ? "is-on" : "ps-accent")">
                    <span class="ps-label">@(followingAuthor ? "دنبال می‌کنید" : "دنبال نویسنده")</span>
                </button>
            </form>
        }
    </div>

    <div class="ps-reactions" role="group" aria-label="واکنش‌ها">
        @foreach (ReactionKind kind in Enum.GetValues<ReactionKind>())
        {
            var emoji = kind switch
            {
                ReactionKind.Like => "👍",
                ReactionKind.Love => "❤️",
                ReactionKind.Clap => "👏",
                ReactionKind.Insight => "💡",
                ReactionKind.Funny => "😄",
                _ => "·"
            };
            var count = RCount(kind);
            var isMine = myReaction == kind;
            if (canSocial)
            {
                <form asp-controller="Social" asp-action="React" method="post" class="ps-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="postId" value="@postId" />
                    <input type="hidden" name="kind" value="@kind" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="ps-react @(isMine ? "is-on" : "")" title="@kind">
                        <span aria-hidden="true">@emoji</span>
                        @if (!string.IsNullOrEmpty(count))
                        {
                            <span class="ps-react-count ltr-field">@count</span>
                        }
                    </button>
                </form>
            }
            else if (!string.IsNullOrEmpty(count))
            {
                <span class="ps-react is-static" title="@kind">
                    <span aria-hidden="true">@emoji</span>
                    <span class="ps-react-count ltr-field">@count</span>
                </span>
            }
        }
    </div>
</div>

<script>
(function () {
  document.querySelectorAll('[data-share-toggle]').forEach(function (btn) {
    var menu = btn.parentElement && btn.parentElement.querySelector('[data-share-menu]');
    if (!menu) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = menu.hasAttribute('hidden');
      menu.toggleAttribute('hidden', !open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function () {
      menu.setAttribute('hidden', '');
      btn.setAttribute('aria-expanded', 'false');
    });
  });
  document.querySelectorAll('[data-share-copy]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var u = btn.getAttribute('data-url');
      if (navigator.clipboard && u) {
        navigator.clipboard.writeText(u).then(function () {
          var t = btn.textContent;
          btn.textContent = 'کپی شد ✓';
          setTimeout(function () { btn.textContent = t; }, 1400);
        });
      }
    });
  });
})();
</script>
