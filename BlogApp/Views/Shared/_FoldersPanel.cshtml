@model TaxonomyAdminViewModel

@{
    var folderCount = Model.Folders?.Count ?? 0;
    var colors = new[] { "blue", "yellow", "red", "green", "purple", "orange", "gray" };
}
<section class="tx-panel is-active" id="tx-folders" role="tabpanel" data-panel="folders" aria-labelledby="tx-folders-title">
    <div class="ff-shell">
        <div class="ff-head">
            <div class="ff-head-text">
                <h2 class="tx-panel-title" id="tx-folders-title">@T["tax.folders_heading"]</h2>
                <p class="tx-panel-desc">@T["tax.folders_desc"]</p>
            </div>
            @if (folderCount > 0)
            {
                <div class="ff-toolbar">
                    <label class="ff-search-wrap" for="folderSearch">
                        <svg class="ff-search-ico" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                            <path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        </svg>
                        <input type="search" id="folderSearch" class="ff-search" placeholder="@T["tax.folder_search"]" autocomplete="off" />
                    </label>
                    <span class="ff-count ltr-field" id="folderCountLabel">@folderCount</span>
                </div>
            }
        </div>

        <form asp-controller="Taxonomy" asp-action="CreateFolder" method="post" class="ff-create" id="folderCreateForm">
            @Html.AntiForgeryToken()
            <div class="ff-create-row">
                <div class="ff-create-name">
                    <label class="tx-label" for="folderNameInput">@T["tax.label_folder_name"]</label>
                    <input id="folderNameInput" class="form-control form-control-sm" name="name" required dir="auto"
                           placeholder="@T["tax.ph_folder_name"]" maxlength="80" />
                </div>
                <div class="ff-create-color">
                    <span class="tx-label">@T["tax.label_folder_color"]</span>
                    <div class="ff-swatches" role="radiogroup" aria-label="@T["tax.label_folder_color"]">
                        @foreach (var c in colors)
                        {
                            var isDefault = c == "blue";
                            var colorKey = "tax.color_" + c;
                            <label class="ff-swatch ff-swatch-@c @(isDefault ? "is-selected" : null)">
                                <input type="radio" name="color" value="@c" @(isDefault ? "checked" : null) />
                                <span class="ff-swatch-dot" aria-hidden="true"></span>
                                <span class="visually-hidden">@T[colorKey]</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="ff-create-desc">
                    <label class="tx-label" for="folderDescInput">@T["tax.label_description"]</label>
                    <input id="folderDescInput" class="form-control form-control-sm" name="description" dir="auto"
                           placeholder="@T["tax.ph_desc_short"]" maxlength="200" />
                </div>
                <div class="ff-create-action">
                    <button type="submit" class="btn btn-accent btn-sm ff-create-btn">@T["tax.btn_create_folder"]</button>
                </div>
            </div>
        </form>

        @if (folderCount == 0)
        {
            <div class="ff-empty">
                <div class="ff-empty-art" aria-hidden="true">
                    <svg viewBox="0 0 72 58" width="64" height="52">
                        <path class="ff-empty-back" d="M4 12c0-3.3 2.7-6 6-6h16l4 5h34c3.3 0 6 2.7 6 6v31c0 3.3-2.7 6-6 6H10c-3.3 0-6-2.7-6-6V12z"/>
                        <path class="ff-empty-front" d="M4 20c0-2.2 1.8-4 4-4h56c2.2 0 4 1.8 4 4v24c0 2.2-1.8 4-4 4H8c-2.2 0-4-1.8-4-4V20z"/>
                    </svg>
                </div>
                <p class="tx-empty-title">@T["tax.empty_folders"]</p>
                <p class="tx-empty-hint">@T["tax.empty_folders_hint"]</p>
            </div>
        }
        else
        {
            <div class="ff-grid" id="folderGrid" role="list">
                @foreach (var f in Model.Folders!)
                {
                    var color = string.IsNullOrWhiteSpace(f.Color) ? "blue" : f.Color.Trim().ToLowerInvariant();
                    <article class="ff-card" role="listitem" data-name="@f.Name.ToLowerInvariant()" data-color="@color">
                        <a class="ff-card-hit" asp-controller="Taxonomy" asp-action="Folder" asp-route-id="@f.Id"
                           aria-label="@f.Name">
                            <span class="ff-icon ff-icon-@color" aria-hidden="true">
                                <svg viewBox="0 0 64 52" width="52" height="42">
                                    <path class="ff-back" d="M2 10c0-3.3 2.7-6 6-6h14l4 5h30c3.3 0 6 2.7 6 6v31c0 3.3-2.7 6-6 6H8c-3.3 0-6-2.7-6-6V10z"/>
                                    <path class="ff-front" d="M2 18c0-2.2 1.8-4 4-4h52c2.2 0 4 1.8 4 4v24c0 2.2-1.8 4-4 4H6c-2.2 0-4-1.8-4-4V18z"/>
                                </svg>
                            </span>
                            <span class="ff-card-name" dir="auto">@f.Name</span>
                            <span class="ff-card-meta ltr-field">@string.Format(T["tax.posts_n"].ToString(), f.PostCount)</span>
                            @if (!string.IsNullOrWhiteSpace(f.Description))
                            {
                                <span class="ff-card-desc" dir="auto">@f.Description</span>
                            }
                        </a>
                        <form asp-controller="Taxonomy" asp-action="DeleteFolder" method="post" class="ff-card-del"
                              onsubmit="return confirm('@T["tax.confirm_delete_folder"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@f.Id" />
                            <button type="submit" class="ff-del-btn" title="@T["tax.btn_delete"]" aria-label="@T["tax.btn_delete"]">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                                    <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                </svg>
                            </button>
                        </form>
                    </article>
                }
            </div>
            <p class="ff-no-match" id="folderNoMatch" hidden>@T["tax.empty_folders"]</p>
        }
    </div>
</section>
