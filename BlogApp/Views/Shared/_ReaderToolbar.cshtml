@*
  Include on post details for font size controls.
*@
<div class="reader-toolbar" role="toolbar" aria-label="ابزار مطالعه">
  <div class="btn-group-font btn-group" role="group">
    <span class="small text-muted-dark me-1">قلم</span>
    <button type="button" class="btn btn-ghost btn-sm" data-font-delta="-0.05" title="کوچکتر">A−</button>
    <button type="button" class="btn btn-ghost btn-sm" data-font-delta="0.05" title="بزرگتر">A+</button>
  </div>
</div>
