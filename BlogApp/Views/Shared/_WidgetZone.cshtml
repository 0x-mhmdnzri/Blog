@*
  Renders widgets for a zone via in-process registry (monolith).
  Usage: <partial name="_WidgetZone" model='"sidebar"' />
*@
@model string
@inject BlogApp.Developer.Widgets.WidgetRegistry Widgets
@{
    var zone = Model ?? "sidebar";
    var list = Widgets.ForZone(zone).ToList();
    var sp = Context.RequestServices;
}
@if (list.Count > 0)
{
    <div class="widget-zone" data-zone="@zone">
    @foreach (var w in list)
    {
        var html = await w.RenderHtmlAsync(sp, Context.RequestAborted);
        if (!string.IsNullOrEmpty(html))
        {
            @Html.Raw(html)
        }
    }
    </div>
}
