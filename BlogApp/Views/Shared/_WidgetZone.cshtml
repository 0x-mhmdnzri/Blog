@*
  Renders widgets for a zone via server-side registry.
  Usage: <partial name="_WidgetZone" model='"sidebar"' />
*@
@model string
@inject Blog.Application.Widgets.IWidgetRegistry Widgets
@{
    var zone = Model ?? "sidebar";
    var list = Widgets.GetForZone(zone);
    var sp = Context.RequestServices;
    var ctx = new Blog.Domain.Widgets.WidgetRenderContext
    {
        Zone = zone,
        Culture = Context.Request.Headers["Accept-Language"].FirstOrDefault(),
        UserId = User.Identity?.IsAuthenticated == true ? User.Identity?.Name : null,
        Services = sp
    };
}
@if (list.Count > 0)
{
    <div class="widget-zone" data-zone="@zone">
    @foreach (var w in list)
    {
        var result = await w.RenderAsync(ctx, Context.RequestAborted);
        if (!string.IsNullOrEmpty(result.Html))
        {
            @Html.Raw(result.Html)
        }
    }
    </div>
}
