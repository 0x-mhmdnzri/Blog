@inject BlogApp.Services.IUiTranslator T
@* Spotlight modal — trigger lives in admin topbar *@
<div id="adminSearchRoot" class="admin-search" data-api="/AdminSearch/api"
     data-i18n-idle="@T["search.admin.idle_hint"]"
     data-i18n-keys="@T["search.admin.idle_keys"]"
     data-i18n-no-results="@T["search.no_results"]"
     data-i18n-results="@T["search.results"]">
    <div class="admin-search-overlay" id="adminSearchOverlay" hidden>
        <div class="admin-search-dialog" role="dialog" aria-modal="true" aria-label="@T["search.admin.aria"]">
            <div class="admin-search-bar">
                <span class="admin-search-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                </span>
                <input type="search" id="adminSearchInput" class="admin-search-input"
                       placeholder="@T["search.admin.placeholder"]"
                       autocomplete="off" spellcheck="false" role="combobox"
                       aria-autocomplete="list" aria-controls="adminSearchResults" aria-expanded="false" />
                <button type="button" class="admin-search-clear" id="adminSearchClear" hidden aria-label="@T["search.clear"]">×</button>
            </div>

            <div class="admin-search-scopes" role="tablist" aria-label="@T["search.admin.scope"]">
                <button type="button" class="scope is-active" data-scope="all" role="tab" aria-selected="true">@T["search.admin.scope_all"]</button>
                <button type="button" class="scope" data-scope="post" role="tab">@T["search.admin.scope_post"]</button>
                <button type="button" class="scope" data-scope="comment" role="tab">@T["search.admin.scope_comment"]</button>
                <button type="button" class="scope" data-scope="user" role="tab">@T["search.admin.scope_user"]</button>
                <button type="button" class="scope" data-scope="media" role="tab">@T["search.admin.scope_media"]</button>
                <button type="button" class="scope" data-scope="page" role="tab">@T["search.admin.scope_page"]</button>
                <button type="button" class="scope" data-scope="theme" role="tab">@T["search.admin.scope_theme"]</button>
            </div>

            <div class="admin-search-meta" id="adminSearchMeta" hidden>
                <span id="adminSearchCount"></span>
                <span id="adminSearchLatency" class="admin-search-latency"></span>
            </div>

            <div class="admin-search-body" id="adminSearchResults" role="listbox">
                <div class="admin-search-empty" id="adminSearchEmpty">
                    <p class="hint">@T["search.admin.idle_hint"]</p>
                    <p class="hint-sub">@T["search.admin.idle_keys"]</p>
                </div>
                <div class="admin-search-skeleton" id="adminSearchSkeleton" hidden>
                    <div class="sk-row"></div><div class="sk-row"></div><div class="sk-row"></div>
                    <div class="sk-row"></div><div class="sk-row"></div>
                </div>
                <ul class="admin-search-list" id="adminSearchList" hidden></ul>
            </div>

            <div class="admin-search-footer">
                <span><kbd>↵</kbd> @T["search.open"]</span>
                <span><kbd>esc</kbd> @T["search.close"]</span>
                <a href="/AdminSearch" class="admin-search-full">@T["search.admin.full"]</a>
            </div>
        </div>
    </div>
</div>
