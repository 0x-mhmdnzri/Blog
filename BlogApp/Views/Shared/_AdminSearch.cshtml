@* Spotlight modal only — trigger lives in admin topbar (wide field) *@
<div id="adminSearchRoot" class="admin-search" data-api="/AdminSearch/api">
    <div class="admin-search-overlay" id="adminSearchOverlay" hidden>
        <div class="admin-search-dialog" role="dialog" aria-modal="true" aria-label="Admin search">
            <div class="admin-search-bar">
                <svg class="admin-search-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                    <path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                </svg>
                <input type="search" id="adminSearchInput" class="admin-search-input"
                       placeholder="Search posts, users, pages…"
                       autocomplete="off" spellcheck="false" role="combobox"
                       aria-autocomplete="list" aria-controls="adminSearchResults" aria-expanded="false" />
                <button type="button" class="admin-search-clear" id="adminSearchClear" hidden aria-label="Clear">✕</button>
            </div>

            <div class="admin-search-scopes" role="tablist" aria-label="Scope">
                <button type="button" class="scope is-active" data-scope="all" role="tab" aria-selected="true">All</button>
                <button type="button" class="scope" data-scope="post" role="tab">Posts</button>
                <button type="button" class="scope" data-scope="comment" role="tab">Comments</button>
                <button type="button" class="scope" data-scope="user" role="tab">People</button>
                <button type="button" class="scope" data-scope="media" role="tab">Media</button>
                <button type="button" class="scope" data-scope="page" role="tab">Pages</button>
                <button type="button" class="scope" data-scope="theme" role="tab">Themes</button>
            </div>

            <div class="admin-search-meta" id="adminSearchMeta" hidden>
                <span id="adminSearchCount"></span>
                <span id="adminSearchLatency" class="admin-search-latency"></span>
            </div>

            <div class="admin-search-body" id="adminSearchResults" role="listbox">
                <div class="admin-search-empty" id="adminSearchEmpty">
                    <p class="hint">Type to search across the admin panel</p>
                    <p class="hint-sub">↑↓ navigate · Enter open · Esc close</p>
                </div>
                <div class="admin-search-skeleton" id="adminSearchSkeleton" hidden>
                    <div class="sk-row"></div><div class="sk-row"></div><div class="sk-row"></div>
                    <div class="sk-row"></div><div class="sk-row"></div>
                </div>
                <ul class="admin-search-list" id="adminSearchList" hidden></ul>
            </div>

            <div class="admin-search-footer">
                <span><kbd>↵</kbd> open</span>
                <span><kbd>esc</kbd> close</span>
                <a href="/AdminSearch" class="admin-search-full">Full results</a>
            </div>
        </div>
    </div>
</div>
