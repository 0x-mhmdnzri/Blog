@model BlogApp.ViewComponents.SiteAnnounceModel
<div class="site-announce @Model.Style"
     id="siteAnnounce"
     dir="auto"
     role="region"
     aria-label="announcement"
     data-announce-version="@Model.Version"
     hidden>
    <p class="site-announce-text mb-0">@Model.Text</p>
    <button type="button" class="site-announce-dismiss" id="siteAnnounceDismiss" aria-label="Dismiss" title="Dismiss">&times;</button>
</div>
<style>
.site-announce{display:flex;align-items:center;justify-content:center;gap:.75rem;padding:.7rem 1rem;font-size:.9rem;line-height:1.45;border-bottom:1px solid var(--border-soft,#1e2430)}
.site-announce[hidden]{display:none!important}
.site-announce-text{flex:1;text-align:center;max-width:52rem;margin:0 auto}
.site-announce-dismiss{flex-shrink:0;border:0;background:rgba(0,0,0,.12);color:inherit;width:1.85rem;height:1.85rem;border-radius:50%;font-size:1.15rem;line-height:1;cursor:pointer;opacity:.75;display:inline-flex;align-items:center;justify-content:center}
.site-announce-dismiss:hover{opacity:1;background:rgba(0,0,0,.2)}
.site-announce.info{background:rgba(111,179,210,.14);color:#b8d4e8}
.site-announce.warn{background:rgba(227,179,65,.16);color:#e3b341}
.site-announce.success{background:rgba(158,203,140,.14);color:#9ecb8c}
html[data-theme="light"] .site-announce.info{background:rgba(37,99,155,.1);color:#1a4a6e}
html[data-theme="light"] .site-announce.warn{background:rgba(180,120,20,.12);color:#7a5200}
html[data-theme="light"] .site-announce.success{background:rgba(60,120,50,.1);color:#2d5a28}
html[data-theme="light"] .site-announce-dismiss{background:rgba(0,0,0,.06)}
</style>
<script>
(function(){
  var ann=document.getElementById('siteAnnounce');
  if(!ann)return;
  var ver=ann.getAttribute('data-announce-version')||'0';
  var key='blog-announce-dismissed';
  try{if(localStorage.getItem(key)!==ver)ann.hidden=false;}catch(e){ann.hidden=false;}
  var btn=document.getElementById('siteAnnounceDismiss');
  if(btn)btn.addEventListener('click',function(){
    ann.hidden=true;
    try{localStorage.setItem(key,ver);}catch(e){}
  });
})();
</script>
