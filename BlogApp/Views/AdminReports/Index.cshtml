@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["page.reports"];
    var current = ViewBag.CurrentStatus as string ?? "open";
    var j = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

<div class="admin-tabs">
    <a class="admin-tab @(current == "open" ? "active" : "")" asp-action="Index" asp-route-status="open">@T["tab.open"] (@ViewBag.OpenCount)</a>
    <a class="admin-tab @(current == "resolved" ? "active" : "")" asp-action="Index" asp-route-status="resolved">@T["tab.resolved"] (@ViewBag.ResolvedCount)</a>
    <a class="admin-tab @(current == "dismissed" ? "active" : "")" asp-action="Index" asp-route-status="dismissed">@T["tab.dismissed"] (@ViewBag.DismissedCount)</a>
    <a class="admin-tab @(current == "all" ? "active" : "")" asp-action="Index" asp-route-status="all">@T["tab.all"]</a>
</div>

@Html.AntiForgeryToken()

<div class="admin-table-wrap">
    <table id="reportsTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>@T["col.index"]</th>
                <th>@T["col.target"]</th>
                <th>@T["col.reason"]</th>
                <th>@T["col.reporter"]</th>
                <th>@T["col.date"]</th>
                <th>@T["col.status"]</th>
                <th>@T["col.actions"]</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
BlogDT.init('#reportsTable', {
    ajax: {
        url: '@Url.Action("Data", "AdminReports")',
        type: 'GET',
        data: function (d) { d.status = '@current'; }
    },
    exportUrl: '@Url.Action("ExportCsv", "AdminReports")',
    exportParams: { status: '@current' },
    columns: [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field col-idx' },
        { data: 1 },
        { data: 2, className: 'dt-wrap' },
        { data: 3 },
        { data: 4, className: 'ltr-field col-date' },
        { data: 5, className: 'col-status' },
        { data: 6, orderable: false, searchable: false, className: 'col-actions' }
    ],
    order: [[4, 'desc']],
    columnDefs: [{ orderable: false, targets: [0, 6] }],
    columnFilters: [
        false,
        true,
        true,
        true,
        false,
        {
            type: 'select',
            placeholder: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["col.status"].ToString(), j)),
            options: [
                { value: 'open', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["tab.open"].ToString(), j)) },
                { value: 'resolved', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["tab.resolved"].ToString(), j)) },
                { value: 'dismissed', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["tab.dismissed"].ToString(), j)) }
            ]
        },
        false
    ]
});
</script>
}
