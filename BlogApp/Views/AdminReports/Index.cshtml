@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "گزارش‌های محتوا";
    var current = ViewBag.CurrentStatus as string ?? "open";
}

<div class="admin-tabs">
    <a class="admin-tab @(current == "open" ? "active" : "")" asp-action="Index" asp-route-status="open">باز (@ViewBag.OpenCount)</a>
    <a class="admin-tab @(current == "resolved" ? "active" : "")" asp-action="Index" asp-route-status="resolved">حل‌شده (@ViewBag.ResolvedCount)</a>
    <a class="admin-tab @(current == "dismissed" ? "active" : "")" asp-action="Index" asp-route-status="dismissed">ردشده (@ViewBag.DismissedCount)</a>
    <a class="admin-tab @(current == "all" ? "active" : "")" asp-action="Index" asp-route-status="all">همه</a>
</div>

@Html.AntiForgeryToken()

<div class="admin-table-wrap">
    <table id="reportsTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>#</th>
                <th>هدف</th>
                <th>دلیل</th>
                <th>گزارش‌دهنده</th>
                <th>تاریخ</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
BlogDT.init('#reportsTable', {
    ajax: {
        url: '@Url.Action("Data", "AdminReports")',
        type: 'GET',
        data: function (d) { d.status = '@current'; }
    },
    columns: [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field' },
        { data: 1 },
        { data: 2 },
        { data: 3 },
        { data: 4, className: 'ltr-field' },
        { data: 5 },
        { data: 6, orderable: false, searchable: false }
    ],
    order: [[4, 'desc']],
    columnDefs: [{ orderable: false, targets: [0, 6] }]
});
</script>
}
