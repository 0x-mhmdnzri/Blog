@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "مدیریت کاربران";
}

@if (TempData["Saved"] != null)
{
    <div class="card-surface p-3 mb-3 small text-muted-dark">@TempData["Saved"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="card-surface p-3 mb-3 small" style="border-color:var(--danger,#e5637a);">@TempData["Error"]</div>
}

@Html.AntiForgeryToken()

<div class="admin-table-wrap">
    <table id="usersTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>#</th>
                <th>کاربر</th>
                <th>نقش‌ها</th>
                <th>نوشته‌ها</th>
                <th>ثبت‌نام</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
BlogDT.init('#usersTable', {
    ajax: { url: '@Url.Action("Data", "AdminUsers")', type: 'GET' },
    columns: [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field' },
        { data: 1 },
        { data: 2, className: 'ltr-field small' },
        { data: 3, className: 'ltr-field' },
        { data: 4, className: 'ltr-field' },
        { data: 5 },
        { data: 6, orderable: false, searchable: false }
    ],
    order: [[4, 'desc']],
    columnDefs: [{ orderable: false, targets: [0, 6] }]
});
</script>
}
