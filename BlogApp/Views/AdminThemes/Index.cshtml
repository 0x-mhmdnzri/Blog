@model List<BlogApp.Models.CustomTheme>
@using BlogApp.Models
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["themes.title"];
    var isSuper = ViewBag.IsSuper as bool? ?? User.IsInRole(AppRoles.SuperAdmin);
    var pending = (int)(ViewBag.PendingCount ?? 0);
}
<div style="max-width:960px">
    <div class="d-flex flex-wrap gap-2 justify-content-between mb-3">
        <p class="small text-muted-dark mb-0">
            @if (isSuper)
            {
                <text>@T["themes.super_hint"]</text>
            }
            else
            {
                <text>@T["themes.author_hint"]</text>
            }
        </p>
        <div class="d-flex gap-1 flex-wrap">
            @if (isSuper)
            {
                <a class="btn btn-ghost btn-sm" asp-route-status="">@T["themes.all"]</a>
                <a class="btn btn-accent btn-sm" asp-route-status="pending">@T["themes.pending"] (@pending)</a>
                <a class="btn btn-ghost btn-sm" asp-route-status="approved">@T["themes.approved"]</a>
                <a class="btn btn-ghost btn-sm" asp-route-status="rejected">@T["themes.rejected"]</a>
            }
            <a class="btn btn-accent btn-sm" asp-action="Create">@T["themes.create"]</a>
        </div>
    </div>

    <div class="card-surface p-3 mb-3">
        <div class="d-flex flex-wrap gap-2 align-items-end justify-content-between">
            <form asp-action="ImportFile" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-end">
                @Html.AntiForgeryToken()
                <div>
                    <label class="form-label small mb-1">@T["themes.upload"]</label>
                    <input type="file" name="file" accept=".blogtheme,application/json,.json" class="form-control form-control-sm" required />
                </div>
                <button type="submit" name="action" value="submit" class="btn btn-accent btn-sm">@T["themes.upload_submit"]</button>
                <button type="submit" name="action" value="draft" class="btn btn-ghost btn-sm">@T["themes.upload_draft"]</button>
            </form>
            @if (isSuper)
            {
                <div class="d-flex flex-wrap gap-2 align-items-end">
                    <form asp-action="ImportSystemPack" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="form-label small mb-1">@T["themes.import_system"]</label>
                            <input type="file" name="file" accept=".blogtheme" class="form-control form-control-sm" required />
                        </div>
                        <button type="submit" class="btn btn-ghost btn-sm">@T["themes.import_btn"]</button>
                    </form>
                    <form asp-action="Reimport" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-ghost btn-sm" title="@T["themes.scan_title"]">@T["themes.scan_folder"]</button>
                    </form>
                </div>
            }
        </div>
    </div>

    @if (TempData["Msg"] != null) { <div class="card-surface p-2 px-3 mb-3 small">@TempData["Msg"]</div> }

    @if (Model.Count == 0)
    {
        <p class="text-muted-dark small">@T["themes.empty"]</p>
    }

    @foreach (var t in Model)
    {
        var canReview = isSuper && t.Status is ThemeApprovalStatus.Pending or ThemeApprovalStatus.Draft or ThemeApprovalStatus.Rejected;
        <article class="card-surface p-3 mb-2">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div style="flex:1;min-width:200px">
                    <strong>@t.Name</strong>
                    @if (t.IsActive) { <span class="badge-category">@T["themes.active_site"]</span> }
                    @if (t.IsSystem) { <span class="small text-muted-dark">@T["themes.system"]</span> }
                    <div class="small text-muted-dark">
                        @(t.Owner?.UserName ?? t.OwnerUserId ?? "—") ·
                        @(t.Status switch {
                            ThemeApprovalStatus.Pending => T["themes.pending_review"],
                            ThemeApprovalStatus.Approved => T["themes.approved"],
                            ThemeApprovalStatus.Rejected => T["themes.rejected"],
                            _ => T["themes.draft"]
                        })
                        · contrast @t.ContrastTextOnBg:1
                    </div>
                    @if (t.Status == ThemeApprovalStatus.Rejected && !string.IsNullOrEmpty(t.RejectionReason))
                    {
                        <div class="small" style="color:var(--danger)">@t.RejectionReason</div>
                    }
                    <div class="d-flex gap-1 mt-1">
                        @foreach (var c in new[]{ t.Bg, t.Text, t.Accent, t.Surface })
                        {
                            <span style="width:1.1rem;height:1.1rem;border-radius:3px;background:@c;border:1px solid var(--border)"></span>
                        }
                    </div>
                </div>
                <div class="d-flex flex-column gap-2" style="min-width:160px">
                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                        @if (canReview)
                        {
                            <form asp-controller="AdminThemes" asp-action="Approve" asp-route-id="@t.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-accent btn-sm" type="submit">@T["themes.approve"]</button>
                            </form>
                        }
                        @if (isSuper && t.Status == ThemeApprovalStatus.Approved && !t.IsActive)
                        {
                            <form asp-controller="AdminThemes" asp-action="Activate" asp-route-id="@t.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-accent btn-sm" type="submit">@T["themes.activate"]</button>
                            </form>
                        }

                        @if (!isSuper && t.Status is ThemeApprovalStatus.Draft or ThemeApprovalStatus.Rejected)
                        {
                            <form asp-controller="AdminThemes" asp-action="Submit" asp-route-id="@t.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-accent btn-sm" type="submit">@T["themes.submit_review"]</button>
                            </form>
                        }

                        @if (!t.IsSystem && !t.IsActive)
                        {
                            <form asp-controller="AdminThemes" asp-action="Delete" asp-route-id="@t.Id" method="post" onsubmit="return confirm('@T["themes.delete_confirm"]');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-ghost btn-sm" type="submit">@T["themes.delete"]</button>
                            </form>
                        }
                    </div>
                    @if (canReview)
                    {
                        <form asp-controller="AdminThemes" asp-action="Reject" asp-route-id="@t.Id" method="post" class="d-flex flex-wrap gap-1 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="text" name="reason" class="form-control form-control-sm" placeholder="@T["themes.reject_reason"]" maxlength="400" style="min-width:140px;flex:1" />
                            <button class="btn btn-outline-danger-dark btn-sm" type="submit">@T["themes.reject"]</button>
                        </form>
                    }
                </div>
            </div>
        </article>
    }
</div>
