@model List<BlogApp.Models.CustomTheme>
@using BlogApp.Models
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "تم‌ها";
    var pending = (int)(ViewBag.PendingCount ?? 0);
}
<div style="max-width:960px">
    <div class="d-flex flex-wrap gap-2 justify-content-between mb-3">
        <p class="small text-muted-dark mb-0">فقط تم‌های با کنتراست کافی تأیید شوند. فعال‌سازی روی کل سایت و پنل اعمال می‌شود. فایل‌های <code>.blogtheme</code> از پوشه <code>themes/</code> در استارت‌آپ وارد می‌شوند.</p>
        <div class="d-flex gap-1 flex-wrap">
            <a class="btn btn-ghost btn-sm" asp-route-status="">همه</a>
            <a class="btn btn-accent btn-sm" asp-route-status="pending">در انتظار (@pending)</a>
            <a class="btn btn-ghost btn-sm" asp-route-status="approved">تأییدشده</a>
        </div>
    </div>

    <div class="card-surface p-3 mb-3">
        <div class="d-flex flex-wrap gap-2 align-items-end justify-content-between">
            <form asp-action="ImportFile" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
                @Html.AntiForgeryToken()
                <div>
                    <label class="form-label small mb-1">واردات فایل .blogtheme</label>
                    <input type="file" name="file" accept=".blogtheme,application/json" class="form-control form-control-sm" required />
                </div>
                <button type="submit" class="btn btn-accent btn-sm">آپلود و واردات</button>
            </form>
            <form asp-action="Reimport" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost btn-sm" title="اسکن مجدد themes/*.blogtheme">اسکن مجدد پوشه themes</button>
            </form>
        </div>
    </div>

    @if (TempData["Msg"] != null) { <div class="card-surface p-2 px-3 mb-3 small">@TempData["Msg"]</div> }

    @foreach (var t in Model)
    {
        <article class="card-surface p-3 mb-2">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div>
                    <strong>@t.Name</strong>
                    @if (t.IsActive) { <span class="badge-category">فعال</span> }
                    @if (t.IsSystem) { <span class="small text-muted-dark">سیستم</span> }
                    <div class="small text-muted-dark">@(t.Owner?.UserName ?? t.OwnerUserId ?? "—") · @t.Status · contrast @t.ContrastTextOnBg:1</div>
                    <div class="d-flex gap-1 mt-1">
                        @foreach (var c in new[]{ t.Bg, t.Text, t.Accent, t.Surface })
                        {
                            <span style="width:1.1rem;height:1.1rem;border-radius:3px;background:@c;border:1px solid var(--border)"></span>
                        }
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @if (t.Status == ThemeApprovalStatus.Pending)
                    {
                        <form asp-action="Approve" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><button class="btn btn-accent btn-sm" type="submit">تأیید</button></form>
                        <form asp-action="Reject" method="post" onsubmit="var r=prompt('دلیل رد:'); if(r===null)return false; this.querySelector('[name=reason]').value=r;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@t.Id" /><input type="hidden" name="reason" value="" />
                            <button class="btn btn-outline-danger-dark btn-sm" type="submit">رد</button>
                        </form>
                    }
                    else if (t.Status == ThemeApprovalStatus.Approved && !t.IsActive)
                    {
                        <form asp-action="Activate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><button class="btn btn-accent btn-sm" type="submit">فعال‌سازی</button></form>
                    }
                    @if (!t.IsSystem)
                    {
                        <form asp-action="Delete" method="post" onsubmit="return confirm('حذف؟');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><button class="btn btn-ghost btn-sm" type="submit">حذف</button></form>
                    }
                </div>
            </div>
        </article>
    }
</div>
