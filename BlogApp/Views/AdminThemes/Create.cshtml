@model BlogApp.Models.CustomTheme
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["themes.create"];
    var isSuper = User.IsInRole(BlogApp.Models.AppRoles.SuperAdmin);
}
<div style="max-width:720px">
    <p class="small text-muted-dark mb-3">@T["themes.contrast_hint"]</p>

    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

    <form method="post" class="card-surface p-3">
        @Html.AntiForgeryToken()
        <div class="mb-2">
            <label class="form-label" asp-for="Name">@T["themes.name"]</label>
            <input class="form-control form-control-sm" asp-for="Name" required maxlength="80" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Description">@T["themes.desc"]</label>
            <input class="form-control form-control-sm" asp-for="Description" maxlength="240" />
        </div>
        <div class="row g-2">
            @foreach (var f in new (string Prop, string LabelKey)[] {
                ("Bg", "themes.color_bg"), ("Surface", "themes.color_surface"), ("Surface2", "themes.color_surface2"),
                ("Border", "themes.color_border"), ("Text", "themes.color_text"), ("TextMuted", "themes.color_text_muted"),
                ("Accent", "themes.color_accent"), ("Danger", "themes.color_danger"), ("Success", "themes.color_success")
            })
            {
                <div class="col-6 col-md-4">
                    <label class="form-label small">@T[f.LabelKey]</label>
                    <input class="form-control form-control-sm ltr-field" name="@f.Prop" type="color"
                           value="@(typeof(BlogApp.Models.CustomTheme).GetProperty(f.Prop)!.GetValue(Model))" />
                </div>
            }
        </div>
        <div class="d-flex gap-2 mt-3 flex-wrap">
            <button class="btn btn-ghost btn-sm" type="submit" name="action" value="draft">@T["themes.save_draft"]</button>
            <button class="btn btn-accent btn-sm" type="submit" name="action" value="submit">@T["themes.submit_review"]</button>
            @if (isSuper)
            {
                <button class="btn btn-accent btn-sm" type="submit" name="action" value="approve">@T["themes.create_approve"]</button>
            }
            <a class="btn btn-ghost btn-sm" asp-action="Index">@T["themes.back"]</a>
        </div>
    </form>
</div>
