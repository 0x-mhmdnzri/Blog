@model BlogApp.Models.CustomTheme
@using BlogApp.Models
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["themes.create"];
    var isSuper = User.IsInRole(AppRoles.SuperAdmin);
    var colors = new (string Prop, string LabelKey)[]
    {
        ("Bg", "themes.color_bg"),
        ("Surface", "themes.color_surface"),
        ("Surface2", "themes.color_surface2"),
        ("Border", "themes.color_border"),
        ("Text", "themes.color_text"),
        ("TextMuted", "themes.color_text_muted"),
        ("Accent", "themes.color_accent"),
        ("Danger", "themes.color_danger"),
        ("Success", "themes.color_success")
    };
}

<header class="tc-hero">
    <div>
        <p class="tc-eyebrow">@T["themes.title"]</p>
        <h1 class="tc-title">@T["themes.create"]</h1>
        <p class="tc-sub">@T["themes.contrast_hint"]</p>
    </div>
    <a class="tc-btn tc-btn-ghost" asp-action="Index">@T["themes.back"]</a>
</header>

<div asp-validation-summary="All" class="tc-errors"></div>

<form method="post" class="tc-form" id="themeCreateForm">
    @Html.AntiForgeryToken()

    <section class="tc-panel">
        <h2 class="tc-panel-title">@T["themes.name"]</h2>
        <div class="tc-field">
            <label class="tc-label" asp-for="Name">@T["themes.name"]</label>
            <input class="tc-input" asp-for="Name" required maxlength="80" />
        </div>
        <div class="tc-field">
            <label class="tc-label" asp-for="Description">@T["themes.desc"]</label>
            <input class="tc-input" asp-for="Description" maxlength="240" />
        </div>
        <div class="tc-field">
            <label class="tc-label" asp-for="Mode">Mode</label>
            <select class="tc-input" asp-for="Mode">
                <option value="dark">dark</option>
                <option value="light">light</option>
            </select>
        </div>
    </section>

    <section class="tc-panel">
        <h2 class="tc-panel-title">Colors</h2>
        <div class="tc-preview" id="tcPreview" aria-hidden="true">
            <span data-c="Bg" style="background:@Model.Bg"></span>
            <span data-c="Surface" style="background:@Model.Surface"></span>
            <span data-c="Surface2" style="background:@Model.Surface2"></span>
            <span data-c="Border" style="background:@Model.Border"></span>
            <span data-c="Text" style="background:@Model.Text"></span>
            <span data-c="TextMuted" style="background:@Model.TextMuted"></span>
            <span data-c="Accent" style="background:@Model.Accent"></span>
            <span data-c="Danger" style="background:@Model.Danger"></span>
            <span data-c="Success" style="background:@Model.Success"></span>
        </div>
        <div class="tc-colors">
            @foreach (var f in colors)
            {
                var val = typeof(CustomTheme).GetProperty(f.Prop)!.GetValue(Model)?.ToString() ?? "#000000";
                <label class="tc-color">
                    <span class="tc-color-label">@T[f.LabelKey]</span>
                    <input class="tc-color-input" type="color" name="@f.Prop" value="@val" data-preview="@f.Prop" />
                    <span class="tc-color-hex ltr-field" data-hex="@f.Prop">@val</span>
                </label>
            }
        </div>
    </section>

    <div class="tc-actions">
        <button class="tc-btn tc-btn-ghost" type="submit" name="action" value="draft">@T["themes.save_draft"]</button>
        <button class="tc-btn tc-btn-primary" type="submit" name="action" value="submit">@T["themes.submit_review"]</button>
        @if (isSuper)
        {
            <button class="tc-btn tc-btn-primary" type="submit" name="action" value="approve">@T["themes.create_approve"]</button>
        }
    </div>
</form>

@section Styles {
<style>
.tc-hero{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:1rem;margin-bottom:1.25rem}
.tc-eyebrow{font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--text-faint);margin:0 0 .3rem}
.tc-title{font-size:1.45rem;font-weight:750;margin:0;letter-spacing:-.02em}
.tc-sub{margin:.4rem 0 0;max-width:36rem;font-size:.88rem;line-height:1.55;color:var(--text-muted)}
.tc-errors{margin:0 0 1rem;padding:.75rem 1rem;border-radius:10px;font-size:.86rem;background:color-mix(in srgb,var(--danger) 12%,var(--surface));border:1px solid color-mix(in srgb,var(--danger) 30%,var(--border));color:var(--danger)}
.tc-errors:empty{display:none}
.tc-form{max-width:40rem;display:flex;flex-direction:column;gap:1rem}
.tc-panel{background:var(--surface);border:1px solid var(--border-soft);border-radius:14px;padding:1.1rem 1.2rem}
.tc-panel-title{font-size:.78rem;font-weight:650;color:var(--text-muted);margin:0 0 .9rem;letter-spacing:.02em}
.tc-field{margin-bottom:.85rem}
.tc-field:last-child{margin-bottom:0}
.tc-label{display:block;font-size:.78rem;font-weight:600;color:var(--text-muted);margin-bottom:.35rem}
.tc-input{width:100%;background:var(--bg);border:1px solid var(--border-soft);border-radius:9px;padding:.5rem .75rem;color:var(--text);font-size:.9rem;font-family:inherit}
.tc-input:focus{outline:none;border-color:var(--accent-dim,var(--accent));box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 15%,transparent)}
.tc-preview{display:grid;grid-template-columns:repeat(9,1fr);height:2.75rem;border-radius:10px;overflow:hidden;margin-bottom:1rem;border:1px solid var(--border-soft)}
.tc-preview span{min-width:0}
.tc-colors{display:grid;grid-template-columns:repeat(auto-fill,minmax(9rem,1fr));gap:.65rem}
.tc-color{display:flex;flex-direction:column;gap:.3rem;padding:.55rem .65rem;border-radius:10px;border:1px solid var(--border-soft);background:var(--bg)}
.tc-color-label{font-size:.72rem;font-weight:600;color:var(--text-muted)}
.tc-color-input{width:100%;height:2.25rem;padding:0;border:none;background:transparent;cursor:pointer}
.tc-color-hex{font-size:.72rem;color:var(--text-faint)}
.tc-actions{display:flex;flex-wrap:wrap;gap:.5rem;padding-top:.25rem}
.tc-btn{display:inline-flex;align-items:center;justify-content:center;border-radius:9px;padding:.5rem 1rem;font-size:.84rem;font-weight:600;font-family:inherit;cursor:pointer;border:1px solid transparent;text-decoration:none!important}
.tc-btn-primary{background:var(--accent);color:#111}
.tc-btn-primary:hover{filter:brightness(1.05)}
.tc-btn-ghost{background:transparent;border-color:var(--border-soft);color:var(--text)}
.tc-btn-ghost:hover{border-color:var(--border);background:var(--surface-2)}
</style>
}

@section Scripts {
<script>
(function () {
  var form = document.getElementById('themeCreateForm');
  if (!form) return;
  form.querySelectorAll('[data-preview]').forEach(function (input) {
    var key = input.getAttribute('data-preview');
    function sync() {
      var v = input.value;
      var sw = document.querySelector('#tcPreview [data-c="' + key + '"]');
      if (sw) sw.style.background = v;
      var hex = document.querySelector('[data-hex="' + key + '"]');
      if (hex) hex.textContent = v;
    }
    input.addEventListener('input', sync);
    sync();
  });
})();
</script>
}
