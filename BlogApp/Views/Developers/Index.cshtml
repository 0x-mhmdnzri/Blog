@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "راهنمای توسعه‌دهندگان API";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

<style>
.dev-book { max-width: 880px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
.dev-hero {
  border-radius: 18px; padding: 1.5rem 1.4rem 1.35rem;
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 14%, var(--surface)), var(--surface));
  border: 1px solid var(--border-soft); margin-bottom: 1.5rem;
}
.dev-hero h1 { font-size: 1.45rem; font-weight: 750; margin: 0 0 .4rem; }
.dev-hero p { margin: 0; color: var(--text-muted); font-size: .92rem; line-height: 1.65; max-width: 38rem; }
.dev-toc {
  display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0 0;
}
.dev-toc a {
  font-size: .78rem; padding: .35rem .7rem; border-radius: 999px;
  border: 1px solid var(--border-soft); background: var(--surface); color: var(--text); text-decoration: none;
}
.dev-toc a:hover { border-color: var(--accent); color: var(--accent); }
.dev-sec {
  background: var(--surface); border: 1px solid var(--border-soft); border-radius: 14px;
  padding: 1.15rem 1.25rem; margin-bottom: 1rem; scroll-margin-top: 5rem;
}
.dev-sec h2 {
  font-size: 1.05rem; font-weight: 700; margin: 0 0 .75rem;
  display: flex; align-items: center; gap: .5rem;
}
.dev-sec h2 .n {
  width: 1.5rem; height: 1.5rem; border-radius: 8px; font-size: .75rem; font-weight: 700;
  display: inline-flex; align-items: center; justify-content: center;
  background: color-mix(in srgb, var(--accent) 20%, transparent); color: var(--accent);
}
.dev-sec h3 { font-size: .9rem; font-weight: 650; margin: 1rem 0 .4rem; }
.dev-sec p, .dev-sec li { font-size: .88rem; line-height: 1.65; color: var(--text); }
.dev-sec ul { padding-inline-start: 1.2rem; margin: .4rem 0 .6rem; }
.dev-callout {
  border-radius: 10px; padding: .75rem .9rem; font-size: .84rem; line-height: 1.55; margin: .75rem 0;
  border: 1px solid var(--border-soft);
}
.dev-callout.info { background: color-mix(in srgb, #6fb3d2 12%, transparent); border-color: color-mix(in srgb, #6fb3d2 35%, var(--border-soft)); }
.dev-callout.warn { background: color-mix(in srgb, #e3b341 12%, transparent); border-color: color-mix(in srgb, #e3b341 40%, var(--border-soft)); }
.dev-callout.ok { background: color-mix(in srgb, #9ecb8c 12%, transparent); border-color: color-mix(in srgb, #9ecb8c 35%, var(--border-soft)); }
.dev-code {
  direction: ltr; text-align: left; font-family: ui-monospace, "JetBrains Mono", Menlo, monospace;
  font-size: .78rem; line-height: 1.5; padding: .85rem 1rem; border-radius: 10px;
  background: color-mix(in srgb, #000 35%, var(--surface)); border: 1px solid var(--border-soft);
  overflow-x: auto; margin: .55rem 0 .85rem; white-space: pre;
}
[data-theme="light"] .dev-code { background: #f4f6fa; }
.dev-table { width: 100%; border-collapse: collapse; font-size: .82rem; margin: .5rem 0 0; }
.dev-table th, .dev-table td {
  border-bottom: 1px solid var(--border-soft); padding: .45rem .5rem; text-align: start; vertical-align: top;
}
.dev-table th { color: var(--text-muted); font-weight: 600; font-size: .75rem; }
.dev-table code { direction: ltr; font-size: .78rem; }
.dev-badge {
  display: inline-block; font-size: .68rem; font-weight: 700; padding: .12rem .4rem; border-radius: 4px;
  font-family: ui-monospace, monospace; direction: ltr;
  background: color-mix(in srgb, var(--accent) 16%, transparent);
}
.dev-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
</style>

<div class="dev-book">
    <header class="dev-hero">
        <h1>کتابچهٔ راهنمای API برای توسعه‌دهندگان</h1>
        <p>
            این صفحه راهنمای انسانی است — نه JSON خام.
            گام‌به‌گام: ساخت کلید (PAT)، تأیید سوپرادمین، احراز هویت، REST، GraphQL، Webhook و RSS.
        </p>
        <nav class="dev-toc" aria-label="فهرست">
            <a href="#s1">۱. شروع</a>
            <a href="#s2">۲. کلید API</a>
            <a href="#s3">۳. احراز هویت</a>
            <a href="#s4">۴. REST</a>
            <a href="#s5">۵. GraphQL</a>
            <a href="#s6">۶. Webhooks</a>
            <a href="#s7">۷. RSS / Atom</a>
            <a href="#s8">۸. محدودیت‌ها</a>
            <a href="#s9">۹. خطاها</a>
        </nav>
        <div class="dev-actions">
            <a class="btn btn-accent btn-sm" asp-controller="AccountApiKeys" asp-action="Index">درخواست کلید API</a>
            <a class="btn btn-ghost btn-sm" href="/api/docs" target="_blank" rel="noopener">JSON machine docs</a>
        </div>
    </header>

    <section class="dev-sec" id="s1">
        <h2><span class="n">۱</span> شروع سریع</h2>
        <ol>
            <li>حساب بسازید و وارد شوید (نقش Reader یا Author کافی است).</li>
            <li>از منوی حساب → <strong>کلیدهای API (PAT)</strong> یک کلید درخواست کنید.</li>
            <li>توکن را <strong>همان لحظه کپی</strong> کنید — فقط یک‌بار نمایش داده می‌شود.</li>
            <li>صبر کنید تا <strong>سوپرادمین</strong> درخواست را تأیید کند؛ اعلان «کلید API شما تأیید شد» می‌گیرید.</li>
            <li>با هدر زیر به API درخواست بزنید.</li>
        </ol>
        <div class="dev-code">curl -s @baseUrl/api/v1/posts \
  -H "X-Api-Key: blog_YOUR_TOKEN_HERE"</div>
        <div class="dev-callout warn">
            قبل از تأیید سوپرادمین، حتی با توکن صحیح پاسخ <strong>401</strong> با پیام pending approval می‌گیرید.
        </div>
    </section>

    <section class="dev-sec" id="s2">
        <h2><span class="n">۲</span> کلید API (مثل GitHub PAT)</h2>
        <ul>
            <li>مسیر کاربر: <code class="ltr-field">/AccountApiKeys</code></li>
            <li>مسیر سوپرادمین: <code class="ltr-field">/AdminApiKeys</code> — تأیید / رد / بن / خاموش</li>
            <li>Scopes پیشنهادی: <code class="ltr-field">read</code> · <code class="ltr-field">write</code> · <code class="ltr-field">webhooks</code> (با کاما)</li>
            <li>حداکثر حدود ۱۰ کلید غیرردشده به‌ازای هر کاربر</li>
        </ul>
        <div class="dev-callout info">
            توکن با پیشوند <code class="ltr-field">blog_</code> شروع می‌شود. فقط hash ذخیره می‌شود؛ سرور توکن را دوباره به شما نشان نمی‌دهد.
        </div>
    </section>

    <section class="dev-sec" id="s3">
        <h2><span class="n">۳</span> احراز هویت</h2>
        <p>یکی از دو هدر را بفرستید:</p>
        <div class="dev-code">X-Api-Key: blog_…

# یا
Authorization: Bearer blog_…</div>
        <h3>مثال Python</h3>
        <div class="dev-code">import requests

r = requests.get(
    "@baseUrl/api/v1/posts",
    headers={"X-Api-Key": "blog_YOUR_TOKEN"},
    params={"page": 1, "pageSize": 10},
)
print(r.status_code, r.json())</div>
        <h3>مثال JavaScript (fetch)</h3>
        <div class="dev-code">const res = await fetch("@baseUrl/api/v1/posts?page=1", {
  headers: { "X-Api-Key": "blog_YOUR_TOKEN" },
});
const data = await res.json();
console.log(data);</div>
    </section>

    <section class="dev-sec" id="s4">
        <h2><span class="n">۴</span> REST API v1</h2>
        <p>پایه: <code class="ltr-field">@baseUrl/api/v1</code></p>
        <table class="dev-table">
            <thead>
            <tr>
                <th>Method</th>
                <th>Path</th>
                <th>Scope</th>
                <th>توضیح</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td><span class="dev-badge">GET</span></td>
                <td><code>/api/v1/posts</code></td>
                <td><code>read</code></td>
                <td>لیست نوشته‌ها — query: <code>page</code>, <code>pageSize</code>, <code>q</code>, <code>lang</code>, <code>tag</code>, <code>category</code></td>
            </tr>
            <tr>
                <td><span class="dev-badge">GET</span></td>
                <td><code>/api/v1/posts/&#123;slug&#125;</code></td>
                <td><code>read</code></td>
                <td>جزئیات یک نوشته — query: <code>lang</code></td>
            </tr>
            <tr>
                <td><span class="dev-badge">POST</span></td>
                <td><code>/api/v1/comments</code></td>
                <td><code>write</code></td>
                <td>ثبت دیدگاه — body JSON: <code>postId</code>, <code>authorName</code>, <code>body</code></td>
            </tr>
            <tr>
                <td><span class="dev-badge">GET</span></td>
                <td><code>/api/v1/webhooks</code></td>
                <td><code>webhooks</code></td>
                <td>لیست webhookهای شما</td>
            </tr>
            <tr>
                <td><span class="dev-badge">POST</span></td>
                <td><code>/api/v1/webhooks</code></td>
                <td><code>webhooks</code></td>
                <td>ثبت webhook — فقط HTTPS عمومی</td>
            </tr>
            <tr>
                <td><span class="dev-badge">DELETE</span></td>
                <td><code>/api/v1/webhooks/&#123;id&#125;</code></td>
                <td><code>webhooks</code></td>
                <td>حذف webhook</td>
            </tr>
            </tbody>
        </table>

        <h3>نمونه لیست پست</h3>
        <div class="dev-code">curl -s "@baseUrl/api/v1/posts?page=1&amp;pageSize=5&amp;lang=fa" \
  -H "Authorization: Bearer blog_YOUR_TOKEN"</div>

        <h3>نمونه ثبت دیدگاه</h3>
        <div class="dev-code">curl -s -X POST "@baseUrl/api/v1/comments" \
  -H "X-Api-Key: blog_YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"postId":1,"authorName":"Dev","body":"سلام از API"}'</div>
        <div class="dev-callout ok">
            ورودی‌های write با <strong>FluentValidation</strong> و sanitizer بررسی می‌شوند (طول، XSS، و برای webhook جلوگیری از SSRF).
        </div>
    </section>

    <section class="dev-sec" id="s5">
        <h2><span class="n">۵</span> GraphQL (مینیمال)</h2>
        <p>Endpoint: <code class="ltr-field">POST @baseUrl/api/graphql</code> — نیاز به scope <code class="ltr-field">read</code></p>
        <div class="dev-code">curl -s -X POST "@baseUrl/api/graphql" \
  -H "X-Api-Key: blog_YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"query":"{ posts(limit:5) { title slug } }"}'</div>
        <p class="small text-muted-dark mb-0">کوئری‌های پشتیبانی‌شده: لیست و جزئیات پست (حداقل فیلدها).</p>
    </section>

    <section class="dev-sec" id="s6">
        <h2><span class="n">۶</span> Webhooks</h2>
        <ul>
            <li>Scope لازم: <code class="ltr-field">webhooks</code></li>
            <li>فقط URLهای <strong>HTTPS</strong> عمومی — میزبان‌های خصوصی/لوکال رد می‌شوند</li>
            <li>رویدادهای نمونه: <code class="ltr-field">post.published</code>, <code class="ltr-field">comment.created</code></li>
        </ul>
        <div class="dev-code">curl -s -X POST "@baseUrl/api/v1/webhooks" \
  -H "X-Api-Key: blog_YOUR_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"targetUrl":"https://example.com/hook","events":"post.published"}'</div>
    </section>

    <section class="dev-sec" id="s7">
        <h2><span class="n">۷</span> RSS / Atom (بدون کلید)</h2>
        <p>فیدهای عمومی نیاز به API Key ندارند:</p>
        <div class="dev-code">@baseUrl/feed/rss
@baseUrl/feed/atom</div>
    </section>

    <section class="dev-sec" id="s8">
        <h2><span class="n">۸</span> محدودیت نرخ و سوءاستفاده</h2>
        <ul>
            <li>سیاست تقریبی: حدود <strong>۶۰ درخواست در دقیقه</strong> به‌ازای هر کلید (Kestrel rate limiter)</li>
            <li>پاسخ <code class="ltr-field">429 Too Many Requests</code> = strike</li>
            <li>پس از حدود <strong>۵ strike</strong> کلید به‌صورت خودکار <strong>بن</strong> می‌شود</li>
            <li>سوپرادمین می‌تواند دستی بن/رفع بن کند و در Analytics ترافیک را ببیند</li>
        </ul>
        <div class="dev-callout warn">
            کلید را در کلاینت مرورگر یا ریپوی عمومی commit نکنید. برای CI از secret store استفاده کنید.
        </div>
    </section>

    <section class="dev-sec" id="s9">
        <h2><span class="n">۹</span> خطاهای رایج</h2>
        <table class="dev-table">
            <thead>
            <tr><th>کد</th><th>معنی رایج</th></tr>
            </thead>
            <tbody>
            <tr><td><code>401</code></td><td>کلید نیست / اشتباه / هنوز تأیید نشده / منقضی / بن‌شده</td></tr>
            <tr><td><code>403</code></td><td>scope کافی نیست (مثلاً write بدون scope write)</td></tr>
            <tr><td><code>400</code></td><td>اعتبارسنجی FluentValidation شکست خورده</td></tr>
            <tr><td><code>404</code></td><td>منبع پیدا نشد</td></tr>
            <tr><td><code>429</code></td><td>نرخ درخواست بیش از حد — صبر کنید</td></tr>
            </tbody>
        </table>
        <div class="dev-actions">
            <a class="btn btn-accent btn-sm" asp-controller="AccountApiKeys" asp-action="Index">مدیریت کلیدهای من</a>
            <a class="btn btn-ghost btn-sm" asp-controller="Pages" asp-action="Contact">پشتیبانی / تماس</a>
            <a class="btn btn-ghost btn-sm" href="/api/docs">OpenAPI-style JSON</a>
        </div>
    </section>
</div>
