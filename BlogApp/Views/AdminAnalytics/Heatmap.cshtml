@model HeatmapDetailViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["ana.heatmap"] + ": " + Model.Title;
    var maxCount = Model.Points.Count == 0 ? 1 : Model.Points.Max(p => p.Count);
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h5 mb-1" dir="auto">@Model.Title</h1>
        <p class="text-muted-dark small mb-0">
            <span class="ltr-field">@Model.TotalClicks</span> @T["ana.clicks"]
            · <span class="ltr-field">@Model.UniqueCells</span> @T["ana.heatmap_cells"]
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-ghost btn-sm" asp-action="Heatmaps">@T["ana.back_heatmap_list"]</a>
        <a class="btn btn-ghost btn-sm" asp-controller="Posts" asp-action="Details" asp-route-slug="@Model.Slug">@T["ana.btn_open_post"]</a>
    </div>
</div>

<div class="range-tabs mb-3">
    <a class="admin-tab @(Model.RangeDays == 7 ? "active" : "")" asp-action="Heatmap" asp-route-id="@Model.PostId" asp-route-range="7">@T["dash.range_7"]</a>
    <a class="admin-tab @(Model.RangeDays == 30 ? "active" : "")" asp-action="Heatmap" asp-route-id="@Model.PostId" asp-route-range="30">@T["dash.range_30"]</a>
    <a class="admin-tab @(Model.RangeDays == 90 ? "active" : "")" asp-action="Heatmap" asp-route-id="@Model.PostId" asp-route-range="90">@T["dash.range_90"]</a>
    <a class="admin-tab @(Model.RangeDays == 0 ? "active" : "")" asp-action="Heatmap" asp-route-id="@Model.PostId" asp-route-range="0">@T["ana.range_all"]</a>
</div>

<div class="chart-card mb-4">
    <div class="chart-title">@T["ana.heatmap"]</div>
    <div class="chart-subtitle">@T["ana.heatmap_sub"]</div>
    <div id="heatmapBox" class="heatmap-canvas" style="position:relative;height:min(70vh,520px);min-height:320px;background:var(--surface-2);border-radius:10px;overflow:hidden;border:1px solid var(--border-soft);">
        @foreach (var h in Model.Points)
        {
            var intensity = Math.Clamp(h.Count * 1.0 / maxCount, 0.12, 1.0);
            var size = 10 + (int)(intensity * 18);
            var left = h.X / 10.0;
            var top = h.Y / 10.0;
            var op = (0.25 + intensity * 0.65).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
            <span class="heatmap-dot"
                  style="position:absolute;left:@left.ToString(System.Globalization.CultureInfo.InvariantCulture)%;top:@top.ToString(System.Globalization.CultureInfo.InvariantCulture)%;width:@(size)px;height:@(size)px;margin:-@(size / 2)px;border-radius:50%;background:rgba(227,179,65,@op);box-shadow:0 0 @(size)px rgba(227,179,65,@op);"
                  title="@h.Count"></span>
        }
        @if (Model.Points.Count == 0)
        {
            <div class="admin-empty" style="padding:2.5rem;border:none;background:transparent;">
                <p class="mb-0">@T["ana.empty_heatmap"]</p>
            </div>
        }
    </div>
</div>

@if (Model.Points.Count > 0)
{
    <h2 class="h6 text-muted-dark mb-2">@T["ana.heatmap_hotspots"]</h2>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th class="ltr-field">X</th>
                    <th class="ltr-field">Y</th>
                    <th>@T["ana.col_clicks"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var h in Model.Points.OrderByDescending(p => p.Count).Take(25))
            {
                <tr>
                    <td class="ltr-field">@h.X</td>
                    <td class="ltr-field">@h.Y</td>
                    <td class="ltr-field">@h.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
