@model AnalyticsDashboardViewModel
@using System.Text.Json
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["ana.title"];
    var json = new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    string FmtSeconds(double s)
    {
        if (s <= 0) return "—";
        if (s < 60) return $"{s:0}s";
        return $"{(int)(s / 60)}m {(int)(s % 60)}s";
    }
}

<p class="text-muted-dark small mb-3">@T["ana.subtitle"]</p>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="range-tabs">
        <a class="admin-tab @(Model.RangeDays == 7 ? "active" : "")" asp-action="Index" asp-route-range="7">@T["dash.range_7"]</a>
        <a class="admin-tab @(Model.RangeDays == 30 ? "active" : "")" asp-action="Index" asp-route-range="30">@T["dash.range_30"]</a>
        <a class="admin-tab @(Model.RangeDays == 90 ? "active" : "")" asp-action="Index" asp-route-range="90">@T["dash.range_90"]</a>
    </div>
    <a class="btn btn-ghost btn-sm" asp-controller="Admin" asp-action="Index">@T["ana.back_ops"]</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@T["ana.kpi_views"]</div>
            <div class="kpi-value ltr-field">@Model.TotalViews</div>
            <div class="kpi-sub">@T["ana.in_range"]</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@T["ana.kpi_unique"]</div>
            <div class="kpi-value ltr-field">@Model.UniqueVisitors</div>
            <div class="kpi-sub">@T["ana.kpi_vpv"]: <span class="ltr-field">@Model.ViewsPerVisitor</span></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card @(Model.BounceRatePercent > 60 ? "kpi-danger" : "")">
            <div class="kpi-label">@T["ana.kpi_bounce"]</div>
            <div class="kpi-value ltr-field">@Model.BounceRatePercent%</div>
            <div class="kpi-sub">@Model.SessionCount @T["ana.sessions"]</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card kpi-good">
            <div class="kpi-label">@T["ana.kpi_read"]</div>
            <div class="kpi-value ltr-field" style="font-size:1.35rem;">@FmtSeconds(Model.AvgReadingSeconds)</div>
            <div class="kpi-sub">@T["ana.kpi_returning"]: <span class="ltr-field">@Model.ReturningVisitorPercent%</span></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi-card"><div class="kpi-label">@T["ana.kpi_searches"]</div><div class="kpi-value ltr-field" style="font-size:1.25rem;">@Model.SearchQueryCount</div></div>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Heatmaps" class="text-decoration-none">
            <div class="kpi-card" style="cursor:pointer;">
                <div class="kpi-label">@T["ana.kpi_heatmap_clicks"]</div>
                <div class="kpi-value ltr-field" style="font-size:1.25rem;">@Model.HeatmapClickCount</div>
                <div class="kpi-sub">@T["ana.heatmap_open_list"] →</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card"><div class="kpi-label">@T["ana.kpi_sources"]</div><div class="kpi-value ltr-field" style="font-size:1.25rem;">@Model.TrafficSources.Count</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card"><div class="kpi-label">@T["ana.kpi_countries"]</div><div class="kpi-value ltr-field" style="font-size:1.25rem;">@Model.Countries.Count</div></div>
    </div>
</div>

<div class="chart-card mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <div class="chart-title mb-0">@T["ana.heatmap"]</div>
            <div class="chart-subtitle mb-0">@T["ana.heatmap_cta_sub"]</div>
        </div>
        <a class="btn btn-accent btn-sm" asp-action="Heatmaps">@T["ana.heatmap_open_list"]</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-title">@T["ana.chart_views"]</div>
            <div class="chart-subtitle">@T["ana.chart_views_sub"]</div>
            <div class="chart-canvas-wrap" style="height:250px;"><canvas id="viewsChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-title">@T["ana.chart_sources"]</div>
            <div class="chart-subtitle">@T["ana.chart_sources_sub"]</div>
            <div class="chart-canvas-wrap" style="height:250px;"><canvas id="sourceChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="chart-card">
            <div class="chart-title">@T["ana.chart_hours"]</div>
            <div class="chart-subtitle">@T["ana.chart_hours_sub"]</div>
            <div class="chart-canvas-wrap" style="height:200px;"><canvas id="hourChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="chart-card">
            <div class="chart-title">@T["ana.chart_device"]</div>
            <div class="chart-canvas-wrap" style="height:200px;"><canvas id="deviceChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="chart-card">
            <div class="chart-title">@T["ana.chart_browser"]</div>
            <div class="chart-canvas-wrap" style="height:200px;"><canvas id="browserChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="chart-card">
            <div class="chart-title">@T["ana.chart_os"]</div>
            <div class="chart-canvas-wrap" style="height:200px;"><canvas id="osChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="chart-card">
            <div class="chart-title">@T["ana.chart_geo"]</div>
            <div class="chart-canvas-wrap" style="height:200px;"><canvas id="geoChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0 text-muted-dark">@T["ana.popular"]</h2>
        </div>
        @if (Model.PopularPosts.Count == 0)
        {
            <div class="admin-empty"><p class="mb-0">@T["ana.empty_posts"]</p></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>@T["col.title"]</th><th>@T["ana.col_all_time"]</th><th>@T["ana.col_range"]</th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.PopularPosts)
                    {
                        <tr>
                            <td dir="auto"><a asp-controller="Posts" asp-action="Details" asp-route-slug="@p.Slug">@p.Title</a></td>
                            <td class="ltr-field">@p.Views</td>
                            <td class="ltr-field">@p.RangeViews</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0 text-muted-dark">@T["ana.trending"]</h2>
        </div>
        @if (Model.TrendingPosts.Count == 0)
        {
            <div class="admin-empty"><p class="mb-0">@T["ana.empty_trending"]</p></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>@T["col.title"]</th><th>@T["ana.col_recent"]</th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.TrendingPosts)
                    {
                        <tr>
                            <td dir="auto"><a asp-controller="Posts" asp-action="Details" asp-route-slug="@p.Slug">@p.Title</a></td>
                            <td class="ltr-field">@p.RangeViews</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-2">@T["ana.referrers"]</h2>
        @if (Model.Referrers.Count == 0)
        {
            <div class="admin-empty"><p class="mb-0">@T["ana.empty_referrers"]</p></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>@T["ana.col_host"]</th><th>@T["ana.col_count"]</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Referrers)
                    {
                        <tr><td class="ltr-field">@r.Name</td><td class="ltr-field">@r.Count</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-2">@T["ana.search_kw"]</h2>
        @if (Model.SearchKeywords.Count == 0)
        {
            <div class="admin-empty"><p class="mb-0">@T["ana.empty_search"]</p></div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>@T["ana.col_query"]</th><th>@T["ana.col_count"]</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.SearchKeywords)
                    {
                        <tr><td dir="auto">@s.Name</td><td class="ltr-field">@s.Count</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
    if (typeof Chart === 'undefined') return;
    const styles = getComputedStyle(document.documentElement);
    const muted = styles.getPropertyValue('--text-muted').trim();
    const accent = styles.getPropertyValue('--accent').trim();
    const border = styles.getPropertyValue('--border-soft').trim();
    Chart.defaults.color = muted;
    Chart.defaults.borderColor = border;
    Chart.defaults.font.family = 'Vazirmatn, sans-serif';
    const palette = [accent, '#6fb3d2', '#c9a0f2', '#9ecb8c', '#e5637a', '#f2789f', '#e3b341', '#8b93a7'];

    function doughnut(id, labels, data) {
        const el = document.getElementById(id);
        if (!el) return;
        if (!labels || !labels.length) {
            el.parentElement.innerHTML = '<div class="admin-empty" style="padding:1.5rem;border:none;"><p class="mb-0 small">—</p></div>';
            return;
        }
        new Chart(el, {
            type: 'doughnut',
            data: { labels, datasets: [{ data, backgroundColor: palette, borderWidth: 0 }] },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '62%',
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 10 } } }
            }
        });
    }

    const dayLabels = @Html.Raw(JsonSerializer.Serialize(Model.ViewsByDay.Select(p => p.Label), json));
    const dayValues = @Html.Raw(JsonSerializer.Serialize(Model.ViewsByDay.Select(p => p.Value), json));
    new Chart(document.getElementById('viewsChart'), {
        type: 'line',
        data: {
            labels: dayLabels,
            datasets: [{
                data: dayValues,
                borderColor: accent,
                backgroundColor: 'rgba(227,179,65,.12)',
                fill: true,
                tension: 0.3,
                pointRadius: 2,
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { maxTicksLimit: 10 } },
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        }
    });

    const hourLabels = @Html.Raw(JsonSerializer.Serialize(Model.ViewsByHour.Select(p => p.Label), json));
    const hourValues = @Html.Raw(JsonSerializer.Serialize(Model.ViewsByHour.Select(p => p.Value), json));
    new Chart(document.getElementById('hourChart'), {
        type: 'bar',
        data: {
            labels: hourLabels,
            datasets: [{
                data: hourValues,
                backgroundColor: 'rgba(111,179,210,0.55)',
                borderRadius: 3,
                maxBarThickness: 18
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { maxTicksLimit: 12 } },
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        }
    });

    doughnut('sourceChart',
        @Html.Raw(JsonSerializer.Serialize(Model.TrafficSources.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.TrafficSources.Select(x => x.Count), json)));
    doughnut('deviceChart',
        @Html.Raw(JsonSerializer.Serialize(Model.Devices.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.Devices.Select(x => x.Count), json)));
    doughnut('browserChart',
        @Html.Raw(JsonSerializer.Serialize(Model.Browsers.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.Browsers.Select(x => x.Count), json)));
    doughnut('osChart',
        @Html.Raw(JsonSerializer.Serialize(Model.OperatingSystems.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.OperatingSystems.Select(x => x.Count), json)));
    doughnut('geoChart',
        @Html.Raw(JsonSerializer.Serialize(Model.Countries.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.Countries.Select(x => x.Count), json)));
})();
</script>
}
