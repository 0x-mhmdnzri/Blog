@model AnalyticsDashboardViewModel
@using System.Text.Json
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "آمار و تحلیل";
    var json = new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="range-tabs">
        <a class="admin-tab @(Model.RangeDays == 7 ? "active" : "")" asp-action="Index" asp-route-range="7">۷ روز</a>
        <a class="admin-tab @(Model.RangeDays == 30 ? "active" : "")" asp-action="Index" asp-route-range="30">۳۰ روز</a>
        <a class="admin-tab @(Model.RangeDays == 90 ? "active" : "")" asp-action="Index" asp-route-range="90">۹۰ روز</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="kpi-card"><div class="kpi-label">بازدید</div><div class="kpi-value ltr-field">@Model.TotalViews</div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi-card"><div class="kpi-label">بازدیدکننده یکتا</div><div class="kpi-value ltr-field">@Model.UniqueVisitors</div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi-card"><div class="kpi-label">نرخ پرش</div><div class="kpi-value ltr-field">@Model.BounceRatePercent٪</div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi-card"><div class="kpi-label">میانگین مطالعه (ثانیه)</div><div class="kpi-value ltr-field">@Model.AvgReadingSeconds</div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-title">روند بازدید</div>
            <div class="chart-canvas-wrap" style="height:240px;"><canvas id="viewsChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-title">منابع ترافیک</div>
            <div class="chart-canvas-wrap" style="height:240px;"><canvas id="sourceChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="chart-card">
            <div class="chart-title">دستگاه</div>
            <div class="chart-canvas-wrap" style="height:200px;"><canvas id="deviceChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="chart-card">
            <div class="chart-title">مرورگر</div>
            <div class="chart-canvas-wrap" style="height:200px;"><canvas id="browserChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="chart-card">
            <div class="chart-title">جغرافیا (کشور)</div>
            <div class="chart-canvas-wrap" style="height:200px;"><canvas id="geoChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-2">پربازدیدترین</h2>
        <table class="admin-table">
            <thead><tr><th>نوشته</th><th>کل</th><th>بازه</th></tr></thead>
            <tbody>
            @foreach (var p in Model.PopularPosts)
            {
                <tr>
                    <td dir="auto"><a asp-controller="Posts" asp-action="Details" asp-route-slug="@p.Slug">@p.Title</a></td>
                    <td class="ltr-field">@p.Views</td>
                    <td class="ltr-field">@p.RangeViews</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-2">پرطرفدار (۳ روز اخیر)</h2>
        <table class="admin-table">
            <thead><tr><th>نوشته</th><th>بازدید اخیر</th></tr></thead>
            <tbody>
            @foreach (var p in Model.TrendingPosts)
            {
                <tr>
                    <td dir="auto"><a asp-controller="Posts" asp-action="Details" asp-route-slug="@p.Slug">@p.Title</a></td>
                    <td class="ltr-field">@p.RangeViews</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-2">ارجاع‌دهنده‌ها</h2>
        <table class="admin-table">
            <thead><tr><th>میزبان</th><th>تعداد</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Referrers)
            {
                <tr><td class="ltr-field">@r.Name</td><td class="ltr-field">@r.Count</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-2">کلمات جست‌وجو</h2>
        <table class="admin-table">
            <thead><tr><th>عبارت</th><th>تعداد</th></tr></thead>
            <tbody>
            @foreach (var s in Model.SearchKeywords)
            {
                <tr><td dir="auto">@s.Name</td><td class="ltr-field">@s.Count</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="chart-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div class="chart-title mb-0">نقشه حرارتی کلیک</div>
        <form method="get" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="range" value="@Model.RangeDays" />
            <select name="heatmapPostId" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width:240px;">
                @foreach (var o in Model.HeatmapPostOptions)
                {
                    if (Model.HeatmapPostId == o.Id)
                    {
                        <option value="@o.Id" selected>@o.Title</option>
                    }
                    else
                    {
                        <option value="@o.Id">@o.Title</option>
                    }
                }
            </select>
        </form>
    </div>
    <div class="chart-subtitle">@Model.HeatmapPostTitle — نقاط نسبی روی بدنه نوشته</div>
    <div id="heatmapBox" style="position:relative;height:280px;background:var(--surface-2);border-radius:8px;overflow:hidden;">
        @foreach (var h in Model.Heatmap)
        {
            var op = Math.Min(0.85, 0.15 + h.Count * 0.12);
            <span style="position:absolute;left:@(h.X / 10.0)%;top:@(h.Y / 10.0)%;width:12px;height:12px;margin:-6px;border-radius:50%;background:rgba(227,179,65,@op.ToString(System.Globalization.CultureInfo.InvariantCulture));" title="@h.Count"></span>
        }
        @if (Model.Heatmap.Count == 0)
        {
            <div class="admin-empty" style="padding:2rem;">هنوز کلیکی ثبت نشده — روی نوشته‌ها کلیک کنید.</div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
    if (typeof Chart === 'undefined') return;
    const muted = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim();
    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
    Chart.defaults.color = muted;
    Chart.defaults.font.family = 'Vazirmatn, sans-serif';

    function doughnut(id, labels, data) {
        const el = document.getElementById(id);
        if (!el) return;
        new Chart(el, {
            type: 'doughnut',
            data: { labels, datasets: [{ data, backgroundColor: [accent,'#6fb3d2','#c9a0f2','#9ecb8c','#e5637a','#f2789f'] }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } } }
        });
    }

    new Chart(document.getElementById('viewsChart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(JsonSerializer.Serialize(Model.ViewsByDay.Select(p => p.Label), json)),
            datasets: [{ data: @Html.Raw(JsonSerializer.Serialize(Model.ViewsByDay.Select(p => p.Value), json)), borderColor: accent, fill: true, tension: 0.3, backgroundColor: 'rgba(227,179,65,.12)' }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });

    doughnut('sourceChart',
        @Html.Raw(JsonSerializer.Serialize(Model.TrafficSources.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.TrafficSources.Select(x => x.Count), json)));
    doughnut('deviceChart',
        @Html.Raw(JsonSerializer.Serialize(Model.Devices.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.Devices.Select(x => x.Count), json)));
    doughnut('browserChart',
        @Html.Raw(JsonSerializer.Serialize(Model.Browsers.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.Browsers.Select(x => x.Count), json)));
    doughnut('geoChart',
        @Html.Raw(JsonSerializer.Serialize(Model.Countries.Select(x => x.Name), json)),
        @Html.Raw(JsonSerializer.Serialize(Model.Countries.Select(x => x.Count), json)));
})();
</script>
}
