@model List<BlogApp.Models.AppNotification>
@{
    ViewData["Title"] = T["notif.title"];
    var unread = Model.Count(n => !n.IsRead);
    var totalCount = Model.Count;
}

<div class="ni-page">
    <header class="ni-hero">
        <div class="ni-hero-text">
            <p class="ni-eyebrow">Inbox</p>
            <h1 class="ni-title">@T["notif.title"]</h1>
            <p class="ni-sub">
                @if (unread > 0)
                {
                    <text><span class="ni-sub-strong">@unread</span> خوانده‌نشده از @totalCount اعلان</text>
                }
                else if (totalCount > 0)
                {
                    <text>همه @totalCount اعلان خوانده شده‌اند</text>
                }
                else
                {
                    <text>هنوز اعلانی ندارید</text>
                }
            </p>
        </div>
        <div class="ni-hero-acts">
            <a class="ni-btn ni-btn-ghost" asp-action="Preferences">@T["notif.preferences"]</a>
            @if (unread > 0)
            {
                <form asp-action="MarkAllRead" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ni-btn ni-btn-accent">@T["notif.mark_all"]</button>
                </form>
            }
        </div>
    </header>

    <div class="ni-shell">
        <aside class="ni-nav" aria-label="folders">
            <button type="button" class="ni-folder is-active" data-filter="all">
                <span>همه</span>
                <span class="ni-folder-count ltr-field">@totalCount</span>
            </button>
            <button type="button" class="ni-folder" data-filter="unread">
                <span>خوانده‌نشده</span>
                <span class="ni-folder-count ltr-field">@unread</span>
            </button>
            <button type="button" class="ni-folder" data-filter="read">
                <span>خوانده‌شده</span>
                <span class="ni-folder-count ltr-field">@(totalCount - unread)</span>
            </button>
            <div class="ni-nav-foot">
                <a asp-action="Preferences" class="ni-nav-link">@T["notif.preferences"]</a>
            </div>
        </aside>

        <section class="ni-list-pane">
            <div class="ni-search">
                <svg class="ni-search-ico" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <input type="search" class="ni-search-input" id="niSearch" placeholder="جست‌وجو در اعلان‌ها…" autocomplete="off" />
            </div>

            @if (Model.Count == 0)
            {
                <div class="ni-empty">
                    <div class="ni-empty-ico" aria-hidden="true">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" opacity=".35"><path d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 0 0 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
                    </div>
                    <p class="ni-empty-title">@T["notif.empty"]</p>
                    <p class="ni-empty-hint">وقتی اتفاقی بیفتد، اینجا می‌بینید.</p>
                </div>
            }
            else
            {
                <div class="ni-list" id="niList" role="list">
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var n = Model[i];
                        var kind = n.Kind.ToString();
                        var bodyAttr = n.Body ?? "";
                        <button type="button"
                                class="ni-row @(n.IsRead ? "is-read" : "is-unread") @(i == 0 ? "is-selected" : "")"
                                role="listitem"
                                data-id="@n.Id"
                                data-read="@(n.IsRead ? "1" : "0")"
                                data-q="@((n.Title + " " + bodyAttr + " " + kind).ToLowerInvariant())"
                                data-title="@n.Title"
                                data-body="@bodyAttr"
                                data-kind="@kind"
                                data-link="@(n.LinkUrl ?? "")"
                                data-time="@PersianDate.DateTime(n.CreatedAtUtc)">
                            <span class="ni-row-dot" aria-hidden="true"></span>
                            <span class="ni-row-main">
                                <span class="ni-row-top">
                                    <span class="ni-row-kind">@kind</span>
                                    <span class="ni-row-time ltr-field">@PersianDate.DateTime(n.CreatedAtUtc)</span>
                                </span>
                                <span class="ni-row-title" dir="auto">@n.Title</span>
                                @if (!string.IsNullOrEmpty(n.Body))
                                {
                                    <span class="ni-row-preview" dir="auto">@n.Body</span>
                                }
                            </span>
                        </button>
                    }
                </div>
                <p class="ni-filter-empty" id="niFilterEmpty" hidden>نتیجه‌ای نیست.</p>
            }
        </section>

        <section class="ni-detail" id="niDetail" aria-live="polite">
            @if (Model.Count == 0)
            {
                <div class="ni-detail-empty">
                    <p>اعلانی برای نمایش نیست.</p>
                </div>
            }
            else
            {
                var first = Model[0];
                var firstBody = string.IsNullOrEmpty(first.Body) ? "—" : first.Body;
                <div class="ni-detail-inner" id="niDetailInner">
                    <div class="ni-detail-head">
                        <span class="ni-detail-kind" id="niDetailKind">@first.Kind</span>
                        <span class="ni-detail-time ltr-field" id="niDetailTime">@PersianDate.DateTime(first.CreatedAtUtc)</span>
                    </div>
                    <h2 class="ni-detail-title" id="niDetailTitle" dir="auto">@first.Title</h2>
                    <div class="ni-detail-body" id="niDetailBody" dir="auto">@firstBody</div>
                    <div class="ni-detail-acts">
                        <form asp-action="MarkRead" method="post" id="niMarkForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" id="niMarkId" value="@first.Id" />
                            <button type="submit" class="ni-btn ni-btn-accent" id="niMarkBtn">
                                @(string.IsNullOrEmpty(first.LinkUrl) ? T["notif.mark_read"] : T["notif.view"])
                            </button>
                        </form>
                        @if (!string.IsNullOrEmpty(first.LinkUrl))
                        {
                            <a class="ni-btn ni-btn-ghost" id="niOpenLink" href="@first.LinkUrl">باز کردن لینک</a>
                        }
                        else
                        {
                            <a class="ni-btn ni-btn-ghost" id="niOpenLink" href="#" style="display:none">باز کردن لینک</a>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>

<style>
.ni-page { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
.ni-hero {
  display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
  gap: 1rem; margin-bottom: 1.15rem;
}
.ni-eyebrow {
  margin: 0 0 .2rem; font-size: .68rem; font-weight: 700; letter-spacing: .08em;
  text-transform: uppercase; color: var(--accent); opacity: .9;
}
.ni-title { margin: 0 0 .3rem; font-size: 1.4rem; font-weight: 750; letter-spacing: -0.02em; }
.ni-sub { margin: 0; font-size: .86rem; color: var(--text-muted); }
.ni-sub-strong { font-weight: 700; color: var(--accent); }
.ni-hero-acts { display: flex; flex-wrap: wrap; gap: .45rem; }
.ni-hero-acts form { margin: 0; }

.ni-btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: .45rem .9rem; border-radius: 10px;
  font-size: .84rem; font-weight: 600;
  border: 1px solid transparent; cursor: pointer;
  text-decoration: none !important; color: inherit;
  transition: background .12s, border-color .12s, color .12s;
}
.ni-btn-ghost {
  background: var(--surface); border-color: var(--border-soft); color: var(--text-muted);
}
.ni-btn-ghost:hover { color: var(--text); border-color: var(--border); }
.ni-btn-accent {
  background: var(--accent); color: #111; border-color: var(--accent);
}
.ni-btn-accent:hover { filter: brightness(1.06); }

.ni-shell {
  display: grid;
  grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 1.15fr);
  min-height: min(70vh, 640px);
  border: 1px solid var(--border-soft);
  border-radius: 16px;
  overflow: hidden;
  background: var(--surface);
}
@@media (max-width: 960px) {
  .ni-shell { grid-template-columns: 1fr; min-height: auto; }
  .ni-nav {
    flex-direction: row; flex-wrap: wrap;
    border-inline-end: 0 !important;
    border-bottom: 1px solid var(--border-soft);
  }
  .ni-nav-foot { width: 100%; }
  .ni-list-pane {
    max-height: 42vh; border-inline-end: 0 !important;
    border-bottom: 1px solid var(--border-soft);
  }
}

.ni-nav {
  display: flex; flex-direction: column; gap: .3rem;
  padding: .85rem .65rem;
  background: var(--surface-2);
  border-inline-end: 1px solid var(--border-soft);
}
.ni-folder {
  display: flex; justify-content: space-between; align-items: center;
  gap: .5rem; width: 100%;
  padding: .5rem .7rem; border-radius: 10px;
  border: 0; background: transparent; color: var(--text-muted);
  font-size: .86rem; font-weight: 550; cursor: pointer; text-align: start;
  transition: background .12s, color .12s;
}
.ni-folder:hover { color: var(--text); background: color-mix(in srgb, var(--text) 4%, transparent); }
.ni-folder.is-active {
  background: color-mix(in srgb, var(--accent) 14%, transparent);
  color: var(--accent); font-weight: 650;
}
.ni-folder-count { font-size: .72rem; opacity: .7; font-variant-numeric: tabular-nums; }
.ni-nav-foot {
  margin-top: auto; padding-top: .75rem;
  border-top: 1px solid var(--border-soft);
}
.ni-nav-link {
  display: block; padding: .45rem .7rem; font-size: .82rem;
  color: var(--text-muted); text-decoration: none !important; border-radius: 8px;
}
.ni-nav-link:hover { color: var(--accent); }

.ni-list-pane {
  display: flex; flex-direction: column; min-height: 0;
  border-inline-end: 1px solid var(--border-soft);
}
.ni-search {
  display: flex; align-items: center; gap: .45rem;
  padding: .65rem .75rem;
  border-bottom: 1px solid var(--border-soft);
}
.ni-search-ico { color: var(--text-faint); flex-shrink: 0; }
.ni-search-input {
  flex: 1; border: 0; background: transparent; color: var(--text);
  font-size: .88rem; outline: none; min-width: 0;
}
.ni-search-input::placeholder { color: var(--text-faint); }

.ni-list { overflow: auto; flex: 1; }
.ni-row {
  display: flex; gap: .55rem; align-items: flex-start;
  width: 100%; padding: .75rem .85rem;
  border: 0; border-bottom: 1px solid color-mix(in srgb, var(--border-soft) 80%, transparent);
  background: transparent; color: inherit; text-align: start; cursor: pointer;
  transition: background .1s;
}
.ni-row:hover { background: color-mix(in srgb, var(--text) 3%, transparent); }
.ni-row.is-selected { background: color-mix(in srgb, var(--accent) 10%, transparent); }
.ni-row.is-unread .ni-row-title { font-weight: 700; }
.ni-row.is-read { opacity: .78; }
.ni-row.is-hidden { display: none !important; }

.ni-row-dot {
  width: .45rem; height: .45rem; border-radius: 50%;
  margin-top: .45rem; flex-shrink: 0; background: transparent;
}
.ni-row.is-unread .ni-row-dot { background: var(--accent); }

.ni-row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .12rem; }
.ni-row-top {
  display: flex; justify-content: space-between; gap: .5rem;
  font-size: .7rem; color: var(--text-faint);
}
.ni-row-kind { font-weight: 600; text-transform: capitalize; color: var(--text-muted); }
.ni-row-title {
  font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ni-row-preview {
  font-size: .78rem; color: var(--text-faint);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.ni-filter-empty {
  padding: 1.5rem; text-align: center; font-size: .86rem; color: var(--text-faint); margin: 0;
}

.ni-empty, .ni-detail-empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 2.5rem 1.25rem; text-align: center; flex: 1; color: var(--text-muted);
}
.ni-empty-ico { margin-bottom: .65rem; }
.ni-empty-title { font-weight: 650; margin: 0 0 .25rem; color: var(--text); }
.ni-empty-hint { margin: 0; font-size: .84rem; }

.ni-detail {
  padding: 1.25rem 1.35rem; overflow: auto;
  display: flex; flex-direction: column;
}
.ni-detail-head {
  display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem;
  margin-bottom: .65rem;
}
.ni-detail-kind {
  font-size: .72rem; font-weight: 700; text-transform: capitalize;
  padding: .2rem .55rem; border-radius: 999px;
  background: color-mix(in srgb, var(--accent) 14%, transparent);
  color: var(--accent);
}
.ni-detail-time { font-size: .78rem; color: var(--text-faint); }
.ni-detail-title {
  margin: 0 0 .85rem; font-size: 1.2rem; font-weight: 700; line-height: 1.35;
}
.ni-detail-body {
  font-size: .95rem; line-height: 1.7; color: var(--text-muted);
  margin-bottom: 1.25rem; white-space: pre-wrap;
}
.ni-detail-acts {
  display: flex; flex-wrap: wrap; gap: .45rem;
  margin-top: auto; padding-top: 1rem;
  border-top: 1px solid var(--border-soft);
}
.ni-detail-acts form { margin: 0; }
</style>

@section Scripts {
<script>
(function () {
  var list = document.getElementById('niList');
  if (!list) return;

  var search = document.getElementById('niSearch');
  var filterEmpty = document.getElementById('niFilterEmpty');
  var folderFilter = 'all';
  var viewLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["notif.view"].ToString()));
  var markLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["notif.mark_read"].ToString()));

  function rows() { return Array.prototype.slice.call(list.querySelectorAll('.ni-row')); }

  function applyFilters() {
    var q = (search && search.value || '').trim().toLowerCase();
    var shown = 0;
    rows().forEach(function (row) {
      var read = row.getAttribute('data-read') === '1';
      var folderOk = folderFilter === 'all'
        || (folderFilter === 'unread' && !read)
        || (folderFilter === 'read' && read);
      var qOk = !q || (row.getAttribute('data-q') || '').indexOf(q) !== -1;
      var ok = folderOk && qOk;
      row.classList.toggle('is-hidden', !ok);
      if (ok) shown++;
    });
    if (filterEmpty) filterEmpty.hidden = shown > 0;
  }

  document.querySelectorAll('.ni-folder').forEach(function (btn) {
    btn.addEventListener('click', function () {
      folderFilter = btn.getAttribute('data-filter') || 'all';
      document.querySelectorAll('.ni-folder').forEach(function (b) {
        b.classList.toggle('is-active', b === btn);
      });
      applyFilters();
    });
  });
  if (search) search.addEventListener('input', applyFilters);

  function selectRow(row) {
    rows().forEach(function (r) { r.classList.toggle('is-selected', r === row); });
    var title = row.getAttribute('data-title') || '';
    var body = row.getAttribute('data-body') || '';
    var kind = row.getAttribute('data-kind') || '';
    var time = row.getAttribute('data-time') || '';
    var link = row.getAttribute('data-link') || '';
    var id = row.getAttribute('data-id') || '';

    var elTitle = document.getElementById('niDetailTitle');
    var elBody = document.getElementById('niDetailBody');
    var elKind = document.getElementById('niDetailKind');
    var elTime = document.getElementById('niDetailTime');
    var elId = document.getElementById('niMarkId');
    var elBtn = document.getElementById('niMarkBtn');
    var elLink = document.getElementById('niOpenLink');

    if (elTitle) elTitle.textContent = title;
    if (elBody) elBody.textContent = body || '—';
    if (elKind) elKind.textContent = kind;
    if (elTime) elTime.textContent = time;
    if (elId) elId.value = id;
    if (elBtn) elBtn.textContent = link ? viewLabel : markLabel;
    if (elLink) {
      if (link) {
        elLink.href = link;
        elLink.style.display = '';
      } else {
        elLink.style.display = 'none';
      }
    }
  }

  rows().forEach(function (row) {
    row.addEventListener('click', function () { selectRow(row); });
  });
})();
</script>
}
