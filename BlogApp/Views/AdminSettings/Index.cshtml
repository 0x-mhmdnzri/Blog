@model SiteSettingsViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["page.settings"];
}

@if (TempData["Saved"] != null)
{
    <div class="card-surface p-3 mb-3 small text-muted-dark">@TempData["Saved"]</div>
}

<form method="post" class="card-surface p-4 admin-form-center">
    @Html.AntiForgeryToken()

    <h2 class="h6 text-muted-dark mb-3">@T["settings.section_seo"]</h2>
    <p class="small text-muted-dark mb-3">@T["settings.seo_hint"]</p>
    <div class="mb-3">
        <label class="form-label" asp-for="SiteName">@T["settings.site_name"]</label>
        <input class="form-control" asp-for="SiteName" dir="auto" />
        <span asp-validation-for="SiteName" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="SiteDescription">@T["settings.site_description"]</label>
        <textarea class="form-control" asp-for="SiteDescription" rows="3" dir="auto"></textarea>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="AuthorName">@T["settings.author_name"]</label>
            <input class="form-control" asp-for="AuthorName" dir="auto" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="TwitterHandle">@T["settings.twitter"]</label>
            <input class="form-control ltr-field" asp-for="TwitterHandle" placeholder="@@handle" />
        </div>
    </div>
    <div class="mb-4">
        <label class="form-label" asp-for="BaseUrl">@T["settings.base_url"]</label>
        <input class="form-control ltr-field" asp-for="BaseUrl" placeholder="https://example.com" />
    </div>

    <h2 class="h6 text-muted-dark mb-3">@T["settings.section_smtp"]</h2>
    <p class="small text-muted-dark mb-3">@T["settings.smtp_hint"]</p>
    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="SmtpEnabled" />
        <label class="form-check-label" asp-for="SmtpEnabled">@T["settings.smtp_enable"]</label>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-8">
            <label class="form-label" asp-for="SmtpHost">@T["settings.smtp_host"]</label>
            <input class="form-control ltr-field" asp-for="SmtpHost" placeholder="smtp.example.com" />
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="SmtpPort">@T["settings.smtp_port"]</label>
            <input class="form-control ltr-field" asp-for="SmtpPort" type="number" min="1" max="65535" />
        </div>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="SmtpEnableSsl" />
        <label class="form-check-label" asp-for="SmtpEnableSsl">@T["settings.smtp_ssl"]</label>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="SmtpUserName">@T["settings.smtp_user"]</label>
            <input class="form-control ltr-field" asp-for="SmtpUserName" autocomplete="off" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="SmtpPassword">@T["settings.smtp_password"]</label>
            <input class="form-control ltr-field" asp-for="SmtpPassword" type="password" autocomplete="new-password" placeholder="@(Model.SmtpPasswordIsSet ? T["settings.smtp_password_placeholder"] : "")" />
            @if (Model.SmtpPasswordIsSet)
            {
                <div class="form-text small text-muted-dark">@T["settings.smtp_password_hint"]</div>
            }
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="form-label" asp-for="SmtpFromAddress">@T["settings.smtp_from"]</label>
            <input class="form-control ltr-field" asp-for="SmtpFromAddress" placeholder="noreply@example.com" />
            <span asp-validation-for="SmtpFromAddress" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="SmtpFromDisplayName">@T["settings.smtp_from_name"]</label>
            <input class="form-control" asp-for="SmtpFromDisplayName" dir="auto" placeholder="Blog" />
        </div>
    </div>

    <h2 class="h6 text-muted-dark mb-3">@T["settings.section_maintenance"]</h2>
    <div class="form-check mb-2">
        <input class="form-check-input" asp-for="MaintenanceMode" />
        <label class="form-check-label" asp-for="MaintenanceMode">@T["settings.maintenance_enable"]</label>
    </div>
    <div class="mb-4">
        <label class="form-label" asp-for="MaintenanceMessage">@T["settings.maintenance_message"]</label>
        <textarea class="form-control" asp-for="MaintenanceMessage" rows="2" dir="auto"></textarea>
    </div>

    <h2 class="h6 text-muted-dark mb-3">@T["settings.section_announcement"]</h2>
    <div class="form-check mb-2">
        <input class="form-check-input" asp-for="AnnouncementEnabled" />
        <label class="form-check-label" asp-for="AnnouncementEnabled">@T["settings.announcement_enable"]</label>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="AnnouncementText">@T["settings.announcement_text"]</label>
        <input class="form-control" asp-for="AnnouncementText" dir="auto" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="AnnouncementStyle">@T["settings.announcement_style"]</label>
        <select class="form-select" asp-for="AnnouncementStyle" style="max-width:200px;">
            <option value="info">@T["settings.style_info"]</option>
            <option value="warn">@T["settings.style_warn"]</option>
            <option value="success">@T["settings.style_success"]</option>
        </select>
    </div>
    <p class="small text-muted-dark mb-4">@T["settings.announcement_hint"]</p>

    <button type="submit" class="btn btn-accent">@T["btn.save_settings"]</button>
</form>
