@{
    var useAdmin = ViewData["UseAdminLayout"] as bool? == true;
}
<style>
.pak { max-width: 1040px; @(useAdmin ? "" : "margin: 0 auto;") }
.pak-hero {
  display: flex; flex-wrap: wrap; gap: 1rem 1.5rem;
  justify-content: space-between; align-items: flex-start;
  margin-bottom: 1.35rem; padding-bottom: 1rem;
  border-bottom: 1px solid var(--border-soft);
}
.pak-hero h1 {
  font-size: 1.25rem; font-weight: 700; margin: 0 0 .4rem;
  letter-spacing: -0.01em;
}
.pak-hero .lead {
  font-size: .88rem; color: var(--text-muted); line-height: 1.6;
  margin: 0; max-width: 38rem;
}
.pak-hero .lead a { color: var(--accent); text-decoration: none; font-weight: 500; }
.pak-hero .lead a:hover { text-decoration: underline; }
.pak-hero-actions { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
.pak-range {
  display: inline-flex; gap: 0; border-radius: 10px;
  border: 1px solid var(--border-soft); overflow: hidden; background: var(--surface);
}
.pak-range a {
  font-size: .78rem; padding: .4rem .75rem; text-decoration: none;
  color: var(--text-muted); border-left: 1px solid var(--border-soft);
  transition: background .12s, color .12s;
}
.pak-range a:first-child { border-left: none; }
.pak-range a:hover { color: var(--text); background: color-mix(in srgb, var(--accent) 8%, transparent); }
.pak-range a.active {
  color: var(--text); background: color-mix(in srgb, var(--accent) 16%, transparent);
  font-weight: 600;
}
.pak-section { margin-bottom: 1.75rem; }
.pak-section-head {
  display: flex; flex-wrap: wrap; gap: .5rem 1rem;
  justify-content: space-between; align-items: center;
  margin-bottom: .85rem;
}
.pak-section-title {
  font-size: .95rem; font-weight: 700; margin: 0;
  display: flex; align-items: center; gap: .45rem;
}
.pak-section-title .count {
  font-size: .75rem; font-weight: 600; color: var(--text-muted);
  background: color-mix(in srgb, var(--text-muted) 12%, transparent);
  padding: .15rem .5rem; border-radius: 999px;
}
.pak-kpis {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: .65rem; margin-bottom: 1rem;
}
@@media (max-width: 700px) { .pak-kpis { grid-template-columns: repeat(2, 1fr); } }
.pak-kpi {
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: 12px; padding: .85rem 1rem;
  min-height: 76px; display: flex; flex-direction: column; justify-content: center;
  transition: border-color .15s;
}
.pak-kpi:hover { border-color: color-mix(in srgb, var(--accent) 35%, var(--border-soft)); }
.pak-kpi .l { font-size: .72rem; color: var(--text-muted); margin-bottom: .2rem; }
.pak-kpi .v {
  font-size: 1.35rem; font-weight: 700; font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}
.pak-kpi.warn .v { color: #e5637a; }
.pak-card {
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: 14px; padding: 1.1rem 1.2rem; margin-bottom: .7rem;
}
.pak-card.pending { border-color: color-mix(in srgb, #e3b341 50%, var(--border-soft)); }
.pak-card.approved { border-color: color-mix(in srgb, #9ecb8c 40%, var(--border-soft)); }
.pak-card.rejected, .pak-card.banned { border-color: color-mix(in srgb, #e5637a 45%, var(--border-soft)); }
.pak-token {
  background: color-mix(in srgb, var(--accent) 10%, var(--surface));
  border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border-soft));
  border-radius: 14px; padding: 1.15rem 1.25rem; margin-bottom: 1.25rem;
}
.pak-token code {
  word-break: break-all; font-size: .88rem; direction: ltr;
  display: block; margin-top: .35rem; line-height: 1.5;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
.pak-token-warn {
  font-size: .8rem; margin-top: .65rem; color: #b8860b;
  display: flex; align-items: flex-start; gap: .4rem;
}
[data-theme="dark"] .pak-token-warn, html.dark .pak-token-warn { color: #e3b341; }
.pak-pill {
  display: inline-flex; align-items: center; font-size: .7rem; font-weight: 650;
  padding: .2rem .55rem; border-radius: 999px; letter-spacing: .01em;
}
.pak-pill.wait { background: color-mix(in srgb, #e3b341 22%, transparent); color: #b8860b; }
.pak-pill.ok { background: color-mix(in srgb, #9ecb8c 22%, transparent); color: #3d6b3a; }
.pak-pill.no { background: color-mix(in srgb, #e5637a 22%, transparent); color: #a33; }
.pak-pill.off { background: color-mix(in srgb, var(--text-muted) 18%, transparent); color: var(--text-muted); }
[data-theme="dark"] .pak-pill.wait, html.dark .pak-pill.wait { color: #e3b341; }
[data-theme="dark"] .pak-pill.ok, html.dark .pak-pill.ok { color: #b6e0a8; }
[data-theme="dark"] .pak-pill.no, html.dark .pak-pill.no { color: #f5a3b0; }
.pak-chart { height: 170px; position: relative; }
.pak-table-wrap {
  max-height: 220px; overflow: auto;
  border: 1px solid var(--border-soft); border-radius: 10px;
}
.pak-table-wrap table { margin: 0; width: 100%; font-size: .8rem; }
.pak-table-wrap th {
  position: sticky; top: 0; background: var(--surface);
  font-size: .72rem; font-weight: 600; color: var(--text-muted);
  border-bottom: 1px solid var(--border-soft);
}
.pak-table-wrap td { vertical-align: middle; }
.pak-copy {
  width: 2rem; height: 2rem; border-radius: 8px;
  border: 1px solid var(--border-soft); background: var(--surface);
  color: var(--text); cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center; padding: 0;
  flex-shrink: 0; transition: border-color .12s, color .12s;
}
.pak-copy:hover { border-color: var(--accent); color: var(--accent); }
.pak-copy.ok { border-color: #9ecb8c; color: #9ecb8c; }
.pak-copy svg { width: 1rem; height: 1rem; }
.pak-toast {
  position: fixed; bottom: 1.25rem; left: 50%; transform: translateX(-50%);
  background: var(--surface); border: 1px solid var(--border-soft); color: var(--text);
  padding: .55rem 1.15rem; border-radius: 999px; font-size: .85rem; z-index: 10050;
  box-shadow: 0 8px 28px rgba(0,0,0,.22); display: none;
}
.pak-alert {
  padding: .7rem 1rem; border-radius: 12px; margin-bottom: 1rem;
  font-size: .85rem; line-height: 1.5;
}
.pak-alert.ok {
  background: color-mix(in srgb, var(--accent) 12%, var(--surface));
  border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border-soft));
}
.pak-alert.err {
  background: color-mix(in srgb, #e5637a 10%, var(--surface));
  border: 1px solid color-mix(in srgb, #e5637a 35%, var(--border-soft));
  color: #c44;
}
[data-theme="dark"] .pak-alert.err, html.dark .pak-alert.err { color: #f5a3b0; }
.pak-form-label {
  font-size: .78rem; font-weight: 500; color: var(--text-muted);
  margin-bottom: .3rem; display: block;
}
.pak-key-row {
  display: flex; flex-wrap: wrap; justify-content: space-between;
  gap: .75rem 1rem; align-items: flex-start;
}
.pak-key-main { flex: 1; min-width: 0; }
.pak-key-title {
  display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .55rem;
  margin-bottom: .4rem;
}
.pak-key-name { font-weight: 650; font-size: .95rem; }
.pak-key-meta {
  font-size: .78rem; color: var(--text-muted);
  display: flex; flex-wrap: wrap; gap: .35rem .9rem; align-items: center;
}
.pak-key-meta code {
  font-size: .75rem; padding: .1rem .4rem; border-radius: 5px;
  background: color-mix(in srgb, var(--text-muted) 10%, transparent);
  border: 1px solid var(--border-soft); direction: ltr;
}
.pak-key-actions {
  display: flex; flex-wrap: wrap; gap: .35rem; align-items: center;
  flex-shrink: 0;
}
.pak-empty {
  text-align: center; padding: 2rem 1rem; border-radius: 14px;
  border: 1px dashed var(--border-soft); color: var(--text-muted); font-size: .88rem;
}
.pak-staff-banner {
  display: flex; flex-wrap: wrap; gap: .75rem; align-items: center;
  justify-content: space-between;
  padding: .75rem 1rem; margin-bottom: 1.25rem; border-radius: 12px;
  background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border-soft));
  font-size: .84rem;
}
.pak-staff-banner p { margin: 0; color: var(--text-muted); line-height: 1.45; }
.pak-staff-banner strong { color: var(--text); }
.pak-grid-2 {
  display: grid; grid-template-columns: 1fr 1fr; gap: .75rem;
}
@@media (max-width: 900px) { .pak-grid-2 { grid-template-columns: 1fr; } }
.pak-subhead {
  font-size: .82rem; font-weight: 600; margin: 0 0 .6rem;
  color: var(--text-muted);
}
</style>
