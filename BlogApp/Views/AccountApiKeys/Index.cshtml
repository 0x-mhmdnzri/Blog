@model BlogApp.Controllers.AccountApiKeysPageModel
@using BlogApp.Models
@using System.Text.Json
@{
    var useAdmin = ViewData["UseAdminLayout"] as bool? == true;
    if (useAdmin)
        Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "کلیدهای API من";
    var newToken = TempData["NewToken"] as string;
    var list = Model.Keys;
    var u = Model.Usage;
    var range = Model.RangeDays;
    var json = new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

<style>
.pak { max-width: 960px; @(useAdmin ? "" : "margin: 0 auto;") }
.pak-hero { display:flex; flex-wrap:wrap; gap:1rem; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; }
.pak-hero h1 { font-size:1.15rem; font-weight:700; margin:0 0 .3rem; }
.pak-hero p { font-size:.85rem; color:var(--text-muted); line-height:1.55; margin:0; max-width:36rem; }
.pak-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.5rem; margin-bottom:1rem; }
@@media (max-width:700px){ .pak-kpis { grid-template-columns:repeat(2,1fr); } }
.pak-kpi { background:var(--surface); border:1px solid var(--border-soft); border-radius:12px; padding:.7rem .85rem; min-height:70px; display:flex; flex-direction:column; justify-content:center; }
.pak-kpi .l { font-size:.7rem; color:var(--text-muted); }
.pak-kpi .v { font-size:1.2rem; font-weight:700; font-variant-numeric:tabular-nums; }
.pak-card { background:var(--surface); border:1px solid var(--border-soft); border-radius:14px; padding:1rem 1.1rem; margin-bottom:.65rem; }
.pak-card.pending { border-color:color-mix(in srgb,#e3b341 45%,var(--border-soft)); }
.pak-card.approved { border-color:color-mix(in srgb,#9ecb8c 35%,var(--border-soft)); }
.pak-card.rejected, .pak-card.banned { border-color:color-mix(in srgb,#e5637a 40%,var(--border-soft)); }
.pak-token { background:color-mix(in srgb,var(--accent) 10%,var(--surface)); border:1px solid color-mix(in srgb,var(--accent) 30%,var(--border-soft)); border-radius:12px; padding:1rem; margin-bottom:1rem; }
.pak-token code { word-break:break-all; font-size:.85rem; direction:ltr; display:block; }
.pak-pill { display:inline-flex; font-size:.7rem; font-weight:650; padding:.18rem .55rem; border-radius:999px; }
.pak-pill.wait { background:color-mix(in srgb,#e3b341 22%,transparent); color:#b8860b; }
.pak-pill.ok { background:color-mix(in srgb,#9ecb8c 22%,transparent); color:#3d6b3a; }
.pak-pill.no { background:color-mix(in srgb,#e5637a 22%,transparent); color:#a33; }
.pak-pill.off { background:color-mix(in srgb,var(--text-muted) 18%,transparent); color:var(--text-muted); }
[data-theme="dark"] .pak-pill.wait, html.dark .pak-pill.wait { color:#e3b341; }
[data-theme="dark"] .pak-pill.ok, html.dark .pak-pill.ok { color:#b6e0a8; }
.pak-chart { height:160px; position:relative; }
.pak-table-wrap { max-height:240px; overflow:auto; border:1px solid var(--border-soft); border-radius:10px; }
.pak-table-wrap table { margin:0; width:100%; font-size:.8rem; }
.pak-table-wrap th { position:sticky; top:0; background:var(--surface); font-size:.72rem; }
.pak-range { display:flex; gap:.35rem; flex-wrap:wrap; }
.pak-range a { font-size:.78rem; padding:.3rem .65rem; border-radius:8px; border:1px solid var(--border-soft); text-decoration:none; color:var(--text); }
.pak-range a.active { border-color:var(--accent); background:color-mix(in srgb,var(--accent) 12%,transparent); }
</style>

<div class="@(useAdmin ? "" : "container py-4") pak">
    <div class="pak-hero">
        <div>
            <h1>کلیدهای API من</h1>
            <p>
                درخواست PAT، وضعیت تأیید، و <strong>مانیتور درخواست‌های خودتان</strong>.
                راهنما: <a href="/developers">/developers</a>
            </p>
        </div>
        <div class="pak-range">
            <a class="@(range==7?"active":"")" asp-action="Index" asp-route-range="7">۷ روز</a>
            <a class="@(range==30?"active":"")" asp-action="Index" asp-route-range="30">۳۰ روز</a>
            <a class="@(range==90?"active":"")" asp-action="Index" asp-route-range="90">۹۰ روز</a>
        </div>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="pak-card small">@TempData["Msg"]</div>
    }
    @if (TempData["Err"] != null)
    {
        <div class="pak-card small" style="border-color:var(--danger,#e5637a);">@TempData["Err"]</div>
    }
    @if (!string.IsNullOrEmpty(newToken))
    {
        <div class="pak-token">
            <div class="small text-muted-dark mb-1">توکن (فقط همین‌بار):</div>
            <code class="ltr-field">@newToken</code>
            <div class="small mt-2" style="color:#e3b341;">تا تأیید سوپرادمین قابل استفاده نیست.</div>
        </div>
    }

    <div class="pak-kpis">
        <div class="pak-kpi"><div class="l">درخواست‌های من</div><div class="v ltr-field">@u.TotalRequests</div></div>
        <div class="pak-kpi"><div class="l">خطا</div><div class="v ltr-field">@u.ErrorCount</div></div>
        <div class="pak-kpi"><div class="l">۴۲۹</div><div class="v ltr-field">@u.RateLimitedCount</div></div>
        <div class="pak-kpi"><div class="l">میانگین ms</div><div class="v ltr-field">@u.AvgDurationMs</div></div>
    </div>

    <div class="pak-card mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong style="font-size:.9rem;">روند درخواست‌های من</strong>
        </div>
        <div class="pak-chart"><canvas id="selfApiChart"></canvas></div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-lg-6">
            <div class="pak-card h-100">
                <strong class="d-block mb-2" style="font-size:.88rem;">Top endpoints</strong>
                @if (u.TopEndpoints.Count == 0)
                {
                    <p class="small text-muted-dark mb-0">هنوز فراخوانی ثبت نشده.</p>
                }
                else
                {
                    <div class="pak-table-wrap">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Endpoint</th><th class="ltr-field">N</th><th class="ltr-field">Err</th><th class="ltr-field">ms</th></tr></thead>
                            <tbody>
                            @foreach (var e in u.TopEndpoints)
                            {
                                <tr>
                                    <td class="ltr-field small">@e.Method @e.Path</td>
                                    <td class="ltr-field">@e.Count</td>
                                    <td class="ltr-field">@e.Errors</td>
                                    <td class="ltr-field">@e.AvgMs</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="pak-card h-100">
                <strong class="d-block mb-2" style="font-size:.88rem;">آخرین فراخوانی‌ها</strong>
                @if (u.Recent.Count == 0)
                {
                    <p class="small text-muted-dark mb-0">—</p>
                }
                else
                {
                    <div class="pak-table-wrap">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>زمان</th><th>Path</th><th class="ltr-field">Code</th><th class="ltr-field">ms</th></tr></thead>
                            <tbody>
                            @foreach (var r in u.Recent)
                            {
                                <tr>
                                    <td class="ltr-field small">@r.CreatedAtUtc.ToString("MM-dd HH:mm")</td>
                                    <td class="ltr-field small">@r.Method @r.Path</td>
                                    <td class="ltr-field">@r.StatusCode</td>
                                    <td class="ltr-field">@r.DurationMs</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <form asp-action="Create" method="post" class="pak-card mb-4">
        @Html.AntiForgeryToken()
        <div class="fw-semibold mb-2" style="font-size:.9rem;">درخواست کلید جدید</div>
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">نام</label>
                <input class="form-control form-control-sm" name="name" required maxlength="120" placeholder="مثلاً CI / script" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">Scopes</label>
                <input class="form-control form-control-sm ltr-field" name="scopes" value="read" placeholder="read,write,webhooks" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">انقضا (روز)</label>
                <input class="form-control form-control-sm ltr-field" name="expiresInDays" type="number" min="1" max="3650" placeholder="—" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-accent btn-sm w-100">درخواست</button>
            </div>
        </div>
    </form>

    @if (list.Count == 0)
    {
        <div class="pak-card text-center text-muted-dark small">هنوز کلیدی ندارید.</div>
    }
    else
    {
        @foreach (var k in list)
        {
            var stateClass = k.IsBanned ? "banned"
                : k.ApprovalStatus == ApiKeyApprovalStatus.Pending ? "pending"
                : k.ApprovalStatus == ApiKeyApprovalStatus.Rejected ? "rejected"
                : k.IsUsable ? "approved" : "";
            <article class="pak-card @stateClass">
                <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start">
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <strong>@k.Name</strong>
                            @if (k.IsBanned) { <span class="pak-pill no">بن</span> }
                            else if (k.ApprovalStatus == ApiKeyApprovalStatus.Pending) { <span class="pak-pill wait">در انتظار تأیید</span> }
                            else if (k.ApprovalStatus == ApiKeyApprovalStatus.Rejected) { <span class="pak-pill no">رد شده</span> }
                            else if (!k.IsActive) { <span class="pak-pill off">باطل</span> }
                            else { <span class="pak-pill ok">تأیید و فعال</span> }
                            <code class="ltr-field small">@k.KeyPrefix…</code>
                        </div>
                        <div class="small text-muted-dark ltr-field">scopes: @k.Scopes · lifetime req: @k.RequestCount</div>
                    </div>
                    <div class="d-flex gap-1">
                        @if (k.IsActive && !k.IsBanned && k.ApprovalStatus != ApiKeyApprovalStatus.Rejected)
                        {
                            <form asp-action="Revoke" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@k.Id" />
                                <button class="btn btn-ghost btn-sm" type="submit">باطل</button>
                            </form>
                        }
                        <form asp-action="Delete" method="post" onsubmit="return confirm('حذف؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@k.Id" />
                            <button class="btn btn-outline-danger-dark btn-sm" type="submit">حذف</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    }
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
  if (typeof Chart === 'undefined') return;
  var el = document.getElementById('selfApiChart');
  if (!el) return;
  var accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#e3b341';
  new Chart(el, {
    type: 'line',
    data: {
      labels: @Html.Raw(JsonSerializer.Serialize(u.RequestsByDay.Select(p => p.Label), json)),
      datasets: [{
        data: @Html.Raw(JsonSerializer.Serialize(u.RequestsByDay.Select(p => p.Value), json)),
        borderColor: accent, backgroundColor: 'rgba(227,179,65,.12)', fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { x: { grid: { display: false }, ticks: { maxTicksLimit: 8 } }, y: { beginAtZero: true, ticks: { precision: 0, maxTicksLimit: 4 } } }
    }
  });
})();
</script>
}
