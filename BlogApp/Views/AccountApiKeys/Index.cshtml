@model BlogApp.Controllers.AccountApiKeysPageModel
@using BlogApp.Models
@using System.Text.Json
@{
    var useAdmin = ViewData["UseAdminLayout"] as bool? == true;
    if (useAdmin)
        Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["apikey.mine.title"];
    var newToken = TempData["NewToken"] as string;
    var list = Model.Keys;
    var u = Model.Usage;
    var range = Model.RangeDays;
    var json = new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var isSuper = User.IsInRole("SuperAdmin");
}

@await Html.PartialAsync("_AccountApiKeysStyles")

<div class="@(useAdmin ? "" : "container py-4") pak">

    <div class="pak-hero">
        <div>
            <h1>@T["apikey.mine.title"]</h1>
            <p class="lead">
                @T["apikey.mine.lead"]
                <a href="/developers">/developers</a>
            </p>
        </div>
        <div class="pak-hero-actions">
            <div class="pak-range" role="group" aria-label="@T["apikey.range_aria"]">
                <a class="@(range==7?"active":"")" asp-action="Index" asp-route-range="7">@T["apikey.days_7"]</a>
                <a class="@(range==30?"active":"")" asp-action="Index" asp-route-range="30">@T["apikey.days_30"]</a>
                <a class="@(range==90?"active":"")" asp-action="Index" asp-route-range="90">@T["apikey.days_90"]</a>
            </div>
        </div>
    </div>

    @if (useAdmin && isSuper)
    {
        <div class="pak-staff-banner">
            <p>@T["apikey.staff_banner"]</p>
            <a class="btn btn-accent btn-sm" href="/AdminApiKeys">@T["apikey.staff_link"]</a>
        </div>
    }

    @if (TempData["Msg"] != null)
    {
        <div class="pak-alert ok">@TempData["Msg"]</div>
    }
    @if (TempData["Err"] != null)
    {
        <div class="pak-alert err">@TempData["Err"]</div>
    }

    @if (!string.IsNullOrEmpty(newToken))
    {
        <div class="pak-token">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <div class="small fw-semibold" style="color:var(--text-muted);">@T["apikey.new_token"]</div>
                <button type="button" class="pak-copy" data-copy-text="@newToken" title="@T["apikey.copy_token"]" aria-label="@T["apikey.copy_token"]">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
                </button>
            </div>
            <code class="ltr-field">@newToken</code>
            <div class="pak-token-warn">
                <span aria-hidden="true">⚠</span>
                <span>@T["apikey.token_warn"]</span>
            </div>
        </div>
    }

    <section class="pak-section" aria-labelledby="pak-usage-title">
        <div class="pak-section-head">
            <h2 id="pak-usage-title" class="pak-section-title">@T["apikey.usage_title"]</h2>
        </div>
        <div class="pak-kpis">
            <div class="pak-kpi">
                <div class="l">@T["apikey.kpi_requests"]</div>
                <div class="v ltr-field">@u.TotalRequests</div>
            </div>
            <div class="pak-kpi @(u.ErrorCount > 0 ? "warn" : "")">
                <div class="l">@T["apikey.kpi_errors"]</div>
                <div class="v ltr-field">@u.ErrorCount</div>
            </div>
            <div class="pak-kpi @(u.RateLimitedCount > 0 ? "warn" : "")">
                <div class="l">@T["apikey.kpi_rate_limit"]</div>
                <div class="v ltr-field">@u.RateLimitedCount</div>
            </div>
            <div class="pak-kpi">
                <div class="l">@T["apikey.kpi_avg_ms"]</div>
                <div class="v ltr-field">@u.AvgDurationMs</div>
            </div>
        </div>

        <div class="pak-card mb-0">
            <div class="pak-subhead">@T["apikey.chart_trend"]</div>
            <div class="pak-chart"><canvas id="selfApiChart" aria-label="@T["apikey.chart_aria"]"></canvas></div>
        </div>
    </section>

    <section class="pak-section">
        <div class="pak-grid-2">
            <div class="pak-card h-100 mb-0">
                <div class="pak-subhead">@T["apikey.top_endpoints"]</div>
                @if (u.TopEndpoints.Count == 0)
                {
                    <p class="small text-muted-dark mb-0">@T["apikey.no_calls"]</p>
                }
                else
                {
                    <div class="pak-table-wrap">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>@T["apikey.col_endpoint"]</th>
                                    <th class="ltr-field">@T["apikey.col_n"]</th>
                                    <th class="ltr-field">@T["apikey.col_err"]</th>
                                    <th class="ltr-field">@T["apikey.col_ms"]</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var e in u.TopEndpoints)
                            {
                                <tr>
                                    <td class="ltr-field small">@e.Method @e.Path</td>
                                    <td class="ltr-field">@e.Count</td>
                                    <td class="ltr-field">@e.Errors</td>
                                    <td class="ltr-field">@e.AvgMs</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="pak-card h-100 mb-0">
                <div class="pak-subhead">@T["apikey.recent_calls"]</div>
                @if (u.Recent.Count == 0)
                {
                    <p class="small text-muted-dark mb-0">—</p>
                }
                else
                {
                    <div class="pak-table-wrap">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>@T["apikey.col_time"]</th>
                                    <th>@T["apikey.col_path"]</th>
                                    <th class="ltr-field">@T["apikey.col_code"]</th>
                                    <th class="ltr-field">@T["apikey.col_ms"]</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var r in u.Recent)
                            {
                                <tr>
                                    <td class="ltr-field small">@r.CreatedAtUtc.ToString("MM-dd HH:mm")</td>
                                    <td class="ltr-field small">@r.Method @r.Path</td>
                                    <td class="ltr-field">@r.StatusCode</td>
                                    <td class="ltr-field">@r.DurationMs</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="pak-section" aria-labelledby="pak-create-title">
        <div class="pak-section-head">
            <h2 id="pak-create-title" class="pak-section-title">@T["apikey.create_title"]</h2>
        </div>
        <form asp-action="Create" method="post" class="pak-card mb-0">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="pak-form-label" for="pak-name">@T["apikey.field_name"]</label>
                    <input id="pak-name" class="form-control form-control-sm" name="name" required maxlength="120" placeholder="e.g. CI / script" autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <label class="pak-form-label" for="pak-scopes">@T["apikey.field_scopes"]</label>
                    <input id="pak-scopes" class="form-control form-control-sm ltr-field" name="scopes" value="read" placeholder="read,write,webhooks" />
                </div>
                <div class="col-md-2">
                    <label class="pak-form-label" for="pak-exp">@T["apikey.field_expires"]</label>
                    <input id="pak-exp" class="form-control form-control-sm ltr-field" name="expiresInDays" type="number" min="1" max="3650" placeholder="—" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-accent btn-sm w-100">@T["apikey.request_btn"]</button>
                </div>
            </div>
            <p class="small text-muted-dark mt-2 mb-0" style="line-height:1.5;">
                @T["apikey.create_hint"]
            </p>
        </form>
    </section>

    <section class="pak-section" aria-labelledby="pak-keys-title">
        <div class="pak-section-head">
            <h2 id="pak-keys-title" class="pak-section-title">
                @T["apikey.keys_title"]
                <span class="count">@list.Count</span>
            </h2>
            @if (list.Count > 0)
            {
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-ghost btn-sm" asp-action="ExportCsv" asp-route-includeTokens="true" title="@T["apikey.csv_tokens"]">@T["apikey.csv_tokens"]</a>
                    <a class="btn btn-ghost btn-sm" asp-action="ExportCsv" asp-route-includeTokens="false" title="@T["apikey.csv_meta"]">@T["apikey.csv_meta"]</a>
                </div>
            }
        </div>

        @if (list.Count == 0)
        {
            <div class="pak-empty">@T["apikey.empty"]</div>
        }
        else
        {
            @foreach (var k in list)
            {
                var stateClass = k.IsBanned ? "banned"
                    : k.ApprovalStatus == ApiKeyApprovalStatus.Pending ? "pending"
                    : k.ApprovalStatus == ApiKeyApprovalStatus.Rejected ? "rejected"
                    : k.IsUsable ? "approved" : "";
                <article class="pak-card @stateClass">
                    <div class="pak-key-row">
                        <div class="pak-key-main">
                            <div class="pak-key-title">
                                <span class="pak-key-name">@k.Name</span>
                                @if (k.IsBanned) { <span class="pak-pill no">@T["apikey.status_banned"]</span> }
                                else if (k.ApprovalStatus == ApiKeyApprovalStatus.Pending) { <span class="pak-pill wait">@T["apikey.status_pending"]</span> }
                                else if (k.ApprovalStatus == ApiKeyApprovalStatus.Rejected) { <span class="pak-pill no">@T["apikey.status_rejected"]</span> }
                                else if (!k.IsActive) { <span class="pak-pill off">@T["apikey.status_revoked"]</span> }
                                else { <span class="pak-pill ok">@T["apikey.status_active"]</span> }
                            </div>
                            <div class="pak-key-meta">
                                <code class="ltr-field">@k.KeyPrefix…</code>
                                <span class="ltr-field">scopes: @k.Scopes</span>
                                <span class="ltr-field">@T["apikey.meta_requests"]: @k.RequestCount</span>
                                @if (k.ExpiresAtUtc is { } exp)
                                {
                                    <span class="ltr-field">@T["apikey.meta_expires"]: @exp.ToString("yyyy-MM-dd")</span>
                                }
                                @if (k.CanRevealToken)
                                {
                                    <button type="button" class="pak-copy" data-reveal-id="@k.Id" title="@T["apikey.copy_full"]" aria-label="@T["apikey.copy_full"]">
                                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
                                    </button>
                                }
                                else
                                {
                                    <span class="small" title="@T["apikey.no_copy_title"]">@T["apikey.no_copy"]</span>
                                }
                            </div>
                        </div>
                        <div class="pak-key-actions">
                            @if (k.IsActive && !k.IsBanned && k.ApprovalStatus != ApiKeyApprovalStatus.Rejected)
                            {
                                <form asp-action="Revoke" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@k.Id" />
                                    <button class="btn btn-ghost btn-sm" type="submit">@T["apikey.revoke"]</button>
                                </form>
                            }
                            <form asp-action="Delete" method="post" onsubmit='return confirm(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["apikey.delete_confirm"])));'>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@k.Id" />
                                <button class="btn btn-outline-danger-dark btn-sm" type="submit">@T["apikey.delete"]</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        }
    </section>
</div>

<div class="pak-toast" id="pakToast" role="status"></div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
window.__pakI18n = {
  copied: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["apikey.toast_copied"])),
  tokenCopied: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["apikey.toast_token_copied"])),
  unavailable: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["apikey.toast_unavailable"])),
  error: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["apikey.toast_error"]))
};
(function () {
  function toast(msg) {
    var el = document.getElementById('pakToast');
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    clearTimeout(el._t);
    el._t = setTimeout(function () { el.style.display = 'none'; }, 1800);
  }
  function copyText(t) {
    if (navigator.clipboard && navigator.clipboard.writeText)
      return navigator.clipboard.writeText(t);
    var i = document.createElement('textarea');
    i.value = t; document.body.appendChild(i); i.select();
    try { document.execCommand('copy'); } catch (e) {}
    i.remove();
    return Promise.resolve();
  }

  document.querySelectorAll('[data-copy-text]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var t = btn.getAttribute('data-copy-text') || '';
      copyText(t).then(function () {
        btn.classList.add('ok');
        toast(window.__pakI18n.copied);
        setTimeout(function () { btn.classList.remove('ok'); }, 1200);
      });
    });
  });

  document.querySelectorAll('[data-reveal-id]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-reveal-id');
      btn.disabled = true;
      fetch('/AccountApiKeys/Reveal?id=' + encodeURIComponent(id), { credentials: 'same-origin' })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          btn.disabled = false;
          if (!res.ok || !res.j.token) {
            toast((res.j && res.j.detail) || window.__pakI18n.unavailable);
            return;
          }
          return copyText(res.j.token).then(function () {
            btn.classList.add('ok');
            toast(window.__pakI18n.tokenCopied);
            setTimeout(function () { btn.classList.remove('ok'); }, 1200);
          });
        })
        .catch(function () {
          btn.disabled = false;
          toast(window.__pakI18n.error);
        });
    });
  });

  if (typeof Chart !== 'undefined') {
    var el = document.getElementById('selfApiChart');
    if (el) {
      var accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#e3b341';
      new Chart(el, {
        type: 'line',
        data: {
          labels: @Html.Raw(JsonSerializer.Serialize(u.RequestsByDay.Select(p => p.Label), json)),
          datasets: [{
            data: @Html.Raw(JsonSerializer.Serialize(u.RequestsByDay.Select(p => p.Value), json)),
            borderColor: accent, backgroundColor: 'rgba(227,179,65,.12)', fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false }, ticks: { maxTicksLimit: 8 } },
            y: { beginAtZero: true, ticks: { precision: 0, maxTicksLimit: 4 } }
          }
        }
      });
    }
  }
})();
</script>
}
