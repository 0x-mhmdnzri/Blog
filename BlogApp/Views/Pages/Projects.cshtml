@inject BlogApp.Services.IUiTranslator T
<link rel="stylesheet" href="~/css/site-marketing.css" asp-append-version="true" />

<section class="persona-hero">
    <div class="container">
        <div class="persona-kicker">@T["mkt.prj.kicker"]</div>
        <h1 class="persona-title" dir="auto">@T["mkt.prj.h1"]</h1>
        <p class="persona-lead" dir="auto">@T["mkt.prj.lead"]</p>
        <div class="persona-cta">
            <a class="btn btn-accent" asp-controller="Pages" asp-action="Contact">@T["mkt.prj.cta_contact"]</a>
            <a class="btn btn-ghost" asp-controller="Pages" asp-action="Services">@T["mkt.prj.cta_services"]</a>
        </div>
    </div>
</section>

<div class="container persona-page">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="skill-card project-card h-100">
                <h3 dir="auto">@T["mkt.prj.p1_t"]</h3>
                <p dir="auto">@T["mkt.prj.p1_b"]</p>
                <div class="project-tags">
                    <span class="tag-pill">DDD</span><span class="tag-pill">CQRS</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="skill-card project-card h-100">
                <h3 dir="auto">@T["mkt.prj.p2_t"]</h3>
                <p dir="auto">@T["mkt.prj.p2_b"]</p>
                <div class="project-tags">
                    <span class="tag-pill">Redis</span><span class="tag-pill">Payments</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="skill-card project-card h-100">
                <h3 dir="auto">@T["mkt.prj.p3_t"]</h3>
                <p dir="auto">@T["mkt.prj.p3_b"]</p>
                <div class="project-tags">
                    <span class="tag-pill">IdentityServer</span><span class="tag-pill">OAuth2</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="skill-card project-card h-100">
                <h3 dir="auto">@T["mkt.prj.p4_t"]</h3>
                <p dir="auto">@T["mkt.prj.p4_b"]</p>
                <div class="project-tags">
                    <span class="tag-pill">RabbitMQ</span><span class="tag-pill">EDA</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="skill-card project-card h-100">
                <h3 dir="auto">@T["mkt.prj.p5_t"]</h3>
                <p dir="auto">@T["mkt.prj.p5_b"]</p>
                <div class="project-tags">
                    <span class="tag-pill">Async</span><span class="tag-pill">Jobs</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="skill-card project-card h-100">
                <h3 dir="auto">@T["mkt.prj.p6_t"]</h3>
                <p dir="auto">@T["mkt.prj.p6_b"]</p>
                <div class="project-tags">
                    <span class="tag-pill">ASP.NET Core</span><span class="tag-pill">SEO</span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 card-surface p-4 text-center">
        <p class="mb-3" dir="auto">@T["mkt.prj.cta_box"]</p>
        <a class="btn btn-accent" asp-controller="Home" asp-action="Index">@T["mkt.prj.cta_blog"]</a>
    </div>
</div>
