@inject BlogApp.Services.IUiTranslator T
<link rel="stylesheet" href="~/css/site-marketing.css" asp-append-version="true" />

<section class="persona-hero">
    <div class="container">
        <div class="persona-kicker">@T["mkt.svc.kicker"]</div>
        <h1 class="persona-title" dir="auto">@T["mkt.svc.h1"]</h1>
        <p class="persona-lead" dir="auto">@T["mkt.svc.lead"]</p>
        <div class="persona-cta">
            <a class="btn btn-accent" asp-controller="Pages" asp-action="Contact">@T["mkt.svc.cta_contact"]</a>
            <a class="btn btn-ghost" asp-controller="Pages" asp-action="Projects">@T["mkt.svc.cta_projects"]</a>
        </div>
    </div>
</section>

<div class="container persona-page">
    <h2 class="section-title" dir="auto">@T["mkt.svc.list_title"]</h2>
    <p class="section-sub" dir="auto">@T["mkt.svc.list_sub"]</p>
    <div class="skill-grid">
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">◇</div>
            <h3 dir="auto">@T["mkt.svc.s1_t"]</h3>
            <p dir="auto">@T["mkt.svc.s1_b"]</p>
        </div>
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">₿</div>
            <h3 dir="auto">@T["mkt.svc.s2_t"]</h3>
            <p dir="auto">@T["mkt.svc.s2_b"]</p>
        </div>
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">⇄</div>
            <h3 dir="auto">@T["mkt.svc.s3_t"]</h3>
            <p dir="auto">@T["mkt.svc.s3_b"]</p>
        </div>
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">◎</div>
            <h3 dir="auto">@T["mkt.svc.s4_t"]</h3>
            <p dir="auto">@T["mkt.svc.s4_b"]</p>
        </div>
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">⬡</div>
            <h3 dir="auto">@T["mkt.svc.s5_t"]</h3>
            <p dir="auto">@T["mkt.svc.s5_b"]</p>
        </div>
        <div class="skill-card">
            <div class="skill-ico" aria-hidden="true">▣</div>
            <h3 dir="auto">@T["mkt.svc.s6_t"]</h3>
            <p dir="auto">@T["mkt.svc.s6_b"]</p>
        </div>
    </div>

    <h2 class="section-title mt-5" dir="auto">@T["mkt.svc.path_title"]</h2>
    <p class="section-sub" dir="auto">@T["mkt.svc.path_sub"]</p>
    <div class="roadmap">
        <div class="roadmap-step">
            <div class="roadmap-num">1</div>
            <div>
                <strong dir="auto">@T["mkt.svc.p1_t"]</strong>
                <p class="text-muted-dark small mb-0" dir="auto">@T["mkt.svc.p1_b"]</p>
            </div>
        </div>
        <div class="roadmap-step">
            <div class="roadmap-num">2</div>
            <div>
                <strong dir="auto">@T["mkt.svc.p2_t"]</strong>
                <p class="text-muted-dark small mb-0" dir="auto">@T["mkt.svc.p2_b"]</p>
            </div>
        </div>
        <div class="roadmap-step">
            <div class="roadmap-num">3</div>
            <div>
                <strong dir="auto">@T["mkt.svc.p3_t"]</strong>
                <p class="text-muted-dark small mb-0" dir="auto">@T["mkt.svc.p3_b"]</p>
            </div>
        </div>
        <div class="roadmap-step">
            <div class="roadmap-num">4</div>
            <div>
                <strong dir="auto">@T["mkt.svc.p4_t"]</strong>
                <p class="text-muted-dark small mb-0" dir="auto">@T["mkt.svc.p4_b"]</p>
            </div>
        </div>
    </div>
</div>
