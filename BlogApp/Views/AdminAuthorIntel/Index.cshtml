@model BlogApp.Models.ViewModels.AuthorIntelIndexViewModel
@inject BlogApp.Services.IUiTranslator T
@inject BlogApp.Services.ICultureService Culture
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["ai.title"];
    var sort = Model.Sort ?? "health";
    var dir = Culture.Current.Direction;

    string MomentumLabel(string m) => m switch
    {
        "rising" => T["ai.momentum_rising"],
        "declining" => T["ai.momentum_declining"],
        "dormant" => T["ai.momentum_dormant"],
        _ => T["ai.momentum_stable"]
    };

    string HealthLabel(string h) => h switch
    {
        "Excellent" => T["ai.health_excellent"],
        "Good" => T["ai.health_good"],
        "Weak" => T["ai.health_weak"],
        "Critical" => T["ai.health_critical"],
        _ => T["ai.health_neutral"]
    };

    string HealthClass(string h) => (h ?? "Neutral").ToLowerInvariant().Replace(" ", "");
    string SortCls(string key) => sort == key ? "is-active" : "";
}

<link rel="stylesheet" href="~/css/author-intel.css" asp-append-version="true" />

<div class="ai-page" dir="@dir">
    <header class="ai-header">
        <div class="ai-header-text">
            <p class="ai-eyebrow">@T["admin.super_only"]</p>
            <h1 class="ai-title">@T["ai.title"]</h1>
            <p class="ai-sub">@T["ai.subtitle"]</p>
        </div>
        <form method="get" class="ai-search" action="@Url.Action("Index")" role="search">
            <label class="visually-hidden" for="ai-q">@T["ai.search_ph"]</label>
            <input id="ai-q" type="search" name="q" value="@Model.Q" placeholder="@T["ai.search_ph"]" class="ai-input" autocomplete="off" />
            <input type="hidden" name="sort" value="@sort" />
            <button type="submit" class="ai-btn">@T["ai.search_btn"]</button>
        </form>
    </header>

    <div class="ai-toolbar">
        <nav class="ai-sorts" aria-label="@T["ai.sort_health"]">
            <a class="ai-sort @SortCls("health")" href="@Url.Action("Index", new { q = Model.Q, sort = "health" })">@T["ai.sort_health"]</a>
            <a class="ai-sort @SortCls("views")" href="@Url.Action("Index", new { q = Model.Q, sort = "views" })">@T["ai.sort_views"]</a>
            <a class="ai-sort @SortCls("posts")" href="@Url.Action("Index", new { q = Model.Q, sort = "posts" })">@T["ai.sort_posts"]</a>
            <a class="ai-sort @SortCls("followers")" href="@Url.Action("Index", new { q = Model.Q, sort = "followers" })">@T["ai.sort_followers"]</a>
            <a class="ai-sort @SortCls("engagement")" href="@Url.Action("Index", new { q = Model.Q, sort = "engagement" })">@T["ai.sort_engagement"]</a>
            <a class="ai-sort @SortCls("recent")" href="@Url.Action("Index", new { q = Model.Q, sort = "recent" })">@T["ai.sort_recent"]</a>
            <a class="ai-sort @SortCls("name")" href="@Url.Action("Index", new { q = Model.Q, sort = "name" })">@T["ai.sort_name"]</a>
        </nav>
    </div>

    <div class="ai-kpis" role="group">
        <div class="ai-kpi">
            <span class="ai-kpi-val">@Model.TotalAuthors</span>
            <span class="ai-kpi-lbl">@T["ai.kpi_authors"]</span>
        </div>
        <div class="ai-kpi">
            <span class="ai-kpi-val">@Model.ActiveAuthors</span>
            <span class="ai-kpi-lbl">@T["ai.kpi_active"]</span>
        </div>
        <div class="ai-kpi ai-kpi--good">
            <span class="ai-kpi-val">@Model.RisingAuthors</span>
            <span class="ai-kpi-lbl">@T["ai.kpi_rising"]</span>
        </div>
        <div class="ai-kpi ai-kpi--warn">
            <span class="ai-kpi-val">@Model.DormantAuthors</span>
            <span class="ai-kpi-lbl">@T["ai.kpi_dormant"]</span>
        </div>
    </div>

    @if (Model.Authors.Count == 0)
    {
        <div class="ai-empty" role="status">
            <div class="ai-empty-title">@T["ai.empty"]</div>
            <p class="ai-empty-hint">@T["ai.empty_hint"]</p>
        </div>
    }
    else
    {
        <div class="ai-grid">
            @foreach (var a in Model.Authors)
            {
                <a class="ai-card" href="@Url.Action("Detail", new { id = a.UserId })">
                    <div class="ai-card-top">
                        <div class="ai-avatar @(a.HasAvatar ? "" : "ai-avatar--ph")">
                            @if (a.HasAvatar)
                            {
                                <img src="@Url.Action("ProfileImage", "Account", new { userId = a.UserId })" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrEmpty(a.DisplayName) ? "?" : char.ToUpperInvariant(a.DisplayName.Trim()[0]))</span>
                            }
                        </div>
                        <div class="ai-card-id">
                            <div class="ai-name">@a.DisplayName</div>
                            <div class="ai-handle ltr-field">@@@a.UserName</div>
                        </div>
                        <div class="ai-health ai-health--@HealthClass(a.HealthLabel)" title="@a.HealthScore">
                            <span class="ai-health-score">@a.HealthScore</span>
                            <span class="ai-health-lbl">@HealthLabel(a.HealthLabel)</span>
                        </div>
                    </div>

                    <div class="ai-momentum ai-momentum--@a.Momentum">@MomentumLabel(a.Momentum)</div>

                    <div class="ai-stats">
                        <div><strong>@a.PublishedPosts</strong><span>@T["ai.stat_posts"]</span></div>
                        <div><strong>@a.Views30d.ToString("N0")</strong><span>@T["ai.stat_views_30d"]</span></div>
                        <div><strong>@a.Likes</strong><span>@T["ai.stat_likes"]</span></div>
                        <div><strong>@a.Followers</strong><span>@T["ai.stat_followers"]</span></div>
                        <div><strong>@a.EngagementRate.ToString("0.##")%</strong><span>@T["ai.stat_eng"]</span></div>
                        <div><strong>@a.CurrentStreakDays</strong><span>@T["ai.stat_streak"]</span></div>
                    </div>

                    <div class="ai-card-foot">
                        @if (a.LastPublishedAtUtc.HasValue)
                        {
                            <span>@T["ai.last_publish"] <time class="ltr-field" datetime="@a.LastPublishedAtUtc.Value.ToString("yyyy-MM-dd")">@a.LastPublishedAtUtc.Value.ToString("yyyy-MM-dd")</time></span>
                        }
                        else
                        {
                            <span>@T["ai.no_publishes"]</span>
                        }
                        @if (a.OpenReports > 0)
                        {
                            <span class="ai-badge-risk">@a.OpenReports @T["ai.reports_badge"]</span>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>
