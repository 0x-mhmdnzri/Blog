@inject BlogApp.Services.IUiTranslator T
@{
    ViewData["Title"] = T["nl.unsub_title"];
    var ok = ViewBag.Ok as bool? ?? false;
}

<div class="container py-5" style="max-width:520px;">
    <div class="card-surface p-4 text-center">
        <h1 class="h4 mb-3">@T["nl.unsub_title"]</h1>
        <p class="@(ok ? "text-success" : "text-danger") mb-3">@ViewBag.Message</p>
        <a class="btn btn-ghost btn-sm" asp-action="Index">@T["nl.resubscribe"]</a>
    </div>
</div>
