@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BlogApp.Controllers.NewsletterSubscribeForm
@inject IUiTranslator T
@inject ICultureService Culture
@{
    ViewData["Title"] = T["nl.title"];
}

<div class="container py-5" style="max-width:520px;">
    <h1 class="h3 mb-2">@T["nl.title"]</h1>
    <p class="text-muted-dark mb-4">@T["nl.intro"]</p>

    @if (TempData["NlOk"] is string ok)
    {
        <div class="wizard-alert success mb-3">@ok</div>
    }
    @if (TempData["NlErr"] is string err)
    {
        <div class="wizard-alert danger mb-3">@err</div>
    }

    <form asp-action="Index" method="post" class="card-surface p-4">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label" asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control ltr-field" type="email" required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Name">@T["nl.name"]</label>
            <input asp-for="Name" class="form-control" dir="auto" />
        </div>
        <input type="hidden" asp-for="LanguageCode" value="@Culture.CurrentCode" />
        <button type="submit" class="btn btn-accent">@T["nl.subscribe"]</button>
    </form>
    <p class="small text-muted-dark mt-3 mb-0">@T["nl.double_optin_hint"]</p>
</div>
