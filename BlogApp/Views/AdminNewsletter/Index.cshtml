@inject BlogApp.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["admin.nav.newsletter"];
    var tab = (string)(ViewBag.ActiveTab ?? "overview");
    var subs = (List<NewsletterSubscriber>)ViewBag.Subscribers;
    var segments = (List<NewsletterSegment>)ViewBag.Segments;
    var campaigns = (List<NewsletterCampaign>)ViewBag.Campaigns;
}

@if (TempData["NlOk"] is string ok) { <div class="wizard-alert success mb-3">@ok</div> }
@if (TempData["NlErr"] is string err) { <div class="wizard-alert danger mb-3">@err</div> }

<div class="admin-tabs mb-3">
    <a class="admin-tab @(tab=="overview"?"active":"")" asp-action="Index" asp-route-tab="overview">@T["nl.tab_overview"]</a>
    <a class="admin-tab @(tab=="subscribers"?"active":"")" asp-action="Index" asp-route-tab="subscribers">@T["nl.tab_subscribers"]</a>
    <a class="admin-tab @(tab=="segments"?"active":"")" asp-action="Index" asp-route-tab="segments">@T["nl.tab_segments"]</a>
    <a class="admin-tab @(tab=="campaigns"?"active":"")" asp-action="Index" asp-route-tab="campaigns">@T["nl.tab_campaigns"]</a>
</div>

@if (tab == "overview")
{
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3"><div class="kpi-card kpi-compact"><div class="kpi-label">@T["nl.kpi_total"]</div><div class="kpi-value ltr-field">@ViewBag.Total</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi-card kpi-compact"><div class="kpi-label">@T["nl.kpi_confirmed"]</div><div class="kpi-value ltr-field">@ViewBag.Confirmed</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi-card kpi-compact"><div class="kpi-label">@T["nl.kpi_pending"]</div><div class="kpi-value ltr-field">@ViewBag.Pending</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi-card kpi-compact"><div class="kpi-label">@T["nl.kpi_campaigns"]</div><div class="kpi-value ltr-field">@ViewBag.CampaignCount</div></div></div>
    </div>
    <div class="chart-card chart-card-tight">
        <p class="small mb-2">@T["nl.overview_hint"]</p>
        <p class="small mb-0">
            <a asp-controller="Newsletter" asp-action="Index" target="_blank">@T["nl.public_page"]</a>
        </p>
    </div>
}

@if (tab == "subscribers")
{
    <div class="admin-table-wrap">
        <table class="admin-table" style="min-width:0;">
            <thead><tr><th>Email</th><th>@T["nl.name"]</th><th>@T["nl.status"]</th><th>Lang</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in subs)
            {
                <tr>
                    <td class="ltr-field small">@s.Email</td>
                    <td>@s.Name</td>
                    <td>@s.Status</td>
                    <td class="ltr-field">@s.LanguageCode</td>
                    <td>
                        <form asp-action="DeleteSubscriber" method="post" class="d-inline" onsubmit="return confirm('@T["msg.confirm_delete"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="icon-btn reject">@T["btn.delete"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (tab == "segments")
{
    <div class="chart-card chart-card-tight mb-3">
        <div class="chart-title mb-2">@T["nl.add_segment"]</div>
        <form asp-action="SaveSegment" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-3"><input name="name" class="form-control form-control-sm" placeholder="@T["nl.segment_name"]" required /></div>
            <div class="col-md-2"><input name="languageCode" class="form-control form-control-sm ltr-field" placeholder="fa/en/ar" /></div>
            <div class="col-md-2"><input name="requiredTag" class="form-control form-control-sm" placeholder="tag" /></div>
            <div class="col-md-3"><input name="description" class="form-control form-control-sm" placeholder="@T["nl.desc"]" /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-accent btn-sm w-100">@T["nl.save"]</button></div>
        </form>
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table" style="min-width:0;">
            <thead><tr><th>@T["nl.segment_name"]</th><th>Lang</th><th>Tag</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in segments)
            {
                <tr>
                    <td>@s.Name</td>
                    <td class="ltr-field">@(s.LanguageCode ?? "—")</td>
                    <td>@(s.RequiredTag ?? "—")</td>
                    <td>
                        <form asp-action="DeleteSegment" method="post" class="d-inline" onsubmit="return confirm('@T["msg.confirm_delete"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="icon-btn reject">@T["btn.delete"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (tab == "campaigns")
{
    <div class="chart-card chart-card-tight mb-3">
        <div class="chart-title mb-2">@T["nl.add_campaign"]</div>
        <form asp-action="SaveCampaign" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-12"><input name="subject" class="form-control form-control-sm" placeholder="@T["nl.subject"]" required /></div>
            <div class="col-12"><textarea name="bodyHtml" class="form-control form-control-sm ltr-field" rows="4" placeholder="HTML body" required></textarea></div>
            <div class="col-md-3">
                <select name="segmentId" class="form-select form-select-sm">
                    <option value="">@T["nl.all_confirmed"]</option>
                    @foreach (var s in segments)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2"><input name="languageFilter" class="form-control form-control-sm ltr-field" placeholder="lang" /></div>
            <div class="col-md-2"><input name="tagFilter" class="form-control form-control-sm" placeholder="tag" /></div>
            <div class="col-md-3"><input name="scheduledAtUtc" type="datetime-local" class="form-control form-control-sm ltr-field" /></div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" name="sendNow" value="false" class="btn btn-ghost btn-sm">@T["nl.schedule"]</button>
                <button type="submit" name="sendNow" value="true" class="btn btn-accent btn-sm">@T["nl.send_now"]</button>
            </div>
        </form>
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table" style="min-width:0;">
            <thead><tr><th>@T["nl.subject"]</th><th>@T["nl.status"]</th><th>Recipients</th><th>Sent</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in campaigns)
            {
                <tr>
                    <td>@c.Subject</td>
                    <td>@c.Status</td>
                    <td class="ltr-field">@c.RecipientCount</td>
                    <td class="ltr-field">@c.SentCount / @c.FailCount</td>
                    <td class="text-nowrap">
                        @if (c.Status is NewsletterCampaignStatus.Draft or NewsletterCampaignStatus.Scheduled)
                        {
                            <form asp-action="SendCampaign" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><button class="icon-btn">@T["nl.send_now"]</button></form>
                            <form asp-action="CancelCampaign" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><button class="icon-btn reject">@T["nl.cancel"]</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
