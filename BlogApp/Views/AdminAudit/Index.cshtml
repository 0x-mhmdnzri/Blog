@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["page.audit"];
    var topActions = ViewBag.TopActions as List<NamedCount> ?? new();
}

<div class="row g-3 mb-4">
    @foreach (var a in topActions)
    {
        <div class="col-6 col-md-3 col-lg-2">
            <div class="kpi-card">
                <div class="kpi-label ltr-field">@a.Name</div>
                <div class="kpi-value ltr-field">@a.Count</div>
            </div>
        </div>
    }
</div>

<div class="admin-table-wrap">
    <table id="auditTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>@T["col.index"]</th>
                <th>@T["col.time"]</th>
                <th>@T["col.user"]</th>
                <th>@T["col.action"]</th>
                <th>@T["col.entity"]</th>
                <th>@T["col.details"]</th>
                <th>@T["col.ip"]</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
BlogDT.init('#auditTable', {
    ajax: { url: '@Url.Action("Data", "AdminAudit")', type: 'GET' },
    exportUrl: '@Url.Action("ExportCsv", "AdminAudit")',
    columns: [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field' },
        { data: 1, className: 'ltr-field small' },
        { data: 2, className: 'ltr-field small' },
        { data: 3, className: 'ltr-field small' },
        { data: 4, className: 'ltr-field small' },
        { data: 5, className: 'small' },
        { data: 6, className: 'ltr-field small' }
    ],
    order: [[1, 'desc']],
    columnDefs: [{ orderable: false, targets: [0] }]
});
</script>
}
