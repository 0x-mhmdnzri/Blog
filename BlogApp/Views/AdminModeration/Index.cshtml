@model ModerationQueueViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["page.moderation"];
}

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-3">@T["mod.pending_comments"] (@Model.PendingComments.Count)</h2>
        @if (Model.PendingComments.Count == 0)
        {
            <div class="admin-empty"><p>@T["mod.no_pending_comments"]</p></div>
        }
        else
        {
            @foreach (var c in Model.PendingComments)
            {
                <div class="card-surface p-3 mb-2">
                    <div class="d-flex justify-content-between gap-2">
                        <strong dir="auto">@c.AuthorName</strong>
                        <span class="ltr-field small text-muted-dark">@PersianDate.DateTime(c.CreatedAtUtc)</span>
                    </div>
                    <p class="mb-2 mt-1 text-muted-dark" dir="auto">@c.Body</p>
                    <div class="small mb-2">
                        <a asp-controller="Posts" asp-action="Details" asp-route-slug="@c.PostSlug" dir="auto">@c.PostTitle</a>
                    </div>
                    <div class="d-flex gap-1">
                        <form asp-controller="Admin" asp-action="ApproveComment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="icon-btn approve">@T["btn.approve"]</button>
                        </form>
                        <form asp-controller="Admin" asp-action="RejectComment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="icon-btn reject">@T["btn.reject"]</button>
                        </form>
                    </div>
                </div>
            }
            <a class="btn btn-ghost btn-sm" asp-controller="Admin" asp-action="Comments">@T["mod.all_comments"] →</a>
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h6 text-muted-dark mb-3">@T["mod.open_reports"] (@Model.OpenReports.Count)</h2>
        @if (Model.OpenReports.Count == 0)
        {
            <div class="admin-empty"><p>@T["mod.no_open_reports"]</p></div>
        }
        else
        {
            @foreach (var r in Model.OpenReports)
            {
                <div class="card-surface p-3 mb-2">
                    <div class="small text-muted-dark">@(r.TargetType == ContentReportTarget.Post ? T["mod.target_post"] : T["mod.target_comment"]) · @r.Reason</div>
                    <div dir="auto" class="mb-1">@(r.TargetTitle ?? "#" + r.TargetId)</div>
                    @if (!string.IsNullOrEmpty(r.Details))
                    {
                        <p class="small text-muted-dark mb-2" dir="auto">@r.Details</p>
                    }
                    <div class="d-flex gap-1">
                        <form asp-controller="AdminReports" asp-action="Resolve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="icon-btn approve">@T["btn.resolve"]</button>
                        </form>
                        <form asp-controller="AdminReports" asp-action="Dismiss" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="icon-btn reject">@T["btn.dismiss"]</button>
                        </form>
                    </div>
                </div>
            }
            <a class="btn btn-ghost btn-sm" asp-controller="AdminReports" asp-action="Index">@T["mod.all_reports"] →</a>
        }
    </div>
</div>
