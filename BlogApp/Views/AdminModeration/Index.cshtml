@model ModerationQueueViewModel
@inject BlogApp.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["page.moderation"];
    var commentCount = Model.PendingComments.Count;
    var reportCount = Model.OpenReports.Count;
    var postCount = Model.PendingPosts?.Count ?? 0;
    var spamCount = Model.OpenReports.Count(r =>
        (r.Reason ?? "").Contains("spam", StringComparison.OrdinalIgnoreCase)
        || (r.Reason ?? "").Contains("اسپم", StringComparison.OrdinalIgnoreCase));
    var total = commentCount + reportCount + postCount;
}

<header class="mq-hero">
    <div>
        <p class="mq-eyebrow">@T["mod.eyebrow"]</p>
        <h1 class="mq-title">@T["page.moderation"]</h1>
        <p class="mq-sub">@T["mod.subtitle"]</p>
    </div>
    <div class="mq-hero-links">
        <a class="mq-link" asp-controller="Admin" asp-action="Comments">@T["mod.all_comments"]</a>
        <a class="mq-link" asp-controller="AdminReports" asp-action="Index">@T["mod.all_reports"]</a>
    </div>
</header>

<div class="mq-kpis">
    <button type="button" class="mq-kpi is-active" data-mq-filter="all">
        <span class="mq-kpi-label">@T["mod.filter_all"]</span>
        <span class="mq-kpi-val">@total</span>
    </button>
    <button type="button" class="mq-kpi" data-mq-filter="post">
        <span class="mq-kpi-label">@T["mod.pending_posts"]</span>
        <span class="mq-kpi-val">@postCount</span>
    </button>
    <button type="button" class="mq-kpi" data-mq-filter="comment">
        <span class="mq-kpi-label">@T["mod.pending_comments"]</span>
        <span class="mq-kpi-val">@commentCount</span>
    </button>
    <button type="button" class="mq-kpi" data-mq-filter="report">
        <span class="mq-kpi-label">@T["mod.open_reports"]</span>
        <span class="mq-kpi-val">@reportCount</span>
    </button>
    <button type="button" class="mq-kpi @(spamCount > 0 ? "mq-kpi-warn" : "")" data-mq-filter="spam">
        <span class="mq-kpi-label">@T["mod.spam"]</span>
        <span class="mq-kpi-val">@spamCount</span>
    </button>
</div>

<div class="mq-toolbar">
    <input type="search" class="mq-search" id="mqSearch" placeholder="@T["mod.search_placeholder"]" autocomplete="off" />
    <span class="mq-hint" id="mqHint" data-suffix="@T["mod.items_suffix"]">@total @T["mod.items_suffix"]</span>
</div>

@await Html.PartialAsync("_PendingPosts", Model)

@if (commentCount + reportCount == 0 && postCount == 0)
{
    <div class="mq-empty">
        <p class="mq-empty-title">@T["mod.queue_empty_title"]</p>
        <p class="mq-empty-hint">@T["mod.no_pending_posts"] · @T["mod.no_pending_comments"] · @T["mod.no_open_reports"]</p>
    </div>
}
else if (commentCount + reportCount > 0)
{
    <div class="mq-feed" id="mqFeed">
        @{
            var items = new List<(string Kind, DateTime At, object Payload)>();
            foreach (var c in Model.PendingComments)
                items.Add(("comment", c.CreatedAtUtc, c));
            foreach (var r in Model.OpenReports)
            {
                var isSpam = (r.Reason ?? "").Contains("spam", StringComparison.OrdinalIgnoreCase)
                             || (r.Reason ?? "").Contains("اسپم", StringComparison.OrdinalIgnoreCase);
                items.Add((isSpam ? "spam" : "report", r.CreatedAtUtc, r));
            }
            foreach (var item in items.OrderByDescending(x => x.At))
            {
                if (item.Kind == "comment")
                {
                    var c = (AdminCommentListItem)item.Payload;
                    <article class="mq-card" data-kind="comment" data-q="@((c.AuthorName + " " + c.Body + " " + c.PostTitle).ToLowerInvariant())">
                        <div class="mq-card-head">
                            <span class="mq-badge mq-badge-comment">@T["mod.badge_comment"]</span>
                            <span class="mq-time ltr-field">@PersianDate.DateTime(c.CreatedAtUtc)</span>
                        </div>
                        <div class="mq-card-who" dir="auto"><strong>@c.AuthorName</strong></div>
                        <p class="mq-card-body" dir="auto">@c.Body</p>
                        <div class="mq-card-meta">
                            <a asp-controller="Posts" asp-action="Details" asp-route-slug="@c.PostSlug" dir="auto">@c.PostTitle</a>
                        </div>
                        <div class="mq-card-acts">
                            <form asp-controller="Admin" asp-action="ApproveComment" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="mq-btn mq-btn-ok">@T["btn.approve"]</button>
                            </form>
                            <form asp-controller="Admin" asp-action="RejectComment" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="mq-btn mq-btn-bad">@T["btn.reject"]</button>
                            </form>
                        </div>
                    </article>
                }
                else
                {
                    var r = (ContentReport)item.Payload;
                    var kindAttr = item.Kind;
                    <article class="mq-card @(kindAttr == "spam" ? "mq-card-spam" : "")" data-kind="@kindAttr" data-q="@(((r.TargetTitle ?? "") + " " + r.Reason + " " + (r.Details ?? "") + " " + (r.ReporterName ?? "")).ToLowerInvariant())">
                        <div class="mq-card-head">
                            <span class="mq-badge @(kindAttr == "spam" ? "mq-badge-spam" : "mq-badge-report")">
                                @(kindAttr == "spam" ? T["mod.spam"] : T["mod.badge_report"])
                            </span>
                            <span class="mq-pill">@(r.TargetType == ContentReportTarget.Post ? T["mod.target_post"] : T["mod.target_comment"])</span>
                            <span class="mq-time ltr-field">@PersianDate.DateTime(r.CreatedAtUtc)</span>
                        </div>
                        <div class="mq-card-who" dir="auto">
                            <strong>@(r.TargetTitle ?? ("#" + r.TargetId))</strong>
                            <span class="mq-reason">@r.Reason</span>
                        </div>
                        @if (!string.IsNullOrEmpty(r.Details))
                        {
                            <p class="mq-card-body" dir="auto">@r.Details</p>
                        }
                        <div class="mq-card-meta">
                            @T["mod.reporter"]: @(r.ReporterName ?? "—")
                        </div>
                        <div class="mq-card-acts">
                            <form asp-controller="AdminReports" asp-action="Resolve" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="mq-btn mq-btn-ok">@T["btn.resolve"]</button>
                            </form>
                            <form asp-controller="AdminReports" asp-action="Dismiss" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="mq-btn mq-btn-ghost">@T["btn.dismiss"]</button>
                            </form>
                        </div>
                    </article>
                }
            }
        }
    </div>
    <p class="mq-none" id="mqNone" hidden>@T["mod.none_for_filter"]</p>
}

@section Styles {
<style>
.mq-hero{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;align-items:flex-end;margin-bottom:1.25rem}
.mq-eyebrow{font-size:.72rem;letter-spacing:.04em;text-transform:uppercase;color:var(--text-faint);margin:0 0 .25rem}
.mq-title{font-size:1.45rem;font-weight:750;margin:0}
.mq-sub{color:var(--text-muted);font-size:.9rem;margin:.35rem 0 0;max-width:36rem;line-height:1.55}
.mq-hero-links{display:flex;flex-wrap:wrap;gap:.5rem}
.mq-link{display:inline-flex;align-items:center;padding:.4rem .75rem;border-radius:10px;border:1px solid var(--border-soft);background:var(--surface);color:var(--text);text-decoration:none!important;font-size:.82rem}
.mq-link:hover{border-color:var(--accent-dim,var(--accent));color:var(--accent)}
.mq-kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.55rem;margin-bottom:1rem}
@@media (max-width:900px){.mq-kpis{grid-template-columns:1fr 1fr}}
.mq-kpi{background:var(--surface);border:1px solid var(--border-soft);border-radius:14px;padding:.85rem 1rem;display:flex;flex-direction:column;gap:.25rem;text-align:start;cursor:pointer;color:inherit;transition:border-color .15s,background .15s}
.mq-kpi:hover{border-color:var(--border)}
.mq-kpi.is-active{border-color:color-mix(in srgb,var(--accent) 45%,var(--border));background:color-mix(in srgb,var(--accent) 8%,var(--surface))}
.mq-kpi-warn{border-color:color-mix(in srgb,var(--danger) 35%,var(--border))}
.mq-kpi-label{font-size:.72rem;color:var(--text-muted);font-weight:550}
.mq-kpi-val{font-size:1.4rem;font-weight:750;direction:ltr;text-align:start;font-variant-numeric:tabular-nums}
.mq-kpi.is-active .mq-kpi-val{color:var(--accent)}
.mq-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem;margin-bottom:.85rem}
.mq-search{flex:1;max-width:20rem;background:var(--bg);border:1px solid var(--border-soft);border-radius:10px;padding:.5rem .85rem;color:var(--text);font-size:.86rem;outline:none}
.mq-search:focus{border-color:var(--accent-dim,var(--accent));box-shadow:0 0 0 3px var(--accent-soft,rgba(227,179,65,.15))}
.mq-hint{font-size:.8rem;color:var(--text-faint)}
.mq-feed{display:flex;flex-direction:column;gap:.75rem}
.mq-card{background:var(--surface);border:1px solid var(--border-soft);border-radius:14px;padding:1rem 1.1rem;transition:border-color .15s}
.mq-card.is-hidden{display:none}
.mq-card-spam{border-color:color-mix(in srgb,var(--danger) 30%,var(--border-soft))}
.mq-card-head{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin-bottom:.5rem}
.mq-badge{font-size:.68rem;font-weight:650;padding:.2rem .5rem;border-radius:999px;background:var(--surface-2);color:var(--text-muted)}
.mq-badge-comment{background:color-mix(in srgb,var(--accent) 14%,var(--surface));color:var(--accent)}
.mq-badge-report{background:color-mix(in srgb,#5b8def 14%,var(--surface));color:#5b8def}
.mq-badge-spam{background:color-mix(in srgb,var(--danger) 14%,var(--surface));color:var(--danger)}
.mq-pill{font-size:.68rem;padding:.15rem .45rem;border-radius:6px;border:1px solid var(--border-soft);color:var(--text-faint)}
.mq-time{margin-inline-start:auto;font-size:.75rem;color:var(--text-faint)}
.mq-card-who{font-size:.92rem;margin-bottom:.35rem}
.mq-reason{margin-inline-start:.4rem;font-size:.8rem;color:var(--text-muted)}
.mq-card-body{font-size:.9rem;line-height:1.55;color:var(--text);margin:0 0 .5rem;white-space:pre-wrap}
.mq-card-meta{font-size:.8rem;color:var(--text-muted);margin-bottom:.65rem}
.mq-card-meta a{color:var(--accent);text-decoration:none}
.mq-card-acts{display:flex;flex-wrap:wrap;gap:.4rem}
.mq-btn{border:1px solid var(--border-soft);background:var(--surface-2);color:var(--text);border-radius:9px;padding:.35rem .7rem;font-size:.8rem;cursor:pointer;font-family:inherit}
.mq-btn-ok{background:color-mix(in srgb,var(--success) 16%,var(--surface));border-color:color-mix(in srgb,var(--success) 35%,var(--border));color:var(--success)}
.mq-btn-bad{background:color-mix(in srgb,var(--danger) 12%,var(--surface));border-color:color-mix(in srgb,var(--danger) 30%,var(--border));color:var(--danger)}
.mq-btn-ghost{background:transparent}
.mq-empty,.mq-none{text-align:center;padding:2.5rem 1rem;color:var(--text-muted)}
.mq-empty-title{font-weight:650;font-size:1.05rem;color:var(--text);margin:0 0 .35rem}
.mq-empty-hint{margin:0;font-size:.88rem}
</style>
}

@section Scripts {
<script>
(function () {
  var filter = 'all';
  var search = document.getElementById('mqSearch');
  var feed = document.getElementById('mqFeed');
  var hint = document.getElementById('mqHint');
  var none = document.getElementById('mqNone');
  var suffix = (hint && hint.getAttribute('data-suffix')) || '';
  function apply() {
    var q = (search && search.value || '').trim().toLowerCase();
    var n = 0;
    document.querySelectorAll('.mq-card').forEach(function (card) {
      var kind = card.getAttribute('data-kind') || '';
      var kindOk = filter === 'all'
        || (filter === 'post' && kind === 'post')
        || (filter === 'comment' && kind === 'comment')
        || (filter === 'report' && (kind === 'report' || kind === 'spam'))
        || (filter === 'spam' && kind === 'spam');
      var qOk = !q || (card.getAttribute('data-q') || '').indexOf(q) !== -1;
      var ok = kindOk && qOk;
      card.classList.toggle('is-hidden', !ok);
      if (ok) n++;
    });
    if (hint) hint.textContent = n + (suffix ? (' ' + suffix) : '');
    if (none) none.hidden = n > 0;
  }
  document.querySelectorAll('[data-mq-filter]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      filter = btn.getAttribute('data-mq-filter') || 'all';
      document.querySelectorAll('[data-mq-filter]').forEach(function (b) {
        b.classList.toggle('is-active', b === btn);
      });
      apply();
    });
  });
  if (search) search.addEventListener('input', apply);
})();
</script>
}
