@model (IEnumerable<BlogApp.Services.AdminNavItem> Items, int PendingCount)
@inject BlogApp.Services.IUiTranslator T
@{
    var items = Model.Items.ToList();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string? lastGroup = null;
}
<nav class="admin-nav" id="adminNav" aria-label="Admin">
@foreach (var item in items)
{
    if (item.GroupKey != lastGroup)
    {
        lastGroup = item.GroupKey;
        <div class="admin-nav-group-label">@T[item.GroupKey!]</div>
    }
    var active = item.Matches(controller, action);
    <a class="admin-nav-link @(active ? "active" : "")"
       asp-controller="@item.Controller"
       asp-action="@item.Action"
       data-nav-key="@item.Key"
       title="@T[item.LabelKey]">
        <span class="nav-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" focusable="false">
                <path d="@item.Icon"/>
            </svg>
        </span>
        <span class="nav-label">@T[item.LabelKey]</span>
        <span class="nav-trail">
            @if (item.ShowPendingBadge)
            {
                <span class="badge-count" id="pendingBadge" style="@(Model.PendingCount > 0 ? "" : "display:none;")">@Model.PendingCount</span>
            }
            @if (item.DemoTag)
            {
                <span class="soon-tag">@T["admin.demo"]</span>
            }
            @if (item.SuperOnlyTag)
            {
                <span class="soon-tag">@T["admin.super_only"]</span>
            }
        </span>
    </a>
}
</nav>
