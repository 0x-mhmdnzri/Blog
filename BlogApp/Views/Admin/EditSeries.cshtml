@{
    Layout = "_AdminLayout";
    var series = (BlogApp.Models.PostSeries)ViewBag.Series;
    var members = (List<BlogApp.Models.SeriesPost>)ViewBag.Members;
    var available = ViewBag.AvailablePosts as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<p class="text-muted-dark mb-3">@series.Description</p>

<form asp-controller="Taxonomy" asp-action="AddPostToSeries" method="post" class="card-surface p-3 mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="seriesId" value="@series.Id" />
    <div class="row g-2 align-items-end">
        <div class="col-md-9">
            <label class="form-label">افزودن نوشته به سری</label>
            <select class="form-select form-select-sm" name="postId" required>
                @foreach (var p in available)
                {
                    <option value="@p.Id">@p.Title</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-accent btn-sm w-100">افزودن</button>
        </div>
    </div>
</form>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr><th>#</th><th>عنوان</th><th>عملیات</th></tr>
        </thead>
        <tbody>
        @foreach (var m in members)
        {
            <tr>
                <td><span class="ltr-field">@m.SortOrder</span></td>
                <td dir="auto"><a asp-controller="Posts" asp-action="Details" asp-route-slug="@m.Post.Slug">@m.Post.Title</a></td>
                <td>
                    <form asp-controller="Taxonomy" asp-action="RemovePostFromSeries" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="seriesId" value="@series.Id" />
                        <input type="hidden" name="postId" value="@m.PostId" />
                        <button type="submit" class="icon-btn reject">حذف از سری</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<a class="btn btn-ghost btn-sm mt-3" asp-controller="Taxonomy" asp-action="Categories">بازگشت</a>
