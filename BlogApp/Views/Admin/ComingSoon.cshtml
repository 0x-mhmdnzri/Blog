@model ComingSoonViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Title;
    var features = Model.DemoFeatures ?? new List<string>();
}

<div class="admin-empty" style="text-align:right;">
    <div class="mb-3" style="font-size:2rem;opacity:.45;">◇</div>
    <h2 class="mb-2" style="text-align:right;">@Model.Title</h2>
    <p class="text-muted-dark mb-4" style="max-width:520px;text-align:right;">@Model.Description</p>

    @if (features.Count > 0)
    {
        <div class="card-surface p-4" style="max-width:480px;text-align:right;">
            <div class="mb-3" style="font-size:0.8rem;color:var(--text-faint);">ویژگی‌های برنامه‌ریزی‌شده (دمو)</div>
            <ul class="mb-0" style="padding-right:1.25rem;padding-left:0;list-style-position:inside;text-align:right;">
                @foreach (var f in features)
                {
                    <li class="mb-2 text-muted-dark">@f</li>
                }
            </ul>
        </div>
    }

    <p class="mt-4 mb-0 small text-muted-dark" style="text-align:right;">
        این بخش به‌زودی فعال می‌شود — فعلاً پیش‌نمایش منوی کناری است.
    </p>
</div>
