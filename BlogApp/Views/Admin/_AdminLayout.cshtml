@inject BlogApp.Data.ApplicationDbContext Db
@inject BlogApp.Services.ICultureService Culture
@inject BlogApp.Services.IUiTranslator T
@using BlogApp.Models
@using BlogApp.Services
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    var isPostsSection = (currentController == "Admin" && currentAction == "Posts")
        || (currentController == "Posts" && (currentAction == "Create" || currentAction == "Edit"));
    var isDashboard = currentController == "Admin" && currentAction == "Index";
    var isProfile = currentController == "Account" && currentAction == "Profile";
    var isAuthors = currentController == "Account" && (currentAction == "Authors" || currentAction == "CreateAuthor");
    var isTaxonomy = currentController == "Taxonomy";
    var isAnalytics = currentController == "AdminAnalytics";
    var isSettings = currentController == "AdminSettings";
    var isUsers = currentController == "AdminUsers";
    var isAudit = currentController == "AdminAudit";
    var isReports = currentController == "AdminReports";
    var isModeration = currentController == "AdminModeration";
    var isSuperAdmin = AuthorAccess.IsSuperAdmin(User);

    var culture = Culture.Current;
    var lang = culture.Code;
    var dir = culture.Direction;

    var userId = AuthorAccess.UserId(User);
    int pendingCount;
    if (AuthorAccess.CanModerateAllComments(User))
        pendingCount = ViewBag.PendingCount as int? ?? await Db.Comments.CountAsync(c => c.Status == CommentStatus.Pending);
    else
        pendingCount = ViewBag.PendingCount as int?
            ?? await Db.Comments.CountAsync(c => c.Status == CommentStatus.Pending && c.Post.AuthorId == userId);

    var panelTitle = T["admin.panel"];
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = pageTitle != null ? $"{pageTitle} · {panelTitle}" : panelTitle;
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir" data-bs-theme="dark" data-culture="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="@culture.BootstrapCss" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-rtl.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cms-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/datatables-admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-brand">
                <span class="brand-cursor"></span>
                <span>@T["admin.brand"]</span>
            </div>

            <nav class="admin-nav">
                <div class="admin-nav-group-label">@T["admin.group.general"]</div>
                <a class="admin-nav-link @(isDashboard ? "active" : "")" asp-controller="Admin" asp-action="Index">
                    <span>@T["admin.nav.dashboard"]</span>
                </a>
                <a class="admin-nav-link @(isModeration ? "active" : "")" asp-controller="AdminModeration" asp-action="Index">
                    <span>@T["admin.nav.moderation"]</span>
                </a>
                <a class="admin-nav-link @(isPostsSection ? "active" : "")" asp-controller="Admin" asp-action="Posts">
                    <span>@T["admin.nav.posts"]</span>
                </a>
                <a class="admin-nav-link @(IsActive("Comments") ? "active" : "")" asp-controller="Admin" asp-action="Comments">
                    <span>@T["admin.nav.comments"]</span>
                    <span class="badge-count" id="pendingBadge" style="@(pendingCount > 0 ? "" : "display:none;")">@pendingCount</span>
                </a>
                <a class="admin-nav-link @(isReports ? "active" : "")" asp-controller="AdminReports" asp-action="Index">
                    <span>@T["admin.nav.reports"]</span>
                </a>

                <div class="admin-nav-group-label">@T["admin.group.content"]</div>
                <a class="admin-nav-link @(IsActive("Media") ? "active" : "")" asp-controller="Admin" asp-action="Media">
                    <span>@T["admin.nav.media"]</span>
                    <span class="soon-tag">@T["admin.demo"]</span>
                </a>
                <a class="admin-nav-link @(isTaxonomy ? "active" : "")" asp-controller="Taxonomy" asp-action="Categories">
                    <span>@T["admin.nav.taxonomy"]</span>
                </a>

                <div class="admin-nav-group-label">@T["admin.group.growth"]</div>
                <a class="admin-nav-link @(isAnalytics ? "active" : "")" asp-controller="AdminAnalytics" asp-action="Index">
                    <span>@T["admin.nav.analytics"]</span>
                </a>
                <a class="admin-nav-link @(IsActive("SeoTools") ? "active" : "")" asp-controller="Admin" asp-action="SeoTools">
                    <span>@T["admin.nav.seo"]</span>
                    <span class="soon-tag">@T["admin.demo"]</span>
                </a>
                <a class="admin-nav-link @(IsActive("Newsletter") ? "active" : "")" asp-controller="Admin" asp-action="Newsletter">
                    <span>@T["admin.nav.newsletter"]</span>
                    <span class="soon-tag">@T["admin.demo"]</span>
                </a>

                <div class="admin-nav-group-label">@T["admin.group.account"]</div>
                <a class="admin-nav-link @(isProfile ? "active" : "")" asp-controller="Account" asp-action="Profile">
                    <span>@T["admin.nav.profile"]</span>
                </a>
                @if (isSuperAdmin)
                {
                    <a class="admin-nav-link @(isUsers ? "active" : "")" asp-controller="AdminUsers" asp-action="Index">
                        <span>@T["admin.nav.users"]</span>
                    </a>
                    <a class="admin-nav-link @(isAuthors ? "active" : "")" asp-controller="Account" asp-action="Authors">
                        <span>@T["admin.nav.authors"]</span>
                    </a>
                }

                <div class="admin-nav-group-label">@T["admin.group.system"]</div>
                @if (isSuperAdmin)
                {
                    <a class="admin-nav-link @(isSettings && IsActive("Index") ? "active" : "")" asp-controller="AdminSettings" asp-action="Index">
                        <span>@T["admin.nav.settings"]</span>
                    </a>
                    <a class="admin-nav-link @(isSettings && IsActive("FeatureFlags") ? "active" : "")" asp-controller="AdminSettings" asp-action="FeatureFlags">
                        <span>@T["admin.nav.flags"]</span>
                    </a>
                    <a class="admin-nav-link @(isAudit ? "active" : "")" asp-controller="AdminAudit" asp-action="Index">
                        <span>@T["admin.nav.audit"]</span>
                    </a>
                }
                else
                {
                    <a class="admin-nav-link" asp-controller="Admin" asp-action="Settings">
                        <span>@T["admin.nav.settings"]</span>
                        <span class="soon-tag">@T["admin.super_only"]</span>
                    </a>
                }
            </nav>

            <div class="admin-sidebar-footer">
                <a asp-controller="Home" asp-action="Index">‹ @T["admin.back_to_site"]</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit">@T["admin.logout"]</button>
                </form>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-topbar d-flex justify-content-between align-items-center">
                <div>
                    <div class="eyebrow mb-1">@panelTitle</div>
                    <h1>@pageTitle</h1>
                </div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <partial name="_LanguageSwitcher" />
                    <span id="liveIndicator" class="live-indicator" title="@T["admin.live_title"]">
                        <span class="live-dot"></span> @T["admin.live"]
                    </span>
                    <button class="btn btn-ghost btn-sm d-md-none" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('open')">☰</button>
                </div>
            </header>

            <div class="admin-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/datatables-server.js" asp-append-version="true"></script>
    <script>
        (function () {
            const indicator = document.getElementById('liveIndicator');
            const pendingBadge = document.getElementById('pendingBadge');
            let pendingCount = @pendingCount;

            function setLive(isLive) {
                if (!indicator) return;
                indicator.classList.toggle('live-on', isLive);
                indicator.classList.toggle('live-off', !isLive);
            }

            function updatePendingBadge(delta) {
                pendingCount = Math.max(0, pendingCount + delta);
                if (!pendingBadge) return;
                pendingBadge.textContent = pendingCount;
                pendingBadge.style.display = pendingCount > 0 ? '' : 'none';
            }

            const source = new EventSource('/Admin/Stream');
            source.onopen = () => setLive(true);
            source.onerror = () => setLive(false);
            source.onmessage = (e) => {
                setLive(true);
                let data;
                try { data = JSON.parse(e.data); } catch { return; }
                if (data.type === 'comment') {
                    if (data.status === 'pending') updatePendingBadge(1);
                    else if (['approved', 'rejected', 'deleted'].includes(data.status)) updatePendingBadge(-1);
                }
                window.dispatchEvent(new CustomEvent('admin-sse-message', { detail: data }));
            };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
