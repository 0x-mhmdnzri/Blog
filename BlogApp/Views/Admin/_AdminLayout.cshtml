@inject BlogApp.Data.ApplicationDbContext Db
@inject BlogApp.Services.ICultureService Culture
@inject BlogApp.Services.IUiTranslator T
@using BlogApp.Models
@using BlogApp.Services
@{
    var culture = Culture.Current;
    var lang = culture.Code;
    var dir = culture.Direction;

    var userId = AuthorAccess.UserId(User);
    int pendingCount;
    if (AuthorAccess.CanModerateAllComments(User))
        pendingCount = ViewBag.PendingCount as int? ?? await Db.Comments.CountAsync(c => c.Status == CommentStatus.Pending);
    else
        pendingCount = ViewBag.PendingCount as int?
            ?? await Db.Comments.CountAsync(c => c.Status == CommentStatus.Pending && c.Post.AuthorId == userId);

    var panelTitle = T["admin.panel"];
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = pageTitle != null ? $"{pageTitle} · {panelTitle}" : panelTitle;

    var navItems = AdminNavCatalog.ForUser(User).ToList();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var activeNav = navItems.FirstOrDefault(i => i.Matches(currentController, currentAction));

    var crumbExtra = ViewData["Breadcrumb"] as string;

    var dtKeys = new[]
    {
        "dt.processing", "dt.search", "dt.search_placeholder", "dt.length_menu",
        "dt.info", "dt.info_empty", "dt.info_filtered", "dt.zero_records", "dt.empty_table",
        "dt.paginate_first", "dt.paginate_last", "dt.paginate_next", "dt.paginate_previous",
        "btn.approve", "btn.reject", "btn.delete", "btn.edit", "btn.duplicate", "btn.restore",
        "msg.confirm_delete", "msg.confirm_trash", "msg.confirm_delete_comment"
    };
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir" data-bs-theme="dark" data-culture="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="@culture.BootstrapCss" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-rtl.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cms-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/datatables-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications-bell.css" asp-append-version="true" />
    <script>
      // Apply locked sidebar before paint to avoid width jump
      (function () {
        try {
          var m = document.cookie.match(/(?:^|; )Blog\.AdminSidebarLocked=([^;]*)/);
          if (m && decodeURIComponent(m[1]) === '1') {
            document.documentElement.classList.add('sidebar-lock-pending');
          }
        } catch (e) {}
      })();
    </script>
    <style>
      html.sidebar-lock-pending .admin-sidebar { width: 260px !important; transition: none !important; }
      html.sidebar-lock-pending .admin-sidebar .nav-label,
      html.sidebar-lock-pending .admin-sidebar .nav-trail,
      html.sidebar-lock-pending .admin-sidebar .admin-nav-group-label,
      html.sidebar-lock-pending .admin-sidebar .brand-text { display: initial !important; }
      html.sidebar-lock-pending .admin-sidebar .admin-nav-link { justify-content: flex-start !important; padding: 0.65rem 0.85rem !important; }
    </style>
</head>
<body class="admin-body sidebar-collapsed">
    <div id="adminPageOverlay" class="admin-page-overlay" aria-hidden="true">
        <div class="admin-page-spinner" role="status"></div>
    </div>
    <div class="admin-sidebar-backdrop" id="adminSidebarBackdrop"></div>
    <div class="admin-shell">
        <aside class="admin-sidebar is-collapsed" id="adminSidebar">
            <div class="admin-brand">
                <span class="brand-cursor"></span>
                <span class="brand-text">@T["admin.brand"]</span>
                <button type="button"
                        class="sidebar-lock-btn"
                        id="sidebarLockBtn"
                        aria-pressed="false"
                        data-title-lock="@T["admin.sidebar_lock"]"
                        data-title-unlock="@T["admin.sidebar_unlock"]"
                        title="@T["admin.sidebar_lock"]">
                    <svg class="icon-lock" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/>
                    </svg>
                </button>
            </div>

            <partial name="~/Views/Shared/_AdminNav.cshtml" model="(navItems, pendingCount)" />

            <div class="admin-sidebar-footer">
                <a asp-controller="Home" asp-action="Index" class="footer-link" title="@T["admin.back_to_site"]">
                    <span class="nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                    </span>
                    <span class="nav-label">@T["admin.back_to_site"]</span>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="footer-logout" title="@T["admin.logout"]">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                        </span>
                        <span class="nav-label">@T["admin.logout"]</span>
                    </button>
                </form>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-topbar">
                <div class="admin-topbar-start d-flex align-items-start gap-2">
                    <button class="btn btn-ghost btn-sm admin-menu-toggle d-md-none" type="button" data-admin-toggle title="Menu">☰</button>
                    <div class="admin-topbar-titles">
                        <nav class="admin-breadcrumb" aria-label="breadcrumb">
                            <a asp-controller="Admin" asp-action="Index" class="bc-link">@panelTitle</a>
                            @if (activeNav?.GroupKey is string gk)
                            {
                                <span class="bc-sep" aria-hidden="true">/</span>
                                <span class="bc-group">@T[gk]</span>
                            }
                            @if (activeNav != null)
                            {
                                <span class="bc-sep" aria-hidden="true">/</span>
                                <a class="bc-link" asp-controller="@activeNav.Controller" asp-action="@activeNav.Action">@T[activeNav.LabelKey]</a>
                            }
                            else if (!string.IsNullOrEmpty(pageTitle))
                            {
                                <span class="bc-sep" aria-hidden="true">/</span>
                                <span class="bc-current">@pageTitle</span>
                            }
                            @if (!string.IsNullOrEmpty(crumbExtra))
                            {
                                <span class="bc-sep" aria-hidden="true">/</span>
                                <span class="bc-current">@crumbExtra</span>
                            }
                        </nav>
                        <h1>@(pageTitle ?? panelTitle)</h1>
                    </div>
                </div>
                <div class="admin-topbar-end d-flex align-items-center gap-3 flex-wrap">
                    <partial name="_NotificationBell" />
                    <partial name="_LanguageSwitcher" />
                    <span id="liveIndicator" class="live-indicator" title="@T["admin.live_title"]">
                        <span class="live-dot"></span> @T["admin.live"]
                    </span>
                </div>
            </header>

            <div class="admin-content is-loading">
                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        window.__i18n = {
@foreach (var k in dtKeys)
{
            @Html.Raw($"            '{k}': {System.Text.Json.JsonSerializer.Serialize(T[k])},\n")
}
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/datatables-server.js" asp-append-version="true"></script>
    <script src="~/js/notifications-bell.js" asp-append-version="true"></script>
    <script src="~/js/admin-sidebar.js" asp-append-version="true"></script>
    <script>
        (function () {
            document.documentElement.classList.remove('sidebar-lock-pending');
            const indicator = document.getElementById('liveIndicator');
            const pendingBadge = document.getElementById('pendingBadge');
            let pendingCount = @pendingCount;

            function setLive(isLive) {
                if (!indicator) return;
                indicator.classList.toggle('live-on', isLive);
                indicator.classList.toggle('live-off', !isLive);
            }

            function updatePendingBadge(delta) {
                pendingCount = Math.max(0, pendingCount + delta);
                if (!pendingBadge) return;
                pendingBadge.textContent = pendingCount;
                pendingBadge.style.display = pendingCount > 0 ? '' : 'none';
            }

            const source = new EventSource('/Admin/Stream');
            source.onopen = () => setLive(true);
            source.onerror = () => setLive(false);
            source.onmessage = (e) => {
                setLive(true);
                let data;
                try { data = JSON.parse(e.data); } catch { return; }
                if (data.type === 'comment') {
                    if (data.status === 'pending') updatePendingBadge(1);
                    else if (['approved', 'rejected', 'deleted'].includes(data.status)) updatePendingBadge(-1);
                }
                window.dispatchEvent(new CustomEvent('admin-sse-message', { detail: data }));
            };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.querySelector('.admin-content')?.classList.remove('is-loading');
        document.getElementById('adminPageOverlay')?.classList.remove('is-visible');
    </script>
</body>
</html>
