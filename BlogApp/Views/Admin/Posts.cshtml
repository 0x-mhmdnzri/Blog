@{
    Layout = "_AdminLayout";
    ViewData["Title"] = T["page.posts"];
    var showAuthor = ViewBag.ShowAuthorColumn as bool? ?? false;
    var j = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="admin-tabs mb-0">
        <span class="admin-tab active">@T["tab.all"]</span>
    </div>
    <a class="btn btn-accent btn-sm" asp-controller="Posts" asp-action="Create">@T["btn.new_post"]</a>
</div>

@Html.AntiForgeryToken()

<div id="postDeleteModal" class="pdm" hidden aria-hidden="true">
  <div class="pdm-backdrop" data-pdm-close></div>
  <div class="pdm-dialog" role="dialog" aria-modal="true" aria-labelledby="pdmTitle">
    <h2 id="pdmTitle" class="pdm-title">حذف نوشته</h2>
    <p class="pdm-sub text-muted-dark">آیا از انتقال این نوشته به سطل زباله مطمئن هستید؟</p>
    <p class="pdm-post" id="pdmPostTitle" dir="auto"></p>
    <form id="pdmForm" method="post" action="/Posts/Delete">
      <input type="hidden" name="__RequestVerificationToken" id="pdmToken" value="" />
      <input type="hidden" name="id" id="pdmId" value="" />
      <label class="form-label" for="pdmReason">دلیل حذف (اختیاری)</label>
      <textarea id="pdmReason" name="reason" class="form-control" rows="3" maxlength="500"
                placeholder="مثلاً: محتوای تکراری، درخواست نویسنده، …"></textarea>
      <div class="pdm-actions">
        <button type="button" class="btn btn-ghost" data-pdm-close>انصراف</button>
        <button type="submit" class="btn btn-accent" style="background:var(--danger,#ef4444);border-color:transparent">تأیید حذف</button>
      </div>
    </form>
  </div>
</div>
<style>
.pdm{position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem}
.pdm[hidden]{display:none!important}
.pdm-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(2px)}
.pdm-dialog{position:relative;z-index:1;width:min(420px,100%);background:var(--surface,var(--bg,#1a1d24));border:1px solid var(--border-soft,rgba(255,255,255,.1));border-radius:12px;padding:1.25rem 1.35rem;box-shadow:0 20px 50px rgba(0,0,0,.4)}
.pdm-title{font-size:1.1rem;margin:0 0 .35rem;font-weight:600}
.pdm-sub{font-size:.9rem;margin:0 0 .75rem}
.pdm-post{font-weight:600;margin:0 0 1rem;padding:.5rem .65rem;border-radius:8px;background:var(--surface-2,rgba(255,255,255,.04))}
.pdm-actions{display:flex;gap:.5rem;justify-content:flex-end;margin-top:1rem;flex-wrap:wrap}
</style>

<div class="admin-table-wrap">
    <table id="postsTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>@T["col.index"]</th>
                <th>@T["col.title"]</th>
                @if (showAuthor)
                {
                    <th>@T["col.author"]</th>
                }
                <th>@T["col.category"]</th>
                <th>@T["col.status"]</th>
                <th>@T["col.features"]</th>
                <th>@T["col.views"]</th>
                <th>@T["col.comments"]</th>
                <th>@T["col.date"]</th>
                <th>@T["col.actions"]</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
(function () {
    var showAuthor = @(showAuthor ? "true" : "false");
    var columns = [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field col-idx' },
        { data: 1, className: 'col-title' },
    ];
    if (showAuthor) columns.push({ data: 2, className: 'col-author' });
    var offset = showAuthor ? 1 : 0;
    columns.push(
        { data: 2 + offset, className: 'col-category' },
        { data: 3 + offset, orderable: true, className: 'col-status' },
        { data: 4 + offset, orderable: false, searchable: false, className: 'col-features' },
        { data: 5 + offset, className: 'ltr-field col-num' },
        { data: 6 + offset, className: 'ltr-field col-num' },
        { data: 7 + offset, className: 'ltr-field col-date' },
        { data: 8 + offset, orderable: false, searchable: false, className: 'col-actions' }
    );
    var dateCol = 7 + offset;

    var columnFilters = [false, true];
    if (showAuthor) columnFilters.push(true);
    columnFilters.push(true);
    columnFilters.push({
        type: 'select',
        placeholder: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["col.status"].ToString(), j)),
        options: [
            { value: 'published', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.published_full"].ToString(), j)) },
            { value: 'draft', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.draft"].ToString(), j)) },
            { value: 'scheduled', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.scheduled"].ToString(), j)) },
            { value: 'deleted', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.deleted"].ToString(), j)) }
        ]
    });
    columnFilters.push(false, false, false, false, false);

    (function () {
      var modal = document.getElementById('postDeleteModal');
      if (!modal) return;
      var idEl = document.getElementById('pdmId');
      var titleEl = document.getElementById('pdmPostTitle');
      var reasonEl = document.getElementById('pdmReason');
      var tokenEl = document.getElementById('pdmToken');
      var pageToken = document.querySelector('input[name="__RequestVerificationToken"]');

      function open(id, title) {
        idEl.value = id;
        titleEl.textContent = title || ('#' + id);
        reasonEl.value = '';
        if (pageToken) tokenEl.value = pageToken.value;
        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        setTimeout(function () { reasonEl.focus(); }, 50);
      }
      function close() {
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
      }

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-post-delete]');
        if (btn) {
          e.preventDefault();
          open(btn.getAttribute('data-id'), btn.getAttribute('data-title'));
          return;
        }
        if (e.target.closest('[data-pdm-close]')) {
          e.preventDefault();
          close();
        }
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) close();
      });
    })();

    BlogDT.init('#postsTable', {
        ajax: { url: '@Url.Action("PostsData", "Admin")', type: 'GET' },
        exportUrl: '@Url.Action("PostsExportCsv", "Admin")',
        columns: columns,
        order: [[dateCol, 'desc']],
        columnDefs: [{ orderable: false, targets: [0, columns.length - 1] }],
        columnFilters: columnFilters
    });
})();
</script>
}
