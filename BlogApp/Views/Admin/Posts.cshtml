@{
    Layout = "_AdminLayout";
    ViewData["Title"] = T["page.posts"];
    var showAuthor = ViewBag.ShowAuthorColumn as bool? == true;
    var scope = (ViewBag.Scope as string) ?? "all";
    var pendingCreated = TempData["PostCreatedPending"] as string == "1";
    var createdTitle = TempData["PostCreatedTitle"] as string;
    var j = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div class="admin-tabs mb-0">
        <a class="admin-tab @(scope == "all" ? "active" : "")" asp-action="Posts" asp-route-scope="all">
            @T["tab.all"] <span class="text-muted-dark">(@(ViewBag.AllCount ?? 0))</span>
        </a>
        <a class="admin-tab @(scope == "published" ? "active" : "")" asp-action="Posts" asp-route-scope="published">
            @T["status.published_full"] <span class="text-muted-dark">(@(ViewBag.PublishedCount ?? 0))</span>
        </a>
        <a class="admin-tab @(scope == "draft" ? "active" : "")" asp-action="Posts" asp-route-scope="draft">
            @T["status.draft"] <span class="text-muted-dark">(@(ViewBag.DraftCount ?? 0))</span>
        </a>
        <a class="admin-tab @(scope == "pending" ? "active" : "")" asp-action="Posts" asp-route-scope="pending">
            @T["post.status_pending_review"] <span class="text-muted-dark">(@(ViewBag.PendingCount ?? 0))</span>
        </a>
        <a class="admin-tab @(scope == "trash" ? "active" : "")" asp-action="Posts" asp-route-scope="trash">
            @T["status.deleted"] <span class="text-muted-dark">(@(ViewBag.TrashCount ?? 0))</span>
        </a>
    </div>
    <a class="btn btn-accent btn-sm" asp-controller="Posts" asp-action="Create">@T["btn.new_post"]</a>
</div>

@Html.AntiForgeryToken()

<div class="admin-table-wrap">
    <table id="postsTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>@T["col.index"]</th>
                <th>@T["col.title"]</th>
                @if (showAuthor)
                {
                    <th>@T["col.author"]</th>
                }
                <th>@T["col.category"]</th>
                <th>@T["col.status"]</th>
                <th>@T["col.features"]</th>
                <th>@T["col.views"]</th>
                <th>@T["col.comments"]</th>
                <th>@T["col.date"]</th>
                <th>@T["col.actions"]</th>
            </tr>
        </thead>
    </table>
</div>

@* Soft-delete confirm *@
<div id="postDeleteModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-surface">
            <div class="modal-header border-0">
                <h5 class="modal-title">@T["btn.delete"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="pdmForm" method="post" action="/Posts/Delete">
                <div class="modal-body">
                    <input type="hidden" name="__RequestVerificationToken" id="pdmToken" value="" />
                    <input type="hidden" name="id" id="pdmId" value="" />
                    <p class="mb-2" id="pdmPostTitle" dir="auto"></p>
                    <label class="form-label" for="pdmReason">@T["report.reason"] (@T["msg.optional"])</label>
                    <textarea class="form-control" id="pdmReason" name="reason" maxlength="500" rows="3"></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">@T["btn.cancel"]</button>
                    <button type="submit" class="btn btn-danger">@T["btn.delete"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (pendingCreated)
{
    <div class="modal fade" id="postPendingModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card-surface">
                <div class="modal-header border-0">
                    <h5 class="modal-title">@T["post.status_pending_review"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p dir="auto">@T["post.created_pending_hint"]</p>
                    @if (!string.IsNullOrEmpty(createdTitle))
                    {
                        <p class="fw-semibold" dir="auto">@createdTitle</p>
                    }
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-accent" data-bs-dismiss="modal">@T["btn.ok"]</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    var showAuthor = @(showAuthor ? "true" : "false");
    var scope = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(scope, j));

    var cols = [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field col-idx' },
        { data: 1, className: 'dt-wrap' }
    ];
    if (showAuthor) cols.push({ data: 2 });
    var off = showAuthor ? 1 : 0;
    cols.push(
        { data: 2 + off },
        { data: 3 + off, className: 'col-status' },
        { data: 4 + off, orderable: false },
        { data: 5 + off, className: 'ltr-field' },
        { data: 6 + off, className: 'ltr-field' },
        { data: 7 + off, className: 'ltr-field col-date' },
        { data: 8 + off, orderable: false, searchable: false }
    );

    BlogDT.init('#postsTable', {
        ajax: {
            url: '@Url.Action("PostsData", "Admin")',
            type: 'GET',
            data: function (d) { d.scope = scope; }
        },
        columns: cols,
        order: [[7 + off, 'desc']]
    });

    var pageToken = document.querySelector('input[name="__RequestVerificationToken"]');
    var modalEl = document.getElementById('postDeleteModal');
    var bsModal = modalEl && window.bootstrap ? new bootstrap.Modal(modalEl) : null;

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-post-delete]');
        if (!btn) return;
        e.preventDefault();
        document.getElementById('pdmId').value = btn.getAttribute('data-id') || '';
        document.getElementById('pdmPostTitle').textContent = btn.getAttribute('data-title') || '';
        document.getElementById('pdmReason').value = '';
        if (pageToken) document.getElementById('pdmToken').value = pageToken.value;
        if (bsModal) bsModal.show();
    });

    var pendingEl = document.getElementById('postPendingModal');
    if (pendingEl && window.bootstrap) {
        new bootstrap.Modal(pendingEl).show();
    }
})();
</script>
}
