@{
    Layout = "_AdminLayout";
    ViewData["Title"] = T["page.posts"];
    var showAuthor = ViewBag.ShowAuthorColumn as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="admin-tabs mb-0">
        <span class="admin-tab active">@T["tab.all"]</span>
    </div>
    <a class="btn btn-accent btn-sm" asp-controller="Posts" asp-action="Create">@T["btn.new_post"]</a>
</div>

@Html.AntiForgeryToken()

<div class="admin-table-wrap">
    <table id="postsTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>@T["col.index"]</th>
                <th>@T["col.title"]</th>
                @if (showAuthor)
                {
                    <th>@T["col.author"]</th>
                }
                <th>@T["col.category"]</th>
                <th>@T["col.status"]</th>
                <th>@T["col.features"]</th>
                <th>@T["col.views"]</th>
                <th>@T["col.comments"]</th>
                <th>@T["col.date"]</th>
                <th>@T["col.actions"]</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
(function () {
    var showAuthor = @(showAuthor ? "true" : "false");
    var columns = [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field' },
        { data: 1 },
    ];
    if (showAuthor) columns.push({ data: 2 });
    var offset = showAuthor ? 1 : 0;
    columns.push(
        { data: 2 + offset },
        { data: 3 + offset, orderable: true },
        { data: 4 + offset, orderable: false, searchable: false },
        { data: 5 + offset, className: 'ltr-field' },
        { data: 6 + offset, className: 'ltr-field' },
        { data: 7 + offset, className: 'ltr-field' },
        { data: 8 + offset, orderable: false, searchable: false }
    );
    var dateCol = 7 + offset;
    var statusCol = 3 + offset;

    // Per-column filters: text inputs; status = dropdown
    var columnFilters = [false, true]; // idx, title
    if (showAuthor) columnFilters.push(true); // author
    columnFilters.push(true); // category
    columnFilters.push({
        type: 'select',
        placeholder: '@T["col.status"]',
        options: [
            { value: 'published', label: '@T["status.published_full"]' },
            { value: 'draft', label: '@T["status.draft"]' },
            { value: 'scheduled', label: '@T["status.scheduled"]' },
            { value: 'deleted', label: '@T["status.deleted"]' }
        ]
    });
    columnFilters.push(false, false, false, false, false); // features, views, comments, date, actions

    BlogDT.init('#postsTable', {
        ajax: { url: '@Url.Action("PostsData", "Admin")', type: 'GET' },
        exportUrl: '@Url.Action("PostsExportCsv", "Admin")',
        columns: columns,
        order: [[dateCol, 'desc']],
        columnDefs: [{ orderable: false, targets: [0, columns.length - 1] }],
        columnFilters: columnFilters
    });
})();
</script>
}
