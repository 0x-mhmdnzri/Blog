@model BlogApp.Models.ViewModels.PostsFinderViewModel
@{
    Layout = null;
    ViewData["Title"] = T["page.posts"];
    var pendingCreated = TempData["PostCreatedPending"] as string == "1";
    var createdTitle = TempData["PostCreatedTitle"] as string;
    var scope = Model.Scope ?? "all";
    var sort = Model.Sort ?? "recent";
    string ScopeUrl(string s) => Url.Action("Posts", "Admin", new { scope = s, sort, q = Model.Search })!;
    string FolderUrl(int id) => Url.Action("Posts", "Admin", new { scope = "all", folderId = id, sort, q = Model.Search })!;
    string CatUrl(int id) => Url.Action("Posts", "Admin", new { scope = "all", categoryId = id, sort, q = Model.Search })!;
    string TagUrl(int id) => Url.Action("Posts", "Admin", new { scope = "all", tagId = id, sort, q = Model.Search })!;
    string StatusLabel(FinderPostItem p)
    {
        if (p.IsDeleted) return T["status.deleted"].ToString();
        if (p.ReviewStatus == PostReviewStatus.PendingReview && !p.IsPublished) return T["post.status_pending_review"].ToString();
        if (p.ScheduledPublishAtUtc.HasValue && !p.IsPublished) return T["status.scheduled"].ToString();
        if (p.IsPublished) return T["status.published_full"].ToString();
        return T["status.draft"].ToString();
    }
    string StatusKey(FinderPostItem p)
    {
        if (p.IsDeleted) return "trash";
        if (p.ReviewStatus == PostReviewStatus.PendingReview && !p.IsPublished) return "pending";
        if (p.ScheduledPublishAtUtc.HasValue && !p.IsPublished) return "scheduled";
        if (p.IsPublished) return "published";
        return "draft";
    }
    var heading = scope switch
    {
        "published" => T["status.published_full"].ToString(),
        "draft" => T["status.draft"].ToString(),
        "pending" => T["post.status_pending_review"].ToString(),
        "trash" => T["status.deleted"].ToString(),
        _ => T["page.posts"].ToString()
    };
    if (Model.FolderId is int fid)
    {
        var f = Model.Folders.FirstOrDefault(x => x.Id == fid);
        if (f != null) heading = f.Name;
    }
    else if (Model.CategoryId is int cid)
    {
        var c = Model.Categories.FirstOrDefault(x => x.Id == cid);
        if (c != null) heading = c.Name;
    }
    else if (Model.TagId is int tid)
    {
        var t = Model.Tags.FirstOrDefault(x => x.Id == tid);
        if (t != null) heading = t.Name;
    }
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"]</title>
<style>
/* —— Finder shell (page-local only) —— */
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;height:100%;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
body{background:#1c1c1e;color:#f5f5f7;overflow:hidden}
a{color:inherit;text-decoration:none}
button,input,select{font:inherit}

.fn{display:grid;grid-template-rows:auto 1fr;height:100vh;height:100dvh}

/* Toolbar */
.fn-tb{display:flex;align-items:center;gap:.55rem;padding:.45rem .7rem;background:rgba(40,40,42,.92);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid rgba(255,255,255,.08);user-select:none}
.fn-tb-nav{display:flex;gap:.25rem}
.fn-ico{width:28px;height:28px;border:0;border-radius:7px;background:transparent;color:#d1d1d6;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:background .12s}
.fn-ico:hover{background:rgba(255,255,255,.1)}
.fn-ico:disabled{opacity:.35;cursor:default}
.fn-ico svg{width:15px;height:15px;fill:currentColor}
.fn-title{font-size:.95rem;font-weight:600;letter-spacing:-.01em;margin:0 .4rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:28vw}
.fn-spacer{flex:1}
.fn-search{position:relative;width:min(240px,28vw)}
.fn-search input{width:100%;height:28px;border-radius:7px;border:0;background:rgba(255,255,255,.1);color:#f5f5f7;padding:0 28px 0 10px;outline:none}
.fn-search input::placeholder{color:#8e8e93}
.fn-search svg{position:absolute;left:8px;top:50%;transform:translateY(-50%);width:13px;height:13px;opacity:.55;fill:#f5f5f7}
.fn-views{display:flex;background:rgba(255,255,255,.08);border-radius:7px;padding:2px}
.fn-views button{width:28px;height:24px;border:0;border-radius:5px;background:transparent;color:#d1d1d6;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.fn-views button.is-on{background:rgba(255,255,255,.16);color:#fff}
.fn-views svg{width:14px;height:14px;fill:currentColor}
.fn-btn{height:28px;padding:0 12px;border:0;border-radius:7px;background:#0a84ff;color:#fff;font-size:.8rem;font-weight:600;cursor:pointer;white-space:nowrap}
.fn-btn:hover{filter:brightness(1.08)}
.fn-btn-ghost{background:rgba(255,255,255,.1);color:#f5f5f7}
.fn-sort{height:28px;border:0;border-radius:7px;background:rgba(255,255,255,.1);color:#f5f5f7;padding:0 8px;font-size:.78rem}

/* Body */
.fn-body{display:grid;grid-template-columns:220px 1fr;min-height:0}

/* Sidebar */
.fn-side{background:#2c2c2e;border-left:1px solid rgba(255,255,255,.06);overflow:auto;padding:.55rem 0 .9rem;scrollbar-width:thin}
.fn-sec{margin:.55rem 0 .2rem;padding:0 12px;font-size:.68rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8e8e93}
.fn-item{display:flex;align-items:center;gap:.55rem;margin:1px 8px;padding:5px 8px;border-radius:7px;font-size:.84rem;color:#e5e5ea;cursor:pointer;border:0;background:transparent;width:calc(100% - 16px);text-align:start}
.fn-item:hover{background:rgba(255,255,255,.07)}
.fn-item.is-active{background:#0a84ff;color:#fff}
.fn-item .dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.fn-item .cnt{margin-inline-start:auto;font-size:.72rem;opacity:.65;font-variant-numeric:tabular-nums}
.fn-item.is-active .cnt{opacity:.9}
.fn-item svg{width:15px;height:15px;flex-shrink:0;fill:currentColor;opacity:.9}
.fn-ff{width:16px;height:13px;flex-shrink:0}
.fn-ff .b{fill:#7eb6f7}.fn-ff .f{fill:#4a9aef}
.fn-ff.yellow .b{fill:#f5d76e}.fn-ff.yellow .f{fill:#e8b923}
.fn-ff.red .b{fill:#f0a0a0}.fn-ff.red .f{fill:#e05555}
.fn-ff.green .b{fill:#9ad4a8}.fn-ff.green .f{fill:#4caf6a}
.fn-ff.purple .b{fill:#c4a8e8}.fn-ff.purple .f{fill:#8b5cf6}
.fn-ff.orange .b{fill:#f5c07a}.fn-ff.orange .f{fill:#e08a2a}
.fn-ff.gray .b{fill:#c7c7cc}.fn-ff.gray .f{fill:#8e8e93}

/* Main */
.fn-main{overflow:auto;background:#1c1c1e;min-height:0;scrollbar-width:thin}
.fn-path{padding:.55rem 1rem .15rem;font-size:.75rem;color:#8e8e93}
.fn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(108px,1fr));gap:6px 4px;padding:.4rem .75rem 2rem}
.fn-card{display:flex;flex-direction:column;align-items:center;gap:.35rem;padding:.65rem .4rem .5rem;border-radius:10px;cursor:default;position:relative;border:1px solid transparent;user-select:none}
.fn-card:hover{background:rgba(255,255,255,.05)}
.fn-card.is-sel{background:rgba(10,132,255,.22);border-color:rgba(10,132,255,.35)}
.fn-thumb{width:72px;height:72px;border-radius:12px;background:linear-gradient(145deg,#3a3a3c,#2c2c2e);display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.25);position:relative}
.fn-thumb img{width:100%;height:100%;object-fit:cover}
.fn-thumb .doc{width:36px;height:44px;border-radius:4px;background:#f5f5f7;position:relative;box-shadow:0 2px 6px rgba(0,0,0,.2)}
.fn-thumb .doc::before{content:"";position:absolute;top:0;right:0;border-width:0 10px 10px 0;border-style:solid;border-color:#c7c7cc #1c1c1e}
.fn-thumb .badge{position:absolute;bottom:4px;inset-inline-end:4px;font-size:.58rem;font-weight:700;padding:1px 5px;border-radius:4px;background:rgba(0,0,0,.55);color:#fff;backdrop-filter:blur(4px)}
.fn-thumb .badge.published{background:rgba(48,209,88,.85)}
.fn-thumb .badge.draft{background:rgba(142,142,147,.9)}
.fn-thumb .badge.pending{background:rgba(255,159,10,.9)}
.fn-thumb .badge.scheduled{background:rgba(10,132,255,.9)}
.fn-thumb .badge.trash{background:rgba(255,69,58,.9)}
.fn-name{font-size:.72rem;line-height:1.25;text-align:center;max-width:100%;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;word-break:break-word}
.fn-meta{font-size:.62rem;color:#8e8e93;text-align:center}

/* List view */
.fn-list{display:none;padding:.25rem 0 2rem}
.fn.is-list .fn-grid{display:none}
.fn.is-list .fn-list{display:block}
.fn-row{display:grid;grid-template-columns:minmax(0,1.6fr) .7fr .55fr .45fr 120px;gap:.5rem;align-items:center;padding:.45rem 1rem;border-bottom:1px solid rgba(255,255,255,.05);font-size:.82rem}
.fn-row:hover{background:rgba(255,255,255,.04)}
.fn-row.is-sel{background:rgba(10,132,255,.18)}
.fn-row-title{display:flex;align-items:center;gap:.55rem;min-width:0}
.fn-row-title .sm{width:28px;height:28px;border-radius:6px;background:#3a3a3c;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.fn-row-title .sm img{width:100%;height:100%;object-fit:cover}
.fn-row-title span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fn-row .muted{color:#8e8e93;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fn-acts{display:flex;gap:.3rem;justify-content:flex-end}
.fn-acts a,.fn-acts button{font-size:.72rem;padding:3px 8px;border-radius:6px;border:0;background:rgba(255,255,255,.08);color:#f5f5f7;cursor:pointer}
.fn-acts a:hover,.fn-acts button:hover{background:rgba(255,255,255,.14)}
.fn-acts .danger{color:#ff6961}

.fn-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4rem 1rem;color:#8e8e93;gap:.4rem}
.fn-empty strong{color:#d1d1d6;font-size:1rem}

/* Context / selection bar */
.fn-selbar{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);display:none;align-items:center;gap:.5rem;padding:.45rem .65rem;background:rgba(44,44,46,.92);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.1);border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,.4);z-index:30}
.fn-selbar.is-on{display:flex}
.fn-selbar span{font-size:.8rem;color:#d1d1d6;padding:0 .35rem}

/* Modals */
.pdm{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:1rem}
.pdm[hidden]{display:none!important}
.pdm-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(4px)}
.pdm-dialog{position:relative;z-index:1;width:min(400px,100%);background:#2c2c2e;border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:1.15rem 1.25rem;box-shadow:0 24px 60px rgba(0,0,0,.5)}
.pdm-title{font-size:1.05rem;margin:0 0 .35rem;font-weight:650}
.pdm-sub{font-size:.88rem;margin:0 0 .75rem;color:#aeaeb2;line-height:1.5}
.pdm-post{font-weight:600;margin:0 0 1rem;padding:.5rem .65rem;border-radius:8px;background:rgba(255,255,255,.06)}
.pdm-actions{display:flex;gap:.5rem;justify-content:flex-end;margin-top:1rem;flex-wrap:wrap}
.pdm-actions button{height:32px;padding:0 14px;border:0;border-radius:8px;cursor:pointer;font-weight:600;font-size:.85rem}
.pdm-actions .ok{background:#0a84ff;color:#fff}
.pdm-actions .ghost{background:rgba(255,255,255,.1);color:#f5f5f7}
.pdm-actions .danger{background:#ff453a;color:#fff}
.pdm textarea{width:100%;border-radius:8px;border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.25);color:#f5f5f7;padding:.55rem .65rem;resize:vertical;min-height:72px}
.pdm label{font-size:.8rem;color:#aeaeb2;display:block;margin-bottom:.3rem}

@@media (max-width:720px){
  .fn-body{grid-template-columns:1fr}
  .fn-side{display:none}
  .fn-row{grid-template-columns:1fr auto;gap:.35rem}
  .fn-row .hide-sm{display:none}
}
</style>
</head>
<body>
<div class="fn" id="finder">
  <header class="fn-tb">
    <div class="fn-tb-nav">
      <a class="fn-ico" href="@Url.Action("Index","Admin")" title="Admin" aria-label="Admin">
        <svg viewBox="0 0 16 16"><path d="M10.5 3.5 5 8l5.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="fn-title" dir="auto">@heading</div>
    <div class="fn-spacer"></div>
    <form method="get" action="@Url.Action("Posts","Admin")" class="fn-search" id="searchForm">
      <input type="hidden" name="scope" value="@scope" />
      @if (Model.FolderId is int hf) { <input type="hidden" name="folderId" value="@hf" /> }
      @if (Model.CategoryId is int hc) { <input type="hidden" name="categoryId" value="@hc" /> }
      @if (Model.TagId is int ht) { <input type="hidden" name="tagId" value="@ht" /> }
      <input type="hidden" name="sort" value="@sort" />
      <input type="search" name="q" value="@Model.Search" placeholder="@T["dt.search_placeholder"]" autocomplete="off" />
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M11.5 11.5 14 14M7 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </form>
    <select class="fn-sort" onchange="location.href=this.value" aria-label="Sort">
      @{ string SortUrl(string s) => Url.Action("Posts","Admin", new { scope, folderId = Model.FolderId, categoryId = Model.CategoryId, tagId = Model.TagId, q = Model.Search, sort = s })!; }
      <option value="@SortUrl("recent")" selected="@(sort=="recent")">Recent</option>
      <option value="@SortUrl("title")" selected="@(sort=="title")">Title</option>
      <option value="@SortUrl("views")" selected="@(sort=="views")">Views</option>
      <option value="@SortUrl("oldest")" selected="@(sort=="oldest")">Oldest</option>
    </select>
    <div class="fn-views" role="group" aria-label="View">
      <button type="button" class="is-on" id="viewIcons" title="Icons" aria-pressed="true">
        <svg viewBox="0 0 16 16"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
      </button>
      <button type="button" id="viewList" title="List" aria-pressed="false">
        <svg viewBox="0 0 16 16"><rect x="1" y="2" width="14" height="2" rx=".5"/><rect x="1" y="7" width="14" height="2" rx=".5"/><rect x="1" y="12" width="14" height="2" rx=".5"/></svg>
      </button>
    </div>
    <a class="fn-btn" asp-controller="Posts" asp-action="Create">@T["btn.new_post"]</a>
  </header>

  <div class="fn-body">
    <aside class="fn-side" aria-label="Sidebar">
      <div class="fn-sec">Favorites</div>
      <a class="fn-item @(scope=="all" && Model.FolderId==null && Model.CategoryId==null && Model.TagId==null ? "is-active" : null)" href="@ScopeUrl("all")">
        <svg viewBox="0 0 16 16"><path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h3l1.5 1.5H12.5A1.5 1.5 0 0 1 14 5v7.5A1.5 1.5 0 0 1 12.5 14h-9A1.5 1.5 0 0 1 2 12.5v-9z"/></svg>
        <span>@T["tab.all"]</span>
        <span class="cnt">@Model.AllCount</span>
      </a>
      <a class="fn-item @(scope=="published" ? "is-active" : null)" href="@ScopeUrl("published")">
        <span class="dot" style="background:#30d158"></span>
        <span>@T["status.published_full"]</span>
        <span class="cnt">@Model.PublishedCount</span>
      </a>
      <a class="fn-item @(scope=="draft" ? "is-active" : null)" href="@ScopeUrl("draft")">
        <span class="dot" style="background:#8e8e93"></span>
        <span>@T["status.draft"]</span>
        <span class="cnt">@Model.DraftCount</span>
      </a>
      <a class="fn-item @(scope=="pending" ? "is-active" : null)" href="@ScopeUrl("pending")">
        <span class="dot" style="background:#ff9f0a"></span>
        <span>@T["post.status_pending_review"]</span>
        <span class="cnt">@Model.PendingCount</span>
      </a>
      <a class="fn-item @(scope=="trash" ? "is-active" : null)" href="@ScopeUrl("trash")">
        <span class="dot" style="background:#ff453a"></span>
        <span>@T["status.deleted"]</span>
        <span class="cnt">@Model.TrashCount</span>
      </a>

      @if (Model.Folders.Count > 0)
      {
        <div class="fn-sec">Folders</div>
        @foreach (var f in Model.Folders)
        {
          <a class="fn-item @(Model.FolderId==f.Id ? "is-active" : null)" href="@FolderUrl(f.Id)">
            <svg class="fn-ff @f.Color" viewBox="0 0 64 52" aria-hidden="true">
              <path class="b" d="M2 10c0-3.3 2.7-6 6-6h14l4 5h30c3.3 0 6 2.7 6 6v31c0 3.3-2.7 6-6 6H8c-3.3 0-6-2.7-6-6V10z"/>
              <path class="f" d="M2 18c0-2.2 1.8-4 4-4h52c2.2 0 4 1.8 4 4v24c0 2.2-1.8 4-4 4H6c-2.2 0-4-1.8-4-4V18z"/>
            </svg>
            <span dir="auto">@f.Name</span>
            <span class="cnt">@f.PostCount</span>
          </a>
        }
      }

      @if (Model.Categories.Count > 0)
      {
        <div class="fn-sec">@T["tax.tab_cats"]</div>
        @foreach (var c in Model.Categories.Take(20))
        {
          <a class="fn-item @(Model.CategoryId==c.Id ? "is-active" : null)" href="@CatUrl(c.Id)">
            <span class="dot" style="background:#64d2ff"></span>
            <span dir="auto">@c.Name</span>
            <span class="cnt">@c.Count</span>
          </a>
        }
      }

      @if (Model.Tags.Count > 0)
      {
        <div class="fn-sec">@T["tax.tab_tags"]</div>
        @foreach (var t in Model.Tags.Take(16))
        {
          <a class="fn-item @(Model.TagId==t.Id ? "is-active" : null)" href="@TagUrl(t.Id)">
            <span class="dot" style="background:#bf5af2"></span>
            <span dir="auto">@t.Name</span>
            <span class="cnt">@t.Count</span>
          </a>
        }
      }
    </aside>

    <main class="fn-main">
      <div class="fn-path">@Model.Posts.Count items</div>

      @if (Model.Posts.Count == 0)
      {
        <div class="fn-empty">
          <strong>@T["dt.empty_table"]</strong>
          <span>@T["btn.new_post"] →</span>
        </div>
      }
      else
      {
        <div class="fn-grid" id="iconGrid">
          @foreach (var p in Model.Posts)
          {
            var sk = StatusKey(p);
            <div class="fn-card" data-id="@p.Id" data-title="@p.Title" data-deleted="@(p.IsDeleted ? "1" : "0")" tabindex="0" role="button">
              <div class="fn-thumb">
                @if (!string.IsNullOrEmpty(p.CoverUrl))
                {
                  <img src="@p.CoverUrl" alt="" loading="lazy" />
                }
                else
                {
                  <div class="doc" aria-hidden="true"></div>
                }
                <span class="badge @sk">@StatusLabel(p)</span>
              </div>
              <div class="fn-name" dir="auto">@p.Title</div>
              <div class="fn-meta">@(p.CategoryName ?? "—") · @p.ViewCount</div>
            </div>
          }
        </div>

        <div class="fn-list" id="listView">
          @foreach (var p in Model.Posts)
          {
            <div class="fn-row" data-id="@p.Id" data-title="@p.Title" data-deleted="@(p.IsDeleted ? "1" : "0")">
              <div class="fn-row-title">
                <div class="sm">
                  @if (!string.IsNullOrEmpty(p.CoverUrl)) { <img src="@p.CoverUrl" alt="" loading="lazy" /> }
                </div>
                <span dir="auto">@p.Title</span>
              </div>
              <div class="muted hide-sm" dir="auto">@(p.CategoryName ?? "—")</div>
              <div class="muted hide-sm">@StatusLabel(p)</div>
              <div class="muted hide-sm ltr">@p.ViewCount</div>
              <div class="fn-acts">
                @if (p.IsDeleted)
                {
                  <form method="post" action="/Posts/Restore" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@p.Id" />
                    <button type="submit">@T["btn.restore"]</button>
                  </form>
                }
                else
                {
                  <a href="/Posts/Edit/@p.Id">@T["btn.edit"]</a>
                  <a href="/post/@p.Slug" target="_blank" rel="noopener">View</a>
                  <button type="button" class="danger" data-post-delete data-id="@p.Id" data-title="@p.Title">@T["btn.delete"]</button>
                }
              </div>
            </div>
          }
        </div>
      }
    </main>
  </div>
</div>

<div class="fn-selbar" id="selBar">
  <span id="selCount">1 selected</span>
  <a class="fn-btn" id="selEdit" href="#">@T["btn.edit"]</a>
  <a class="fn-btn fn-btn-ghost" id="selView" href="#" target="_blank" rel="noopener">View</a>
  <button type="button" class="fn-btn fn-btn-ghost" id="selDelete" style="color:#ff6961">@T["btn.delete"]</button>
</div>

@Html.AntiForgeryToken()

<div id="postPendingModal" class="pdm" @(pendingCreated ? null : "hidden") aria-hidden="@(pendingCreated ? "false" : "true")">
  <div class="pdm-backdrop" data-ppm-close></div>
  <div class="pdm-dialog" role="dialog" aria-modal="true">
    <h2 class="pdm-title">@T["post.status_pending_review"]</h2>
    <p class="pdm-sub">@T["post.created_pending_hint"]</p>
    @if (!string.IsNullOrEmpty(createdTitle)) { <p class="pdm-post" dir="auto">@createdTitle</p> }
    <div class="pdm-actions"><button type="button" class="ok" data-ppm-close>باشه</button></div>
  </div>
</div>

<div id="postDeleteModal" class="pdm" hidden aria-hidden="true">
  <div class="pdm-backdrop" data-pdm-close></div>
  <div class="pdm-dialog" role="dialog" aria-modal="true">
    <h2 class="pdm-title">حذف نوشته</h2>
    <p class="pdm-sub">آیا از انتقال این نوشته به سطل زباله مطمئن هستید؟</p>
    <p class="pdm-post" id="pdmPostTitle" dir="auto"></p>
    <form id="pdmForm" method="post" action="/Posts/Delete">
      <input type="hidden" name="__RequestVerificationToken" id="pdmToken" value="" />
      <input type="hidden" name="id" id="pdmId" value="" />
      <label for="pdmReason">دلیل حذف (اختیاری)</label>
      <textarea id="pdmReason" name="reason" maxlength="500"></textarea>
      <div class="pdm-actions">
        <button type="button" class="ghost" data-pdm-close>انصراف</button>
        <button type="submit" class="danger">تأیید حذف</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('finder');
  var iconBtn = document.getElementById('viewIcons');
  var listBtn = document.getElementById('viewList');
  try {
    if (localStorage.getItem('blog-finder-view') === 'list') {
      root.classList.add('is-list');
      iconBtn.classList.remove('is-on');
      listBtn.classList.add('is-on');
    }
  } catch (e) {}
  iconBtn.addEventListener('click', function () {
    root.classList.remove('is-list');
    iconBtn.classList.add('is-on'); listBtn.classList.remove('is-on');
    try { localStorage.setItem('blog-finder-view', 'icons'); } catch (e) {}
  });
  listBtn.addEventListener('click', function () {
    root.classList.add('is-list');
    listBtn.classList.add('is-on'); iconBtn.classList.remove('is-on');
    try { localStorage.setItem('blog-finder-view', 'list'); } catch (e) {}
  });

  var selBar = document.getElementById('selBar');
  var selEdit = document.getElementById('selEdit');
  var selView = document.getElementById('selView');
  var selDelete = document.getElementById('selDelete');
  var selected = null;

  function clearSel() {
    document.querySelectorAll('.fn-card.is-sel,.fn-row.is-sel').forEach(function (el) { el.classList.remove('is-sel'); });
    selected = null;
    selBar.classList.remove('is-on');
  }
  function select(el) {
    clearSel();
    el.classList.add('is-sel');
    selected = el;
    var id = el.getAttribute('data-id');
    var deleted = el.getAttribute('data-deleted') === '1';
    selEdit.href = '/Posts/Edit/' + id;
    selView.href = '#';
    selBar.classList.add('is-on');
    selDelete.style.display = deleted ? 'none' : '';
    selEdit.style.display = deleted ? 'none' : '';
  }

  document.addEventListener('click', function (e) {
    var card = e.target.closest('.fn-card, .fn-row');
    if (card && !e.target.closest('.fn-acts')) {
      select(card);
      return;
    }
    if (!e.target.closest('.fn-selbar') && !e.target.closest('.fn-card') && !e.target.closest('.fn-row')) clearSel();
  });
  document.addEventListener('dblclick', function (e) {
    var card = e.target.closest('.fn-card, .fn-row');
    if (!card) return;
    var id = card.getAttribute('data-id');
    var deleted = card.getAttribute('data-deleted') === '1';
    if (!deleted) location.href = '/Posts/Edit/' + id;
  });

  selDelete.addEventListener('click', function () {
    if (!selected) return;
    openDelete(selected.getAttribute('data-id'), selected.getAttribute('data-title'));
  });

  // Pending modal
  (function () {
    var modal = document.getElementById('postPendingModal');
    if (!modal) return;
    function close() { modal.hidden = true; modal.setAttribute('aria-hidden', 'true'); }
    document.addEventListener('click', function (e) { if (e.target.closest('[data-ppm-close]')) { e.preventDefault(); close(); } });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
  })();

  // Delete modal
  var modal = document.getElementById('postDeleteModal');
  var idEl = document.getElementById('pdmId');
  var titleEl = document.getElementById('pdmPostTitle');
  var reasonEl = document.getElementById('pdmReason');
  var tokenEl = document.getElementById('pdmToken');
  var pageToken = document.querySelector('input[name="__RequestVerificationToken"]');
  function openDelete(id, title) {
    idEl.value = id;
    titleEl.textContent = title || ('#' + id);
    reasonEl.value = '';
    if (pageToken) tokenEl.value = pageToken.value;
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
  }
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-post-delete]');
    if (btn) { e.preventDefault(); openDelete(btn.getAttribute('data-id'), btn.getAttribute('data-title')); return; }
    if (e.target.closest('[data-pdm-close]')) { e.preventDefault(); modal.hidden = true; modal.setAttribute('aria-hidden', 'true'); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal && !modal.hidden) { modal.hidden = true; modal.setAttribute('aria-hidden', 'true'); }
  });
})();
</script>
</body>
</html>
