@model SeoToolsViewModel
@inject BlogApp.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["admin.nav.seo"];
    var tab = Model.ActiveTab ?? "overview";
    var isSuper = BlogApp.Services.AuthorAccess.IsSuperAdmin(User);
}

@if (TempData["SeoOk"] is string ok)
{
    <div class="wizard-alert success mb-3">@ok</div>
}
@if (TempData["SeoErr"] is string err)
{
    <div class="wizard-alert danger mb-3">@err</div>
}

<div class="admin-tabs mb-3">
    <a class="admin-tab @(tab == "overview" ? "active" : "")" asp-action="SeoTools" asp-route-tab="overview">@T["seo.tab_overview"]</a>
    <a class="admin-tab @(tab == "meta" ? "active" : "")" asp-action="SeoTools" asp-route-tab="meta">@T["seo.tab_meta"]</a>
    <a class="admin-tab @(tab == "redirects" ? "active" : "")" asp-action="SeoTools" asp-route-tab="redirects">@T["seo.tab_redirects"]</a>
    <a class="admin-tab @(tab == "broken" ? "active" : "")" asp-action="SeoTools" asp-route-tab="broken">@T["seo.tab_broken"]</a>
    <a class="admin-tab @(tab == "health" ? "active" : "")" asp-action="SeoTools" asp-route-tab="health">@T["seo.tab_health"]</a>
</div>

@if (tab == "overview")
{
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3"><div class="kpi-card kpi-compact"><div class="kpi-label">@T["seo.kpi_published"]</div><div class="kpi-value ltr-field">@Model.PublishedCount</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi-card kpi-compact"><div class="kpi-label">@T["seo.kpi_redirects"]</div><div class="kpi-value ltr-field">@Model.Redirects.Count</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi-card kpi-compact @(Model.BrokenLinks.Count > 0 ? "kpi-danger" : "")"><div class="kpi-label">@T["seo.kpi_broken"]</div><div class="kpi-value ltr-field">@Model.BrokenLinks.Count</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi-card kpi-compact"><div class="kpi-label">@T["seo.kpi_no_summary"]</div><div class="kpi-value ltr-field">@Model.MissingSummaryCount</div></div></div>
    </div>

    <div class="chart-card chart-card-tight mb-3">
        <div class="chart-title mb-2">@T["seo.live_endpoints"]</div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-ghost btn-sm" href="@Model.SitemapUrl" target="_blank" rel="noopener">sitemap.xml</a>
            <a class="btn btn-ghost btn-sm" href="@Model.RobotsUrl" target="_blank" rel="noopener">robots.txt</a>
        </div>
        <p class="text-muted-dark small mt-2 mb-0">@T["seo.live_hint"]</p>
    </div>

    <div class="chart-card chart-card-tight">
        <div class="chart-title mb-2">@T["seo.capabilities"]</div>
        <ul class="mb-0 small text-muted-dark" style="padding-inline-start:1.2rem;">
            <li>@T["seo.cap_meta"]</li>
            <li>@T["seo.cap_redirect"]</li>
            <li>@T["seo.cap_broken"]</li>
            <li>@T["seo.cap_sitemap"]</li>
            <li>@T["seo.cap_og"]</li>
        </ul>
    </div>
}

@if (tab == "meta")
{
    @if (!isSuper)
    {
        <div class="wizard-alert mb-3">@T["seo.meta_super_only"]</div>
    }
    <form asp-action="SeoSaveMeta" method="post" class="chart-card chart-card-tight">
        @Html.AntiForgeryToken()
        <div class="chart-title mb-3">@T["seo.tab_meta"]</div>
        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label small">@T["seo.site_name"]</label>
                <input class="form-control" name="SiteName" value="@Model.Meta.SiteName" maxlength="120" @(isSuper ? null : "disabled") />
            </div>
            <div class="col-md-6">
                <label class="form-label small">@T["seo.author_name"]</label>
                <input class="form-control" name="AuthorName" value="@Model.Meta.AuthorName" maxlength="120" @(isSuper ? null : "disabled") />
            </div>
            <div class="col-12">
                <label class="form-label small">@T["seo.site_desc"]</label>
                <textarea class="form-control" name="SiteDescription" rows="2" maxlength="400" @(isSuper ? null : "disabled")>@Model.Meta.SiteDescription</textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label small">@T["seo.twitter"]</label>
                <input class="form-control ltr-field" name="TwitterHandle" value="@Model.Meta.TwitterHandle" placeholder="@@site" maxlength="80" @(isSuper ? null : "disabled") />
            </div>
            <div class="col-md-6">
                <label class="form-label small">@T["seo.base_url"]</label>
                <input class="form-control ltr-field" name="BaseUrl" value="@Model.Meta.BaseUrl" placeholder="https://example.com" maxlength="200" @(isSuper ? null : "disabled") />
            </div>
            <div class="col-12">
                <label class="form-label small">@T["seo.robots_custom"]</label>
                <textarea class="form-control ltr-field" name="RobotsTxt" rows="6" maxlength="4000" placeholder="User-agent: *" @(isSuper ? null : "disabled")>@Model.Meta.RobotsTxt</textarea>
                <div class="form-text">@T["seo.robots_hint"]</div>
            </div>
        </div>
        @if (isSuper)
        {
            <div class="mt-3">
                <button type="submit" class="btn btn-accent btn-sm">@T["seo.save_meta"]</button>
            </div>
        }
    </form>
}

@if (tab == "redirects")
{
    <div class="chart-card chart-card-tight mb-3">
        <div class="chart-title mb-2">@T["seo.add_redirect"]</div>
        <form asp-action="SeoAddRedirect" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label small">@T["seo.from_path"]</label>
                <input class="form-control ltr-field" name="FromPath" required placeholder="/post/old-slug" maxlength="500" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">@T["seo.to_url"]</label>
                <input class="form-control ltr-field" name="ToUrl" required placeholder="/post/new-slug" maxlength="1000" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">@T["seo.status"]</label>
                <select class="form-select" name="StatusCode">
                    <option value="301">301</option>
                    <option value="302">302</option>
                    <option value="307">307</option>
                    <option value="308">308</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["seo.add"]</button>
            </div>
            <div class="col-12">
                <input class="form-control form-control-sm" name="Notes" maxlength="300" placeholder="@T["seo.notes"]" />
            </div>
        </form>
    </div>

    @if (Model.Redirects.Count == 0)
    {
        <p class="text-muted-dark small">@T["seo.empty_redirects"]</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table" style="min-width:0;">
                <thead>
                <tr>
                    <th>@T["seo.from_path"]</th>
                    <th>@T["seo.to_url"]</th>
                    <th>@T["seo.status"]</th>
                    <th>@T["seo.hits"]</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Redirects)
                {
                    <tr style="@(r.IsActive ? "" : "opacity:.55")">
                        <td class="ltr-field small">@r.FromPath</td>
                        <td class="ltr-field small">@r.ToUrl</td>
                        <td class="ltr-field">@r.StatusCode</td>
                        <td class="ltr-field">@r.HitCount</td>
                        <td class="text-nowrap">
                            <form asp-action="SeoToggleRedirect" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="icon-btn">@(r.IsActive ? T["seo.disable"] : T["seo.enable"])</button>
                            </form>
                            <form asp-action="SeoDeleteRedirect" method="post" class="d-inline" onsubmit="return confirm('@T["msg.confirm_delete"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="icon-btn reject">@T["btn.delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

@if (tab == "broken")
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <p class="text-muted-dark small mb-0">@T["seo.broken_hint"]</p>
        <form asp-action="SeoScanBrokenLinks" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-accent btn-sm">@T["seo.scan_now"]</button>
        </form>
    </div>

    @if (Model.BrokenLinks.Count == 0)
    {
        <p class="text-muted-dark small">@T["seo.empty_broken"]</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table" style="min-width:0;">
                <thead>
                <tr>
                    <th>@T["col.title"]</th>
                    <th>@T["seo.broken_url"]</th>
                    <th>@T["seo.detected"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var b in Model.BrokenLinks)
                {
                    <tr>
                        <td dir="auto">
                            <a asp-controller="Posts" asp-action="Edit" asp-route-id="@b.PostId">@b.PostTitle</a>
                        </td>
                        <td class="ltr-field small">@b.Url</td>
                        <td class="ltr-field small">@b.DetectedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

@if (tab == "health")
{
    <p class="text-muted-dark small mb-3">@T["seo.health_hint"]</p>
    @if (Model.PostHealth.Count == 0)
    {
        <p class="text-muted-dark small">@T["seo.empty_health"]</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table" style="min-width:0;">
                <thead>
                <tr>
                    <th>@T["col.title"]</th>
                    <th>@T["seo.has_summary"]</th>
                    <th>@T["seo.has_cover"]</th>
                    <th>@T["seo.score"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var h in Model.PostHealth)
                {
                    <tr>
                        <td dir="auto"><a asp-controller="Posts" asp-action="Edit" asp-route-id="@h.Id">@h.Title</a></td>
                        <td>@(h.HasSummary ? "✓" : "—")</td>
                        <td>@(h.HasCover ? "✓" : "—")</td>
                        <td class="ltr-field">@h.Score</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
