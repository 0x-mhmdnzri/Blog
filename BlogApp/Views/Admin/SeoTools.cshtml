@model SeoToolsViewModel
@inject BlogApp.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["admin.nav.seo"];
    var tab = Model.ActiveTab ?? "overview";
    string TabClass(string id) => tab == id ? "is-active" : "";
}
<header class="st-hero">
    <div class="st-hero-text">
        <p class="st-eyebrow">SEO</p>
        <h1 class="st-title">@T["admin.nav.seo"]</h1>
        <p class="st-sub">@T["seo.hero_sub"]</p>
    </div>
    <div class="st-hero-actions">
        <a class="st-chip-link" href="@Model.SitemapUrl" target="_blank" rel="noopener">sitemap.xml</a>
        <a class="st-chip-link" href="@Model.RobotsUrl" target="_blank" rel="noopener">robots.txt</a>
    </div>
</header>
<nav class="st-tabs" role="tablist" aria-label="@T["seo.tabs_aria"]">
    <a class="st-tab @TabClass("overview")" asp-action="SeoTools" asp-route-tab="overview">@T["seo.tab_overview"]</a>
    <a class="st-tab @TabClass("meta")" asp-action="SeoTools" asp-route-tab="meta">@T["seo.tab_meta"]</a>
    <a class="st-tab @TabClass("redirects")" asp-action="SeoTools" asp-route-tab="redirects">@T["seo.tab_redirects"]</a>
    <a class="st-tab @TabClass("broken")" asp-action="SeoTools" asp-route-tab="broken">@T["seo.tab_broken"]</a>
    <a class="st-tab @TabClass("health")" asp-action="SeoTools" asp-route-tab="health">@T["seo.tab_health"]</a>
    <a class="st-tab @TabClass("import")" asp-action="SeoTools" asp-route-tab="import">@T["seo.tab_import"]</a>
    <a class="st-tab @TabClass("indexnow")" asp-action="SeoTools" asp-route-tab="indexnow">@T["seo.tab_indexnow"]</a>
</nav>
<div class="st-alert st-alert-info" role="status">
    Full SEO Tools UI is being restored. Translation keys (seo.*) are live.
</div>
