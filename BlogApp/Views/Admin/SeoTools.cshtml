@model SeoToolsViewModel
@inject BlogApp.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["admin.nav.seo"];
    var tab = Model.ActiveTab ?? "overview";
    var isSuper = BlogApp.Services.AuthorAccess.IsSuperAdmin(User);

    string TabClass(string id) => tab == id ? "is-active" : "";
}

@if (TempData["SeoOk"] is string ok)
{
    <div class="seo-alert seo-alert-ok mb-3" role="status">@ok</div>
}
@if (TempData["SeoErr"] is string err)
{
    <div class="seo-alert seo-alert-err mb-3" role="alert">@err</div>
}

<header class="seo-header">
    <div>
        <h1 class="seo-title">@T["admin.nav.seo"]</h1>
        <p class="seo-sub">متا، ریدایرکت، لینک شکسته، سلامت محتوا، ایمپورت و IndexNow — یک پنل برای دیده‌شدن در جست‌وجو.</p>
    </div>
</header>

<nav class="seo-nav" role="tablist" aria-label="ابزارهای سئو">
    <a class="seo-nav-item @TabClass("overview")" asp-action="SeoTools" asp-route-tab="overview">@T["seo.tab_overview"]</a>
    <a class="seo-nav-item @TabClass("meta")" asp-action="SeoTools" asp-route-tab="meta">@T["seo.tab_meta"]</a>
    <a class="seo-nav-item @TabClass("redirects")" asp-action="SeoTools" asp-route-tab="redirects">
        @T["seo.tab_redirects"]
        @if (Model.Redirects.Count > 0)
        {
            <span class="seo-nav-badge">@Model.Redirects.Count</span>
        }
    </a>
    <a class="seo-nav-item @TabClass("broken")" asp-action="SeoTools" asp-route-tab="broken">
        @T["seo.tab_broken"]
        @if (Model.BrokenLinks.Count > 0)
        {
            <span class="seo-nav-badge seo-nav-badge-warn">@Model.BrokenLinks.Count</span>
        }
    </a>
    <a class="seo-nav-item @TabClass("health")" asp-action="SeoTools" asp-route-tab="health">@T["seo.tab_health"]</a>
    <a class="seo-nav-item @TabClass("import")" asp-action="SeoTools" asp-route-tab="import">@T["seo.tab_import"]</a>
    <a class="seo-nav-item @TabClass("indexnow")" asp-action="SeoTools" asp-route-tab="indexnow">@T["seo.tab_indexnow"]</a>
</nav>

@if (tab == "overview")
{
    <div class="seo-kpis">
        <div class="seo-kpi">
            <span class="seo-kpi-label">@T["seo.kpi_published"]</span>
            <span class="seo-kpi-value">@Model.PublishedCount.ToString("N0")</span>
        </div>
        <div class="seo-kpi">
            <span class="seo-kpi-label">@T["seo.kpi_redirects"]</span>
            <span class="seo-kpi-value">@Model.Redirects.Count.ToString("N0")</span>
        </div>
        <div class="seo-kpi @(Model.BrokenLinks.Count > 0 ? "seo-kpi-warn" : "")">
            <span class="seo-kpi-label">@T["seo.kpi_broken"]</span>
            <span class="seo-kpi-value">@Model.BrokenLinks.Count.ToString("N0")</span>
        </div>
        <div class="seo-kpi @(Model.MissingSummaryCount > 0 ? "seo-kpi-muted" : "")">
            <span class="seo-kpi-label">@T["seo.kpi_no_summary"]</span>
            <span class="seo-kpi-value">@Model.MissingSummaryCount.ToString("N0")</span>
        </div>
    </div>

    <div class="seo-grid-2">
        <section class="seo-card">
            <h2 class="seo-card-title">@T["seo.live_endpoints"]</h2>
            <p class="seo-card-desc">@T["seo.live_hint"]</p>
            <div class="seo-endpoint-list">
                <a class="seo-endpoint" href="@Model.SitemapUrl" target="_blank" rel="noopener">
                    <span class="seo-endpoint-ico" aria-hidden="true">🗺️</span>
                    <span class="seo-endpoint-body">
                        <strong>sitemap.xml</strong>
                        <span class="ltr-field seo-endpoint-url">@Model.SitemapUrl</span>
                    </span>
                    <span class="seo-endpoint-go" aria-hidden="true">↗</span>
                </a>
                <a class="seo-endpoint" href="@Model.RobotsUrl" target="_blank" rel="noopener">
                    <span class="seo-endpoint-ico" aria-hidden="true">🤖</span>
                    <span class="seo-endpoint-body">
                        <strong>robots.txt</strong>
                        <span class="ltr-field seo-endpoint-url">@Model.RobotsUrl</span>
                    </span>
                    <span class="seo-endpoint-go" aria-hidden="true">↗</span>
                </a>
                @if (!string.IsNullOrEmpty(Model.IndexNowKeyUrl))
                {
                    <a class="seo-endpoint" href="@Model.IndexNowKeyUrl" target="_blank" rel="noopener">
                        <span class="seo-endpoint-ico" aria-hidden="true">🔑</span>
                        <span class="seo-endpoint-body">
                            <strong>IndexNow key</strong>
                            <span class="ltr-field seo-endpoint-url">@Model.IndexNowKeyUrl</span>
                        </span>
                        <span class="seo-endpoint-go" aria-hidden="true">↗</span>
                    </a>
                }
            </div>
        </section>

        <section class="seo-card">
            <h2 class="seo-card-title">@T["seo.capabilities"]</h2>
            <ul class="seo-cap-list">
                <li>@T["seo.cap_meta"]</li>
                <li>@T["seo.cap_redirect"]</li>
                <li>@T["seo.cap_broken"]</li>
                <li>@T["seo.cap_sitemap"]</li>
                <li>@T["seo.cap_og"]</li>
                <li>@T["seo.cap_import"]</li>
                <li>@T["seo.cap_indexnow"]</li>
                <li>@T["seo.cap_hreflang"]</li>
            </ul>
        </section>
    </div>

    <div class="seo-quick">
        <a class="seo-quick-link" asp-action="SeoTools" asp-route-tab="meta">متا سایت ←</a>
        <a class="seo-quick-link" asp-action="SeoTools" asp-route-tab="redirects">ریدایرکت‌ها ←</a>
        <a class="seo-quick-link" asp-action="SeoTools" asp-route-tab="broken">لینک‌های شکسته ←</a>
        <a class="seo-quick-link" asp-action="SeoTools" asp-route-tab="health">سلامت پست‌ها ←</a>
    </div>
}

@if (tab == "meta")
{
    @if (!isSuper)
    {
        <div class="seo-alert seo-alert-info mb-3">@T["seo.meta_super_only"]</div>
    }

    <form asp-action="SeoSaveMeta" method="post" class="seo-card seo-form">
        @Html.AntiForgeryToken()
        <div class="seo-card-head">
            <h2 class="seo-card-title mb-0">@T["seo.tab_meta"]</h2>
            <p class="seo-card-desc mb-0">نام سایت، توضیح پیش‌فرض، Twitter و robots.txt سفارشی.</p>
        </div>

        <div class="seo-form-grid">
            <div class="seo-field">
                <label class="seo-label">@T["seo.site_name"]</label>
                <input class="form-control" name="SiteName" value="@Model.Meta.SiteName" maxlength="120" @(isSuper ? null : "disabled") />
            </div>
            <div class="seo-field">
                <label class="seo-label">@T["seo.author_name"]</label>
                <input class="form-control" name="AuthorName" value="@Model.Meta.AuthorName" maxlength="120" @(isSuper ? null : "disabled") />
            </div>
            <div class="seo-field seo-field-full">
                <label class="seo-label">@T["seo.site_desc"]</label>
                <textarea class="form-control" name="SiteDescription" rows="2" maxlength="400" @(isSuper ? null : "disabled")>@Model.Meta.SiteDescription</textarea>
            </div>
            <div class="seo-field">
                <label class="seo-label">@T["seo.twitter"]</label>
                <input class="form-control ltr-field" name="TwitterHandle" value="@Model.Meta.TwitterHandle" placeholder="@@handle" maxlength="80" @(isSuper ? null : "disabled") />
            </div>
            <div class="seo-field">
                <label class="seo-label">@T["seo.base_url"]</label>
                <input class="form-control ltr-field" name="BaseUrl" value="@Model.Meta.BaseUrl" placeholder="https://example.com" maxlength="200" @(isSuper ? null : "disabled") />
            </div>
            <div class="seo-field seo-field-full">
                <label class="seo-label">@T["seo.robots_custom"]</label>
                <textarea class="form-control ltr-field seo-mono" name="RobotsTxt" rows="7" maxlength="4000" placeholder="User-agent: *" @(isSuper ? null : "disabled")>@Model.Meta.RobotsTxt</textarea>
                <p class="seo-hint">@T["seo.robots_hint"]</p>
            </div>
        </div>

        @if (isSuper)
        {
            <div class="seo-form-footer">
                <button type="submit" class="btn btn-accent">@T["seo.save_meta"]</button>
            </div>
        }
    </form>
}

@if (tab == "redirects")
{
    <section class="seo-card seo-form mb-3">
        <div class="seo-card-head">
            <h2 class="seo-card-title mb-0">@T["seo.add_redirect"]</h2>
            <p class="seo-card-desc mb-0">مسیر قدیم → مقصد جدید با کد وضعیت HTTP.</p>
        </div>
        <form asp-action="SeoAddRedirect" method="post">
            @Html.AntiForgeryToken()
            <div class="seo-form-grid seo-form-grid-redir">
                <div class="seo-field">
                    <label class="seo-label">@T["seo.from_path"]</label>
                    <input class="form-control ltr-field" name="FromPath" required placeholder="/post/old-slug" maxlength="500" />
                </div>
                <div class="seo-field">
                    <label class="seo-label">@T["seo.to_url"]</label>
                    <input class="form-control ltr-field" name="ToUrl" required placeholder="/post/new-slug" maxlength="1000" />
                </div>
                <div class="seo-field seo-field-sm">
                    <label class="seo-label">@T["seo.status"]</label>
                    <select class="form-select" name="StatusCode">
                        <option value="301">301</option>
                        <option value="302">302</option>
                        <option value="307">307</option>
                        <option value="308">308</option>
                    </select>
                </div>
                <div class="seo-field seo-field-full">
                    <label class="seo-label">@T["seo.notes"]</label>
                    <input class="form-control form-control-sm" name="Notes" maxlength="300" placeholder="@T["seo.notes"]" />
                </div>
                <div class="seo-field seo-field-action">
                    <button type="submit" class="btn btn-accent btn-sm w-100">@T["seo.add"]</button>
                </div>
            </div>
        </form>
    </section>

    @if (Model.Redirects.Count == 0)
    {
        <div class="seo-empty">
            <div class="seo-empty-ico" aria-hidden="true">↪️</div>
            <p class="seo-empty-title">@T["seo.empty_redirects"]</p>
            <p class="seo-empty-hint">اولین ریدایرکت را از فرم بالا بسازید.</p>
        </div>
    }
    else
    {
        <div class="seo-list">
            @foreach (var r in Model.Redirects)
            {
                <article class="seo-list-item @(r.IsActive ? "" : "is-disabled")">
                    <div class="seo-redir-paths">
                        <div class="seo-redir-from ltr-field">@r.FromPath</div>
                        <span class="seo-redir-arrow" aria-hidden="true">→</span>
                        <div class="seo-redir-to ltr-field">@r.ToUrl</div>
                    </div>
                    <div class="seo-list-meta">
                        <span class="seo-pill seo-pill-code">@r.StatusCode</span>
                        <span class="seo-pill">@r.HitCount hit</span>
                        @if (!r.IsActive)
                        {
                            <span class="seo-pill seo-pill-off">off</span>
                        }
                    </div>
                    <div class="seo-list-actions">
                        <form asp-action="SeoToggleRedirect" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="seo-act">@(r.IsActive ? T["seo.disable"] : T["seo.enable"])</button>
                        </form>
                        <form asp-action="SeoDeleteRedirect" method="post" onsubmit="return confirm('@T["msg.confirm_delete"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="seo-act seo-act-danger">@T["btn.delete"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
}

@if (tab == "broken")
{
    <div class="seo-toolbar">
        <p class="seo-toolbar-hint">@T["seo.broken_hint"]</p>
        <form asp-action="SeoScanBrokenLinks" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-accent btn-sm">@T["seo.scan_now"]</button>
        </form>
    </div>

    @if (Model.BrokenLinks.Count == 0)
    {
        <div class="seo-empty seo-empty-ok">
            <div class="seo-empty-ico" aria-hidden="true">✓</div>
            <p class="seo-empty-title">@T["seo.empty_broken"]</p>
            <p class="seo-empty-hint">اسکن دوره‌ای یا دستی وضعیت لینک‌های داخلی را چک می‌کند.</p>
        </div>
    }
    else
    {
        <div class="seo-list">
            @foreach (var b in Model.BrokenLinks)
            {
                <article class="seo-list-item seo-list-item-warn">
                    <div class="seo-list-text">
                        <div class="seo-list-name" dir="auto">
                            <a asp-controller="Posts" asp-action="Edit" asp-route-id="@b.PostId">@b.PostTitle</a>
                        </div>
                        <div class="seo-list-meta">
                            <span class="ltr-field seo-broken-url">@b.Url</span>
                            <span class="seo-dot">·</span>
                            <span class="ltr-field">@b.DetectedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                    <div class="seo-list-actions">
                        <a class="seo-act" asp-controller="Posts" asp-action="Edit" asp-route-id="@b.PostId">ویرایش</a>
                    </div>
                </article>
            }
        </div>
    }
}

@if (tab == "health")
{
    <p class="seo-section-hint">@T["seo.health_hint"]</p>

    @if (Model.PostHealth.Count == 0)
    {
        <div class="seo-empty">
            <div class="seo-empty-ico" aria-hidden="true">📋</div>
            <p class="seo-empty-title">@T["seo.empty_health"]</p>
        </div>
    }
    else
    {
        <div class="seo-health-list">
            @foreach (var h in Model.PostHealth)
            {
                var scoreCls = h.Score >= 80 ? "good" : h.Score >= 50 ? "mid" : "low";
                <article class="seo-health-item">
                    <div class="seo-health-main">
                        <a class="seo-health-title" dir="auto" asp-controller="Posts" asp-action="Edit" asp-route-id="@h.Id">@h.Title</a>
                        <div class="seo-health-flags">
                            <span class="seo-flag @(h.HasSummary ? "is-on" : "is-off")" title="@T["seo.has_summary"]">
                                @(h.HasSummary ? "✓" : "—") خلاصه
                            </span>
                            <span class="seo-flag @(h.HasCover ? "is-on" : "is-off")" title="@T["seo.has_cover"]">
                                @(h.HasCover ? "✓" : "—") کاور
                            </span>
                        </div>
                    </div>
                    <div class="seo-health-score seo-score-@scoreCls">
                        <div class="seo-score-bar" style="--p:@h.Score%"></div>
                        <span class="seo-score-num ltr-field">@h.Score</span>
                    </div>
                </article>
            }
        </div>
    }
}

@if (tab == "import")
{
    @if (!isSuper)
    {
        <div class="seo-alert seo-alert-info mb-3">@T["seo.meta_super_only"]</div>
    }
    else
    {
        <section class="seo-card seo-form">
            <div class="seo-card-head">
                <h2 class="seo-card-title mb-0">@T["seo.import_title"]</h2>
                <p class="seo-card-desc mb-0">@T["seo.import_hint"]</p>
            </div>
            <form asp-action="SeoImport" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="seo-form-grid seo-form-grid-import">
                    <div class="seo-field seo-field-file">
                        <label class="seo-label">@T["seo.import_file"]</label>
                        <input type="file" class="form-control" name="file" accept=".xml,.json,.wxr,application/xml,application/json" required />
                    </div>
                    <div class="seo-field">
                        <label class="seo-label">@T["seo.import_format"]</label>
                        <select class="form-select" name="format">
                            <option value="wordpress">WordPress WXR</option>
                            <option value="ghost">Ghost JSON</option>
                        </select>
                    </div>
                    <div class="seo-field">
                        <label class="seo-label">@T["seo.import_lang"]</label>
                        <select class="form-select" name="languageCode">
                            <option value="fa">fa</option>
                            <option value="en">en</option>
                            <option value="ar">ar</option>
                        </select>
                    </div>
                    <div class="seo-field seo-field-full">
                        <div class="seo-checks">
                            <label class="seo-check">
                                <input type="checkbox" name="createRedirects" value="true" checked />
                                <span>@T["seo.import_redirects"]</span>
                            </label>
                            <label class="seo-check">
                                <input type="checkbox" name="publishImmediately" value="true" checked />
                                <span>@T["seo.import_publish"]</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="seo-form-footer">
                    <button type="submit" class="btn btn-accent">@T["seo.import_run"]</button>
                </div>
            </form>
        </section>
    }
}

@if (tab == "indexnow")
{
    <section class="seo-card">
        <div class="seo-card-head">
            <h2 class="seo-card-title mb-0">@T["seo.indexnow_title"]</h2>
            <p class="seo-card-desc mb-0">@T["seo.indexnow_hint"]</p>
        </div>

        <div class="seo-status-grid">
            <div class="seo-status-cell">
                <span class="seo-status-label">@T["seo.indexnow_status"]</span>
                <span class="seo-status-value @(Model.IndexNowEnabled ? "is-on" : "is-off")">
                    @(Model.IndexNowEnabled ? "enabled" : "disabled")
                </span>
            </div>
            <div class="seo-status-cell">
                <span class="seo-status-label">Key</span>
                <span class="seo-status-value ltr-field">@(Model.IndexNowHasKey ? Model.IndexNowKeyHint : "—")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.IndexNowKeyUrl))
            {
                <div class="seo-status-cell seo-status-full">
                    <span class="seo-status-label">Verify URL</span>
                    <a class="seo-status-link ltr-field" href="@Model.IndexNowKeyUrl" target="_blank" rel="noopener">@Model.IndexNowKeyUrl</a>
                </div>
            }
        </div>

        <p class="seo-hint mt-3 mb-0">@T["seo.indexnow_config"]</p>

        @if (isSuper)
        {
            <form asp-action="SeoIndexNowSubmitAll" method="post" class="seo-form-footer mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-accent"
                        @(Model.IndexNowEnabled && Model.IndexNowHasKey ? null : "disabled")>
                    @T["seo.indexnow_submit_all"]
                </button>
            </form>
        }
    </section>
}
