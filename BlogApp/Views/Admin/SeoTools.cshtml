@model SeoToolsViewModel
@inject BlogApp.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["admin.nav.seo"];
    var tab = Model.ActiveTab ?? "overview";
    var isSuper = BlogApp.Services.AuthorAccess.IsSuperAdmin(User);
    string TabClass(string id) => tab == id ? "is-active" : "";

    var avgHealth = Model.PostHealth.Count > 0
        ? (int)Math.Round(Model.PostHealth.Average(h => (double)h.Score))
        : 0;
    var healthyCount = Model.PostHealth.Count(h => h.Score >= 80);
    var weakCount = Model.PostHealth.Count(h => h.Score < 50);
}

@if (TempData["SeoOk"] is string ok)
{
    <div class="st-alert st-alert-ok" role="status">@ok</div>
}
@if (TempData["SeoErr"] is string err)
{
    <div class="st-alert st-alert-err" role="alert">@err</div>
}

<header class="st-hero">
    <div class="st-hero-text">
        <p class="st-eyebrow">SEO</p>
        <h1 class="st-title">@T["admin.nav.seo"]</h1>
        <p class="st-sub">متا، ریدایرکت، لینک شکسته، سلامت محتوا، ایمپورت و IndexNow</p>
    </div>
    <div class="st-hero-actions">
        <a class="st-chip-link" href="@Model.SitemapUrl" target="_blank" rel="noopener">sitemap.xml</a>
        <a class="st-chip-link" href="@Model.RobotsUrl" target="_blank" rel="noopener">robots.txt</a>
    </div>
</header>

<nav class="st-tabs" role="tablist" aria-label="ابزارهای سئو">
    <a class="st-tab @TabClass("overview")" asp-action="SeoTools" asp-route-tab="overview">@T["seo.tab_overview"]</a>
    <a class="st-tab @TabClass("meta")" asp-action="SeoTools" asp-route-tab="meta">@T["seo.tab_meta"]</a>
    <a class="st-tab @TabClass("redirects")" asp-action="SeoTools" asp-route-tab="redirects">
        @T["seo.tab_redirects"]
        @if (Model.Redirects.Count > 0) { <span class="st-badge">@Model.Redirects.Count</span> }
    </a>
    <a class="st-tab @TabClass("broken")" asp-action="SeoTools" asp-route-tab="broken">
        @T["seo.tab_broken"]
        @if (Model.BrokenLinks.Count > 0) { <span class="st-badge st-badge-warn">@Model.BrokenLinks.Count</span> }
    </a>
    <a class="st-tab @TabClass("health")" asp-action="SeoTools" asp-route-tab="health">@T["seo.tab_health"]</a>
    <a class="st-tab @TabClass("import")" asp-action="SeoTools" asp-route-tab="import">@T["seo.tab_import"]</a>
    <a class="st-tab @TabClass("indexnow")" asp-action="SeoTools" asp-route-tab="indexnow">@T["seo.tab_indexnow"]</a>
</nav>

@* ── Overview ── *@
@if (tab == "overview")
{
    <div class="st-kpis">
        <a class="st-kpi" asp-action="SeoTools" asp-route-tab="health">
            <span class="st-kpi-label">@T["seo.kpi_published"]</span>
            <span class="st-kpi-val">@Model.PublishedCount.ToString("N0")</span>
        </a>
        <a class="st-kpi" asp-action="SeoTools" asp-route-tab="redirects">
            <span class="st-kpi-label">@T["seo.kpi_redirects"]</span>
            <span class="st-kpi-val">@Model.Redirects.Count.ToString("N0")</span>
        </a>
        <a class="st-kpi @(Model.BrokenLinks.Count > 0 ? "st-kpi-warn" : "")" asp-action="SeoTools" asp-route-tab="broken">
            <span class="st-kpi-label">@T["seo.kpi_broken"]</span>
            <span class="st-kpi-val">@Model.BrokenLinks.Count.ToString("N0")</span>
        </a>
        <a class="st-kpi" asp-action="SeoTools" asp-route-tab="health">
            <span class="st-kpi-label">@T["seo.kpi_no_summary"]</span>
            <span class="st-kpi-val">@Model.MissingSummaryCount.ToString("N0")</span>
        </a>
    </div>

    <div class="st-split">
        <section class="st-card">
            <div class="st-card-head">
                <h2 class="st-card-title">@T["seo.live_endpoints"]</h2>
                <p class="st-card-desc">@T["seo.live_hint"]</p>
            </div>
            <div class="st-endpoints">
                <a class="st-ep" href="@Model.SitemapUrl" target="_blank" rel="noopener">
                    <span class="st-ep-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                    </span>
                    <span class="st-ep-body">
                        <strong>sitemap.xml</strong>
                        <span class="st-ep-url ltr-field">@Model.SitemapUrl</span>
                    </span>
                    <span class="st-ep-go" aria-hidden="true">↗</span>
                </a>
                <a class="st-ep" href="@Model.RobotsUrl" target="_blank" rel="noopener">
                    <span class="st-ep-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46a.5.5 0 0 0-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65A.49.49 0 0 0 14 2h-4a.49.49 0 0 0-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1a.5.5 0 0 0-.61.22l-2 3.46a.5.5 0 0 0 .12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65a.5.5 0 0 0-.12.64l2 3.46c.14.24.42.32.65.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.05.24.25.42.49.42h4c.24 0 .44-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.1.51.02.65-.22l2-3.46a.5.5 0 0 0-.12-.64l-2.11-1.65zM12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7z"/></svg>
                    </span>
                    <span class="st-ep-body">
                        <strong>robots.txt</strong>
                        <span class="st-ep-url ltr-field">@Model.RobotsUrl</span>
                    </span>
                    <span class="st-ep-go" aria-hidden="true">↗</span>
                </a>
                @if (!string.IsNullOrEmpty(Model.IndexNowKeyUrl))
                {
                    <a class="st-ep" href="@Model.IndexNowKeyUrl" target="_blank" rel="noopener">
                        <span class="st-ep-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
                        </span>
                        <span class="st-ep-body">
                            <strong>IndexNow key</strong>
                            <span class="st-ep-url ltr-field">@Model.IndexNowKeyUrl</span>
                        </span>
                        <span class="st-ep-go" aria-hidden="true">↗</span>
                    </a>
                }
            </div>
        </section>

        <section class="st-card">
            <div class="st-card-head">
                <h2 class="st-card-title">@T["seo.capabilities"]</h2>
            </div>
            <ul class="st-caps">
                <li>@T["seo.cap_meta"]</li>
                <li>@T["seo.cap_redirect"]</li>
                <li>@T["seo.cap_broken"]</li>
                <li>@T["seo.cap_sitemap"]</li>
                <li>@T["seo.cap_og"]</li>
                <li>@T["seo.cap_import"]</li>
                <li>@T["seo.cap_indexnow"]</li>
                <li>@T["seo.cap_hreflang"]</li>
            </ul>
            @if (Model.PostHealth.Count > 0)
            {
                <div class="st-health-snap">
                    <div class="st-snap-row">
                        <span>میانگین سلامت</span>
                        <strong class="ltr-field">@avgHealth</strong>
                    </div>
                    <div class="st-snap-bar"><i style="width:@avgHealth%"></i></div>
                    <div class="st-snap-meta">
                        <span class="st-snap-good">@healthyCount خوب</span>
                        <span class="st-snap-weak">@weakCount ضعیف</span>
                    </div>
                </div>
            }
        </section>
    </div>

    <div class="st-shortcuts">
        <a asp-action="SeoTools" asp-route-tab="meta">@T["seo.tab_meta"]</a>
        <a asp-action="SeoTools" asp-route-tab="redirects">@T["seo.tab_redirects"]</a>
        <a asp-action="SeoTools" asp-route-tab="broken">@T["seo.tab_broken"]</a>
        <a asp-action="SeoTools" asp-route-tab="health">@T["seo.tab_health"]</a>
        <a asp-action="SeoTools" asp-route-tab="indexnow">@T["seo.tab_indexnow"]</a>
    </div>
}

@* ── Meta ── *@
@if (tab == "meta")
{
    @if (!isSuper)
    {
        <div class="st-alert st-alert-info">@T["seo.meta_super_only"]</div>
    }

    <form asp-action="SeoSaveMeta" method="post" class="st-card st-form">
        @Html.AntiForgeryToken()
        <div class="st-card-head">
            <h2 class="st-card-title">@T["seo.tab_meta"]</h2>
            <p class="st-card-desc">نام سایت، توضیح پیش‌فرض، Twitter و robots.txt</p>
        </div>

        <div class="st-fields st-fields-2">
            <div class="st-field">
                <label class="st-label">@T["seo.site_name"]</label>
                <input class="form-control" name="SiteName" value="@Model.Meta.SiteName" maxlength="120" @(isSuper ? null : "disabled") />
            </div>
            <div class="st-field">
                <label class="st-label">@T["seo.author_name"]</label>
                <input class="form-control" name="AuthorName" value="@Model.Meta.AuthorName" maxlength="120" @(isSuper ? null : "disabled") />
            </div>
            <div class="st-field st-field-full">
                <label class="st-label">@T["seo.site_desc"]</label>
                <textarea class="form-control" name="SiteDescription" rows="2" maxlength="400" @(isSuper ? null : "disabled")>@Model.Meta.SiteDescription</textarea>
            </div>
            <div class="st-field">
                <label class="st-label">@T["seo.twitter"]</label>
                <input class="form-control ltr-field" name="TwitterHandle" value="@Model.Meta.TwitterHandle" placeholder="@@site" maxlength="80" @(isSuper ? null : "disabled") />
            </div>
            <div class="st-field">
                <label class="st-label">@T["seo.base_url"]</label>
                <input class="form-control ltr-field" name="BaseUrl" value="@Model.Meta.BaseUrl" placeholder="https://example.com" maxlength="200" @(isSuper ? null : "disabled") />
            </div>
            <div class="st-field st-field-full">
                <label class="st-label">@T["seo.robots_custom"]</label>
                <textarea class="form-control ltr-field st-mono" name="RobotsTxt" rows="8" maxlength="4000" placeholder="User-agent: *" @(isSuper ? null : "disabled")>@Model.Meta.RobotsTxt</textarea>
                <p class="st-hint">@T["seo.robots_hint"]</p>
            </div>
        </div>

        @if (isSuper)
        {
            <div class="st-form-foot">
                <button type="submit" class="btn btn-accent">@T["seo.save_meta"]</button>
            </div>
        }
    </form>
}

@* ── Redirects ── *@
@if (tab == "redirects")
{
    <section class="st-card st-form st-mb">
        <div class="st-card-head">
            <h2 class="st-card-title">@T["seo.add_redirect"]</h2>
            <p class="st-card-desc">مسیر قدیم → مقصد جدید</p>
        </div>
        <form asp-action="SeoAddRedirect" method="post">
            @Html.AntiForgeryToken()
            <div class="st-fields st-fields-redir">
                <div class="st-field">
                    <label class="st-label">@T["seo.from_path"]</label>
                    <input class="form-control ltr-field" name="FromPath" required placeholder="/post/old-slug" maxlength="500" />
                </div>
                <div class="st-field">
                    <label class="st-label">@T["seo.to_url"]</label>
                    <input class="form-control ltr-field" name="ToUrl" required placeholder="/post/new-slug" maxlength="1000" />
                </div>
                <div class="st-field st-field-sm">
                    <label class="st-label">@T["seo.status"]</label>
                    <select class="form-select" name="StatusCode">
                        <option value="301">301</option>
                        <option value="302">302</option>
                        <option value="307">307</option>
                        <option value="308">308</option>
                    </select>
                </div>
                <div class="st-field st-field-full">
                    <label class="st-label">@T["seo.notes"]</label>
                    <input class="form-control form-control-sm" name="Notes" maxlength="300" placeholder="@T["seo.notes"]" />
                </div>
                <div class="st-field st-field-btn">
                    <button type="submit" class="btn btn-accent btn-sm w-100">@T["seo.add"]</button>
                </div>
            </div>
        </form>
    </section>

    @if (Model.Redirects.Count == 0)
    {
        <div class="st-empty">
            <p class="st-empty-title">@T["seo.empty_redirects"]</p>
            <p class="st-empty-hint">اولین ریدایرکت را از فرم بالا اضافه کنید.</p>
        </div>
    }
    else
    {
        <div class="st-filter-bar">
            <input type="search" class="st-filter" id="redirFilter" placeholder="فیلتر مسیر…" autocomplete="off" />
            <span class="st-filter-count" id="redirCount">@Model.Redirects.Count</span>
        </div>
        <div class="st-rows" id="redirList">
            @foreach (var r in Model.Redirects)
            {
                <article class="st-row @(r.IsActive ? "" : "is-off")" data-q="@((r.FromPath + " " + r.ToUrl).ToLowerInvariant())">
                    <div class="st-redir">
                        <code class="st-path ltr-field">@r.FromPath</code>
                        <span class="st-arrow" aria-hidden="true">→</span>
                        <code class="st-path ltr-field">@r.ToUrl</code>
                    </div>
                    <div class="st-row-meta">
                        <span class="st-pill st-pill-code">@r.StatusCode</span>
                        <span class="st-pill">@r.HitCount hit</span>
                        @if (!r.IsActive) { <span class="st-pill st-pill-off">off</span> }
                    </div>
                    <div class="st-row-acts">
                        <form asp-action="SeoToggleRedirect" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="st-btn">@(r.IsActive ? T["seo.disable"] : T["seo.enable"])</button>
                        </form>
                        <form asp-action="SeoDeleteRedirect" method="post" onsubmit="return confirm('@T["msg.confirm_delete"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="st-btn st-btn-danger">@T["btn.delete"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
}

@* ── Broken ── *@
@if (tab == "broken")
{
    <div class="st-toolbar">
        <p class="st-toolbar-text">@T["seo.broken_hint"]</p>
        <form asp-action="SeoScanBrokenLinks" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-accent btn-sm">@T["seo.scan_now"]</button>
        </form>
    </div>

    @if (Model.BrokenLinks.Count == 0)
    {
        <div class="st-empty st-empty-ok">
            <p class="st-empty-title">@T["seo.empty_broken"]</p>
            <p class="st-empty-hint">اسکن دستی یا دوره‌ای لینک‌های داخلی را بررسی می‌کند.</p>
        </div>
    }
    else
    {
        <div class="st-filter-bar">
            <input type="search" class="st-filter" id="brokenFilter" placeholder="فیلتر عنوان یا URL…" autocomplete="off" />
            <span class="st-filter-count" id="brokenCount">@Model.BrokenLinks.Count</span>
        </div>
        <div class="st-rows" id="brokenList">
            @foreach (var b in Model.BrokenLinks)
            {
                <article class="st-row st-row-warn" data-q="@((b.PostTitle + " " + b.Url).ToLowerInvariant())">
                    <div class="st-row-body">
                        <a class="st-row-title" dir="auto" asp-controller="Posts" asp-action="Edit" asp-route-id="@b.PostId">@b.PostTitle</a>
                        <div class="st-row-sub">
                            <span class="ltr-field st-url">@b.Url</span>
                            <span class="st-sep">·</span>
                            <span class="ltr-field">@b.DetectedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                    <div class="st-row-acts">
                        <a class="st-btn" asp-controller="Posts" asp-action="Edit" asp-route-id="@b.PostId">ویرایش</a>
                    </div>
                </article>
            }
        </div>
    }
}

@* ── Health ── *@
@if (tab == "health")
{
    <div class="st-toolbar">
        <p class="st-toolbar-text">@T["seo.health_hint"]</p>
        @if (Model.PostHealth.Count > 0)
        {
            <div class="st-health-legend">
                <span><i class="st-dot st-dot-good"></i> ≥80</span>
                <span><i class="st-dot st-dot-mid"></i> 50–79</span>
                <span><i class="st-dot st-dot-low"></i> &lt;50</span>
            </div>
        }
    </div>

    @if (Model.PostHealth.Count == 0)
    {
        <div class="st-empty">
            <p class="st-empty-title">@T["seo.empty_health"]</p>
        </div>
    }
    else
    {
        <div class="st-kpis st-kpis-3 st-mb">
            <div class="st-kpi">
                <span class="st-kpi-label">میانگین</span>
                <span class="st-kpi-val">@avgHealth</span>
            </div>
            <div class="st-kpi">
                <span class="st-kpi-label">سالم</span>
                <span class="st-kpi-val st-val-good">@healthyCount</span>
            </div>
            <div class="st-kpi">
                <span class="st-kpi-label">ضعیف</span>
                <span class="st-kpi-val st-val-bad">@weakCount</span>
            </div>
        </div>

        <div class="st-filter-bar">
            <input type="search" class="st-filter" id="healthFilter" placeholder="فیلتر عنوان…" autocomplete="off" />
        </div>

        <div class="st-health" id="healthList">
            @foreach (var h in Model.PostHealth.OrderBy(x => x.Score))
            {
                var cls = h.Score >= 80 ? "good" : h.Score >= 50 ? "mid" : "low";
                <article class="st-health-row" data-q="@h.Title.ToLowerInvariant()">
                    <div class="st-health-main">
                        <a class="st-health-title" dir="auto" asp-controller="Posts" asp-action="Edit" asp-route-id="@h.Id">@h.Title</a>
                        <div class="st-flags">
                            <span class="st-flag @(h.HasSummary ? "on" : "")">@(h.HasSummary ? "✓" : "—") @T["seo.has_summary"]</span>
                            <span class="st-flag @(h.HasCover ? "on" : "")">@(h.HasCover ? "✓" : "—") @T["seo.has_cover"]</span>
                        </div>
                    </div>
                    <div class="st-score st-score-@cls">
                        <div class="st-score-track"><i style="width:@h.Score%"></i></div>
                        <span class="st-score-num ltr-field">@h.Score</span>
                    </div>
                </article>
            }
        </div>
    }
}

@* ── Import ── *@
@if (tab == "import")
{
    @if (!isSuper)
    {
        <div class="st-alert st-alert-info">@T["seo.meta_super_only"]</div>
    }
    else
    {
        <section class="st-card st-form">
            <div class="st-card-head">
                <h2 class="st-card-title">@T["seo.import_title"]</h2>
                <p class="st-card-desc">@T["seo.import_hint"]</p>
            </div>
            <form asp-action="SeoImport" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="st-fields st-fields-import">
                    <div class="st-field st-field-file">
                        <label class="st-label">@T["seo.import_file"]</label>
                        <input type="file" class="form-control" name="file" accept=".xml,.json,.wxr,application/xml,application/json" required />
                    </div>
                    <div class="st-field">
                        <label class="st-label">@T["seo.import_format"]</label>
                        <select class="form-select" name="format">
                            <option value="wordpress">WordPress WXR</option>
                            <option value="ghost">Ghost JSON</option>
                        </select>
                    </div>
                    <div class="st-field">
                        <label class="st-label">@T["seo.import_lang"]</label>
                        <select class="form-select" name="languageCode">
                            <option value="fa">fa</option>
                            <option value="en">en</option>
                            <option value="ar">ar</option>
                        </select>
                    </div>
                    <div class="st-field st-field-full">
                        <div class="st-checks">
                            <label class="st-check">
                                <input type="checkbox" name="createRedirects" value="true" checked />
                                <span>@T["seo.import_redirects"]</span>
                            </label>
                            <label class="st-check">
                                <input type="checkbox" name="publishImmediately" value="true" checked />
                                <span>@T["seo.import_publish"]</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="st-form-foot">
                    <button type="submit" class="btn btn-accent">@T["seo.import_run"]</button>
                </div>
            </form>
        </section>
    }
}

@* ── IndexNow ── *@
@if (tab == "indexnow")
{
    <section class="st-card">
        <div class="st-card-head">
            <h2 class="st-card-title">@T["seo.indexnow_title"]</h2>
            <p class="st-card-desc">@T["seo.indexnow_hint"]</p>
        </div>

        <div class="st-status">
            <div class="st-status-cell">
                <span class="st-status-label">@T["seo.indexnow_status"]</span>
                <span class="st-status-val @(Model.IndexNowEnabled ? "on" : "off")">
                    @(Model.IndexNowEnabled ? "enabled" : "disabled")
                </span>
            </div>
            <div class="st-status-cell">
                <span class="st-status-label">Key</span>
                <span class="st-status-val ltr-field">@(Model.IndexNowHasKey ? Model.IndexNowKeyHint : "—")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.IndexNowKeyUrl))
            {
                <div class="st-status-cell st-status-wide">
                    <span class="st-status-label">Verify URL</span>
                    <a class="st-status-link ltr-field" href="@Model.IndexNowKeyUrl" target="_blank" rel="noopener">@Model.IndexNowKeyUrl</a>
                </div>
            }
        </div>

        <p class="st-hint st-mt">@T["seo.indexnow_config"]</p>

        @if (isSuper)
        {
            <form asp-action="SeoIndexNowSubmitAll" method="post" class="st-form-foot">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-accent"
                        @(Model.IndexNowEnabled && Model.IndexNowHasKey ? null : "disabled")>
                    @T["seo.indexnow_submit_all"]
                </button>
            </form>
        }
    </section>
}

