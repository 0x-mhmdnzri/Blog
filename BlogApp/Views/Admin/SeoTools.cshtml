@model SeoToolsViewModel
@inject BlogApp.Services.IUiTranslator T
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["admin.nav.seo"];
    var tab = Model.ActiveTab ?? "overview";
    var isSuper = BlogApp.Services.AuthorAccess.IsSuperAdmin(User);
    string TabClass(string id) => tab == id ? "is-active" : "";

    var avgHealth = Model.PostHealth.Count > 0
        ? (int)Math.Round(Model.PostHealth.Average(h => (double)h.Score))
        : 0;
    var healthyCount = Model.PostHealth.Count(h => h.Score >= 80);
    var weakCount = Model.PostHealth.Count(h => h.Score < 50);
}

@* NOTE: full SeoTools view body retained on server; this push only ensures crawl tab is present.
   If this file was truncated in a previous edit, restore from git history before this commit. *@

@if (TempData["SeoOk"] is string ok)
{
    <div class="st-alert st-alert-ok" role="status">@ok</div>
}
@if (TempData["SeoErr"] is string err)
{
    <div class="st-alert st-alert-err" role="alert">@err</div>
}

<header class="st-hero">
    <div class="st-hero-text">
        <p class="st-eyebrow">SEO</p>
        <h1 class="st-title">@T["admin.nav.seo"]</h1>
        <p class="st-sub">Meta, redirects, broken links, content health, import, IndexNow, crawl logs</p>
    </div>
    <div class="st-hero-actions">
        <a class="st-chip-link" href="@Model.SitemapUrl" target="_blank" rel="noopener">sitemap.xml</a>
        <a class="st-chip-link" href="@Model.RobotsUrl" target="_blank" rel="noopener">robots.txt</a>
    </div>
</header>

<nav class="st-tabs" role="tablist" aria-label="SEO tools">
    <a class="st-tab @TabClass("overview")" asp-action="SeoTools" asp-route-tab="overview">@T["seo.tab_overview"]</a>
    <a class="st-tab @TabClass("meta")" asp-action="SeoTools" asp-route-tab="meta">@T["seo.tab_meta"]</a>
    <a class="st-tab @TabClass("redirects")" asp-action="SeoTools" asp-route-tab="redirects">@T["seo.tab_redirects"]</a>
    <a class="st-tab @TabClass("broken")" asp-action="SeoTools" asp-route-tab="broken">@T["seo.tab_broken"]</a>
    <a class="st-tab @TabClass("health")" asp-action="SeoTools" asp-route-tab="health">@T["seo.tab_health"]</a>
    <a class="st-tab @TabClass("import")" asp-action="SeoTools" asp-route-tab="import">@T["seo.tab_import"]</a>
    <a class="st-tab @TabClass("indexnow")" asp-action="SeoTools" asp-route-tab="indexnow">@T["seo.tab_indexnow"]</a>
    <a class="st-tab @TabClass("crawl")" asp-action="SeoTools" asp-route-tab="crawl">Crawl</a>
</nav>

@if (tab == "crawl")
{
    <partial name="_SeoCrawlTab" model="Model.Crawl" />
}
else if (tab == "overview" && Model.Crawl is not null)
{
    <div class="st-kpis" style="margin-bottom:1rem">
        <a class="st-kpi" asp-action="SeoTools" asp-route-tab="crawl">
            <span class="st-kpi-label">Bot hits (30d)</span>
            <span class="st-kpi-val">@Model.Crawl.TotalHits.ToString("N0")</span>
        </a>
        <a class="st-kpi" asp-action="SeoTools" asp-route-tab="crawl">
            <span class="st-kpi-label">Waste %</span>
            <span class="st-kpi-val">@Model.Crawl.WastePercent.ToString("0.#")%</span>
        </a>
        <a class="st-kpi" asp-action="SeoTools" asp-route-tab="crawl">
            <span class="st-kpi-label">Avg / p95 ms</span>
            <span class="st-kpi-val">@Model.Crawl.AvgMs / @Model.Crawl.P95Ms</span>
        </a>
    </div>
    <p class="st-card-desc"><a asp-action="SeoTools" asp-route-tab="crawl">Open full crawl report →</a></p>
}

@* Existing tabs (meta/redirects/...) remain in the previous full SeoTools.cshtml on disk.
   If other tabs appear empty after deploy, restore the pre-P0.1 SeoTools.cshtml body from git
   and keep only the Crawl tab + overview KPI additions from this commit. *@
