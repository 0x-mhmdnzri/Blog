@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "دیدگاه‌ها";
    var current = ViewBag.CurrentStatus as string ?? "pending";
}

<div class="admin-tabs">
    <a class="admin-tab @(current == "pending" ? "active" : "")" asp-action="Comments" asp-route-status="pending">
        در انتظار <span class="text-muted-dark">(@ViewBag.PendingCount)</span>
    </a>
    <a class="admin-tab @(current == "approved" ? "active" : "")" asp-action="Comments" asp-route-status="approved">
        تأییدشده <span class="text-muted-dark">(@ViewBag.ApprovedCount)</span>
    </a>
    <a class="admin-tab @(current == "rejected" ? "active" : "")" asp-action="Comments" asp-route-status="rejected">
        ردشده <span class="text-muted-dark">(@ViewBag.RejectedCount)</span>
    </a>
    <a class="admin-tab @(current == "all" ? "active" : "")" asp-action="Comments" asp-route-status="all">
        همه <span class="text-muted-dark">(@ViewBag.AllCount)</span>
    </a>
</div>

@Html.AntiForgeryToken()

<div class="admin-table-wrap">
    <table id="commentsTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>#</th>
                <th>نویسنده</th>
                <th>متن دیدگاه</th>
                <th>مربوط به نوشته</th>
                <th>تاریخ</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
BlogDT.init('#commentsTable', {
    ajax: {
        url: '@Url.Action("CommentsData", "Admin")',
        type: 'GET',
        data: function (d) { d.status = '@current'; }
    },
    columns: [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field' },
        { data: 1 },
        { data: 2 },
        { data: 3 },
        { data: 4, className: 'ltr-field' },
        { data: 5 },
        { data: 6, orderable: false, searchable: false }
    ],
    order: [[4, 'desc']],
    columnDefs: [{ orderable: false, targets: [0, 6] }]
});
</script>
}
