@{
    Layout = "_AdminLayout";
    ViewData["Title"] = T["page.comments"];
    var current = ViewBag.CurrentStatus as string ?? "pending";
    var j = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

<div class="admin-tabs">
    <a class="admin-tab @(current == "pending" ? "active" : "")" asp-action="Comments" asp-route-status="pending">
        @T["tab.pending"] <span class="text-muted-dark">(@ViewBag.PendingCount)</span>
    </a>
    <a class="admin-tab @(current == "approved" ? "active" : "")" asp-action="Comments" asp-route-status="approved">
        @T["tab.approved"] <span class="text-muted-dark">(@ViewBag.ApprovedCount)</span>
    </a>
    <a class="admin-tab @(current == "rejected" ? "active" : "")" asp-action="Comments" asp-route-status="rejected">
        @T["tab.rejected"] <span class="text-muted-dark">(@ViewBag.RejectedCount)</span>
    </a>
    <a class="admin-tab @(current == "spam" ? "active" : "")" asp-action="Comments" asp-route-status="spam">
        Spam <span class="text-muted-dark">(@(ViewBag.SpamCount ?? 0))</span>
    </a>
    <a class="admin-tab @(current == "all" ? "active" : "")" asp-action="Comments" asp-route-status="all">
        @T["tab.all"] <span class="text-muted-dark">(@ViewBag.AllCount)</span>
    </a>
</div>

@Html.AntiForgeryToken()

<div class="admin-table-wrap">
    <table id="commentsTable" class="admin-table display nowrap" style="width:100%">
        <thead>
            <tr>
                <th>@T["col.index"]</th>
                <th>@T["col.author"]</th>
                <th>@T["col.comment_body"]</th>
                <th>@T["col.related_post"]</th>
                <th>@T["col.date"]</th>
                <th>@T["col.status"]</th>
                <th>@T["col.actions"]</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
<script>
BlogDT.init('#commentsTable', {
    ajax: {
        url: '@Url.Action("CommentsData", "Admin")',
        type: 'GET',
        data: function (d) { d.status = '@current'; }
    },
    exportUrl: '@Url.Action("CommentsExportCsv", "Admin")',
    exportParams: { status: '@current' },
    columns: [
        { data: 0, orderable: false, searchable: false, className: 'ltr-field col-idx' },
        { data: 1 },
        { data: 2, className: 'dt-wrap' },
        { data: 3 },
        { data: 4, className: 'ltr-field col-date' },
        { data: 5, className: 'col-status' },
        { data: 6, orderable: false, searchable: false, className: 'col-actions' }
    ],
    order: [[4, 'desc']],
    columnDefs: [{ orderable: false, targets: [0, 6] }],
    columnFilters: [
        false,
        true,
        true,
        true,
        false,
        {
            type: 'select',
            placeholder: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["col.status"].ToString(), j)),
            options: [
                { value: 'pending', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.pending"].ToString(), j)) },
                { value: 'approved', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.approved"].ToString(), j)) },
                { value: 'rejected', label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["status.rejected"].ToString(), j)) },
                { value: 'spam', label: 'Spam' }
            ]
        },
        false
    ]
});
</script>
}
