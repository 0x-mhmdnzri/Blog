@model AdminDashboardViewModel
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = T["admin.nav.dashboard"];

    string FormatBytes(long bytes)
    {
        if (bytes >= 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024 * 1024):0.##} GB";
        if (bytes >= 1024L * 1024) return $"{bytes / (1024.0 * 1024):0.##} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.##} KB";
        return $"{bytes} B";
    }

    var jsonOptions = new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var viewsByDayLabels = JsonSerializer.Serialize(Model.ViewsByDay.Select(p => p.Label), jsonOptions);
    var viewsByDayValues = JsonSerializer.Serialize(Model.ViewsByDay.Select(p => p.Value), jsonOptions);
    var postsByMonthLabels = JsonSerializer.Serialize(Model.PostsByMonth.Select(p => p.Label), jsonOptions);
    var postsByMonthValues = JsonSerializer.Serialize(Model.PostsByMonth.Select(p => p.Value), jsonOptions);
    var categoryLabels = JsonSerializer.Serialize(Model.PostsByCategory.Select(c => c.Name), jsonOptions);
    var categoryValues = JsonSerializer.Serialize(Model.PostsByCategory.Select(c => c.Count), jsonOptions);
    var commentStatusValues = JsonSerializer.Serialize(new[] { Model.ApprovedComments, Model.PendingComments, Model.RejectedComments }, jsonOptions);
    var maxLeaderViews = Math.Max(1, Model.TopPosts.Any() ? Model.TopPosts.Max(p => p.Views) : 1);
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
    var seeAllAnalytics = ViewBag.SeeAllAnalytics as bool? ?? false;

    var chartViewsLabel = JsonSerializer.Serialize(T["dash.chart_views_label"], jsonOptions);
    var chartCommentLabels = JsonSerializer.Serialize(new[] { T["status.approved"], T["status.pending"], T["status.rejected"] }, jsonOptions);
    var chartPostsLabel = JsonSerializer.Serialize(T["col.posts"], jsonOptions);
    var chartFailMsg = JsonSerializer.Serialize(T["dash.chart_fail"], jsonOptions);
}

@if (TempData["AnalyticsReset"] != null)
{
    <div class="alert mb-3" style="background:rgba(158,203,140,.12);color:var(--good,#9ecb8c);border:1px solid rgba(158,203,140,.35);">
        @T["msg.analytics_reset"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="range-tabs">
        <a class="admin-tab @(Model.RangeDays == 7 ? "active" : "")" asp-action="Index" asp-route-range="7">@T["dash.range_7"]</a>
        <a class="admin-tab @(Model.RangeDays == 30 ? "active" : "")" asp-action="Index" asp-route-range="30">@T["dash.range_30"]</a>
        <a class="admin-tab @(Model.RangeDays == 90 ? "active" : "")" asp-action="Index" asp-route-range="90">@T["dash.range_90"]</a>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a class="btn btn-accent btn-sm" asp-controller="Posts" asp-action="Create">@T["btn.new_post"]</a>
        @if (Model.IsSuperAdmin)
        {
            <form asp-action="ResetAnalytics" method="post" class="d-inline"
                  onsubmit="return confirm('@T["dash.reset_confirm"]');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost btn-sm" title="@T["dash.reset_title"]">@T["dash.reset_btn"]</button>
            </form>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@T["dash.kpi_views_range"]</div>
            <div class="kpi-value"><span class="ltr-field" id="kpiViewsRange" style="font-size:inherit;color:inherit;">@Model.ViewsThisRange</span></div>
            <div class="kpi-sub">
                @{
                    var trendClass = Model.ViewsTrendPercent > 0 ? "up" : Model.ViewsTrendPercent < 0 ? "down" : "flat";
                    var trendArrow = Model.ViewsTrendPercent > 0 ? "▲" : Model.ViewsTrendPercent < 0 ? "▼" : "—";
                }
                <span class="trend-badge @trendClass">@trendArrow @Math.Abs(Model.ViewsTrendPercent)٪</span>
                @T["dash.vs_previous"]
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@T["dash.kpi_views_today"]</div>
            <div class="kpi-value" id="kpiViewsToday">@Model.ViewsToday</div>
            <div class="kpi-sub">@T["dash.kpi_views_total"]: <span class="ltr-field" id="kpiViewsTotal" style="font-size:inherit;color:inherit;">@Model.TotalViews</span></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card @(Model.PendingComments > 0 ? "kpi-danger" : "kpi-good")" id="kpiPendingCard">
            <div class="kpi-label">@T["dash.kpi_pending"]</div>
            <div class="kpi-value" id="kpiPending">@Model.PendingComments</div>
            <div class="kpi-sub">
                <a asp-action="Comments" asp-route-status="pending">@T["dash.view_moderation"]</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card kpi-good">
            <div class="kpi-label">@T["col.posts"]</div>
            <div class="kpi-value">@Model.TotalPosts</div>
            <div class="kpi-sub">@Model.PublishedPosts @T["status.published_full"] · @Model.DraftPosts @T["status.draft"]</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@T["dash.kpi_approved"]</div>
            <div class="kpi-value" id="kpiApproved" style="font-size:1.3rem;">@Model.ApprovedComments</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@T["dash.kpi_rejected"]</div>
            <div class="kpi-value" id="kpiRejected" style="font-size:1.3rem;">@Model.RejectedComments</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@T["dash.kpi_media"]</div>
            <div class="kpi-value" style="font-size:1.3rem;">@Model.TotalMedia</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-label">@T["dash.kpi_media_size"]</div>
            <div class="kpi-value ltr-field" style="font-size:1.3rem;color:inherit;">@FormatBytes(Model.TotalMediaBytes)</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="chart-card">
            <div class="chart-title">@T["dash.chart_views_title"]</div>
            <div class="chart-subtitle">@string.Format(T["dash.chart_views_sub"], Model.RangeDays)</div>
            <div class="chart-canvas-wrap" style="height:260px;">
                <canvas id="viewsChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card">
            <div class="chart-title">@T["dash.chart_comments_title"]</div>
            <div class="chart-subtitle">@T["dash.chart_comments_sub"]</div>
            <div class="chart-canvas-wrap" style="height:260px;">
                <canvas id="commentStatusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="chart-card">
            <div class="chart-title">@T["dash.chart_posts_title"]</div>
            <div class="chart-subtitle">@T["dash.chart_posts_sub"]</div>
            <div class="chart-canvas-wrap" style="height:240px;">
                <canvas id="postsByMonthChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="chart-card">
            <div class="chart-title">@T["dash.chart_cat_title"]</div>
            <div class="chart-subtitle">@T["dash.chart_cat_sub"]</div>
            <div class="chart-canvas-wrap" style="height:240px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h6 mb-0 text-muted-dark">@T["dash.top_posts"]</h2>
    <a class="btn btn-ghost btn-sm" asp-action="Posts">@T["dash.view_all_posts"]</a>
</div>

@if (!Model.TopPosts.Any())
{
    <div class="admin-empty mb-4" id="topPostsEmpty">
        <h2>@T["dash.top_empty_title"]</h2>
        <p class="mb-0">@T["dash.top_empty_body"]</p>
    </div>
    <table class="admin-table mb-4 d-none" id="topPostsTable">
        <thead>
            <tr>
                <th>@T["col.title"]</th>
                <th style="width:40%;">@T["dash.col_views_total"]</th>
                <th>@T["dash.col_views_range"]</th>
            </tr>
        </thead>
        <tbody id="topPostsBody"></tbody>
    </table>
}
else
{
    <table class="admin-table mb-4" id="topPostsTable">
        <thead>
            <tr>
                <th>@T["col.title"]</th>
                <th style="width:40%;">@T["dash.col_views_total"]</th>
                <th>@T["dash.col_views_range"]</th>
            </tr>
        </thead>
        <tbody id="topPostsBody">
            @foreach (var p in Model.TopPosts)
            {
                <tr data-slug="@p.Slug">
                    <td dir="auto"><a asp-controller="Posts" asp-action="Details" asp-route-slug="@p.Slug">@p.Title</a></td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="leader-bar-track" style="max-width:220px;">
                                <div class="leader-bar-fill" data-leader-fill style="width:@((int)(p.Views * 100.0 / maxLeaderViews))%;"></div>
                            </div>
                            <span class="ltr-field" data-total-views>@p.Views</span>
                        </div>
                    </td>
                    <td><span class="ltr-field" data-range-views>@p.RangeViews</span></td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h6 mb-0 text-muted-dark">@T["dash.recent_comments"]</h2>
    <a class="btn btn-ghost btn-sm" asp-action="Comments">@T["dash.view_all"]</a>
</div>

@if (!Model.RecentComments.Any())
{
    <div class="admin-empty">
        <h2>@T["dash.comments_empty_title"]</h2>
        <p class="mb-0">@T["dash.comments_empty_body"]</p>
    </div>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>@T["col.author"]</th>
                <th>@T["col.comment_body"]</th>
                <th>@T["col.related_post"]</th>
                <th>@T["col.status"]</th>
                <th>@T["col.date"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.RecentComments)
            {
                <tr>
                    <td dir="auto">@c.AuthorName</td>
                    <td dir="auto" style="max-width:320px;">@(c.Body.Length > 90 ? c.Body[..90] + "…" : c.Body)</td>
                    <td dir="auto"><a asp-controller="Posts" asp-action="Details" asp-route-slug="@c.PostSlug">@c.PostTitle</a></td>
                    <td>
                        @switch (c.Status)
                        {
                            case CommentStatus.Approved:
                                <span class="status-pill approved">@T["status.approved"]</span>
                                break;
                            case CommentStatus.Rejected:
                                <span class="status-pill rejected">@T["status.rejected"]</span>
                                break;
                            default:
                                <span class="status-pill pending">@T["status.pending"]</span>
                                break;
                        }
                    </td>
                    <td><span class="ltr-field">@PersianDate.DateTime(c.CreatedAtUtc)</span></td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"
            onerror="this.dataset.failed='1'"></script>
    <script>
        (function () {
            const currentUserId = @Html.Raw(JsonSerializer.Serialize(currentUserId, jsonOptions));
            const seeAllAnalytics = @(seeAllAnalytics ? "true" : "false");
            const chartViewsLabel = @Html.Raw(chartViewsLabel);
            const chartCommentLabels = @Html.Raw(chartCommentLabels);
            const chartPostsLabel = @Html.Raw(chartPostsLabel);
            const chartFailMsg = @Html.Raw(chartFailMsg);

            let viewsChart = null;
            let commentStatusChart = null;

            function bump(elId, delta) {
                const el = document.getElementById(elId);
                if (!el) return;
                const current = parseInt(String(el.textContent).replace(/[^\d-]/g, ''), 10) || 0;
                el.textContent = current + delta;
                el.classList.add('kpi-flash');
                setTimeout(() => el.classList.remove('kpi-flash'), 900);
            }

            // View KPIs: no optimistic +1. admin-live.js LiveSnapshot is authoritative
            // (scoped to !IsDeleted posts) so totals never jump high → low after soft-delete.
            window.addEventListener('admin-sse-message', function (e) {
                const data = e.detail;
                if (!data || !data.type) return;

                if (data.type === 'comment') {
                    if (data.status === 'pending') {
                        bump('kpiPending', 1);
                        if (commentStatusChart) {
                            commentStatusChart.data.datasets[0].data[1]++;
                            commentStatusChart.update();
                        }
                    } else if (data.status === 'approved') {
                        bump('kpiApproved', 1);
                        bump('kpiPending', -1);
                        if (commentStatusChart) {
                            commentStatusChart.data.datasets[0].data[0]++;
                            commentStatusChart.data.datasets[0].data[1] = Math.max(0, commentStatusChart.data.datasets[0].data[1] - 1);
                            commentStatusChart.update();
                        }
                    } else if (data.status === 'rejected') {
                        bump('kpiRejected', 1);
                        bump('kpiPending', -1);
                        if (commentStatusChart) {
                            commentStatusChart.data.datasets[0].data[2]++;
                            commentStatusChart.data.datasets[0].data[1] = Math.max(0, commentStatusChart.data.datasets[0].data[1] - 1);
                            commentStatusChart.update();
                        }
                    }

                    const pendingEl = document.getElementById('kpiPending');
                    const pendingCard = document.getElementById('kpiPendingCard');
                    if (pendingEl && pendingCard) {
                        const stillPending = parseInt(pendingEl.textContent, 10) > 0;
                        pendingCard.classList.toggle('kpi-danger', stillPending);
                        pendingCard.classList.toggle('kpi-good', !stillPending);
                    }
                }
            });

            if (typeof Chart === 'undefined') {
                console.error('Chart.js failed to load — KPI counters still update via SSE.');
                document.querySelectorAll('.chart-canvas-wrap').forEach(function (el) {
                    el.innerHTML = '<div class="admin-empty" style="padding:1rem;"><p class="mb-0">' + chartFailMsg + '</p></div>';
                });
                return;
            }

            const styles = getComputedStyle(document.documentElement);
            const textMuted = styles.getPropertyValue('--text-muted').trim();
            const borderSoft = styles.getPropertyValue('--border-soft').trim();
            const accent = styles.getPropertyValue('--accent').trim();
            const good = '#9ecb8c';
            const danger = styles.getPropertyValue('--danger').trim();
            const info = '#6fb3d2';
            const purple = '#c9a0f2';

            Chart.defaults.color = textMuted;
            Chart.defaults.borderColor = borderSoft;
            Chart.defaults.font.family = 'Vazirmatn, sans-serif';

            function safeChart(label, factory) {
                try { return factory(); }
                catch (err) { console.error('Chart failed to render: ' + label, err); return null; }
            }

            viewsChart = safeChart('viewsChart', function () {
                return new Chart(document.getElementById('viewsChart'), {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(viewsByDayLabels),
                        datasets: [{
                            label: chartViewsLabel,
                            data: @Html.Raw(viewsByDayValues),
                            borderColor: accent,
                            backgroundColor: 'rgba(227,179,65,0.12)',
                            fill: true,
                            tension: 0.3,
                            pointRadius: 2,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: { duration: 400 },
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false }, ticks: { maxTicksLimit: 8 } },
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            });
            window.__adminViewsChart = viewsChart;

            commentStatusChart = safeChart('commentStatusChart', function () {
                return new Chart(document.getElementById('commentStatusChart'), {
                    type: 'doughnut',
                    data: {
                        labels: chartCommentLabels,
                        datasets: [{
                            data: @Html.Raw(commentStatusValues),
                            backgroundColor: [good, accent, danger],
                            borderColor: borderSoft,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 12 } } }
                    }
                });
            });
            window.__adminCommentChart = commentStatusChart;

            safeChart('postsByMonthChart', function () {
                return new Chart(document.getElementById('postsByMonthChart'), {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(postsByMonthLabels),
                        datasets: [{
                            label: chartPostsLabel,
                            data: @Html.Raw(postsByMonthValues),
                            backgroundColor: info,
                            borderRadius: 4,
                            maxBarThickness: 40
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            });

            safeChart('categoryChart', function () {
                return new Chart(document.getElementById('categoryChart'), {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(categoryLabels),
                        datasets: [{
                            data: @Html.Raw(categoryValues),
                            backgroundColor: [accent, info, purple, good, danger, '#f2789f'],
                            borderColor: borderSoft,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '60%',
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 12 } } }
                    }
                });
            });
        })();
    </script>
}
