@model TaxonomyAdminViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["tax.title"];
    var folderCount = Model.Folders?.Count ?? 0;
    var catCount = Model.Categories?.Count ?? 0;
    var tagCount = Model.Tags?.Count ?? 0;
    var seriesCount = Model.Series?.Count ?? 0;
    var topicCount = Model.Topics?.Count ?? 0;
}

@if (TempData["TaxonomyMsg"] != null)
{
    <div class="tx-alert tx-alert-ok mb-3" role="status">@TempData["TaxonomyMsg"]</div>
}
@if (TempData["TaxonomyErr"] != null)
{
    <div class="tx-alert tx-alert-err mb-3" role="alert">@TempData["TaxonomyErr"]</div>
}

<header class="tx-header">
    <div>
        <h1 class="tx-title">@T["tax.title"]</h1>
        <p class="tx-sub">@T["tax.subtitle"]</p>
    </div>
</header>

<div class="tx-kpis" role="group" aria-label="@T["tax.stats_aria"]">
    <button type="button" class="tx-kpi is-active" data-tx-tab="folders">
        <span class="tx-kpi-label">@T["tax.tab_folders"]</span>
        <span class="tx-kpi-value">@folderCount</span>
    </button>
    <button type="button" class="tx-kpi" data-tx-tab="cats">
        <span class="tx-kpi-label">@T["tax.tab_cats"]</span>
        <span class="tx-kpi-value">@catCount</span>
    </button>
    <button type="button" class="tx-kpi" data-tx-tab="tags">
        <span class="tx-kpi-label">@T["tax.tab_tags"]</span>
        <span class="tx-kpi-value">@tagCount</span>
    </button>
    <button type="button" class="tx-kpi" data-tx-tab="series">
        <span class="tx-kpi-label">@T["tax.tab_series"]</span>
        <span class="tx-kpi-value">@seriesCount</span>
    </button>
    <button type="button" class="tx-kpi" data-tx-tab="topics">
        <span class="tx-kpi-label">@T["tax.tab_topics"]</span>
        <span class="tx-kpi-value">@topicCount</span>
    </button>
</div>

<nav class="tx-seg" role="tablist" aria-label="@T["tax.tabs_aria"]">
    <button type="button" class="tx-seg-item is-active" role="tab" aria-selected="true" data-tx-tab="folders">@T["tax.tab_folders"]</button>
    <button type="button" class="tx-seg-item" role="tab" aria-selected="false" data-tx-tab="cats">@T["tax.tab_cats"]</button>
    <button type="button" class="tx-seg-item" role="tab" aria-selected="false" data-tx-tab="tags">@T["tax.tab_tags"]</button>
    <button type="button" class="tx-seg-item" role="tab" aria-selected="false" data-tx-tab="series">@T["tax.tab_series"]</button>
    <button type="button" class="tx-seg-item" role="tab" aria-selected="false" data-tx-tab="topics">@T["tax.tab_topics"]</button>
</nav>

@await Html.PartialAsync("~/Views/Shared/_FoldersPanel.cshtml", Model)

@* Categories *@
<section class="tx-panel" id="tx-cats" role="tabpanel" data-panel="cats" hidden>
    <div class="tx-panel-head">
        <h2 class="tx-panel-title">@T["tax.cats_heading"]</h2>
        <p class="tx-panel-desc">@T["tax.cats_desc"]</p>
    </div>
    <form asp-controller="Taxonomy" asp-action="CreateCategory" method="post" class="tx-form-card">
        @Html.AntiForgeryToken()
        <div class="tx-form-grid">
            <div class="tx-field">
                <label class="tx-label">@T["tax.label_cat_name"]</label>
                <input class="form-control form-control-sm" name="name" required dir="auto" placeholder="@T["tax.ph_cat_name"]" />
            </div>
            <div class="tx-field">
                <label class="tx-label">@T["tax.label_parent"]</label>
                <select class="form-select form-select-sm" name="parentId">
                    <option value="">@T["tax.label_root"]</option>
                    @foreach (var o in Model.ParentOptions)
                    {
                        <option value="@o.Id">@o.Name</option>
                    }
                </select>
            </div>
            <div class="tx-field tx-field-wide">
                <label class="tx-label">@T["tax.label_description"]</label>
                <input class="form-control form-control-sm" name="description" dir="auto" placeholder="@T["tax.ph_desc_short"]" />
            </div>
            <div class="tx-field tx-field-action">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["tax.btn_add"]</button>
            </div>
        </div>
    </form>
    @if (!(Model.Categories?.Any() ?? false))
    {
        <div class="tx-empty">
            <div class="tx-empty-icon" aria-hidden="true">📁</div>
            <p class="tx-empty-title">@T["tax.empty_cats"]</p>
            <p class="tx-empty-hint">@T["tax.empty_cats_hint"]</p>
        </div>
    }
    else
    {
        <div class="tx-search-row">
            <input type="search" class="tx-search" id="catSearch" placeholder="@T["tax.ph_search_cats"]" autocomplete="off" />
        </div>
        <div class="tx-tree" id="catTree">
            @foreach (var c in Model.Categories!)
            {
                <article class="tx-tree-item" data-name="@c.Name.ToLowerInvariant()" style="--depth:@c.Depth">
                    <div class="tx-tree-main">
                        <span class="tx-tree-indent" aria-hidden="true"></span>
                        @if (c.Depth > 0)
                        {
                            <span class="tx-tree-branch" aria-hidden="true">└</span>
                        }
                        else
                        {
                            <span class="tx-tree-root-dot" aria-hidden="true"></span>
                        }
                        <div class="tx-tree-text">
                            <div class="tx-tree-name" dir="auto">@c.Name</div>
                            <div class="tx-tree-meta">
                                <span class="ltr-field">@c.Slug</span>
                                <span class="tx-dot">·</span>
                                <span class="ltr-field">@string.Format(T["tax.posts_n"].ToString(), c.PostCount)</span>
                            </div>
                        </div>
                    </div>
                    <div class="tx-tree-actions">
                        <a class="tx-act" asp-controller="Home" asp-action="Index" asp-route-category="@c.Slug">@T["tax.btn_view"]</a>
                        <form asp-controller="Taxonomy" asp-action="DeleteCategory" method="post"
                              onsubmit="return confirm('@T["tax.confirm_delete_cat"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="tx-act tx-act-danger">@T["tax.btn_delete"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>

@* Tags *@
<section class="tx-panel" id="tx-tags" role="tabpanel" data-panel="tags" hidden>
    <div class="tx-panel-head">
        <h2 class="tx-panel-title">@T["tax.tags_heading"]</h2>
        <p class="tx-panel-desc">@T["tax.tags_desc"]</p>
    </div>
    <form asp-controller="Taxonomy" asp-action="CreateTag" method="post" class="tx-form-card">
        @Html.AntiForgeryToken()
        <div class="tx-form-grid">
            <div class="tx-field">
                <label class="tx-label">@T["tax.label_tag_name"]</label>
                <input class="form-control form-control-sm" name="name" required dir="auto" placeholder="@T["tax.ph_tag_name"]" />
            </div>
            <div class="tx-field tx-field-wide">
                <label class="tx-label">@T["tax.label_description"]</label>
                <input class="form-control form-control-sm" name="description" dir="auto" placeholder="@T["tax.ph_desc"]" />
            </div>
            <div class="tx-field tx-field-action">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["tax.btn_add_tag"]</button>
            </div>
        </div>
    </form>
    @if ((Model.Tags?.Count ?? 0) >= 2)
    {
        <form asp-controller="Taxonomy" asp-action="MergeTags" method="post" class="tx-form-card tx-form-merge">
            @Html.AntiForgeryToken()
            <div class="tx-merge-title">@T["tax.merge_title"]</div>
            <div class="tx-form-grid">
                <div class="tx-field">
                    <label class="tx-label">@T["tax.label_merge_from"]</label>
                    <select class="form-select form-select-sm" name="sourceId" required>
                        @foreach (var t in Model.Tags!) { <option value="@t.Id">@t.Name (@t.PostCount)</option> }
                    </select>
                </div>
                <div class="tx-field">
                    <label class="tx-label">@T["tax.label_merge_to"]</label>
                    <select class="form-select form-select-sm" name="targetId" required>
                        @foreach (var t in Model.Tags!) { <option value="@t.Id">@t.Name (@t.PostCount)</option> }
                    </select>
                </div>
                <div class="tx-field tx-field-action">
                    <button type="submit" class="btn btn-ghost btn-sm w-100">@T["tax.btn_merge"]</button>
                </div>
            </div>
        </form>
    }
    @if ((Model.Tags?.Count ?? 0) == 0)
    {
        <div class="tx-empty">
            <div class="tx-empty-icon" aria-hidden="true">🏷</div>
            <p class="tx-empty-title">@T["tax.empty_tags"]</p>
            <p class="tx-empty-hint">@T["tax.empty_tags_hint"]</p>
        </div>
    }
    else
    {
        <div class="tx-search-row">
            <input type="search" class="tx-search" id="tagSearch" placeholder="@T["tax.ph_search_tags"]" autocomplete="off" />
        </div>
        <div class="tx-tag-cloud" id="tagCloud">
            @foreach (var t in Model.Tags!.OrderByDescending(x => x.PostCount))
            {
                var weight = t.PostCount switch { >= 20 => "xl", >= 10 => "lg", >= 3 => "md", _ => "sm" };
                <div class="tx-tag" data-name="@t.Name.ToLowerInvariant()" data-weight="@weight">
                    <a class="tx-tag-link" asp-controller="Home" asp-action="Index" asp-route-tag="@t.Slug" dir="auto">@t.Name</a>
                    <span class="tx-tag-count ltr-field">@t.PostCount</span>
                    <form asp-controller="Taxonomy" asp-action="DeleteTag" method="post" class="tx-tag-del"
                          onsubmit="return confirm('@T["tax.confirm_delete_tag"]');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="tx-tag-x" title="@T["tax.btn_delete"]" aria-label="@T["tax.btn_delete"]">×</button>
                    </form>
                </div>
            }
        </div>
    }
</section>

@* Series *@
<section class="tx-panel" id="tx-series" role="tabpanel" data-panel="series" hidden>
    <div class="tx-panel-head">
        <h2 class="tx-panel-title">@T["tax.series_heading"]</h2>
        <p class="tx-panel-desc">@T["tax.series_desc"]</p>
    </div>
    <form asp-controller="Taxonomy" asp-action="CreateSeries" method="post" class="tx-form-card">
        @Html.AntiForgeryToken()
        <div class="tx-form-grid">
            <div class="tx-field">
                <label class="tx-label">@T["tax.label_series_name"]</label>
                <input class="form-control form-control-sm" name="name" required dir="auto" placeholder="@T["tax.ph_series_name"]" />
            </div>
            <div class="tx-field tx-field-wide">
                <label class="tx-label">@T["tax.label_description"]</label>
                <input class="form-control form-control-sm" name="description" dir="auto" placeholder="@T["tax.ph_desc"]" />
            </div>
            <div class="tx-field tx-field-action">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["tax.btn_create_series"]</button>
            </div>
        </div>
    </form>
    @if ((Model.Series?.Count ?? 0) == 0)
    {
        <div class="tx-empty">
            <div class="tx-empty-icon" aria-hidden="true">📚</div>
            <p class="tx-empty-title">@T["tax.empty_series"]</p>
        </div>
    }
    else
    {
        <div class="tx-list">
            @foreach (var s in Model.Series!)
            {
                <article class="tx-list-item">
                    <div class="tx-list-text">
                        <div class="tx-list-name" dir="auto">@s.Name</div>
                        <div class="tx-list-meta">
                            <span class="ltr-field">@s.Slug</span>
                            <span class="tx-dot">·</span>
                            <span class="ltr-field">@string.Format(T["tax.posts_n"].ToString(), s.PostCount)</span>
                        </div>
                    </div>
                    <div class="tx-list-actions">
                        <a class="tx-act" asp-controller="Taxonomy" asp-action="EditSeries" asp-route-id="@s.Id">@T["tax.btn_edit"]</a>
                        <a class="tx-act" href="/series/@s.Slug">@T["tax.btn_public"]</a>
                        <form asp-controller="Taxonomy" asp-action="DeleteSeries" method="post"
                              onsubmit="return confirm('@T["tax.confirm_delete_series"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="tx-act tx-act-danger">@T["tax.btn_delete"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>

@* Topics *@
<section class="tx-panel" id="tx-topics" role="tabpanel" data-panel="topics" hidden>
    <div class="tx-panel-head">
        <h2 class="tx-panel-title">@T["tax.topics_heading"]</h2>
        <p class="tx-panel-desc">@T["tax.topics_desc"]</p>
    </div>
    <form asp-controller="Taxonomy" asp-action="CreateTopic" method="post" class="tx-form-card">
        @Html.AntiForgeryToken()
        <div class="tx-form-grid">
            <div class="tx-field">
                <label class="tx-label">@T["tax.label_topic_name"]</label>
                <input class="form-control form-control-sm" name="name" required dir="auto" placeholder="@T["tax.ph_topic_name"]" />
            </div>
            <div class="tx-field tx-field-wide">
                <label class="tx-label">@T["tax.label_description"]</label>
                <input class="form-control form-control-sm" name="description" dir="auto" placeholder="@T["tax.ph_desc"]" />
            </div>
            <div class="tx-field tx-field-action">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["tax.btn_create_topic"]</button>
            </div>
        </div>
    </form>
    @if ((Model.Topics?.Count ?? 0) == 0)
    {
        <div class="tx-empty">
            <div class="tx-empty-icon" aria-hidden="true">🗂</div>
            <p class="tx-empty-title">@T["tax.empty_topics"]</p>
        </div>
    }
    else
    {
        <div class="tx-list">
            @foreach (var t in Model.Topics!)
            {
                <article class="tx-list-item">
                    <div class="tx-list-text">
                        <div class="tx-list-name" dir="auto">@t.Name</div>
                        <div class="tx-list-meta">
                            <span class="ltr-field">@t.Slug</span>
                            <span class="tx-dot">·</span>
                            <span class="ltr-field">@string.Format(T["tax.items_n"].ToString(), t.ItemCount)</span>
                        </div>
                    </div>
                    <div class="tx-list-actions">
                        <a class="tx-act" asp-controller="Taxonomy" asp-action="EditTopic" asp-route-id="@t.Id">@T["tax.btn_edit"]</a>
                        <a class="tx-act" href="/topic/@t.Slug">@T["tax.btn_public"]</a>
                        <form asp-controller="Taxonomy" asp-action="DeleteTopic" method="post"
                              onsubmit="return confirm('@T["tax.confirm_delete_topic"]');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@t.Id" />
                            <button type="submit" class="tx-act tx-act-danger">@T["tax.btn_delete"]</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>

<link rel="stylesheet" href="~/css/taxonomy-admin.css" asp-append-version="true" />

@section Scripts {
<script src="~/js/taxonomy-admin.js" asp-append-version="true"></script>
}
