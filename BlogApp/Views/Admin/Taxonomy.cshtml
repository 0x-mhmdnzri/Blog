@model TaxonomyAdminViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = T["tax.title"];
}

@if (TempData["TaxonomyMsg"] != null)
{
    <div class="alert mb-3" style="background:rgba(158,203,140,.12);color:var(--success);border:1px solid rgba(158,203,140,.35);">@TempData["TaxonomyMsg"]</div>
}
@if (TempData["TaxonomyErr"] != null)
{
    <div class="alert mb-3" style="background:rgba(229,99,122,.12);color:var(--danger);border:1px solid rgba(229,99,122,.35);">@TempData["TaxonomyErr"]</div>
}

<div class="admin-tabs mb-4">
    <a class="admin-tab active" href="#cats">@T["tax.tab_cats"]</a>
    <a class="admin-tab" href="#tags">@T["tax.tab_tags"]</a>
    <a class="admin-tab" href="#series">@T["tax.tab_series"]</a>
    <a class="admin-tab" href="#topics">@T["tax.tab_topics"]</a>
</div>

<section id="cats" class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="h6 mb-0 text-muted-dark">@T["tax.cats_heading"]</h2>
    </div>

    <form asp-controller="Taxonomy" asp-action="CreateCategory" method="post" class="card-surface p-3 mb-3">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@T["tax.label_cat_name"]</label>
                <input class="form-control form-control-sm" name="name" required dir="auto" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@T["tax.label_parent"]</label>
                <select class="form-select form-select-sm" name="parentId">
                    <option value="">@T["tax.label_root"]</option>
                    @foreach (var o in Model.ParentOptions)
                    {
                        <option value="@o.Id">@o.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@T["tax.label_description"]</label>
                <input class="form-control form-control-sm" name="description" dir="auto" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["tax.btn_add"]</button>
            </div>
        </div>
    </form>

    @if (!Model.Categories.Any())
    {
        <div class="admin-empty">@T["tax.empty_cats"]</div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@T["tax.col_name"]</th>
                        <th>@T["tax.col_slug"]</th>
                        <th>@T["tax.col_posts"]</th>
                        <th>@T["tax.col_actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td dir="auto">
                            <span style="padding-inline-start:@(c.Depth * 1.2)rem;display:inline-block;">
                                @if (c.Depth > 0) { <span class="text-muted-dark">└ </span> }
                                @c.Name
                            </span>
                        </td>
                        <td><span class="ltr-field">@c.Slug</span></td>
                        <td><span class="ltr-field">@c.PostCount</span></td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a class="icon-btn" asp-controller="Home" asp-action="Index" asp-route-category="@c.Slug">@T["tax.btn_view"]</a>
                                <form asp-controller="Taxonomy" asp-action="DeleteCategory" method="post"
                                      onsubmit="return confirm('@T["tax.confirm_delete_cat"]');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="icon-btn reject">@T["tax.btn_delete"]</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section id="tags" class="mb-5">
    <h2 class="h6 mb-3 text-muted-dark">@T["tax.tags_heading"]</h2>

    <form asp-controller="Taxonomy" asp-action="CreateTag" method="post" class="card-surface p-3 mb-3">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@T["tax.label_tag_name"]</label>
                <input class="form-control form-control-sm" name="name" required dir="auto" />
            </div>
            <div class="col-md-5">
                <label class="form-label">@T["tax.label_description"]</label>
                <input class="form-control form-control-sm" name="description" dir="auto" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["tax.btn_add_tag"]</button>
            </div>
        </div>
    </form>

    @if (Model.Tags.Count >= 2)
    {
        <form asp-controller="Taxonomy" asp-action="MergeTags" method="post" class="card-surface p-3 mb-3">
            @Html.AntiForgeryToken()
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">@T["tax.label_merge_from"]</label>
                    <select class="form-select form-select-sm" name="sourceId" required>
                        @foreach (var t in Model.Tags) { <option value="@t.Id">@t.Name</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@T["tax.label_merge_to"]</label>
                    <select class="form-select form-select-sm" name="targetId" required>
                        @foreach (var t in Model.Tags) { <option value="@t.Id">@t.Name</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-ghost btn-sm w-100">@T["tax.btn_merge"]</button>
                </div>
            </div>
        </form>
    }

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@T["tax.col_name"]</th>
                    <th>@T["tax.col_slug"]</th>
                    <th>@T["tax.col_posts"]</th>
                    <th>@T["tax.col_actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.Tags)
            {
                <tr>
                    <td dir="auto">@t.Name</td>
                    <td><span class="ltr-field">@t.Slug</span></td>
                    <td><span class="ltr-field">@t.PostCount</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="icon-btn" asp-controller="Home" asp-action="Index" asp-route-tag="@t.Slug">@T["tax.btn_view"]</a>
                            <form asp-controller="Taxonomy" asp-action="DeleteTag" method="post"
                                  onsubmit="return confirm('@T["tax.confirm_delete_tag"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="icon-btn reject">@T["tax.btn_delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section id="series" class="mb-5">
    <h2 class="h6 mb-3 text-muted-dark">@T["tax.series_heading"]</h2>

    <form asp-controller="Taxonomy" asp-action="CreateSeries" method="post" class="card-surface p-3 mb-3">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@T["tax.label_series_name"]</label>
                <input class="form-control form-control-sm" name="name" required dir="auto" />
            </div>
            <div class="col-md-5">
                <label class="form-label">@T["tax.label_description"]</label>
                <input class="form-control form-control-sm" name="description" dir="auto" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["tax.btn_create_series"]</button>
            </div>
        </div>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@T["tax.col_name"]</th>
                    <th>@T["tax.col_slug"]</th>
                    <th>@T["tax.col_posts"]</th>
                    <th>@T["tax.col_actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Series)
            {
                <tr>
                    <td dir="auto">@s.Name</td>
                    <td><span class="ltr-field">@s.Slug</span></td>
                    <td><span class="ltr-field">@s.PostCount</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="icon-btn" asp-controller="Taxonomy" asp-action="EditSeries" asp-route-id="@s.Id">@T["tax.btn_edit"]</a>
                            <a class="icon-btn" href="/series/@s.Slug">@T["tax.btn_public"]</a>
                            <form asp-controller="Taxonomy" asp-action="DeleteSeries" method="post"
                                  onsubmit="return confirm('@T["tax.confirm_delete_series"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="icon-btn reject">@T["tax.btn_delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section id="topics" class="mb-5">
    <h2 class="h6 mb-3 text-muted-dark">@T["tax.topics_heading"]</h2>

    <form asp-controller="Taxonomy" asp-action="CreateTopic" method="post" class="card-surface p-3 mb-3">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@T["tax.label_topic_name"]</label>
                <input class="form-control form-control-sm" name="name" required dir="auto" />
            </div>
            <div class="col-md-5">
                <label class="form-label">@T["tax.label_description"]</label>
                <input class="form-control form-control-sm" name="description" dir="auto" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-accent btn-sm w-100">@T["tax.btn_create_topic"]</button>
            </div>
        </div>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@T["tax.col_name"]</th>
                    <th>@T["tax.col_slug"]</th>
                    <th>@T["tax.col_items"]</th>
                    <th>@T["tax.col_actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.Topics)
            {
                <tr>
                    <td dir="auto">@t.Name</td>
                    <td><span class="ltr-field">@t.Slug</span></td>
                    <td><span class="ltr-field">@t.ItemCount</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="icon-btn" asp-controller="Taxonomy" asp-action="EditTopic" asp-route-id="@t.Id">@T["tax.btn_edit"]</a>
                            <a class="icon-btn" href="/topic/@t.Slug">@T["tax.btn_public"]</a>
                            <form asp-controller="Taxonomy" asp-action="DeleteTopic" method="post"
                                  onsubmit="return confirm('@T["tax.confirm_delete_topic"]');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="icon-btn reject">@T["tax.btn_delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
