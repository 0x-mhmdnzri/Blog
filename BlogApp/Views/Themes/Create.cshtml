@model BlogApp.Models.CustomTheme
@{
    ViewData["Title"] = "تم جدید";
}
<div class="container py-4" style="max-width:720px">
    <h1 class="h5 mb-2">ساخت تم</h1>
    <p class="small text-muted-dark mb-3">حداقل کنتراست متن روی پس‌زمینه ۴٫۵:۱ و اکسنت ۳:۱ الزامی است. می‌توانید دستی بسازید یا فایل <code>.blogtheme</code> بارگذاری کنید.</p>

    @if (TempData["Err"] != null)
    {
        <div class="card-surface p-2 px-3 mb-3 small" style="border-color:var(--danger)">@TempData["Err"]</div>
    }

    <div class="card-surface p-3 mb-3">
        <h2 class="h6 mb-2">بارگذاری فایل تم</h2>
        <p class="small text-muted-dark mb-2">فایل JSON با پسوند <code>.blogtheme</code> — پس از بارگذاری برای شما اعمال می‌شود و در صورت ارسال برای تأیید در گالری عمومی قرار می‌گیرد.</p>
        <form asp-action="ImportFile" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="flex-grow-1" style="min-width:12rem">
                <label class="form-label small mb-1" for="themeFile">فایل</label>
                <input id="themeFile" type="file" name="file" accept=".blogtheme,application/json,.json" class="form-control form-control-sm" required />
            </div>
            <button class="btn btn-ghost btn-sm" type="submit" name="action" value="draft">بارگذاری پیش‌نویس</button>
            <button class="btn btn-accent btn-sm" type="submit" name="action" value="submit">بارگذاری و ارسال برای تأیید</button>
        </form>
    </div>

    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

    <form method="post" class="card-surface p-3">
        @Html.AntiForgeryToken()
        <h2 class="h6 mb-2">ساخت دستی</h2>
        <div class="mb-2">
            <label class="form-label" asp-for="Name">نام</label>
            <input class="form-control form-control-sm" asp-for="Name" required maxlength="80" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Description">توضیح</label>
            <input class="form-control form-control-sm" asp-for="Description" maxlength="240" />
        </div>
        <div class="row g-2">
            @foreach (var f in new (string Prop, string Label)[] {
                ("Bg","پس‌زمینه"), ("Surface","Surface"), ("Surface2","Surface 2"),
                ("Border","حاشیه"), ("Text","متن"), ("TextMuted","متن کم‌رنگ"),
                ("Accent","اکسنت"), ("Danger","خطر"), ("Success","موفقیت")
            })
            {
                <div class="col-6 col-md-4">
                    <label class="form-label small">@f.Label</label>
                    <input class="form-control form-control-sm ltr-field" name="@f.Prop" type="color"
                           value="@(typeof(BlogApp.Models.CustomTheme).GetProperty(f.Prop)!.GetValue(Model))" />
                </div>
            }
        </div>
        <div class="d-flex gap-2 mt-3 flex-wrap">
            <button class="btn btn-ghost btn-sm" type="submit" name="action" value="draft">ذخیره پیش‌نویس</button>
            <button class="btn btn-accent btn-sm" type="submit" name="action" value="submit">ارسال برای تأیید</button>
            <a class="btn btn-ghost btn-sm" asp-action="Index">بازگشت</a>
        </div>
    </form>
</div>
