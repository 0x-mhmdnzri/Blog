{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Information",
        "BlogApp": "Debug"
      }
    },
    "Properties": {
      "Application": "BlogApp",
      "Environment": "Development"
    }
  },
  "Backup": {
    "Enabled": true,
    "Path": "",
    "IntervalHours": 24,
    "RetentionDays": 14,
    "MaxFiles": 30,
    "IncludeDatabase": true,
    "IncludeDataDirectory": true,
    "TargetRtoMinutes": 30
  }
}
