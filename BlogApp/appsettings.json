{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=blog.db;Cache=Shared;Pooling=True;Default Timeout=30"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxPoolSize": 100,
    "MinPoolSize": 0,
    "ConnectionLifetime": true
  },
  "ForceHttps": false,
  "OpenTelemetry": {
    "ServiceName": "BlogApp",
    "OtlpEndpoint": "",
    "Prometheus": true
  },
  "RabbitMq": {
    "HostName": "",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "FanoutExchange": "blog.notifications.fanout",
    "TopicExchange": "blog.notifications.topic",
    "ClientProvidedName": "blogapp-notifications",
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoverySeconds": 10,
    "RequestedHeartbeatSeconds": 30,
    "RequestedConnectionTimeoutSeconds": 5,
    "DispatchConsumersAsync": true
  },
  "ApiTopicBus": {
    "UseRabbit": true,
    "TopicExchange": "blog.api.topic",
    "WorkQueue": "blog.api.work",
    "RoutingPrefix": "api",
    "Prefetch": 1,
    "DefaultTimeoutSeconds": 25,
    "InProcessCapacity": 10000
  },
  "Performance": {
    "Cache": {
      "Provider": "memory",
      "RedisConnection": "",
      "RedisInstanceName": "BlogApp:",
      "DefaultSeconds": 60,
      "HomeFeedSeconds": 30,
      "PostPageSeconds": 120,
      "StaticMediaSeconds": 604800,
      "OutputCacheEnabled": true,
      "ResponseCacheEnabled": true
    },
    "Cdn": {
      "Enabled": false,
      "BaseUrl": "https://cdn.example.com",
      "RewriteMediaPaths": true
    },
    "ImageOptimize": {
      "Enabled": true,
      "MaxWidth": 1920,
      "JpegQuality": 82,
      "PreferWebP": true
    },
    "Jobs": {
      "Enabled": true,
      "PollIntervalMs": 2000,
      "BatchSize": 8,
      "Workers": 2
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "BlogApp": "Information"
      }
    },
    "Properties": {
      "Application": "BlogApp",
      "Environment": "Production"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Admin": {
    "Username": "admin",
    "Password": "ChangeMe123!",
    "Email": "admin@localhost"
  },
  "Seo": {
    "SiteName": "وبلاگ دارک‌پرو",
    "SiteDescription": "یادداشت‌های بلند و فنی به سبک ریدمی درباره دات‌نت، معماری نرم‌افزار و ساختن درست چیزها.",
    "AuthorName": "مدیر کل",
    "BaseUrl": "https://example.com",
    "TwitterHandle": "@yourhandle"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "noreply@example.com",
    "FromDisplayName": "وبلاگ دارک‌پرو"
  },
  "Sms": {
    "Enabled": false,
    "Provider": "none",
    "ApiKey": "",
    "ApiSecret": "",
    "FromNumber": "",
    "Endpoint": ""
  },
  "Push": {
    "Enabled": false,
    "VapidPublicKey": "",
    "VapidPrivateKey": "",
    "Subject": "mailto:admin@example.com"
  },
  "Digest": {
    "Enabled": true,
    "DayOfWeekUtc": 1,
    "HourUtc": 8
  }
}
